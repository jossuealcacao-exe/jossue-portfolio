# Public canonical origin. Keep empty locally to use https://portfolio.invalid.
PUBLIC_SITE_URL=

# Optional analytics identifiers. Never load analytics before consent.
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=G-LVEXEJH1YJ

# Contact form delivery.
#
# Leave EMPTY and the form still works: it opens the visitor's mail client
# with every field pre-filled and addressed to the email in src/data/contact.ts.
#
# Set it to receive submissions in your inbox without the mail-client step.
# Paste the POST URL your form provider gives you, for example:
#   Formspree   https://formspree.io/f/xxxxxxxx
#   Web3Forms   https://api.web3forms.com/submit   (also add access_key)
#   Basin       https://usebasin.com/f/xxxxxxxx
# The form posts multipart/form-data with: name, email, organization,
# siteUrl, projectType, budget, message, consent.
PUBLIC_CONTACT_ENDPOINT=

# Production uses the same-origin Cloudflare Worker endpoint:
# PUBLIC_SITE_URL=https://jossuealcala.com
# PUBLIC_CONTACT_ENDPOINT=/api/contact

# Local contact API (`npm run api`).
# Use a long random value in production; never commit the real token.
CONTACT_API_HOST=0.0.0.0
CONTACT_API_PORT=8787
CONTACT_DATA_FILE=./api/data/submissions.json
CONTACT_ADMIN_TOKEN=
CONTACT_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://192.168.100.110:4321
CONTACT_SUBMISSIONS_ENDPOINT=https://jossuealcala.com/api/submissions
