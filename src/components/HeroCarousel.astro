---
import type { ImageMetadata } from 'astro';
import { routes, type Locale } from '../data/i18n';
import heroDevDesktop from '../assets/hero/hero-dev-desktop.webp';
import heroDevMobile from '../assets/hero/hero-dev-mobile.webp';
import heroProfileDesktop from '../assets/hero/hero-profile-desktop.webp';
import heroProfileMobile from '../assets/hero/hero-profile-mobile.webp';
import heroUxDesktop from '../assets/hero/hero-ux-desktop.webp';
import heroUxMobile from '../assets/hero/hero-ux-mobile.webp';
import Icon, { type IconName } from './Icon.astro';

interface Props {
	locale: Locale;
}

interface HeroSlide {
	id: 'profile' | 'ux' | 'development';
	kicker: string;
	title: string;
	copy: string;
	icon: IconName;
	primary: string;
	secondary: string;
	visualLabel: string;
	points: Array<{ label: string; icon: IconName }>;
	image: {
		desktop: ImageMetadata;
		mobile: ImageMetadata;
	};
}

const { locale } = Astro.props;
const es = locale === 'es';
const slides: HeroSlide[] = es
	? [
			{
				id: 'profile',
				kicker: 'Ecommerce Product Builder',
				title: 'Ecommerce que de verdad vende.',
				copy: 'Estrategia, UX, Shopify e IA para convertir oportunidades en productos reales.',
				icon: 'user',
				primary: 'Explorar proyectos',
				secondary: 'Platiquemos',
				visualLabel: 'Perfil profesional',
				points: [
					{ label: 'Estrategia', icon: 'trend-up' },
					{ label: 'Producto', icon: 'basket' },
					{ label: 'Operación', icon: 'check-list' },
				],
				image: {
					desktop: heroProfileDesktop,
					mobile: heroProfileMobile,
				},
			},
			{
				id: 'ux',
				kicker: 'UX ecommerce · CRO',
				title: 'UX que reduce fricción.',
				copy: 'Desarrollo de UX coherentes enfocadas en CRO.',
				icon: 'basket',
				primary: 'Ver trabajo UX',
				secondary: 'Contáctame',
				visualLabel: 'Optimización ecommerce',
				points: [
					{ label: 'Descubrir', icon: 'filter' },
					{ label: 'Decidir', icon: 'badge-percent' },
					{ label: 'Comprar', icon: 'basket' },
				],
				image: {
					desktop: heroUxDesktop,
					mobile: heroUxMobile,
				},
			},
			{
				id: 'development',
				kicker: 'Web Development',
				title: 'Desarrollo web profesional, personalizado y adaptado a tu negocio.',
				copy: 'Arquitectura, componentes y datos convertidos en interfaces medibles.',
				icon: 'code',
				primary: 'Ver servicios',
				secondary: 'Habla conmigo',
				visualLabel: 'Desarrollo web',
				points: [
					{ label: 'Arquitectura', icon: 'display' },
					{ label: 'Componentes', icon: 'code' },
					{ label: 'QA', icon: 'check-list' },
				],
				image: {
					desktop: heroDevDesktop,
					mobile: heroDevMobile,
				},
			},
		]
	: [
			{
				id: 'profile',
				kicker: 'Ecommerce Product Builder',
				title: 'Ecommerce that truly sells.',
				copy: 'Strategy, UX, Shopify, and AI turning opportunities into real products.',
				icon: 'user',
				primary: 'Explore projects',
				secondary: 'Let’s talk',
				visualLabel: 'Professional profile',
				points: [
					{ label: 'Strategy', icon: 'trend-up' },
					{ label: 'Product', icon: 'basket' },
					{ label: 'Operation', icon: 'check-list' },
				],
				image: {
					desktop: heroProfileDesktop,
					mobile: heroProfileMobile,
				},
			},
			{
				id: 'ux',
				kicker: 'Ecommerce UX · CRO',
				title: 'UX with less friction.',
				copy: 'Coherent UX built around CRO.',
				icon: 'basket',
				primary: 'View UX work',
				secondary: 'Contact me',
				visualLabel: 'Ecommerce optimization',
				points: [
					{ label: 'Discover', icon: 'filter' },
					{ label: 'Decide', icon: 'badge-percent' },
					{ label: 'Buy', icon: 'basket' },
				],
				image: {
					desktop: heroUxDesktop,
					mobile: heroUxMobile,
				},
			},
			{
				id: 'development',
				kicker: 'Web Development',
				title: 'Professional web development, tailored to your business.',
				copy: 'Architecture, components, and data turned into measurable interfaces.',
				icon: 'code',
				primary: 'View services',
				secondary: 'Talk to me',
				visualLabel: 'Web development',
				points: [
					{ label: 'Architecture', icon: 'display' },
					{ label: 'Components', icon: 'code' },
					{ label: 'QA', icon: 'check-list' },
				],
				image: {
					desktop: heroDevDesktop,
					mobile: heroDevMobile,
				},
			},
		];

const heroTitleId = `home-hero-title-${locale}`;
---

<div class="hero-carousel" data-hero-carousel aria-label={es ? 'Enfoques profesionales' : 'Professional focus areas'}>
	<div class="hero-carousel__viewport" data-hero-viewport>
		<div class="hero-carousel__slides">
		{slides.map((slide, index) => (
			<section
				class:list={['hero-carousel__slide', `hero-carousel__slide--${slide.id}`]}
				aria-labelledby={index === 0 ? heroTitleId : undefined}
				data-hero-slide
			>
				<figure class="hero-carousel__visual" aria-label={slide.visualLabel}>
					<div class="hero-visual">
						<picture class="hero-visual__media" aria-hidden="true">
							<source media="(max-width: 767px)" srcset={slide.image.mobile.src} />
							<img
								src={slide.image.desktop.src}
								width={slide.image.desktop.width}
								height={slide.image.desktop.height}
								alt=""
								loading={index === 0 ? 'eager' : 'lazy'}
								decoding="async"
							/>
						</picture>
						<div class="hero-visual__topline">
							<span>{String(index + 1).padStart(2, '0')}</span>
							<strong>{slide.visualLabel}</strong>
						</div>
					</div>
				</figure>
				<div class="hero-carousel__content flow">
					<p class="eyebrow">
						<Icon name={slide.icon} />
						{slide.kicker}
					</p>
					{index === 0 ? (
						<h1 id={heroTitleId} class="hero-title">
							<span class="hero-title__sizer" aria-hidden="true">{slide.title}</span>
							<span class="hero-title__type" data-tw data-tw-text={slide.title}>{slide.title}</span>
						</h1>
					) : (
						<h2 class="hero-title">
							<span class="hero-title__sizer" aria-hidden="true">{slide.title}</span>
							<span class="hero-title__type" data-tw data-tw-text={slide.title}>{slide.title}</span>
						</h2>
					)}
					<p class="hero__lede">{slide.copy}</p>
					<ul class="hero-carousel__badges">
						{slide.points.map((point) => <li><Icon name={point.icon} />{point.label}</li>)}
					</ul>
					<div class="hero__actions">
						<a class="button" href={index === 1 ? routes[locale].work : index === 2 ? routes[locale].services : routes[locale].work}>
							{slide.primary}
						</a>
						<a class="button button--ghost" href={routes[locale].contact} data-analytics-event="click_contact">
							{slide.secondary}
						</a>
					</div>
				</div>
			</section>
		))}
		</div>
	</div>
	<div class="hero-carousel__controls" aria-label={es ? 'Cambiar enfoque' : 'Change focus'}>
		{slides.map((slide, index) => (
			<button type="button" data-hero-control data-slide-index={index} aria-current={index === 0 ? 'true' : 'false'}>
				<span>{String(index + 1).padStart(2, '0')}</span>
				{slide.visualLabel}
			</button>
		))}
	</div>
	<button class="hero-carousel__nav hero-carousel__nav--prev" type="button" data-hero-prev aria-label={es ? 'Slide anterior' : 'Previous slide'}>
		<Icon name="arrow-left" />
	</button>
	<button class="hero-carousel__nav hero-carousel__nav--next" type="button" data-hero-next aria-label={es ? 'Slide siguiente' : 'Next slide'}>
		<Icon name="arrow-right" />
	</button>
</div>

<script>
	const MOTION_REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const AUTOPLAY_MS = 7000;
	const heroCarousels = document.querySelectorAll('[data-hero-carousel]');

	heroCarousels.forEach((carousel) => {
		const viewport = carousel.querySelector<HTMLElement>('[data-hero-viewport]');
		const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-hero-slide]'));
		const controls = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-hero-control]'));
		const prev = carousel.querySelector<HTMLButtonElement>('[data-hero-prev]');
		const next = carousel.querySelector<HTMLButtonElement>('[data-hero-next]');
		let activeIndex = -1;
		let frame = 0;
		let autoplayTimer = 0;
		let typeTimer = 0;
		let paused = false;
		let dragging = false;
		let moved = false;
		let startX = 0;
		let startLeft = 0;
		// While a programmatic smooth scroll is in flight, ignore scroll-driven
		// active tracking so it cannot fight the transition (retype/reschedule churn).
		let settling = false;
		let settleTarget = 0;
		let settleTimer = 0;

		if (!viewport || slides.length === 0) return;

		const typeTitle = (slide: HTMLElement) => {
			const target = slide.querySelector<HTMLElement>('[data-tw]');
			if (!target) return;
			const full = target.dataset.twText ?? target.textContent ?? '';
			target.dataset.twText = full;
			window.clearInterval(typeTimer);
			const holder = target.closest('.hero-title');
			if (MOTION_REDUCED) {
				target.textContent = full;
				return;
			}
			holder?.classList.add('is-typing');
			let count = 0;
			target.textContent = '';
			const stepMs = Math.max(24, Math.min(48, Math.round(1000 / Math.max(1, full.length))));
			typeTimer = window.setInterval(() => {
				count += 1;
				target.textContent = full.slice(0, count);
				if (count >= full.length) {
					window.clearInterval(typeTimer);
					holder?.classList.remove('is-typing');
				}
			}, stepMs);
		};

		const syncProgress = () => {
			controls.forEach((control, controlIndex) => {
				control.classList.remove('is-filling');
				if (controlIndex === activeIndex && !MOTION_REDUCED && !paused) {
					void control.offsetWidth;
					control.classList.add('is-filling');
				}
			});
		};

		const schedule = () => {
			window.clearTimeout(autoplayTimer);
			if (MOTION_REDUCED || paused) return;
			autoplayTimer = window.setTimeout(() => goTo(activeIndex + 1), AUTOPLAY_MS);
		};

		const setActive = (index: number, force = false) => {
			const nextIndex = (index + slides.length) % slides.length;
			if (nextIndex === activeIndex && !force) return;
			activeIndex = nextIndex;
			controls.forEach((control, controlIndex) => {
				control.setAttribute('aria-current', String(controlIndex === activeIndex));
			});
			slides.forEach((slide, slideIndex) => slide.classList.toggle('is-active', slideIndex === activeIndex));
			typeTitle(slides[activeIndex]);
			syncProgress();
			schedule();
		};

		const goTo = (index: number) => {
			const nextIndex = (index + slides.length) % slides.length;
			settleTarget = slides[nextIndex].offsetLeft;
			settling = true;
			window.clearTimeout(settleTimer);
			settleTimer = window.setTimeout(() => {
				settling = false;
			}, 900);
			viewport.scrollTo({ left: settleTarget, behavior: MOTION_REDUCED ? 'auto' : 'smooth' });
			setActive(nextIndex);
		};

		const pause = () => {
			if (paused) return;
			paused = true;
			carousel.classList.add('is-paused');
			window.clearTimeout(autoplayTimer);
		};

		const resume = () => {
			if (!paused) return;
			paused = false;
			carousel.classList.remove('is-paused');
			syncProgress();
			schedule();
		};

		controls.forEach((control) => {
			control.addEventListener('click', () => goTo(Number(control.dataset.slideIndex ?? 0)));
		});

		prev?.addEventListener('click', () => goTo(activeIndex - 1));
		next?.addEventListener('click', () => goTo(activeIndex + 1));

		viewport.addEventListener('pointerdown', (event) => {
			if (event.pointerType === 'touch' || (event.target instanceof Element && event.target.closest('a, button'))) return;
			dragging = true;
			moved = false;
			startX = event.clientX;
			startLeft = viewport.scrollLeft;
			viewport.setPointerCapture(event.pointerId);
			viewport.dataset.dragging = 'true';
			settling = false;
			window.clearTimeout(settleTimer);
			pause();
		});

		viewport.addEventListener('pointermove', (event) => {
			if (!dragging) return;
			const delta = event.clientX - startX;
			if (Math.abs(delta) > 4) moved = true;
			viewport.scrollLeft = startLeft - delta;
		});

		viewport.addEventListener('pointerup', (event) => {
			if (!dragging) return;
			dragging = false;
			viewport.releasePointerCapture(event.pointerId);
			delete viewport.dataset.dragging;
			if (moved) {
				const nearest = Math.round(viewport.scrollLeft / viewport.clientWidth);
				resume();
				goTo(nearest);
			} else {
				resume();
			}
		});

		viewport.addEventListener('scroll', () => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(() => {
				if (settling) {
					if (Math.abs(viewport.scrollLeft - settleTarget) < 2) settling = false;
					return;
				}
				const closest = slides.reduce(
					(best, slide, index) => {
						const distance = Math.abs(slide.offsetLeft - viewport.scrollLeft);
						return distance < best.distance ? { index, distance } : best;
					},
					{ index: activeIndex, distance: Number.POSITIVE_INFINITY },
				);
				setActive(closest.index);
			});
		}, { passive: true });

		carousel.addEventListener('focusin', pause);
		carousel.addEventListener('focusout', (event) => {
			const related = (event as FocusEvent).relatedTarget;
			if (!(related instanceof Node) || !carousel.contains(related)) resume();
		});
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) pause();
			else resume();
		});

		setActive(0, true);
	});
</script>
