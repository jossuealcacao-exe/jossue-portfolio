---
import { workImage } from '../data/workImages';
import MediaSlot from './surface/MediaSlot.astro';

interface MediaItem {
	key: string;
	alt: string;
	caption: string;
	sourceUrl: string;
	capturedAt: string;
	viewport: string;
	annotations?: unknown[];
}

interface Props {
	media: MediaItem[];
	locale: 'es' | 'en';
}

const { media, locale } = Astro.props;
const es = locale === 'es';
const ratioFor = (item: MediaItem): '16:9' | '4:3' | '9:16' =>
	/mobile|390|iphone|9:16/i.test(`${item.key} ${item.viewport}`) ? '9:16' : /4:3/i.test(item.viewport) ? '4:3' : '16:9';
---

<div class="evidence-gallery evidence-gallery--shots" role="region" aria-label={es ? 'Galería del proyecto' : 'Project gallery'}>
	<div class="evidence-placeholder-grid">
		{media.map((item, index) => {
			const src = workImage(item.key);
			return (
				<article class:list={['evidence-shot', ratioFor(item) === '9:16' && 'evidence-shot--portrait']}>
					<MediaSlot
						id={`gallery-${item.key}`}
						ratio={ratioFor(item) === '9:16' ? '9:16' : '16:9'}
						variant="bleed"
						src={src}
						alt={item.alt}
						label={`${String(index + 1).padStart(2, '0')} / ${String(media.length).padStart(2, '0')} · ${item.alt}`}
						note={es ? 'Captura pendiente.' : 'Screenshot pending.'}
					/>
					<p><span class="jx-mono">{String(index + 1).padStart(2, '0')}</span> {item.caption}</p>
				</article>
			);
		})}
	</div>
</div>
