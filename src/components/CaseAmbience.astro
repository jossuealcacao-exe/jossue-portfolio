---
import { caseCover, workImage } from '../data/workImages';
import MediaSlot from './surface/MediaSlot.astro';

interface AmbienceItem {
	key: string;
	alt: string;
	caption: string;
	generatedWith: string;
	generatedAt: string;
}

interface Props {
	ambience: AmbienceItem;
	locale: 'es' | 'en';
	slug: string;
	title: string;
}

const { ambience, locale, slug, title } = Astro.props;
const es = locale === 'es';
const src = workImage(ambience.key) ?? caseCover(slug);
---

<figure class="case-ambience" data-case-ambience>
	<MediaSlot
		id={`ambience-${ambience.key}`}
		ratio="16:9"
		variant="bleed"
		src={src}
		alt={es ? `Portada de ${title}` : `${title} home page`}
		label={es ? 'Escena de contexto · por diseñar' : 'Context scene · to be designed'}
		note={ambience.caption}
	/>
	<figcaption class="case-ambience__caption">
		<p class="eyebrow">{title}</p>
		<p>{src ? (es ? 'La portada del proyecto, capturada del sitio en septiembre de 2026.' : 'The project home page, captured from the site in September 2026.') : ambience.caption}</p>
	</figcaption>
</figure>
