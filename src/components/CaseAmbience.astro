---
import MediaSlot from './surface/MediaSlot.astro';

interface AmbienceItem {
	key: string;
	alt: string;
	caption: string;
	generatedWith: string;
	generatedAt: string;
}

interface Props {
	ambience: AmbienceItem;
	locale: 'es' | 'en';
}

const { ambience, locale } = Astro.props;
const es = locale === 'es';
---

<figure class="case-ambience" data-case-ambience>
	<MediaSlot
		id={`ambience-${ambience.key}`}
		ratio="16:9"
		variant="bleed"
		label={es ? 'Escena de contexto · por diseñar' : 'Context scene · to be designed'}
		note={ambience.caption}
	/>
	<figcaption class="case-ambience__caption">
		<p class="eyebrow">{es ? 'Placeholder editorial' : 'Editorial placeholder'}</p>
		<p>{es ? 'La ambientación anterior se retiró. Este espacio conserva la proporción para la imagen definitiva.' : 'The previous ambience image was removed. This space keeps the final image ratio.'}</p>
	</figcaption>
</figure>
