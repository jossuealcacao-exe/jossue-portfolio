---
// Chatbots inteligentes: la página de venta para empresas que quieren su propio asistente.
// Demos reales (Daniela y Jossue AI), qué ganan, cómo se conecta, tradicional vs inteligente,
// arquitectura y seguridad, política contra abusos, costos de API con calculadora y FAQ.
// Los precios de API son los oficiales publicados por cada proveedor (fecha abajo). Las cifras
// de uso de referencia son las de Jossue AI medidas en producción; de Daniela solo se publican
// capacidades y stack, sin volúmenes ni costos de WU Nutrition.
import { routes, type Locale } from '../data/i18n';
import { commercialProduct, productDemo } from '../data/products';
import Breadcrumbs from './Breadcrumbs.astro';
import DemoVideo from './DemoVideo.astro';
import Icon, { type IconName } from './Icon.astro';
import PageHero from './PageHero.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';
const product = commercialProduct('chatbots');
const daniela = commercialProduct('daniela');
if (!product || !daniela) throw new Error('chatbots and daniela products are required');
const jossueDemo = productDemo(product, locale);
const danielaDemo = productDemo(daniela, locale);
const contactUrl = `${routes[locale].contact}?producto=chatbots`;
const flow = es ? '/videos/chatbots/chatbot-flow-es' : '/videos/chatbots/chatbot-flow-en';
const flowDemo = { wide: flow, tall: `${flow}-tall`, label: es ? 'Cómo funciona' : 'How it works', alt: es ? 'Animación: el cliente pregunta, el mensaje pasa por los controles de seguridad, la IA responde con el catálogo, los pedidos y la lista de clientes, arma el carrito y deja guardados los datos del cliente.' : 'Animation: the customer asks, the message goes through security checks, the AI answers with the catalog, orders and customer list, builds the cart and saves the customer’s details.' };

// Precios oficiales por millón de tokens (USD), consultados el 30 de septiembre de 2026.
const PRICES_AS_OF = es ? '30 de septiembre de 2026' : 'September 30, 2026';
const models = [
	{ id: 'gemini-3.8-flash', vendor: 'Google', name: 'Gemini 3.8 Flash', input: 0.75, output: 3.75, note: es ? 'Precio promocional hasta el 31 dic 2026 (después $1.50 / $7.50).' : 'Promotional price through Dec 31, 2026 (then $1.50 / $7.50).', url: 'https://ai.google.dev/gemini-api/docs/pricing' },
	{ id: 'gemini-3.5-flash', vendor: 'Google', name: 'Gemini 3.5 Flash', input: 1.5, output: 9, note: es ? 'El que usan hoy Daniela y Jossue AI.' : 'What Daniela and Jossue AI use today.', url: 'https://ai.google.dev/gemini-api/docs/pricing' },
	{ id: 'gemini-3.1-flash-lite', vendor: 'Google', name: 'Gemini 3.1 Flash-Lite', input: 0.25, output: 1.5, note: es ? 'Para mucho volumen y preguntas simples.' : 'For high volume and simple questions.', url: 'https://ai.google.dev/gemini-api/docs/pricing' },
	{ id: 'gpt-6-luna', vendor: 'OpenAI', name: 'GPT-6 Luna', input: 0.1, output: 0.5, note: es ? 'El más barato de la tabla.' : 'The cheapest in the table.', url: 'https://developers.openai.com/api/docs/pricing' },
	{ id: 'gpt-6.1-sol', vendor: 'OpenAI', name: 'GPT-6.1 Sol', input: 2, output: 10, note: es ? 'Razona mejor en casos complicados.' : 'Reasons better through complicated cases.', url: 'https://developers.openai.com/api/docs/pricing' },
	{ id: 'claude-haiku-4-5', vendor: 'Anthropic', name: 'Claude Haiku 4.5', input: 1, output: 5, note: es ? 'Rápido, buen tono en español.' : 'Fast, good tone in Spanish.', url: 'https://platform.claude.com/docs/en/about-claude/pricing' },
	{ id: 'claude-sonnet-5-5', vendor: 'Anthropic', name: 'Claude Sonnet 5.5', input: 2, output: 10, note: es ? 'Para conversaciones más complejas.' : 'For more complex conversations.', url: 'https://platform.claude.com/docs/en/about-claude/pricing' },
];
// Referencia medida en producción (Jossue AI, sep 2026): ~9,200 tokens de entrada y ~120 de salida por mensaje.
const REF = { inputPerMessage: 9200, outputPerMessage: 120, messages: 6 };
const perConversation = (m: (typeof models)[number]) => (REF.messages * (REF.inputPerMessage * m.input + REF.outputPerMessage * m.output)) / 1_000_000;
const usd = (value: number) => (value < 0.01 ? `$${value.toFixed(4)}` : `$${value.toFixed(3)}`);

const gains: Array<{ icon: IconName; title: string; text: string }> = es
	? [
			{ icon: 'bolt', title: 'Vendes también de noche', text: 'Responde en segundos, cualquier día a cualquier hora. La duda de las 11 de la noche ya no espera al lunes.' },
			{ icon: 'basket', title: 'Menos compras que se caen por una duda', text: 'Resuelve envío, pagos, tallas o cuál conviene en el momento en que la persona está por comprar.' },
			{ icon: 'chats', title: 'Tu equipo atiende lo importante', text: 'Las preguntas de siempre las contesta el asistente. Lo delicado o una venta grande se lo pasa a una persona, con toda la conversación.' },
			{ icon: 'user', title: 'Los datos del cliente, ya guardados', text: 'Nombre, qué busca y la conversación completa quedan en tu lista de clientes (CRM), sin que nadie copie y pegue.' },
			{ icon: 'trend-up', title: 'Sabes qué pregunta tu cliente', text: 'Cada conversación te dice qué falta en tu ficha de producto, qué objeción frena y qué campaña funciona.' },
			{ icon: 'shield', title: 'Sin respuestas inventadas', text: 'Solo usa tus datos. Si algo no lo sabe, lo dice y ofrece hablar con alguien.' },
		]
	: [
			{ icon: 'bolt', title: 'You sell at night too', text: 'It answers in seconds, any day, any hour. The 11 p.m. question no longer waits until Monday.' },
			{ icon: 'basket', title: 'Fewer purchases lost to a doubt', text: 'It solves shipping, payments, sizes or which one fits right when the person is about to buy.' },
			{ icon: 'chats', title: 'Your team handles what matters', text: 'The assistant answers the usual questions. Sensitive cases or a big sale go to a person, with the whole conversation.' },
			{ icon: 'user', title: 'Customer details, already saved', text: 'Name, what they are looking for and the full conversation land in your customer list (CRM), with nobody copying and pasting.' },
			{ icon: 'trend-up', title: 'You learn what customers ask', text: 'Each conversation tells you what your product page is missing, which objection stops people and which campaign works.' },
			{ icon: 'shield', title: 'No made-up answers', text: 'It only uses your data. If it does not know something, it says so and offers a person.' },
		];

const stack = es
	? [
			['Dónde habla', 'Tu tienda, tu sitio o WhatsApp Business', 'La ventana de chat aparece en tu página, y el mismo asistente puede atender también en otros canales.'],
			['El servidor', 'Cloudflare Workers', 'Recibe cada mensaje, pone límites, oculta los datos personales y revisa lo que la IA quiere hacer antes de hacerlo.'],
			['La IA', 'Gemini, Claude u OpenAI', 'Elijo cuál usar por precio, rapidez y cómo suena en español. Se puede cambiar después sin rehacer el chatbot.'],
			['Tus sistemas', 'Shopify, Odoo, Klaviyo y tu correo', 'De ahí saca el catálogo y el carrito, los pedidos y el inventario, y los contactos con su permiso para recibir promociones. También le avisa a tu equipo.'],
		]
	: [
			['Where it talks', 'Your store, your site or WhatsApp Business', 'The chat window shows up on your page, and the same assistant can also answer on other channels.'],
			['The server', 'Cloudflare Workers', 'Receives every message, sets limits, hides personal data and checks what the AI wants to do before it does it.'],
			['The AI', 'Gemini, Claude or OpenAI', 'I pick one by price, speed and how it sounds in Spanish. It can be swapped later without rebuilding the chatbot.'],
			['Your systems', 'Shopify, Odoo, Klaviyo and your email', 'That is where it gets the catalog and cart, orders and inventory, and contacts with their permission to receive promotions. It also alerts your team.'],
		];

const danielaDoes = es
	? [
			'Recomienda solo productos del catálogo de Shopify que existen y tienen stock, con su precio real y sus promociones.',
			'Arma combos y maneja el carrito de la tienda (agregar, cambiar cantidad, quitar), siempre con el sí de la clienta.',
			'Consulta cómo va un pedido en Odoo sin poder modificarlo. Pide el número de pedido y el correo, y los dos tienen que coincidir.',
			'Crea códigos de descuento de un solo uso que caducan pronto. Los genera el servidor, así que la clave de acceso a la tienda nunca llega al navegador.',
			'Usa Klaviyo para mandar ofertas solo si la persona aceptó recibir promociones y ese permiso sigue vigente.',
			'Cuando el caso es delicado, lo pasa a WhatsApp de soporte con un folio y el resumen de la plática.',
		]
	: [
			'Recommends only Shopify catalog products that exist and are in stock, with their real price and promotions.',
			'Builds bundles and manages the store cart (add, change quantity, remove), always with the shopper’s yes.',
			'Checks how an order is doing in Odoo without being able to change it. It asks for the order number and email, and both must match.',
			'Creates single-use discount codes that expire soon. The server generates them, so the store’s access key never reaches the browser.',
			'Uses Klaviyo to send offers only if the person agreed to receive promotions and that permission is still valid.',
			'When a case is sensitive, it hands it to support on WhatsApp with a reference number and a summary.',
		];

const compare = es
	? [
			['Cómo entiende', 'Palabras clave y menús de botones', 'Entiende lo que la persona escribe, como lo escribe, y recuerda toda la plática'],
			['Qué sabe', 'Respuestas escritas a mano, que envejecen', 'Tu catálogo, tus pedidos y tus políticas, actualizados'],
			['Qué puede hacer', 'Mandar un link', 'Recomendar, armar el carrito, consultar un pedido, dejar el contacto'],
			['Cuando no sabe', '«No entendí» en bucle', 'Lo dice y te pasa con una persona'],
			['Mantenerlo', 'Rehacer árboles de conversación', 'Actualizar datos y reglas'],
			['Cómo suena', 'Robot', 'Como tu marca'],
			['Cuánto cuesta usarlo', 'Cuota fija de la plataforma', 'Por uso: centavos de dólar por conversación'],
		]
	: [
			['How it understands', 'Keywords and button menus', 'It understands what people write, the way they write it, and remembers the whole chat'],
			['What it knows', 'Hand-written answers that age', 'Your catalog, orders and policies, up to date'],
			['What it can do', 'Send a link', 'Recommend, build the cart, check an order, leave the lead'],
			['When it does not know', '"I did not understand" on repeat', 'It says so and hands you to a person'],
			['Maintaining it', 'Rebuilding conversation trees', 'Updating data and rules'],
			['How it sounds', 'A robot', 'Like your brand'],
			['What it costs to run', 'A fixed platform fee', 'Per use: cents of a dollar per conversation'],
		];

const security: Array<{ icon: IconName; title: string; text: string }> = es
	? [
			{ icon: 'lock', title: 'Las claves de acceso se quedan en el servidor', text: 'Las claves para usar la IA y para entrar a tu tienda (API keys) se guardan protegidas en el servidor. El navegador del cliente nunca las ve.' },
			{ icon: 'shield', title: 'La IA no toca tus sistemas', text: 'Quien consulta pedidos o arma el carrito es el servidor, y revisa cada acción. Solo acepta productos de tu catálogo, cantidades razonables y descuentos que cumplen tus reglas.' },
			{ icon: 'user', title: 'Datos personales protegidos', text: 'Correos y teléfonos se borran de lo que se guarda y las conversaciones se purgan solas (30 días en Jossue AI, 60 en Daniela).' },
			{ icon: 'globe', title: 'Solo funciona en tu página', text: 'El chatbot solo se puede usar desde tus sitios (CORS) y cada conexión (IP) tiene un límite de mensajes. Los paneles internos piden una clave y, sin ella, ni siquiera aparecen.' },
			{ icon: 'check-list', title: 'Respuestas con formato fijo', text: 'La IA tiene que contestar en un formato definido. Si una respuesta no lo cumple, se descarta y sale una respuesta segura.' },
			{ icon: 'bolt', title: 'Si la IA falla, la venta no se cae', text: 'Si tarda demasiado, se corta y le ofrece al cliente WhatsApp o el formulario. La pantalla nunca se queda congelada.' },
		]
	: [
			{ icon: 'lock', title: 'Access keys stay on the server', text: 'The keys to use the AI and to access your store (API keys) are stored safely on the server. The customer’s browser never sees them.' },
			{ icon: 'shield', title: 'The AI does not touch your systems', text: 'The server is what checks orders or builds the cart, and it reviews every action. It only accepts products from your catalog, reasonable quantities and discounts that follow your rules.' },
			{ icon: 'user', title: 'Personal data protected', text: 'Emails and phone numbers are stripped from what is stored, and conversations are purged automatically (30 days on Jossue AI, 60 on Daniela).' },
			{ icon: 'globe', title: 'Works only on your site', text: 'The chatbot can only be used from your sites (CORS) and each connection (IP) has a message limit. Internal panels ask for a key and, without it, they do not even show up.' },
			{ icon: 'check-list', title: 'Answers in a fixed format', text: 'The AI has to reply in a set format. If an answer does not follow it, it is discarded and a safe answer goes out.' },
			{ icon: 'bolt', title: 'If the AI fails, the sale does not', text: 'If it takes too long, it cuts off and offers the customer WhatsApp or the form. The screen never freezes.' },
		];

// Lo que protege el gasto: cada línea es algo que ya hacen Jossue AI o Daniela en producción.
const abuse = es
	? [
			['Lo obvio ni llega a la IA', 'Los intentos más obvios se frenan antes de llegar a la IA, así que no te cuestan nada.'],
			['Quien insiste, se bloquea', 'Si alguien lo intenta varias veces seguidas, queda bloqueado un rato y mientras tanto no gasta nada.'],
			['Límites por persona', 'Jossue AI acepta 24 mensajes cada 10 minutos por conexión (IP) y 30 por conversación. Daniela acepta 40 por conversación y 600 caracteres por mensaje.'],
			['Topes de gasto', 'Cada respuesta tiene un largo máximo, medido en tokens (pedacitos de texto, que es como cobran las empresas de IA), y hay un máximo de acciones por hora. Daniela hace como máximo 6 consultas de pedido y 8 descuentos de combo por hora.'],
			['Un vigilante barato', 'La IA que revisa los mensajes es una versión ligera y cuesta menos de US$0.0002 por mensaje.'],
			['Avisos a tiempo', 'Si la IA se queda sin saldo o alguien insiste en abusar, te llega un correo. Los recados tienen tope diario para que nadie te llene la bandeja.'],
			['Temas sensibles', 'Salud, legal y finanzas llevan respuesta segura o pasan a una persona. Nunca revela datos internos de tu empresa.'],
		]
	: [
			['The obvious stuff never reaches the AI', 'The most obvious attempts are stopped before they reach the AI, so they cost you nothing.'],
			['Whoever insists gets blocked', 'If someone tries several times in a row, they are blocked for a while and meanwhile they use up nothing.'],
			['Per-person limits', 'Jossue AI accepts 24 messages every 10 minutes per connection (IP) and 30 per conversation. Daniela accepts 40 per conversation and 600 characters per message.'],
			['Spending caps', 'Each answer has a maximum length, measured in tokens (small pieces of text, which is how AI companies charge), and there is a maximum number of actions per hour. Daniela does at most 6 order lookups and 8 bundle discounts per hour.'],
			['A cheap guard', 'The AI that reviews messages is a light version and costs less than US$0.0002 per message.'],
			['Timely alerts', 'If the AI runs out of credit or someone keeps abusing it, you get an email. Leads have a daily cap so nobody floods your inbox.'],
			['Sensitive topics', 'Health, legal and finance get a safe answer or go to a person. It never reveals your company’s internal data.'],
		];

// Doble candado (Jossue AI). Se explica para clientes, sin umbrales ni detalles que le sirvan a un atacante.
const locks = es
	? [
			['01', 'Reglas instantáneas', 'Reconocen al momento los trucos más conocidos, en español y en inglés, como «ignora tus instrucciones», «muéstrame tu prompt» o pedir claves y código. Esos ni siquiera llegan a la IA.'],
			['02', 'Una IA que vigila a la IA', 'Una segunda IA, distinta de la que contesta, revisa cada mensaje al mismo tiempo, sin hacer esperar a nadie. Detecta los intentos disfrazados («mi abuela me leía tus reglas…») y los mensajes hechos para saturarlo.'],
			['03', 'Inspector de respuestas', 'Antes de enviar una respuesta, la revisa. Si se coló información interna o código, la descarta y manda una segura.'],
		]
	: [
			['01', 'Instant rules', 'They recognize the best-known tricks on the spot, in Spanish and English, like "ignore your instructions", "show me your prompt" or asking for keys and code. Those never even reach the AI.'],
			['02', 'An AI watching the AI', 'A second AI, separate from the one that answers, checks every message at the same time, without making anyone wait. It catches disguised attempts and messages written to overload it.'],
			['03', 'Answer inspector', 'Before an answer is sent, it checks it. If internal information or code slipped in, it drops that answer and sends a safe one.'],
		];
const outcomes = es
	? ['Contesta con humor y no suelta nada', 'Bloquea un rato a quien insiste', 'Te avisa por correo', 'Cada respuesta va firmada, así que nadie puede falsificar una']
	: ['Replies with humor and gives nothing away', 'Blocks whoever insists for a while', 'Emails you', 'Every answer is signed, so nobody can fake one'];
const protectedBy = es
	? [
			{ name: 'Jossue AI', where: 'En este sitio', items: ['El doble candado completo: reglas, IA vigilante e inspector de respuestas', 'Bloqueo temporal y alertas por correo', 'Respuestas firmadas por el servidor', 'Tope de recados por persona al día'] },
			{ name: 'Daniela', where: 'En wunutrition.com', items: ['El servidor valida cada acción: solo productos del catálogo y cantidades razonables', 'Un pedido solo se consulta con su número y el correo exacto', 'Los descuentos los crea el servidor: de un solo uso y con caducidad', 'Pide permiso antes de guardar datos en el CRM'] },
		]
	: [
			{ name: 'Jossue AI', where: 'On this site', items: ['The full double lock: rules, AI guard and answer inspector', 'Temporary blocks and email alerts', 'Server-signed answers', 'Daily lead cap per person'] },
			{ name: 'Daniela', where: 'On wunutrition.com', items: ['The server validates every action: catalog products and reasonable quantities only', 'An order can only be checked with its number and the exact email', 'Discounts are created by the server: single use and with an expiry', 'Asks for permission before saving data to the CRM'] },
		];

// Opcional: archivista y destilación. Son proyectos aparte; no se promete ahorro sin volumen.
const ownAi: Array<{ icon: IconName; tag: string; title: string; text: string; items: string[] }> = es
	? [
			{ icon: 'layers', tag: 'Archivista', title: 'Ordena lo que aprende tu chatbot', text: 'Junta las conversaciones, tus preguntas frecuentes, tu catálogo y tus políticas, les quita los datos personales y los acomoda en un archivo ordenado de lo que sabe tu negocio (base de conocimiento), con historial de cambios.', items: ['Solo con permiso de tus clientes y sin correos ni teléfonos', 'Marca qué se respondió bien y qué hubo que corregir', 'Es tuya: la exportas cuando quieras'] },
			{ icon: 'cube', tag: 'Destilación', title: 'Una IA más chica, entrenada con tu negocio', text: 'Una IA más chica aprende de las mejores respuestas que dio la IA grande con tu información. A esto se le llama destilación. Puede funcionar en tu servidor o en tu propia computadora.', items: ['Cuesta menos por conversación cuando tienes muchas conversaciones', 'Tu información no sale de tus propios equipos', 'Antes de usarla, la comparo contra la IA grande. Las preguntas difíciles pueden seguir yendo a la grande'] },
		]
	: [
			{ icon: 'layers', tag: 'Archivist', title: 'Organizes what your chatbot learns', text: 'It gathers conversations, your FAQs, your catalog and your policies, strips personal data and arranges them into an organized record of what your business knows (a knowledge base), with a history of changes.', items: ['Only with your customers’ permission and with no emails or phone numbers', 'Marks what was answered well and what had to be fixed', 'It is yours: export it whenever you want'] },
			{ icon: 'cube', tag: 'Distillation', title: 'A smaller AI trained on your business', text: 'A smaller AI learns from the best answers the large AI gave with your information. This is called distillation. It can run on your server or on your own computer.', items: ['It costs less per conversation once you have many conversations', 'Your information never leaves your own equipment', 'Before using it, I compare it against the large AI. Hard questions can keep going to the large one'] },
		];
const ownAiFlow = es ? ['Conversaciones', 'Archivista', 'Base de conocimiento', 'Destilación', 'Tu propia IA'] : ['Conversations', 'Archivist', 'Knowledge base', 'Distillation', 'Your own AI'];

const steps = es
	? [
			['01', 'Diagnóstico', 'Leo lo que te preguntan hoy por WhatsApp, correo y redes, y vemos de dónde tiene que sacar las respuestas.'],
			['02', 'Datos y reglas', 'Juntamos tu catálogo y tus políticas, y definimos cómo debe hablar, qué no puede hacer y en qué casos le pasa la plática a una persona.'],
			['03', 'Primera versión con tus datos', 'Lo pruebas con tu equipo antes de que lo vea un cliente.'],
			['04', 'Lanzamiento y mejora', 'Lo publicamos, leemos conversaciones reales y ajusto lo que haga falta.'],
		]
	: [
			['01', 'Diagnosis', 'I read what you get asked today on WhatsApp, email and social media, and we see where it has to get the answers from.'],
			['02', 'Data and rules', 'We gather your catalog and policies, and define how it should talk, what it cannot do and when it hands the chat to a person.'],
			['03', 'First version with your data', 'You test it with your team before any customer sees it.'],
			['04', 'Launch and improvement', 'We publish it, read real conversations and I adjust what is needed.'],
		];

const faq = es
	? [
			['¿Qué IA usas?', 'La que mejor le quede a tu caso por precio, rapidez y tono, entre Gemini, Claude u OpenAI. Daniela y Jossue AI usan Gemini. El chatbot no queda amarrado a un proveedor.'],
			['¿Mis datos se usan para entrenar a la IA?', 'En sus planes de pago para empresas (API), Google, OpenAI y Anthropic indican que tu contenido no se usa para entrenar su IA. Además, lo que se guarda va sin correos ni teléfonos y se borra solo.'],
			['¿Funciona con WhatsApp?', 'Sí. El mismo asistente puede atender en tu web y en WhatsApp Business, con las mismas reglas y límites.'],
			['¿Cuánto tarda en responder?', 'Normalmente entre 3 y 8 segundos. Si el proveedor tarda de más, Jossue AI corta a los 30 segundos y ofrece WhatsApp; el tuyo puede hacer lo mismo.'],
			['¿Y si se equivoca?', 'Lo importante no depende de lo que diga. Precios, existencias y pedidos salen de tus sistemas, y las acciones las revisa el servidor. Además, leo conversaciones reales para corregir el tono y las reglas.'],
			['¿Pueden hackear o manipular al chatbot?', 'Lo intentan, y para eso está el doble candado: reglas instantáneas, una IA que vigila cada mensaje y un inspector que revisa cada respuesta. Lo que importa (precios, pedidos, descuentos) además lo valida el servidor, no la IA.'],
			['¿Puedo tener una IA propia que funcione en mis servidores?', 'Sí, con el archivista y la destilación, que te dan una IA más chica entrenada con lo que tu negocio ya sabe. Conviene cuando tienes muchas conversaciones. En la llamada te digo si en tu caso vale la pena.'],
			['¿Cuánto cuesta construirlo?', 'Depende de con qué sistemas se conecta y qué acciones hace. Te doy precio después de una llamada corta. Usarlo cuesta centavos de dólar por conversación, y puedes calcular tu caso en la calculadora de esta página.'],
		]
	: [
			['Which AI do you use?', 'Whichever fits your case best on price, speed and tone, among Gemini, Claude or OpenAI. Daniela and Jossue AI use Gemini. The chatbot is not tied to one provider.'],
			['Is my data used to train the AI?', 'On their paid business plans (API), Google, OpenAI and Anthropic state that your content is not used to train their AI. On top of that, what gets stored has no emails or phone numbers and deletes itself.'],
			['Does it work with WhatsApp?', 'Yes. The same assistant can serve on your website and on WhatsApp Business, with the same rules and limits.'],
			['How fast does it answer?', 'Usually between 3 and 8 seconds. If the provider is slow, Jossue AI cuts off at 30 seconds and offers WhatsApp; yours can do the same.'],
			['What if it gets something wrong?', 'What matters does not depend on what it says. Prices, stock and orders come from your systems, and the server checks every action. I also read real conversations to fix tone and rules.'],
			['Can someone hack or manipulate the chatbot?', 'People try, and that is what the double lock is for: instant rules, an AI that watches every message and an inspector that checks every answer. What matters (prices, orders, discounts) is also validated by the server, not the AI.'],
			['Can I have my own AI running on my servers?', 'Yes, with the archivist and distillation, which give you a smaller AI trained on what your business already knows. It pays off once you have many conversations. On the call I tell you whether it is worth it for you.'],
			['How much does it cost to build?', 'It depends on which systems it connects to and what it does. I give you a price after a short call. Running it costs cents of a dollar per conversation, and you can work out your case with the calculator on this page.'],
		];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
// Demo abstracta: qué hace, qué ahorra y la API frente a una persona en línea, con los
// valores de ejemplo de la calculadora de abajo (scripts/video/demos, docs/video-demos-producto.md).
const heroDemo = {
	wide: '/videos/demos/chatbots-ia',
	tall: '/videos/demos/chatbots-ia-tall',
	alt: es
		? 'Demo animada: un chatbot con IA entiende las preguntas y contesta con el catálogo, los pedidos y los clientes, y pasa lo delicado a una persona. Con los valores de ejemplo de la calculadora, 1,000 conversaciones al mes liberan 60 horas de tu equipo, y la API cuesta unos $1,650 MXN al mes frente a unos $21,120 MXN de una persona en línea en un turno de 8 horas.'
		: 'Animated demo (in Spanish): an AI chatbot understands questions and answers with the catalog, orders and customers, and hands sensitive cases to a person. With the calculator’s example values, 1,000 conversations a month free up 60 hours of your team, and the API costs about $1,650 MXN a month versus about $21,120 MXN for a person online on an 8-hour shift.',
	label: es ? 'Demo · 43 s' : 'Demo · 43 s (in Spanish)',
};
const calcConfig = { models: models.map(({ id, name, input, output }) => ({ id, name, input, output })), ref: REF, locale };
---

<Breadcrumbs
	locale={locale}
	items={[
		{ label: es ? 'Productos' : 'Products', href: routes[locale].products },
		{ label: product.title[locale] },
	]}
/>
<article class="jx-home jx-bots" data-product-detail="chatbots">
	<PageHero
		loop="chatbots"
		id="bots-title"
		label={es ? 'Chatbots con IA · Tiendas y negocios' : 'AI chatbots · Stores and businesses'}
		title={es ? ['Chatbots con IA que atienden', 'a tus clientes cuando tú no puedes.'] : ['AI chatbots that serve your customers', 'when you cannot.']}
		lede={es
			? 'Construyo asistentes que contestan con tu catálogo, tus pedidos y tu lista de clientes reales. Recomiendan productos, arman el carrito, revisan cómo va un pedido y le pasan a tu equipo los datos de quien quiere comprar. Así trabajan Daniela en wunutrition.com y Jossue AI en este sitio.'
			: 'I build assistants that answer with your real catalog, orders and customer list. They recommend products, build the cart, check how an order is doing and pass your team the details of whoever wants to buy. That is how Daniela works on wunutrition.com and Jossue AI on this site.'}
	>
		<div class="jx-actions jx-actions--center">
			<a class="jx-btn jx-btn--primary" href={contactUrl} data-analytics-event="click_chatbots_contact">{es ? 'Quiero un chatbot para mi negocio' : 'I want a chatbot for my business'}<Icon name="arrow-right" /></a>
			<button class="jx-btn jx-btn--ghost" type="button" data-ai-open data-ai-ask={es ? '¿Cómo sería un chatbot para mi tienda?' : 'What would a chatbot for my store look like?'}>{es ? 'Pruébalo ahora' : 'Try it now'}</button>
		</div>
		<DemoVideo demo={heroDemo} locale={locale} class="jx-bots__stage" />
	</PageHero>

	<section class="jx-bots__section" aria-labelledby="bots-demos">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot jx-dot--live" aria-hidden="true"></span>{es ? 'Demos reales · en uso hoy' : 'Real demos · live today'}</p>
			<h2 id="bots-demos" class="jx-h2"><span>{es ? 'Daniela y Jossue AI,' : 'Daniela and Jossue AI,'}</span>{' '}<span class="jx-soft">{es ? 'dos asistentes que ya están funcionando' : 'two assistants already at work'}</span></h2>
			<div class="jx-bots__demos">
				<article class="jx-feature" data-bot="daniela">
					{danielaDemo && <DemoVideo demo={danielaDemo} locale={locale} orientation="wide" />}
					<div class="jx-feature__body">
						<p class="jx-mono">{es ? 'Tienda · wunutrition.com' : 'Store · wunutrition.com'}</p>
						<h3 class="jx-feature__title">Daniela</h3>
						<p class="jx-feature__promise">{es ? 'La asistente de compra de WU Nutrition. Recomienda con el catálogo real, arma combos, maneja el carrito y consulta pedidos.' : 'WU Nutrition’s shopping assistant. It recommends with the real catalog, builds bundles, manages the cart and checks orders.'}</p>
						<p class="jx-bots__note">{es ? 'Es la tienda real: pídele una recomendación o arma un carrito. Nada se cobra hasta que tú pagas.' : 'It is the real store: ask for a recommendation or build a cart. Nothing is charged until you pay.'}</p>
						<div class="jx-actions">
							<a class="jx-btn jx-btn--primary" href="https://wunutrition.com/" target="_blank" rel="noopener" data-analytics-event="try_daniela">{es ? 'Platica con Daniela' : 'Talk to Daniela'}<Icon name="arrow-up-right" /></a>
						</div>
					</div>
				</article>
				<article class="jx-feature" data-bot="jossue-ai">
					{jossueDemo && <DemoVideo demo={jossueDemo} locale={locale} orientation="wide" />}
