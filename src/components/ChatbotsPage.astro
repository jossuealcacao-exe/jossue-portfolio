	</section>

	<section class="jx-band" id="blindaje" aria-labelledby="bots-shield">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot jx-dot--live" aria-hidden="true"></span>{es ? 'Protección contra abusos' : 'Protection against abuse'}</p>
			<h2 id="bots-shield" class="jx-h2"><span>{es ? 'Un doble candado,' : 'A double lock,'}</span>{' '}<span class="jx-soft">{es ? 'con una IA que vigila a la IA' : 'with an AI watching the AI'}</span></h2>
			<p class="jx-bots__lede">{es ? 'Hay quien entra a un chatbot para sacarle sus instrucciones internas (el prompt), pedirle código, ponerlo a calcular millones de números o insultarlo. Jossue AI lo frena con tres revisiones que se pasan información entre sí en el momento.' : 'Some people open a chatbot to pull out its internal instructions (the prompt), ask it for code, make it compute millions of numbers or insult it. Jossue AI stops that with three checks that pass information to each other on the spot.'}</p>
			<ol class="jx-bots__locks">
				{locks.map(([number, title, text]) => <li><span class="jx-mono">{number}</span><strong>{title}</strong><p>{text}</p></li>)}
			</ol>
			<ul class="jx-bots__outcomes" aria-label={es ? 'Qué pasa ante un abuso' : 'What happens on abuse'}>
				{outcomes.map((item) => <li><Icon name="shield" />{item}</li>)}
			</ul>
			<div class="jx-bots__protected">
				{protectedBy.map((bot) => (
					<div>
						<p class="jx-mono">{bot.where}</p>
						<h3>{bot.name}</h3>
						<ul>{bot.items.map((item) => <li>{item}</li>)}</ul>
					</div>
				))}
			</div>
			<p class="jx-bots__note">{es ? 'El doble candado se puede instalar en el chatbot que construya para ti, también en WhatsApp.' : 'The double lock can be installed on the chatbot I build for you, WhatsApp included.'}</p>
		</div>
	</section>

	<section class="jx-bots__section" id="costos" aria-labelledby="bots-costs">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Costos y ahorro' : 'Costs and savings'}</p>
			<h2 id="bots-costs" class="jx-h2"><span>{es ? 'Cuánto cuesta usar un chatbot,' : 'How much a chatbot costs to run,'}</span>{' '}<span class="jx-soft">{es ? 'con precios oficiales y tu volumen' : 'with official prices and your volume'}</span></h2>
			<p class="jx-bots__lede">
				{es
					? `Estos son los precios oficiales de cada proveedor por millón de tokens (pedacitos de texto, que es como cobran las empresas de IA), consultados el ${PRICES_AS_OF}. La columna de la derecha es lo que cuesta una conversación de ${REF.messages} mensajes como las de Jossue AI. Cada mensaje lleva unos ${REF.inputPerMessage.toLocaleString('es-MX')} tokens de entrada y ${REF.outputPerMessage} de salida, medidos con conversaciones reales, sin contar el descuento por texto repetido (caché).`
					: `These are each provider’s official prices per million tokens (small pieces of text, which is how AI companies charge), checked on ${PRICES_AS_OF}. The right-hand column is what a ${REF.messages}-message conversation like Jossue AI’s costs. Each message carries about ${REF.inputPerMessage.toLocaleString('en-US')} input and ${REF.outputPerMessage} output tokens, measured on real conversations, without the discount for repeated text (caching).`}
			</p>
			<div class="jx-bots__table-wrap">
				<table class="jx-bots__table jx-bots__prices">
					<thead><tr><th scope="col">{es ? 'Modelo' : 'Model'}</th><th scope="col">{es ? 'Entrada' : 'Input'}</th><th scope="col">{es ? 'Salida' : 'Output'}</th><th scope="col">{es ? 'Por conversación' : 'Per conversation'}</th></tr></thead>
					<tbody>
						{models.map((model) => (
							<tr>
								<th scope="row"><a href={model.url} target="_blank" rel="noopener">{model.name}</a><small>{model.vendor} · {model.note}</small></th>
								<td>${model.input.toFixed(2)}</td>
								<td>${model.output.toFixed(2)}</td>
								<td><strong>{usd(perConversation(model))}</strong></td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<form class="jx-calc" data-bot-calc aria-labelledby="calc-title">
				<div class="jx-calc__inputs">
					<h3 id="calc-title">{es ? 'Calcula tu caso' : 'Calculate your case'}</h3>
					<label>{es ? 'Conversaciones al mes' : 'Conversations per month'}<input type="number" name="conversations" min="0" step="100" value="1000" inputmode="numeric" /></label>
					<label>{es ? 'Mensajes por conversación' : 'Messages per conversation'}<input type="number" name="messages" min="1" max="40" value={REF.messages} inputmode="numeric" /></label>
					<label>{es ? '% que resuelve el chatbot sin una persona' : '% the chatbot solves without a person'}<input type="number" name="solved" min="0" max="100" value="60" inputmode="numeric" /></label>
					<label>{es ? 'Minutos que tarda tu equipo por conversación' : 'Minutes your team spends per conversation'}<input type="number" name="minutes" min="0" step="1" value="6" inputmode="numeric" /></label>
					<label>{es ? 'Costo por hora de tu equipo (MXN)' : 'Your team’s hourly cost (MXN)'}<input type="number" name="hourly" min="0" step="10" value="120" inputmode="numeric" /></label>
					<label>{es ? 'Tipo de cambio (MXN por dólar)' : 'Exchange rate (MXN per dollar)'}<input type="number" name="fx" min="1" step="0.1" value="18.5" inputmode="decimal" /></label>
					<label>{es ? 'Modelo' : 'Model'}
						<select name="model">{models.map((model) => <option value={model.id} selected={model.id === 'gemini-3.8-flash'}>{model.name}</option>)}</select>
					</label>
				</div>
				<div class="jx-calc__out" aria-live="polite">
					<div><p class="jx-mono">{es ? 'Costo de la IA al mes' : 'AI cost per month'}</p><strong data-out="api">—</strong><span data-out="api-mxn"></span></div>
					<div><p class="jx-mono">{es ? 'Horas de tu equipo que liberas' : 'Team hours you free up'}</p><strong data-out="hours">—</strong></div>
					<div class="jx-calc__big"><p class="jx-mono">{es ? 'Ahorro estimado al mes' : 'Estimated savings per month'}</p><strong data-out="savings">—</strong><span>{es ? 'tiempo de tu equipo menos lo que cuesta la IA' : 'your team’s time minus what the AI costs'}</span></div>
					<p class="jx-bots__fine">{es ? 'Es una estimación con tus propios números. No incluye el desarrollo ni el servidor, y no es una promesa de resultados. Sirve para ver si te da la cuenta.' : 'It is an estimate with your own numbers. It excludes development and hosting, and it is not a promise of results. It helps you see whether the numbers work for you.'}</p>
				</div>
			</form>
		</div>
	</section>

	<section class="jx-band" id="ia-propia" aria-labelledby="bots-own-ai">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Opcional · tu propia IA' : 'Optional · your own AI'}</p>
			<h2 id="bots-own-ai" class="jx-h2"><span>{es ? 'Con lo que preguntan tus clientes' : 'With what your customers ask'}</span>{' '}<span class="jx-soft">{es ? 'puedes tener una IA propia' : 'you can have your own AI'}</span></h2>
			<p class="jx-bots__lede">{es ? 'Cada conversación te dice qué preguntan tus clientes, qué los convence y dónde se atoran. Con dos servicios opcionales, esa información queda guardada de tu lado y no solo en la empresa de IA.' : 'Every conversation tells you what your customers ask, what convinces them and where they get stuck. With two optional services, that information is kept on your side and not only with the AI company.'}</p>
			<ol class="jx-bots__flowline" aria-label={es ? 'De las conversaciones a tu propia IA' : 'From conversations to your own AI'}>
				{ownAiFlow.map((step) => <li>{step}</li>)}
			</ol>
			<div class="jx-bots__own">
				{ownAi.map((item) => (
					<article>
						<Icon name={item.icon} size="md" />
						<p class="jx-mono">{item.tag}</p>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
						<ul>{item.items.map((line) => <li>{line}</li>)}</ul>
					</article>
				))}
			</div>
			<p class="jx-bots__note">{es ? 'Son proyectos aparte, para negocios con volumen de conversaciones. En la llamada te digo si en tu caso conviene.' : 'They are separate projects, for businesses with conversation volume. On the call I tell you whether it makes sense for you.'}</p>
		</div>
	</section>

	<section class="jx-bots__section" aria-labelledby="bots-steps">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Los pasos' : 'The steps'}</p>
			<h2 id="bots-steps" class="jx-h2"><span>{es ? 'Cómo lo construyo,' : 'How I build it,'}</span>{' '}<span class="jx-soft">{es ? 'paso por paso' : 'step by step'}</span></h2>
			<ol class="jx-steps">{steps.map(([number, title, text]) => <li><span class="jx-mono">{number}</span><strong>{title}</strong><p>{text}</p></li>)}</ol>
		</div>
	</section>

	<section class="jx-band" aria-labelledby="bots-faq">
		<div class="jx-wrap jx-bots__faq">
			<div>
				<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Preguntas frecuentes' : 'FAQ'}</p>
				<h2 id="bots-faq" class="jx-h2"><span>{es ? 'Lo que me preguntan' : 'What people ask me'}</span>{' '}<span class="jx-soft">{es ? 'antes de empezar' : 'before getting started'}</span></h2>
			</div>
			<div class="jx-bots__faq-list">
				{faq.map(([question, answer]) => (
					<details>
						<summary>{question}<Icon name="arrow-right" /></summary>
						<p>{answer}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<section class="jx-close" aria-labelledby="bots-close">
		<div class="jx-close__card">
			<h2 id="bots-close" class="jx-close__title"><span>{es ? '¿Quieres un chatbot' : 'Do you want a chatbot'}</span>{' '}<span class="jx-soft">{es ? 'como Daniela en tu negocio?' : 'like Daniela for your business?'}</span></h2>
			<p>{es ? 'Cuéntame qué te preguntan tus clientes y con qué sistemas trabajas. En menos de un día hábil te respondo con cómo lo armaría.' : 'Tell me what your customers ask and which systems you use. Within one business day I reply with how I would build it.'}</p>
			<div class="jx-actions jx-actions--center">
				<a class="jx-btn jx-btn--primary" href={contactUrl} data-analytics-event="click_chatbots_contact_bottom">{es ? 'Quiero mi chatbot' : 'I want my chatbot'}<Icon name="arrow-right" /></a>
				<button class="jx-btn jx-btn--ghost" type="button" data-ai-open data-ai-ask={es ? 'Quiero un chatbot para mi negocio, ¿qué necesitas saber?' : 'I want a chatbot for my business, what do you need to know?'}>{es ? 'Pregúntale a Jossue AI' : 'Ask Jossue AI'}</button>
			</div>
		</div>
	</section>
</article>
<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
<script type="application/json" data-bot-calc-config set:html={JSON.stringify(calcConfig)} />

<script>
	type Model = { id: string; name: string; input: number; output: number };
	const form = document.querySelector<HTMLFormElement>('[data-bot-calc]');
	const configNode = document.querySelector<HTMLScriptElement>('[data-bot-calc-config]');
	if (form && configNode) {
		const config = JSON.parse(configNode.textContent || '{}') as { models: Model[]; ref: { inputPerMessage: number; outputPerMessage: number }; locale: 'es' | 'en' };
		const lang = config.locale === 'es' ? 'es-MX' : 'en-US';
		const money = (value: number, currency: 'USD' | 'MXN') => new Intl.NumberFormat(lang, { style: 'currency', currency, maximumFractionDigits: value < 100 ? 2 : 0 }).format(value);
		const num = (name: string) => Math.max(0, Number((form.elements.namedItem(name) as HTMLInputElement | null)?.value) || 0);
		const out = (key: string) => form.querySelector<HTMLElement>(`[data-out="${key}"]`);
		// Los números cuentan hacia su nuevo valor (y desde cero la primera vez que se ven).
		const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const last: Record<string, number> = { api: 0, apiMxn: 0, hours: 0, savings: 0 };
		const tween = (key: string, to: number, render: (value: number) => string, el: HTMLElement | null) => {
			if (!el) return;
			const from = last[key] ?? 0;
			last[key] = to;
			if (calm || from === to) {
				el.textContent = render(to);
				return;
			}
			const start = performance.now();
			const step = (now: number) => {
				const k = Math.min(1, (now - start) / 520);
				const eased = 1 - Math.pow(1 - k, 3);
				el.textContent = render(from + (to - from) * eased);
				if (k < 1) requestAnimationFrame(step);
			};
			requestAnimationFrame(step);
		};
		const update = () => {
			const model = config.models.find((item) => item.id === (form.elements.namedItem('model') as HTMLSelectElement).value) ?? config.models[0];
			const conversations = num('conversations');
			const messages = Math.max(1, num('messages'));
			const perConversation = (messages * (config.ref.inputPerMessage * model.input + config.ref.outputPerMessage * model.output)) / 1_000_000;
			const apiUsd = conversations * perConversation;
			const fx = Math.max(1, num('fx'));
			const hours = (conversations * (Math.min(100, num('solved')) / 100) * num('minutes')) / 60;
			const savings = hours * num('hourly') - apiUsd * fx;
			tween('api', apiUsd, (value) => money(value, 'USD'), out('api'));
			tween('apiMxn', apiUsd * fx, (value) => `≈ ${money(value, 'MXN')}`, out('api-mxn'));
			tween('hours', hours, (value) => `${new Intl.NumberFormat(lang, { maximumFractionDigits: 0 }).format(value)} h`, out('hours'));
			tween('savings', savings, (value) => money(value, 'MXN'), out('savings'));
		};
		form.addEventListener('input', update);
		form.addEventListener('submit', (event) => event.preventDefault());
		if (calm || !('IntersectionObserver' in window)) update();
		else {
			const io = new IntersectionObserver((entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				io.disconnect();
				update();
			}, { threshold: 0.35 });
			io.observe(form);
		}
	}
</script>
