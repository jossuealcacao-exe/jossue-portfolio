---
// Chatbots inteligentes: la página de venta para empresas que quieren su propio asistente.
// Demos reales (Daniela y Jossue AI), qué ganan, cómo se conecta, tradicional vs inteligente,
// arquitectura y seguridad, política contra abusos, costos de API con calculadora y FAQ.
// Los precios de API son los oficiales publicados por cada proveedor (fecha abajo). Las cifras
// de uso de referencia son las de Jossue AI medidas en producción; de Daniela solo se publican
// capacidades y stack, sin volúmenes ni costos de WU Nutrition.
import { routes, type Locale } from '../data/i18n';
import { commercialProduct, productDemo } from '../data/products';
import Breadcrumbs from './Breadcrumbs.astro';
import DemoVideo from './DemoVideo.astro';
import Icon, { type IconName } from './Icon.astro';
import PageHero from './PageHero.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';
const product = commercialProduct('chatbots');
const daniela = commercialProduct('daniela');
if (!product || !daniela) throw new Error('chatbots and daniela products are required');
const jossueDemo = productDemo(product, locale);
const danielaDemo = productDemo(daniela, locale);
const contactUrl = `${routes[locale].contact}?producto=chatbots`;
const flow = es ? '/videos/chatbots/chatbot-flow-es' : '/videos/chatbots/chatbot-flow-en';
const flowDemo = { wide: flow, tall: `${flow}-tall`, label: es ? 'Cómo funciona' : 'How it works', alt: es ? 'Animación: el cliente pregunta, el mensaje pasa por los controles de seguridad, el modelo responde con el catálogo, los pedidos y el CRM, arma el carrito y deja el contacto listo.' : 'Animation: the customer asks, the message goes through security checks, the model answers with the catalog, orders and CRM, builds the cart and leaves the lead ready.' };

// Precios oficiales por millón de tokens (USD), consultados el 30 de septiembre de 2026.
const PRICES_AS_OF = es ? '30 de septiembre de 2026' : 'September 30, 2026';
const models = [
	{ id: 'gemini-3.8-flash', vendor: 'Google', name: 'Gemini 3.8 Flash', input: 0.75, output: 3.75, note: es ? 'Precio promocional hasta el 31 dic 2026 (después $1.50 / $7.50).' : 'Promotional price through Dec 31, 2026 (then $1.50 / $7.50).', url: 'https://ai.google.dev/gemini-api/docs/pricing' },
	{ id: 'gemini-3.5-flash', vendor: 'Google', name: 'Gemini 3.5 Flash', input: 1.5, output: 9, note: es ? 'El que usan hoy Daniela y Jossue AI.' : 'What Daniela and Jossue AI use today.', url: 'https://ai.google.dev/gemini-api/docs/pricing' },
	{ id: 'gemini-3.1-flash-lite', vendor: 'Google', name: 'Gemini 3.1 Flash-Lite', input: 0.25, output: 1.5, note: es ? 'Para mucho volumen y preguntas simples.' : 'For high volume and simple questions.', url: 'https://ai.google.dev/gemini-api/docs/pricing' },
	{ id: 'gpt-6-luna', vendor: 'OpenAI', name: 'GPT-6 Luna', input: 0.1, output: 0.5, note: es ? 'El más barato de la tabla.' : 'The cheapest in the table.', url: 'https://developers.openai.com/api/docs/pricing' },
	{ id: 'gpt-6.1-sol', vendor: 'OpenAI', name: 'GPT-6.1 Sol', input: 2, output: 10, note: es ? 'Más capacidad de razonamiento.' : 'More reasoning capacity.', url: 'https://developers.openai.com/api/docs/pricing' },
	{ id: 'claude-haiku-4-5', vendor: 'Anthropic', name: 'Claude Haiku 4.5', input: 1, output: 5, note: es ? 'Rápido, buen tono en español.' : 'Fast, good tone in Spanish.', url: 'https://platform.claude.com/docs/en/about-claude/pricing' },
	{ id: 'claude-sonnet-5-5', vendor: 'Anthropic', name: 'Claude Sonnet 5.5', input: 2, output: 10, note: es ? 'Para conversaciones más complejas.' : 'For more complex conversations.', url: 'https://platform.claude.com/docs/en/about-claude/pricing' },
];
// Referencia medida en producción (Jossue AI, sep 2026): ~9,200 tokens de entrada y ~120 de salida por mensaje.
const REF = { inputPerMessage: 9200, outputPerMessage: 120, messages: 6 };
const perConversation = (m: (typeof models)[number]) => (REF.messages * (REF.inputPerMessage * m.input + REF.outputPerMessage * m.output)) / 1_000_000;
const usd = (value: number) => (value < 0.01 ? `$${value.toFixed(4)}` : `$${value.toFixed(3)}`);

const gains: Array<{ icon: IconName; title: string; text: string }> = es
	? [
			{ icon: 'bolt', title: 'Vendes también de noche', text: 'Responde en segundos, cualquier día a cualquier hora. La duda de las 11 de la noche ya no espera al lunes.' },
			{ icon: 'basket', title: 'Menos compras que se caen por una duda', text: 'Resuelve envío, pagos, tallas o cuál conviene en el momento en que la persona está por comprar.' },
			{ icon: 'chats', title: 'Tu equipo atiende lo importante', text: 'Lo repetido lo contesta el asistente; lo delicado o lo grande se lo pasa a una persona con toda la conversación.' },
			{ icon: 'user', title: 'Contactos listos en tu CRM', text: 'Nombre, necesidad y conversación completa, sin que nadie tenga que copiar y pegar.' },
			{ icon: 'trend-up', title: 'Sabes qué pregunta tu cliente', text: 'Cada conversación te dice qué falta en tu ficha de producto, qué objeción frena y qué campaña funciona.' },
			{ icon: 'shield', title: 'Sin respuestas inventadas', text: 'Solo usa tus datos. Si algo no lo sabe, lo dice y ofrece hablar con alguien.' },
		]
	: [
			{ icon: 'bolt', title: 'You sell at night too', text: 'It answers in seconds, any day, any hour. The 11 p.m. question no longer waits until Monday.' },
			{ icon: 'basket', title: 'Fewer purchases lost to a doubt', text: 'It solves shipping, payments, sizes or which one fits right when the person is about to buy.' },
			{ icon: 'chats', title: 'Your team handles what matters', text: 'The assistant answers the repeated questions; the sensitive or big ones go to a person with the whole conversation.' },
			{ icon: 'user', title: 'Leads ready in your CRM', text: 'Name, need and the full conversation, with nobody copying and pasting.' },
			{ icon: 'trend-up', title: 'You learn what customers ask', text: 'Each conversation tells you what your product page is missing, which objection stops people and which campaign works.' },
			{ icon: 'shield', title: 'No made-up answers', text: 'It only uses your data. If it does not know something, it says so and offers a person.' },
		];

const stack = es
	? [
			['Dónde habla', 'Tu tienda, tu sitio o WhatsApp Business', 'El widget vive en tu página; el mismo asistente puede atender en otros canales.'],
			['El servidor', 'Cloudflare Workers', 'Recibe cada mensaje, aplica límites, oculta datos personales y valida lo que el modelo quiere hacer.'],
			['El modelo', 'Gemini, Claude u OpenAI', 'Se elige por costo, velocidad y tono. Se puede cambiar sin rehacer el chatbot.'],
			['Tus sistemas', 'Shopify, Odoo, Klaviyo y tu correo', 'Catálogo y carrito, pedidos e inventario, contactos y consentimiento, avisos a tu equipo.'],
		]
	: [
			['Where it talks', 'Your store, your site or WhatsApp Business', 'The widget lives on your page; the same assistant can serve other channels.'],
			['The server', 'Cloudflare Workers', 'Receives every message, applies limits, hides personal data and validates what the model wants to do.'],
			['The model', 'Gemini, Claude or OpenAI', 'Chosen by cost, speed and tone. It can be swapped without rebuilding the chatbot.'],
			['Your systems', 'Shopify, Odoo, Klaviyo and your email', 'Catalog and cart, orders and inventory, contacts and consent, alerts for your team.'],
		];

const danielaDoes = es
	? [
			'Recomienda solo productos del catálogo de Shopify que existen y tienen stock, con su precio real y sus promociones.',
			'Arma combos y maneja el carrito de la tienda (agregar, cambiar cantidad, quitar), siempre con el sí de la clienta.',
			'Consulta el estado de un pedido en Odoo en modo lectura: pide número y correo, y los dos tienen que coincidir.',
			'Crea códigos de descuento del lado del servidor, de un solo uso y con vigencia corta; el navegador nunca ve la llave de la tienda.',
			'Conecta con Klaviyo para ofertas solo si la persona tiene consentimiento de marketing vigente.',
			'Cuando el caso es delicado, lo pasa a WhatsApp de soporte con un folio y el resumen de la plática.',
		]
	: [
			'Recommends only Shopify catalog products that exist and are in stock, with their real price and promotions.',
			'Builds bundles and manages the store cart (add, change quantity, remove), always with the shopper’s yes.',
			'Checks an order’s status in Odoo, read-only: it asks for the order number and email, and both must match.',
			'Creates discount codes on the server, single use and short-lived; the browser never sees the store key.',
			'Connects with Klaviyo for offers only if the person has current marketing consent.',
			'When a case is sensitive, it hands it to support on WhatsApp with a reference number and a summary.',
		];

const compare = es
	? [
			['Cómo entiende', 'Palabras clave y menús de botones', 'Lenguaje natural, con el contexto de toda la plática'],
			['Qué sabe', 'Respuestas escritas a mano, que envejecen', 'Tu catálogo, tus pedidos y tus políticas, actualizados'],
			['Qué puede hacer', 'Mandar un link', 'Recomendar, armar el carrito, consultar un pedido, dejar el contacto'],
			['Cuando no sabe', '«No entendí» en bucle', 'Lo dice y te pasa con una persona'],
			['Mantenerlo', 'Rehacer árboles de conversación', 'Actualizar datos y reglas'],
			['Cómo suena', 'Robot', 'Como tu marca'],
			['Cuánto cuesta usarlo', 'Cuota fija de la plataforma', 'Por uso: centavos de dólar por conversación'],
		]
	: [
			['How it understands', 'Keywords and button menus', 'Natural language, with the context of the whole chat'],
			['What it knows', 'Hand-written answers that age', 'Your catalog, orders and policies, up to date'],
			['What it can do', 'Send a link', 'Recommend, build the cart, check an order, leave the lead'],
			['When it does not know', '"I did not understand" on repeat', 'It says so and hands you to a person'],
			['Maintaining it', 'Rebuilding conversation trees', 'Updating data and rules'],
			['How it sounds', 'A robot', 'Like your brand'],
			['What it costs to run', 'A fixed platform fee', 'Per use: cents of a dollar per conversation'],
		];

const security: Array<{ icon: IconName; title: string; text: string }> = es
	? [
			{ icon: 'lock', title: 'Las llaves nunca salen del servidor', text: 'La API key del modelo y las de tu tienda viven como secretos del Worker. El navegador nunca las ve.' },
			{ icon: 'shield', title: 'El modelo no toca tus sistemas', text: 'Quien consulta pedidos o arma el carrito es el servidor, y valida cada acción: solo productos del catálogo, cantidades razonables, códigos con reglas.' },
			{ icon: 'user', title: 'Datos personales protegidos', text: 'Correos y teléfonos se borran de lo que se guarda y las conversaciones se purgan solas (30 días en Jossue AI, 60 en Daniela).' },
			{ icon: 'globe', title: 'Solo desde tu dominio', text: 'El navegador solo deja usar el chatbot desde tus sitios (CORS) y cada IP tiene su límite. Los paneles internos piden token y no existen sin él.' },
			{ icon: 'check-list', title: 'Respuestas con estructura', text: 'El modelo contesta en un formato fijo; lo que no cumple el esquema se descarta y se usa una respuesta segura.' },
			{ icon: 'bolt', title: 'Si la IA falla, la venta no se cae', text: 'Hay tiempo máximo de espera y plan B: WhatsApp o el formulario, nunca una pantalla colgada.' },
		]
	: [
			{ icon: 'lock', title: 'Keys never leave the server', text: 'The model API key and your store keys live as Worker secrets. The browser never sees them.' },
			{ icon: 'shield', title: 'The model does not touch your systems', text: 'The server is what checks orders or builds the cart, and it validates every action: catalog products only, reasonable quantities, rule-bound codes.' },
			{ icon: 'user', title: 'Personal data protected', text: 'Emails and phone numbers are stripped from what is stored, and conversations are purged automatically (30 days on Jossue AI, 60 on Daniela).' },
			{ icon: 'globe', title: 'From your domain only', text: 'Browsers can only use the chatbot from your sites (CORS) and each IP has its own limit. Internal panels require a token and do not exist without it.' },
			{ icon: 'check-list', title: 'Structured answers', text: 'The model replies in a fixed format; anything that breaks the schema is discarded and a safe answer is used.' },
			{ icon: 'bolt', title: 'If the AI fails, the sale does not', text: 'There is a maximum wait and a plan B: WhatsApp or the form, never a frozen screen.' },
		];

// Lo que protege el gasto: cada línea es algo que ya hacen Jossue AI o Daniela en producción.
const abuse = es
	? [
			['Lo descarado no llega a la IA', 'Las reglas frenan los intentos obvios antes de llamar al modelo: no gastan ni un token.'],
			['Quien insiste, se bloquea', 'Varios intentos seguidos bloquean a esa persona un rato; mientras tanto no consume nada.'],
			['Límites por persona', 'Jossue AI acepta 24 mensajes cada 10 minutos por IP y 30 por conversación; Daniela, 40 por conversación y 600 caracteres por mensaje.'],
			['Topes de gasto', 'Máximo de tokens por respuesta y de acciones por hora. En Daniela: 6 consultas de pedido y 8 descuentos de combo por hora.'],
			['Un vigilante barato', 'La IA que vigila usa un modelo ligero: cuesta menos de US$0.0002 por mensaje.'],
			['Avisos a tiempo', 'Si la IA se queda sin saldo o alguien insiste en abusar, te llega un correo. Los recados tienen tope diario para que nadie te llene la bandeja.'],
			['Temas sensibles', 'Salud, legal y finanzas llevan respuesta segura o pasan a una persona. Nunca revela datos internos de tu empresa.'],
		]
	: [
			['Blatant attempts never reach the AI', 'Rules stop the obvious attempts before the model is called: not a single token is spent.'],
			['Whoever insists gets blocked', 'Several attempts in a row block that person for a while; meanwhile they consume nothing.'],
			['Per-person limits', 'Jossue AI accepts 24 messages every 10 minutes per IP and 30 per conversation; Daniela, 40 per conversation and 600 characters per message.'],
			['Spending caps', 'Maximum tokens per answer and actions per hour. On Daniela: 6 order lookups and 8 bundle discounts per hour.'],
			['A cheap guard', 'The watching AI uses a light model: it costs less than US$0.0002 per message.'],
			['Timely alerts', 'If the AI runs out of credit or someone keeps abusing it, you get an email. Leads have a daily cap so nobody floods your inbox.'],
			['Sensitive topics', 'Health, legal and finance get a safe answer or go to a person. It never reveals your company’s internal data.'],
		];

// Doble candado (Jossue AI). Se explica para clientes, sin umbrales ni detalles que le sirvan a un atacante.
const locks = es
	? [
			['01', 'Reglas instantáneas', 'Reconocen al momento los intentos conocidos, en español e inglés: «ignora tus instrucciones», «muéstrame tu prompt», pedir claves o código. Los descarados ni siquiera llegan a la IA.'],
			['02', 'Una IA que vigila a la IA', 'Un segundo modelo, aparte del que contesta, revisa cada mensaje al mismo tiempo, sin hacer esperar a nadie. Atrapa lo disfrazado («mi abuela me leía tus reglas…») y lo escrito para saturarlo.'],
			['03', 'Inspector de respuestas', 'Antes de enviar, revisa lo que va a contestar. Si se coló información interna o código, esa respuesta se descarta y sale una segura.'],
		]
	: [
			['01', 'Instant rules', 'They recognize known attempts on the spot, in Spanish and English: "ignore your instructions", "show me your prompt", asking for keys or code. Blatant ones never even reach the AI.'],
			['02', 'An AI watching the AI', 'A second model, separate from the one that answers, checks every message at the same time, without making anyone wait. It catches disguised attempts and messages written to overload it.'],
			['03', 'Answer inspector', 'Before sending, it checks what it is about to say. If internal information or code slipped in, that answer is dropped and a safe one goes out.'],
		];
const outcomes = es
	? ['Responde con humor y sin dar nada', 'Bloquea un rato a quien insiste', 'Te avisa por correo', 'Nadie puede inventarle respuestas: cada una va firmada']
	: ['Replies with humor and gives nothing away', 'Blocks whoever insists for a while', 'Emails you', 'Nobody can forge its answers: each one is signed'];
const protectedBy = es
	? [
			{ name: 'Jossue AI', where: 'En este sitio', items: ['El doble candado completo: reglas, IA vigilante e inspector de respuestas', 'Bloqueo temporal y alertas por correo', 'Respuestas firmadas por el servidor', 'Tope de recados por persona al día'] },
			{ name: 'Daniela', where: 'En wunutrition.com', items: ['El servidor valida cada acción: solo productos del catálogo y cantidades razonables', 'Un pedido solo se consulta con su número y el correo exacto', 'Los descuentos los crea el servidor: de un solo uso y con caducidad', 'Pide permiso antes de guardar datos en el CRM'] },
		]
	: [
			{ name: 'Jossue AI', where: 'On this site', items: ['The full double lock: rules, AI guard and answer inspector', 'Temporary blocks and email alerts', 'Server-signed answers', 'Daily lead cap per person'] },
			{ name: 'Daniela', where: 'On wunutrition.com', items: ['The server validates every action: catalog products and reasonable quantities only', 'An order can only be checked with its number and the exact email', 'Discounts are created by the server: single use and with an expiry', 'Asks for permission before saving data to the CRM'] },
		];

// Opcional: archivista y destilación. Son proyectos aparte; no se promete ahorro sin volumen.
const ownAi: Array<{ icon: IconName; tag: string; title: string; text: string; items: string[] }> = es
	? [
			{ icon: 'layers', tag: 'Archivista', title: 'Ordena lo que aprende tu chatbot', text: 'Junta las conversaciones, tus preguntas frecuentes, tu catálogo y tus políticas, les quita los datos personales y los deja en una base de conocimiento limpia y con historial.', items: ['Solo con permiso de tus clientes y sin correos ni teléfonos', 'Marca qué se respondió bien y qué hubo que corregir', 'Es tuya: la exportas cuando quieras'] },
			{ icon: 'cube', tag: 'Destilación', title: 'Una IA local entrenada con tu negocio', text: 'Un modelo más chico aprende de las mejores respuestas del modelo grande con tu información y queda entrenado para tu negocio. Puede correr en tu servidor o en tu propia computadora.', items: ['Menos costo por conversación cuando el volumen lo justifica', 'Tu información no sale de tu infraestructura', 'Se compara contra el modelo grande antes de reemplazarlo; lo difícil puede seguir yendo al grande'] },
		]
	: [
			{ icon: 'layers', tag: 'Archivist', title: 'Organizes what your chatbot learns', text: 'It gathers conversations, your FAQs, your catalog and your policies, strips personal data and leaves a clean, versioned knowledge base.', items: ['Only with your customers’ permission and with no emails or phone numbers', 'Marks what was answered well and what had to be fixed', 'It is yours: export it whenever you want'] },
			{ icon: 'cube', tag: 'Distillation', title: 'A local AI trained on your business', text: 'A smaller model learns from the large model’s best answers on your information and ends up trained for your business. It can run on your server or on your own computer.', items: ['Lower cost per conversation once volume justifies it', 'Your information never leaves your infrastructure', 'It is checked against the large model before replacing it; hard cases can keep going to the large one'] },
		];
const ownAiFlow = es ? ['Conversaciones', 'Archivista', 'Base de conocimiento', 'Destilación', 'IA local'] : ['Conversations', 'Archivist', 'Knowledge base', 'Distillation', 'Local AI'];

const steps = es
	? [
			['01', 'Diagnóstico', 'Leo lo que te preguntan hoy (WhatsApp, correo, redes) y vemos qué sistemas tiene que consultar.'],
			['02', 'Datos y reglas', 'Catálogo, políticas, límites, tono de tu marca y qué se le pasa a una persona.'],
			['03', 'Prototipo con tus datos', 'Lo pruebas con tu equipo antes de que lo vea un cliente.'],
			['04', 'Lanzamiento y mejora', 'Lo publicamos, leemos conversaciones reales y ajusto lo que haga falta.'],
		]
	: [
			['01', 'Diagnosis', 'I read what you get asked today (WhatsApp, email, social) and we see which systems it must check.'],
			['02', 'Data and rules', 'Catalog, policies, limits, your brand’s tone and what goes to a person.'],
			['03', 'Prototype with your data', 'You test it with your team before any customer sees it.'],
			['04', 'Launch and improvement', 'We publish it, read real conversations and I adjust what is needed.'],
		];

const faq = es
	? [
			['¿Qué modelo de IA usan?', 'El que mejor le quede a tu caso por costo, velocidad y tono: Gemini, Claude u OpenAI. Daniela y Jossue AI usan Gemini. El chatbot no queda amarrado a un proveedor.'],
			['¿Mis datos se usan para entrenar a la IA?', 'En los planes de pago de API, Google, OpenAI y Anthropic indican que tu contenido no se usa para entrenar sus modelos. Además, lo que guardamos va sin correos ni teléfonos y se borra solo.'],
			['¿Funciona con WhatsApp?', 'Sí. El mismo asistente puede atender en tu web y en WhatsApp Business, con las mismas reglas y límites.'],
			['¿Cuánto tarda en responder?', 'Normalmente entre 3 y 8 segundos. Si el proveedor tarda de más, Jossue AI corta a los 30 segundos y ofrece WhatsApp; el tuyo puede hacer lo mismo.'],
			['¿Y si se equivoca?', 'Lo importante no depende de lo que diga: precios, stock y pedidos salen de tus sistemas, y las acciones las valida el servidor. Leemos conversaciones para corregir el tono y las reglas.'],
			['¿Pueden hackear o manipular al chatbot?', 'Lo intentan, y para eso está el doble candado: reglas instantáneas, una IA que vigila cada mensaje y un inspector que revisa cada respuesta. Lo que importa (precios, pedidos, descuentos) además lo valida el servidor, no la IA.'],
			['¿Puedo tener una IA propia que corra en mis servidores?', 'Sí, con el archivista y la destilación: un modelo más chico entrenado con lo que tu negocio ya sabe. Conviene cuando hay volumen de conversaciones; te digo en la llamada si en tu caso vale la pena.'],
			['¿Cuánto cuesta construirlo?', 'Depende de con qué sistemas se conecta y qué acciones hace. Te doy precio después de una llamada corta. Usarlo cuesta centavos de dólar por conversación (calcula abajo).'],
		]
	: [
			['Which AI model do you use?', 'Whichever fits your case best on cost, speed and tone: Gemini, Claude or OpenAI. Daniela and Jossue AI use Gemini. The chatbot is not tied to one provider.'],
			['Is my data used to train the AI?', 'On paid API plans, Google, OpenAI and Anthropic state that your content is not used to train their models. On top of that, what we store has no emails or phone numbers and deletes itself.'],
			['Does it work with WhatsApp?', 'Yes. The same assistant can serve on your website and on WhatsApp Business, with the same rules and limits.'],
			['How fast does it answer?', 'Usually between 3 and 8 seconds. If the provider is slow, Jossue AI cuts off at 30 seconds and offers WhatsApp; yours can do the same.'],
			['What if it gets something wrong?', 'What matters does not depend on what it says: prices, stock and orders come from your systems, and the server validates actions. We read conversations to fix tone and rules.'],
			['Can someone hack or manipulate the chatbot?', 'People try, and that is what the double lock is for: instant rules, an AI that watches every message and an inspector that checks every answer. What matters (prices, orders, discounts) is also validated by the server, not the AI.'],
			['Can I have my own AI running on my servers?', 'Yes, with the archivist and distillation: a smaller model trained on what your business already knows. It pays off once there is conversation volume; I tell you on the call whether it is worth it for you.'],
			['How much does it cost to build?', 'It depends on which systems it connects to and what it does. I give you a price after a short call. Running it costs cents of a dollar per conversation (calculate below).'],
		];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const heroDemo = {
	wide: '/videos/chatbots/bot-hero',
	tall: '/videos/chatbots/bot-hero-tall',
	alt: es ? 'Animación abstracta: burbujas de chat que se conectan como una constelación sobre un cielo oscuro.' : 'Abstract animation: chat bubbles connecting like a constellation over a dark sky.',
	label: es ? 'Tu tienda, atendida a toda hora' : 'Your store, served around the clock',
};
const calcConfig = { models: models.map(({ id, name, input, output }) => ({ id, name, input, output })), ref: REF, locale };
---

<Breadcrumbs
	locale={locale}
	items={[
		{ label: es ? 'Productos' : 'Products', href: routes[locale].products },
		{ label: product.title[locale] },
	]}
/>
<article class="jx-home jx-bots" data-product-detail="chatbots">
	<PageHero
		loop="ai"
		id="bots-title"
		label={es ? 'Chatbots con IA · Ecommerce' : 'AI chatbots · Ecommerce'}
		title={es ? ['Chatbots con IA que atienden', 'y venden con tus datos reales.'] : ['AI chatbots that serve and sell', 'with your real data.']}
		lede={es
