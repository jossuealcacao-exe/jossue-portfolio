---
// Jossue AI: chat real con Gemini a través del Worker (/api/ai). Toma la estructura de Daniela:
// botón fijo, panel nativo (no iframe), historial en la sesión, invitaciones medidas y ajuste al
// teclado del teléfono. Si la IA no está disponible, ofrece WhatsApp y el formulario.
import { contact } from '../data/contact';
import { AUDIT_ENABLED } from '../data/features';
import { routes, type Locale } from '../data/i18n';
import Icon from './Icon.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';
const cvHref = es ? contact.cvEs : contact.cvEn ?? contact.cvEs;
const starters = es
	? ['¿Qué ha construido Jossué?', '¿Qué resultados ha tenido?', 'Necesito ayuda con mi tienda']
	: ['What has Jossué built?', 'What results has he had?', 'I need help with my store'];
const copy = es
	? {
			greeting: 'Hola, soy Jossue AI, el asistente de Jossué. Te puedo contar qué ha construido y cómo trabaja. También puedes contarme qué pasa en tu negocio y te digo si él te puede ayudar. Si no sé algo, te lo digo.',
			placeholder: 'Escribe tu pregunta…',
			send: 'Enviar',
			typing: 'Jossue AI está escribiendo',
			disclosure: 'Soy una IA y respondo con lo que Jossué publica. Guardo la conversación 30 días para mejorar mis respuestas, sin correos ni teléfonos. No compartas datos sensibles.',
			error: 'Ahorita no puedo contestar. Escríbele a Jossué por WhatsApp o con el formulario y te responde en menos de un día hábil.',
			limit: 'Llegaste al límite de mensajes por ahora. Si quieres seguir, escríbele directo a Jossué.',
			lead: 'Listo, le pasé tus datos a Jossué.',
			actions: { contact: 'Escribirle a Jossué', call: 'Agendar llamada de 10 min', whatsapp: 'WhatsApp', cv: 'Descargar su CV', page: 'Ver la página' },
			reset: 'Nueva conversación',
			leave: 'Dejarle un mensaje a Jossué',
			leaveAsk: 'Quiero dejarle un mensaje a Jossué',
			role: 'IA · responde al momento',
			audit: {
				invite: 'Te hago una auditoría express gratis. En unos 2 minutos te digo 3 cosas de tu sitio que puedes mejorar.',
				start: 'Hacer mi auditoría express',
				intro: 'Va. Reviso la página principal de tu sitio, le pongo una calificación general y te señalo 3 cosas que puedes mejorar. Al final te queda un reporte para descargar. Es gratis y tarda uno o dos minutos. ¿A nombre de quién y a qué correo te lo mando?',
				name: 'Tu nombre',
				email: 'Tu correo',
				consent: 'Acepto que Jossué me escriba sobre esta auditoría. Mis datos solo se usan para eso y puedo pedir que los borren escribiendo a hola@jossuealcala.com.',
				next: 'Siguiente',
				askUrl: 'Gracias, {name}. ¿Cuál es la dirección de tu sitio?',
				url: 'tusitio.com',
				run: 'Revisar mi sitio',
				steps: ['Abriendo tu sitio', 'Midiendo la velocidad en celular', 'Revisando lo que ve tu cliente', 'Buscando qué te cuesta ventas', 'Escribiendo qué puedes mejorar'],
				waiting: 'Revisando {domain}…',
				doneTitle: 'Tu auditoría express de {domain}',
				health: 'Calificación',
				areas: '{n} cosas que puedes mejorar',
				areaOne: 'Lo que puedes mejorar',
				why: 'Por qué importa',
				fix: 'Por dónde empezaría',
				severity: { high: 'Alta', medium: 'Media', low: 'Baja' },
				pdf: 'Descargar el reporte (PDF)',
				report: 'Ver el reporte completo',
				talk: 'Agendar 10 min con Jossué',
				doneNote: 'Jossué ya tiene tu reporte y te va a escribir para ver contigo el primer arreglo.',
				errors: {
					invalid_name: 'Escribe tu nombre, por favor.',
					invalid_email: 'Revisa tu correo, parece que le falta algo.',
					consent_required: 'Para mandarte el reporte necesito tu permiso.',
					invalid_url: 'Esa dirección no la puedo revisar. Escribe la de tu sitio público, por ejemplo tutienda.com.',
					limit_ip: 'Hoy ya revisaste varios sitios desde aquí. Si quieres revisar otro, escríbele a Jossué.',
					limit_domain: 'Ese sitio ya se revisó hoy. Si quieres el reporte, pídeselo a Jossué y te lo manda.',
					blocked: 'Por ahora no puedo hacer la auditoría desde este chat.',
					unavailable: 'Ahorita no puedo hacer la revisión. Déjale tus datos a Jossué y te la manda por correo.',
				},
			},
		}
	: {
			greeting: 'Hi, I am Jossue AI, Jossué’s assistant. I can tell you what he has built and how he works. You can also tell me what is going on in your business and I will tell you whether he can help. If I do not know something, I will say so.',
			placeholder: 'Type your question…',
			send: 'Send',
			typing: 'Jossue AI is typing',
			disclosure: 'I am an AI and I answer with what Jossué publishes. I keep the conversation for 30 days to improve my answers, without emails or phone numbers. Do not share sensitive data.',
			error: 'I cannot answer right now. Message Jossué on WhatsApp or through the form and he will reply within one business day.',
			limit: 'You reached the message limit for now. If you want to keep going, write to Jossué directly.',
			lead: 'Done, I passed your details to Jossué.',
			actions: { contact: 'Write to Jossué', call: 'Book a 10-min call', whatsapp: 'WhatsApp', cv: 'Download his CV', page: 'See the page' },
			reset: 'New conversation',
			leave: 'Leave Jossué a message',
			leaveAsk: 'I want to leave Jossué a message',
			role: 'AI · answers right away',
			audit: {
				invite: 'I can run a free express audit. In about 2 minutes I tell you 3 things on your site you can improve.',
				start: 'Run my express audit',
				intro: 'Sure. I review your site’s home page, give it an overall score and point out 3 things you can improve. At the end you get a report to download. It is free and takes a minute or two. Who should I send it to, and at what email?',
				name: 'Your name',
				email: 'Your email',
				consent: 'I agree that Jossué may write to me about this audit. My details are only used for that; I can ask for them to be deleted at hola@jossuealcala.com.',
				next: 'Next',
				askUrl: 'Thanks, {name}. What is your site’s address?',
				url: 'yoursite.com',
				run: 'Review my site',
				steps: ['Opening your site', 'Measuring mobile speed', 'Checking what your customer sees', 'Looking for what costs you sales', 'Writing what you can improve'],
				waiting: 'Reviewing {domain}…',
				doneTitle: 'Your express audit of {domain}',
				health: 'Score',
				areas: '{n} things you can improve',
				areaOne: 'What you can improve',
				why: 'Why it matters',
				fix: 'Where I would start',
				severity: { high: 'High', medium: 'Medium', low: 'Low' },
				pdf: 'Download the report (PDF)',
				report: 'See the full report',
				talk: 'Book 10 min with Jossué',
				doneNote: 'Jossué already has your report and will write to you to go over the first fix together.',
				errors: {
					invalid_name: 'Please type your name.',
					invalid_email: 'Check your email, something seems to be missing.',
					consent_required: 'I need your permission to send you the report.',
					invalid_url: 'I cannot review that address. Type your public site, for example yourstore.com.',
					limit_ip: 'You already ran several audits from here today. To review another site, write to Jossué.',
					limit_domain: 'That site was already reviewed today. Jossué can send you the report if you ask.',
					blocked: 'I cannot run the audit from this chat right now.',
					unavailable: 'I cannot run the review right now. Leave Jossué your details and he will email it to you.',
				},
			},
		};
const invites = es
	? {
			audit: copy.audit.invite,
			home: '¿Algo no funciona en tu tienda o tu página? Cuéntame y te digo si Jossué te puede ayudar.',
			products: '¿No sabes qué producto necesitas? Te ayudo a elegir.',
			about: '¿Eres reclutador? Pregúntame por su experiencia.',
			work: '¿Quieres el resumen de un caso? Pregúntame.',
			madre: '¿Dudas sobre MADRE? Te explico cómo funciona.',
			default: '¿Tienes una pregunta sobre el trabajo de Jossué?',
		}
	: {
			audit: copy.audit.invite,
			home: 'Something not working on your store or website? Tell me and I will say whether Jossué can help.',
			products: 'Not sure which product fits? I can help you pick.',
			about: 'Recruiting? Ask me about his experience.',
			work: 'Want the short version of a case? Ask me.',
			madre: 'Questions about MADRE? I can explain how it works.',
			default: 'Got a question about Jossué’s work?',
		};
const config = {
	locale,
	auditEnabled: AUDIT_ENABLED,
	copy,
	links: { contact: routes[locale].contact, call: `${routes[locale].booking}?origen=chat`, whatsapp: contact.whatsapp, cv: cvHref },
	invites,
	routes: routes[locale],
};
---

<aside class="jai" data-jai>
	<p class="jai__invite" data-jai-invite hidden>
		<button class="jai__invite-text" type="button" data-jai-invite-open></button>
		<button class="jai__invite-close" type="button" data-jai-invite-close aria-label={es ? 'Cerrar invitación' : 'Dismiss invitation'}><Icon name="close" /></button>
	</p>
	<button class="jai__launcher" type="button" aria-expanded="false" aria-controls="jai-panel" data-analytics-event="assistant_open">
		<span class="jai__avatar" aria-hidden="true"><img src="/images/jossue-alcala-480.webp" alt="" width="40" height="40" loading="lazy" decoding="async" /><i></i></span>
		<span class="jai__launcher-text"><strong>Jossue AI</strong><small>{es ? 'Pregúntame' : 'Ask me'}</small></span>
	</button>
	<section class="jai__panel" id="jai-panel" hidden aria-label="Jossue AI" role="dialog">
		<header class="jai__head">
			<span class="jai__avatar jai__avatar--lg" aria-hidden="true"><img src="/images/jossue-alcala-480.webp" alt="" width="44" height="44" loading="lazy" decoding="async" /><i></i></span>
			<div class="jai__title">
				<h2>Jossue AI</h2>
				<p>{copy.role}</p>
			</div>
			<button class="jai__icon-btn" type="button" data-jai-reset aria-label={copy.reset} title={copy.reset}>
				<svg viewBox="0 0 32 32" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 16a10 10 0 1 0 3-7.1M6 5v5h5" /></g></svg>
			</button>
			<button class="jai__icon-btn" type="button" data-jai-close aria-label={es ? 'Cerrar Jossue AI' : 'Close Jossue AI'}><Icon name="close" /></button>
		</header>
		<div class="jai__log" data-jai-log aria-live="polite" aria-relevant="additions">
			<div class="jai__msg jai__msg--ai"><p>{copy.greeting}</p></div>
		</div>
		<div class="jai__chips" data-jai-chips>
			{starters.map((text) => <button type="button" data-jai-chip>{text}</button>)}
		</div>
		<button class="jai__leave" type="button" data-jai-leave data-analytics-event="assistant_leave_message"><Icon name="envelope" />{copy.leave}</button>
		<form class="jai__form" data-jai-form>
			<label class="sr-only" for="jai-input">{copy.placeholder}</label>
			<textarea id="jai-input" rows="1" maxlength="800" placeholder={copy.placeholder} data-jai-input enterkeyhint="send"></textarea>
			<button class="jai__send" type="submit" aria-label={copy.send} data-jai-send><Icon name="arrow-right" /></button>
		</form>
		<p class="jai__disclosure">{copy.disclosure} <a href={routes[locale].privacy}>{es ? 'Aviso de privacidad' : 'Privacy notice'}</a></p>
	</section>
	<script type="application/json" data-jai-config set:html={JSON.stringify(config)} />
</aside>

<script>
	import { trackLead } from '../scripts/analytics';

	type Message = { role: 'user' | 'assistant'; content: string; sig?: string; action?: string; page?: string | null };
	type AuditCopy = {
		invite: string; start: string; intro: string; name: string; email: string; consent: string; next: string; askUrl: string; url: string; run: string;
		steps: string[]; waiting: string; doneTitle: string; health: string; areas: string; areaOne: string; why: string; fix: string; severity: Record<string, string>;
		pdf: string; report: string; talk: string; doneNote: string; errors: Record<string, string>;
	};
	type Copy = {
		greeting: string; placeholder: string; send: string; typing: string; disclosure: string; error: string; limit: string; lead: string;
		actions: Record<string, string>; reset: string; leave: string; leaveAsk: string; role: string; audit: AuditCopy;
	};
	type Finding = { title: string; severity: string; business_effect: string; recommendation: string; category?: string };
	type AuditResult = { id: string; status: string; domain: string; url: string; score: number | null; findings: Finding[]; report_url: string | null; pdf_url: string | null; error: string | null };
	type AuditState = { step: 'contact' | 'url' | 'running' | 'done' | 'failed'; name?: string; email?: string; consent?: boolean; error?: string; audit?: AuditResult; startedAt?: number };
	type Config = {
		locale: 'es' | 'en';
		auditEnabled: boolean;
		copy: Copy;
		links: { contact: string; call: string; whatsapp: string | null; cv: string | null };
		invites: Record<string, string>;
		routes: Record<string, string>;
	};

	const root = document.querySelector<HTMLElement>('[data-jai]');
	const configNode = root?.querySelector<HTMLScriptElement>('[data-jai-config]');
	if (root && configNode) {
		const config = JSON.parse(configNode.textContent || '{}') as Config;
		const host: HTMLElement = root;
		const $ = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
		const launcher = $<HTMLButtonElement>('.jai__launcher');
		const panel = $<HTMLElement>('.jai__panel');
		const log = $<HTMLElement>('[data-jai-log]');
		const chips = $<HTMLElement>('[data-jai-chips]');
		const form = $<HTMLFormElement>('[data-jai-form]');
		const input = $<HTMLTextAreaElement>('[data-jai-input]');
		const send = $<HTMLButtonElement>('[data-jai-send]');
		const invite = $<HTMLElement>('[data-jai-invite]');
		const inviteText = $<HTMLButtonElement>('[data-jai-invite-open]');
		const leave = $<HTMLButtonElement>('[data-jai-leave]');

		const store = {
			get<T>(key: string, fallback: T): T {
				try {
					const raw = sessionStorage.getItem(`jai:${key}`);
					return raw ? (JSON.parse(raw) as T) : fallback;
				} catch {
					return fallback;
				}
			},
			set(key: string, value: unknown) {
				try {
					sessionStorage.setItem(`jai:${key}`, JSON.stringify(value));
				} catch {
					/* modo privado: el chat funciona igual, solo no se recuerda */
				}
			},
		};
		const newSid = () => (crypto.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(16).slice(2)}`).replace(/[^\w-]/g, '');
		let sid = store.get('sid', '') || newSid();
		store.set('sid', sid);
		let messages = store.get<Message[]>('messages', []);
		let busy = false;

		const scrollDown = () => (log.scrollTop = log.scrollHeight);

		function actionHref(message: Message) {
			if (message.action === 'contact') return config.links.contact;
			if (message.action === 'call') return config.links.call;
			if (message.action === 'whatsapp') return config.links.whatsapp;
			if (message.action === 'cv') return config.links.cv;
			if (message.action === 'page') return message.page ?? null;
			return null;
		}

		function renderMessage(message: Message) {
			const bubble = document.createElement('div');
			bubble.className = `jai__msg jai__msg--${message.role === 'user' ? 'me' : 'ai'}`;
			const text = document.createElement('p');
			text.textContent = message.content;
			bubble.append(text);
			if (message.role === 'assistant' && message.action === 'audit' && config.auditEnabled) {
				const start = document.createElement('button');
				start.type = 'button';
				start.className = 'jai__action';
				start.textContent = config.copy.audit.start;
				start.dataset.analyticsEvent = 'assistant_audit_offer';
				start.addEventListener('click', () => startAudit());
				bubble.append(start);
			}
			const href = message.role === 'assistant' ? actionHref(message) : null;
			if (href && message.action) {
				const link = document.createElement('a');
				link.className = 'jai__action';
				link.href = href;
				link.textContent = config.copy.actions[message.action] ?? config.copy.actions.page;
				link.dataset.analyticsEvent = `assistant_${message.action}`;
				if (message.action === 'whatsapp') link.rel = 'noreferrer';
				if (message.action === 'cv') link.setAttribute('download', '');
				bubble.append(link);
			}
			log.append(bubble);
		}

		function renderChips(list: string[]) {
			chips.replaceChildren(
				...list.map((label) => {
					const chip = document.createElement('button');
					chip.type = 'button';
					chip.dataset.jaiChip = '';
					chip.textContent = label;
					return chip;
				}),
			);
			chips.hidden = list.length === 0;
		}

		function renderAll() {
			log.querySelectorAll('.jai__msg:not(:first-child)').forEach((node) => node.remove());
			messages.forEach(renderMessage);
			if (messages.length) renderChips(store.get<string[]>('chips', []));
			if (store.get<AuditState | null>('audit', null)) renderAudit();
			scrollDown();
		}

		function typing(on: boolean) {
			log.querySelector('.jai__typing')?.remove();
			if (!on) return;
			const dots = document.createElement('div');
			dots.className = 'jai__msg jai__msg--ai jai__typing';
			dots.setAttribute('aria-label', config.copy.typing);
			dots.innerHTML = '<span></span><span></span><span></span>';
			log.append(dots);
			scrollDown();
		}

		function note(text: string, action?: string) {
			const message: Message = { role: 'assistant', content: text, action };
			renderMessage(message);
			scrollDown();
		}

		// ---------- Auditoría express: solo se hace aquí, en el chat ----------
		const A = config.copy.audit;
		let pollTimer: number | undefined;
		let stepTimer: number | undefined;
		const fill = (template: string, values: Record<string, string>) => template.replace(/\{(\w+)\}/g, (_, key: string) => values[key] ?? '');
		const make = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
			const node = document.createElement(tag);
			if (className) node.className = className;
			if (text !== undefined) node.textContent = text;
			return node;
		};
		const auditState = () => store.get<AuditState | null>('audit', null);
		const setAudit = (state: AuditState | null) => {
			store.set('audit', state);
			renderAudit();
		};

		function field(type: string, name: string, label: string, value = '') {
			const wrap = make('label', 'jai__field');
			wrap.append(make('span', 'sr-only', label));
			const input = make('input');
			input.type = type;
			input.name = name;
			input.placeholder = label;
			input.value = value;
			input.required = true;
			input.setAttribute('autocomplete', name === 'email' ? 'email' : name === 'name' ? 'name' : 'url');
			if (name === 'url') input.inputMode = 'url';
			wrap.append(input);
			return wrap;
		}

		function renderAudit() {
			window.clearInterval(stepTimer);
			log.querySelector('[data-jai-audit]')?.remove();
			const state = auditState();
			// Mientras llena el formulario o espera, las sugerencias y «Dejarle un mensaje» se esconden.
			// (Con el resultado ya visible también: ya dejó sus datos y la tarjeta necesita el espacio.)
			host.classList.toggle('is-auditing', Boolean(state));
			if (!state) return;
			const card = make('div', 'jai__msg jai__msg--ai jai__audit');
			card.dataset.jaiAudit = '';
			if (state.step === 'contact' || state.step === 'url') {
				const formNode = make('form', 'jai__audit-form');
				formNode.noValidate = true;
				if (state.step === 'contact') {
					formNode.append(make('p', '', A.intro), field('text', 'name', A.name, state.name), field('email', 'email', A.email, state.email));
					const consent = make('label', 'jai__consent');
					const box = make('input');
					box.type = 'checkbox';
					box.name = 'consent';
					box.checked = Boolean(state.consent);
					const consentText = make('span', '', `${A.consent} `);
					const privacy = make('a', '', config.locale === 'es' ? 'Aviso de privacidad' : 'Privacy notice');
					privacy.href = config.routes.privacy;
					privacy.target = '_blank';
					consentText.append(privacy);
					consent.append(box, consentText);
					formNode.append(consent);
				} else {
					formNode.append(make('p', '', fill(A.askUrl, { name: (state.name ?? '').split(' ')[0] })), field('text', 'url', A.url));
				}
				if (state.error) formNode.append(make('p', 'jai__audit-error', state.error));
				const submit = make('button', 'jai__action', state.step === 'contact' ? A.next : A.run);
				submit.type = 'submit';
				submit.dataset.analyticsEvent = state.step === 'contact' ? 'assistant_audit_contact' : 'assistant_audit_submit';
				formNode.append(submit);
				formNode.addEventListener('submit', (event) => {
					event.preventDefault();
					const data = new FormData(formNode);
					if (state.step === 'contact') {
						const name = String(data.get('name') ?? '').trim();
						const email = String(data.get('email') ?? '').trim();
						const consent = data.get('consent') === 'on';
						const error = name.length < 2 ? A.errors.invalid_name : !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email) ? A.errors.invalid_email : !consent ? A.errors.consent_required : '';
						setAudit(error ? { ...state, name, email, consent, error } : { step: 'url', name, email, consent: true });
					} else {
						submit.disabled = true;
						requestAudit(state, String(data.get('url') ?? '').trim());
					}
				});
				card.append(formNode);
				log.append(card);
				// Hasta el final del formulario, sin animación: el permiso y el botón tienen que verse.
				// El foco va sin mover el scroll; antes cortaba la bajada y dejaba la casilla tapada.
				window.requestAnimationFrame(() => {
					log.scrollTo({ top: log.scrollHeight, behavior: 'instant' });
					if (matchMedia('(pointer: fine)').matches) formNode.querySelector<HTMLInputElement>('input:not([type=checkbox])')?.focus({ preventScroll: true });
				});
				return;
			}
			const audit = state.audit;
			if (state.step === 'running' && audit) {
				card.classList.add('is-running');
				card.append(make('p', 'jai__audit-title', fill(A.waiting, { domain: audit.domain })));
				const list = make('ol', 'jai__audit-steps');
				A.steps.forEach((label) => list.append(make('li', '', label)));
				card.append(list, make('div', 'jai__audit-bar'));
				let current = Math.min(A.steps.length - 1, Math.floor((Date.now() - (state.startedAt ?? Date.now())) / 9000));
				const paint = () => [...list.children].forEach((item, index) => item.className = index < current ? 'is-done' : index === current ? 'is-now' : '');
				paint();
				stepTimer = window.setInterval(() => {
					current = Math.min(A.steps.length - 1, current + 1);
					paint();
				}, 9000);
				log.append(card);
				scrollDown();
				return;
			}
			if (state.step === 'done' && audit) {
				const head = make('div', 'jai__audit-head');
				const score = audit.score ?? 0;
				const ring = make('div', 'jai__ring');
				ring.style.setProperty('--score', String(Math.max(0, Math.min(100, score))));
				ring.setAttribute('role', 'img');
				ring.setAttribute('aria-label', `${A.health}: ${audit.score ?? '—'} / 100`);
				ring.append(make('strong', '', audit.score === null ? '—' : String(audit.score)), make('small', '', A.health));
				head.append(ring, make('p', 'jai__audit-title', fill(A.doneTitle, { domain: audit.domain })));
				card.append(head, make('p', 'jai__audit-kicker', audit.findings.length === 1 ? A.areaOne : fill(A.areas, { n: String(audit.findings.length) })));
				const areas = make('ol', 'jai__areas');
				audit.findings.forEach((finding) => {
					const item = make('li');
					const top = make('p', 'jai__area-title');
					top.append(make('span', `jai__sev jai__sev--${finding.severity}`, A.severity[finding.severity] ?? finding.severity), document.createTextNode(` ${finding.title}`));
					item.append(top);
					if (finding.business_effect) item.append(make('p', '', `${A.why}: ${finding.business_effect}`));
					if (finding.recommendation) item.append(make('p', '', `${A.fix}: ${finding.recommendation}`));
					areas.append(item);
				});
				card.append(areas);
				const actions = make('div', 'jai__audit-actions');
				const link = (href: string | null, label: string, event: string, primary = false) => {
					if (!href) return;
					const anchor = make('a', primary ? 'jai__action' : 'jai__action jai__action--ghost', label);
					anchor.href = href;
					anchor.target = '_blank';
					anchor.rel = 'noopener';
					anchor.dataset.analyticsEvent = event;
					actions.append(anchor);
				};
				link(audit.pdf_url, A.pdf, 'assistant_audit_pdf', true);
				link(audit.report_url, A.report, 'assistant_audit_report');
				link(`${config.routes.booking}?origen=auditoria`, A.talk, 'assistant_audit_talk');
				card.append(actions, make('p', 'jai__audit-note', A.doneNote));
				log.append(card);
				// Que se vea desde el anillo de salud, no desde los botones.
				log.scrollTop = Math.max(0, card.offsetTop - log.offsetTop - 8);
				return;
			}
			card.append(make('p', '', state.error || A.errors.unavailable));
			const contactLink = make('a', 'jai__action', config.copy.actions.contact);
			contactLink.href = `${config.links.contact}?producto=consultoria`;
			card.append(contactLink);
			log.append(card);
			scrollDown();
		}

		async function requestAudit(state: AuditState, url: string) {
			try {
				const response = await fetch('/api/audit', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ sid, locale: config.locale, page: location.pathname, name: state.name, email: state.email, url, consent: true }),
				});
				const data = await response.json().catch(() => ({}));
				if (response.status === 400) {
					const backToContact = ['invalid_name', 'invalid_email', 'consent_required'].includes(data.error);
					setAudit({ ...state, step: backToContact ? 'contact' : 'url', error: A.errors[data.error] ?? A.errors.invalid_url });
					return;
				}
				if (response.status === 429) return setAudit({ ...state, step: 'url', error: A.errors[data.error] ?? A.errors.limit_ip });
				if (!response.ok || !data.ok) return setAudit({ ...state, step: 'failed', error: A.errors.unavailable });
				trackLead('audit');
				applyAudit({ ...state, startedAt: Date.now() }, data as AuditResult);
			} catch {
				setAudit({ ...state, step: 'url', error: A.errors.unavailable });
			}
		}

		function applyAudit(state: AuditState, audit: AuditResult) {
			const step = audit.status === 'done' ? 'done' : ['failed', 'rejected'].includes(audit.status) ? 'failed' : 'running';
			setAudit({ ...state, step, audit, error: audit.error ?? undefined });
			if (step === 'running') schedulePoll();
		}

		function schedulePoll() {
			window.clearTimeout(pollTimer);
			pollTimer = window.setTimeout(async () => {
				const state = auditState();
				if (!state?.audit || state.step !== 'running') return;
				if (Date.now() - (state.startedAt ?? 0) > 10 * 60_000) return setAudit({ ...state, step: 'failed', error: A.errors.unavailable });
				try {
					const response = await fetch(`/api/audit/${encodeURIComponent(state.audit.id)}?sid=${encodeURIComponent(sid)}`);
					if (response.ok) applyAudit(state, (await response.json()) as AuditResult);
					else schedulePoll();
				} catch {
					schedulePoll();
				}
			}, 4000);
		}

		function startAudit() {
			if (panel.hidden) setOpen(true, false);
			hideInvite(true);
			const state = auditState();
			if (!state) setAudit({ step: 'contact' });
			else {
				renderAudit();
				if (state.step === 'running') schedulePoll();
			}
		}

		async function ask(question: string) {
			const content = question.trim().slice(0, 800);
			if (!content || busy) return;
			busy = true;
			send.disabled = true;
			const userMessage: Message = { role: 'user', content };
			messages.push(userMessage);
			store.set('messages', messages);
			renderMessage(userMessage);
			renderChips([]);
			input.value = '';
			autosize();
			typing(true);
			try {
				// Si el modelo tarda de más, se corta a los 30 s y se ofrece WhatsApp.
				const controller = new AbortController();
				const timer = window.setTimeout(() => controller.abort(), 30000);
				const response = await fetch('/api/ai', {
					signal: controller.signal,
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						sid,
						locale: config.locale,
						page: location.pathname,
						// Las respuestas del asistente vuelven con su firma: el servidor solo confía en las que firmó él.
						messages: messages.slice(-12).map(({ role, content, sig }) => ({ role, content, ...(sig ? { sig } : {}) })),
					}),
				});
				window.clearTimeout(timer);
				const data = await response.json().catch(() => ({}));
				typing(false);
				if (!response.ok || !data.ok) {
					note(response.status === 429 ? config.copy.limit : config.copy.error, 'whatsapp');
					return;
				}
				const reply: Message = { role: 'assistant', content: data.reply, sig: data.sig, action: data.action, page: data.page };
				messages.push(reply);
				store.set('messages', messages);
				renderMessage(reply);
				store.set('chips', data.suggestions ?? []);
				renderChips(data.suggestions ?? []);
				// Bloqueado por abuso: el chat se queda en pausa en esta sesión.
				if (data.blocked) {
					input.disabled = true;
					send.disabled = true;
					store.set('blocked', true);
				}
				if (data.leadSaved) {
					store.set('leadSaved', true);
					leave.hidden = true;
					window.dispatchEvent(new CustomEvent('jai:lead'));
				}
				scrollDown();
			} catch {
				typing(false);
				note(config.copy.error, 'whatsapp');
			} finally {
				busy = false;
				send.disabled = store.get('blocked', false);
			}
		}

		function autosize() {
			input.style.height = 'auto';
			input.style.height = `${Math.min(input.scrollHeight, 132)}px`;
		}

		// Teclado del teléfono: el panel se ajusta al alto visible, como en Daniela.
		const fitViewport = () => {
			const viewport = window.visualViewport;
			if (!viewport) return;
			host.style.setProperty('--jai-vh', `${viewport.height}px`);
			host.style.setProperty('--jai-top', `${viewport.offsetTop}px`);
		};

		function setOpen(open: boolean, focusInput = true) {
			launcher.setAttribute('aria-expanded', String(open));
			panel.hidden = !open;
			host.classList.toggle('is-open', open);
			document.documentElement.classList.toggle('jai-open', open);
			window.requestAnimationFrame(() => clearConsent());
			if (open) {
				hideInvite(true);
				fitViewport();
				renderAll();
				if (focusInput && matchMedia('(pointer: fine)').matches) input.focus();
				store.set('opened', true);
			}
		}

		function hideInvite(forever = false) {
			invite.hidden = true;
			if (forever) store.set('inviteDone', true);
		}

		launcher.addEventListener('click', () => setOpen(!host.classList.contains('is-open')));
		$<HTMLButtonElement>('[data-jai-close]').addEventListener('click', () => {
			setOpen(false);
			launcher.focus();
		});
		$<HTMLButtonElement>('[data-jai-reset]').addEventListener('click', () => {
			messages = [];
			sid = newSid();
			store.set('sid', sid);
			store.set('messages', []);
			store.set('chips', []);
			store.set('audit', null);
			window.clearTimeout(pollTimer);
			renderAll();
			renderChips(JSON.parse(chips.dataset.starters || '[]'));
			input.focus();
		});
		chips.dataset.starters = JSON.stringify([...chips.querySelectorAll('button')].map((button) => button.textContent));
		// Si el servidor bloqueó esta sesión por abuso, el chat sigue en pausa aunque se recargue la página.
		if (store.get('blocked', false)) {
			input.disabled = true;
			send.disabled = true;
		}
		chips.addEventListener('click', (event) => {
			const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-jai-chip]');
			if (chip) ask(chip.textContent ?? '');
		});
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			ask(input.value);
		});
		input.addEventListener('keydown', (event) => {
			if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
				event.preventDefault();
				ask(input.value);
			}
		});
		input.addEventListener('input', autosize);
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !panel.hidden) {
				setOpen(false);
				launcher.focus();
			}
		});
		window.visualViewport?.addEventListener('resize', fitViewport);
		window.visualViewport?.addEventListener('scroll', fitViewport);

		// Botones del sitio con data-ai-audit: abren el chat directo en la auditoría express.
		document.addEventListener('click', (event) => {
			const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-ai-audit]');
			if (!trigger || !config.auditEnabled) return;
			event.preventDefault();
			startAudit();
		});

		// Cualquier botón del sitio con data-ai-open abre el chat; con data-ai-ask además pregunta.
		document.addEventListener('click', (event) => {
			const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-ai-open]');
			if (!trigger) return;
			event.preventDefault();
			setOpen(true, !trigger.dataset.aiAsk);
			if (trigger.dataset.aiAsk) ask(trigger.dataset.aiAsk);
		});

		// Invitación medida: una por página, máximo dos por sesión, nunca en contacto ni si ya abrió el chat.
		const path = location.pathname;
		const pageKey = Object.entries(config.routes).find(([key, route]) => key !== 'home' && path.startsWith(route))?.[0] ?? (path === config.routes.home ? 'home' : 'default');
		const shown = store.get('invites', 0);
		const allowed = pageKey !== 'contact' && !store.get('opened', false) && !store.get('inviteDone', false) && shown < 2;
		if (allowed) {
			window.setTimeout(() => {
				if (!panel.hidden || document.hidden) return;
				// El mensaje discreto junto al botón: la auditoría express, salvo en Sobre mí y MADRE
				// (ahí llega gente buscando otra cosa) o si ya la hizo en esta sesión.
				const offerAudit = config.auditEnabled && !['about', 'madre'].includes(pageKey) && !auditState();
				inviteText.dataset.audit = offerAudit ? '1' : '';
				inviteText.textContent = offerAudit ? config.invites.audit : config.invites[pageKey] ?? config.invites.default;
				invite.hidden = false;
				store.set('invites', shown + 1);
				window.setTimeout(() => hideInvite(), 9000);
			}, 12000);
		}
		inviteText.addEventListener('click', () => (inviteText.dataset.audit ? startAudit() : setOpen(true)));
		$<HTMLButtonElement>('[data-jai-invite-close]').addEventListener('click', () => hideInvite(true));

		// Mientras el aviso de analítica está visible, el botón sube por encima de él.
		const consentBanner = document.querySelector<HTMLElement>('[data-analytics-consent]');
		const clearConsent = () => {
			if (!consentBanner || consentBanner.hidden || host.classList.contains('is-open')) {
				host.style.bottom = '';
				return;
			}
			const rect = consentBanner.getBoundingClientRect();
			host.style.bottom = rect.height ? `${Math.max(0, window.innerHeight - rect.top) + 12}px` : '';
		};
		if (consentBanner) {
			new MutationObserver(clearConsent).observe(consentBanner, { attributes: true, attributeFilter: ['hidden'] });
			window.addEventListener('resize', clearConsent);
			window.requestAnimationFrame(clearConsent);
		}

		leave.hidden = store.get('leadSaved', false);
		leave.addEventListener('click', () => ask(config.copy.leaveAsk));

		if (messages.length || auditState()) renderAll();
		if (auditState()?.step === 'running') schedulePoll();
	}
</script>
