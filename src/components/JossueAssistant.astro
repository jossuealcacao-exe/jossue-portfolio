---
// Jossue AI: chat real con Gemini a través del Worker (/api/ai). Toma la estructura de Daniela:
// botón fijo, panel nativo (no iframe), historial en la sesión, invitaciones medidas y ajuste al
// teclado del teléfono. Si la IA no está disponible, ofrece WhatsApp y el formulario.
import { contact } from '../data/contact';
import { AUDIT_ENABLED } from '../data/features';
import { routes, type Locale } from '../data/i18n';
import Icon from './Icon.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';
const cvHref = es ? contact.cvEs : contact.cvEn ?? contact.cvEs;
const starters = es
	? ['¿Qué ha construido Jossué?', '¿Qué resultados ha tenido?', 'Necesito ayuda con mi tienda']
	: ['What has Jossué built?', 'What results has he had?', 'I need help with my store'];
const copy = es
	? {
			greeting: 'Hola, soy Jossue AI, el asistente de Jossué. Te puedo contar qué ha construido y cómo trabaja. También puedes contarme qué pasa en tu negocio y te digo si él te puede ayudar. Si no sé algo, te lo digo.',
			greetings: [
				'¡Qué tal! Soy Jossue AI, el asistente de Jossué. Cuéntame qué traes con tu negocio y te digo si él te puede echar la mano.',
				'Hola, soy Jossue AI. Me sé lo que Jossué ha construido y cómo trabaja. ¿Qué te trae por aquí?',
				'¿Tu tienda no vende lo que debería? Soy Jossue AI, el asistente de Jossué. Platícame qué pasa y lo vemos.',
				'Hola. Soy Jossue AI y contesto con lo que Jossué ha hecho de verdad, nada inventado. ¿En qué te ayudo?',
				'Qué onda, soy Jossue AI. Pregúntame por tiendas en Shopify, chatbots o lo que Jossué hace con IA.',
				'Hola, soy Jossue AI. Jossué anda construyendo algo; mientras, yo te atiendo. ¿Qué necesitas?',
				'Bienvenido. Soy Jossue AI. Si algo no lo sé, te lo digo y te paso directo con Jossué. ¿Por dónde empezamos?',
			],
			greetingAudit: 'Hola, soy Jossue AI. Si tienes un sitio, te lo reviso gratis en un par de minutos y te digo qué te está costando ventas. O pregúntame lo que quieras de Jossué.',
			placeholder: 'Escribe tu pregunta…',
			send: 'Enviar',
			typing: 'Jossue AI está escribiendo',
			disclosure: 'Soy una IA y respondo con lo que Jossué publica. Guardo la conversación 30 días para mejorar mis respuestas, sin correos ni teléfonos. No compartas datos sensibles.',
			error: 'Ahorita no puedo contestar. Escríbele a Jossué por WhatsApp o con el formulario y te responde en menos de un día hábil.',
			limit: 'Llegaste al límite de mensajes por ahora. Si quieres seguir, escríbele directo a Jossué.',
			lead: 'Listo, le pasé tus datos a Jossué.',
			actions: { contact: 'Escribirle a Jossué', call: 'Agendar llamada de 10 min', whatsapp: 'WhatsApp', cv: 'Descargar su CV', page: 'Ver la página' },
			reset: 'Nueva conversación',
			leave: 'Dejarle un mensaje a Jossué',
			leaveAsk: 'Quiero dejarle un mensaje a Jossué',
			role: 'IA · responde al momento',
			bookShort: 'Agendar llamada',
			leaveShort: 'Dejar un mensaje',
			booking: {
				intro: 'Va. Elige un horario y Jossué te llama 10 minutos para entender tu caso y decirte por dónde empezaría. Es gratis y no tienes que contratar nada. Horarios en hora de Guadalajara.',
				loading: 'Buscando horarios libres…',
				full: 'Sin espacios',
				left: 'Quedan {n}',
				leftOne: 'Queda 1',
				yourTime: 'tu hora',
				empty: 'Ahorita no hay horarios libres en la agenda. Déjale un mensaje a Jossué o escríbele por WhatsApp y te busca un espacio.',
				failed: 'No pude cargar la agenda desde aquí. Ábrela en su página o escríbele a Jossué por WhatsApp.',
				picked: 'Elegiste el {when} (hora de Guadalajara).',
				change: 'Cambiar horario',
				later: 'Ahora no',
				name: 'Tu nombre',
				email: 'Tu correo',
				phone: 'Tu teléfono (ahí te llama)',
				topic: '¿De qué quieres hablar? (opcional)',
				consent: 'Acepto que Jossué me llame y me escriba sobre esta llamada. Mis datos solo se usan para eso.',
				submit: 'Confirmar llamada',
				sending: 'Agendando…',
				doneTitle: 'Listo, {name}. Tu llamada quedó agendada.',
				doneText: 'Jossué te llama el {when} (hora de Guadalajara) al {phone}.',
				ics: 'Agregar a mi calendario',
				google: 'Google Calendar',
				manage: 'Ver o cancelar',
				page: 'Abrir la agenda',
				leave: 'Dejarle un mensaje',
