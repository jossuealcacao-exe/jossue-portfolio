				severity: { high: 'Alta', medium: 'Media', low: 'Baja' },
				hello: '{name}, revisé {domain} como lo ve un cliente desde su celular.',
				verdict: { good: 'Va bien, pero hay detalles que te cuestan clientes.', mid: 'Se te están yendo ventas por aquí.', bad: 'Tu sitio te está costando clientes.' },
				cost: 'Qué te está costando',
				teaser: 'Cómo resolver cada punto, y en qué orden, te lo explico en una llamada de 10 minutos. Jossué ya tiene tu revisión completa.',
				talk: 'Agendar 10 min para resolverlo',
				whatsapp: 'Prefiero WhatsApp',
				errors: {
					invalid_name: 'Escribe tu nombre, por favor.',
					invalid_email: 'Revisa tu correo, parece que le falta algo.',
					consent_required: 'Para que Jossué te escriba sobre tu revisión necesito tu permiso.',
					invalid_url: 'Esa dirección no la puedo revisar. Escribe la de tu sitio público, por ejemplo tutienda.com.',
					limit_ip: 'Hoy ya revisaste varios sitios desde aquí. Si quieres revisar otro, escríbele a Jossué.',
					limit_domain: 'Ese sitio ya se revisó hoy. Si quieres saber qué salió, agenda 10 minutos con Jossué y te lo explica.',
					blocked: 'Por ahora no puedo hacer la auditoría desde este chat.',
					unavailable: 'Ahorita no puedo hacer la revisión. Déjale tus datos a Jossué y te la manda por correo.',
				},
			},
		}
	: {
			greeting: 'Hi, I am Jossue AI, Jossué’s assistant. I can tell you what he has built and how he works. You can also tell me what is going on in your business and I will tell you whether he can help. If I do not know something, I will say so.',
			greetings: [
				'Hey! I am Jossue AI, Jossué’s assistant. Tell me what is going on with your business and I will tell you if he can help.',
				'Hi, I am Jossue AI. I know what Jossué has built and how he works. What brings you here?',
				'Is your store not selling like it should? I am Jossue AI, Jossué’s assistant. Tell me what is happening and we will look at it.',
				'Hi. I am Jossue AI and I answer with what Jossué has actually done, nothing made up. How can I help?',
				'Hi, I am Jossue AI. Ask me about Shopify stores, chatbots or what Jossué builds with AI.',
				'Hi, I am Jossue AI. If I do not know something, I will say so and pass you straight to Jossué. Where do we start?',
			],
			greetingAudit: 'Hi, I am Jossue AI. If you have a site, I can review it for free in a couple of minutes and tell you what is costing you sales. Or ask me anything about Jossué.',
			placeholder: 'Type your question…',
			send: 'Send',
			typing: 'Jossue AI is typing',
			disclosure: 'I am an AI and I answer with what Jossué publishes. I keep the conversation for 30 days to improve my answers, without emails or phone numbers. Do not share sensitive data.',
			error: 'I cannot answer right now. Message Jossué on WhatsApp or through the form and he will reply within one business day.',
			limit: 'You reached the message limit for now. If you want to keep going, write to Jossué directly.',
			lead: 'Done, I passed your details to Jossué.',
			actions: { contact: 'Write to Jossué', call: 'Book a 10-min call', whatsapp: 'WhatsApp', cv: 'Download his CV', page: 'See the page' },
			reset: 'New conversation',
			leave: 'Leave Jossué a message',
			leaveAsk: 'I want to leave Jossué a message',
			role: 'AI · answers right away',
			bookShort: 'Book a call',
			leaveShort: 'Leave a message',
			booking: {
				intro: 'Sure. Pick a time and Jossué will call you for 10 minutes to understand your case and tell you where he would start. It is free and you do not have to hire anything. Times are in Guadalajara time.',
				loading: 'Looking for free times…',
				full: 'Full',
				left: '{n} left',
				leftOne: '1 left',
				yourTime: 'your time',
				empty: 'There are no free times right now. Leave Jossué a message or write to him on WhatsApp and he will find you a slot.',
				failed: 'I could not load the calendar from here. Open it on its page or message Jossué on WhatsApp.',
				picked: 'You picked {when} (Guadalajara time).',
				change: 'Change time',
				later: 'Not now',
				name: 'Your name',
				email: 'Your email',
				phone: 'Your phone (he calls you here)',
				topic: 'What do you want to talk about? (optional)',
				consent: 'I agree that Jossué may call me and write to me about this call. My data is only used for that.',
				submit: 'Confirm the call',
				sending: 'Booking…',
				doneTitle: 'Done, {name}. Your call is booked.',
				doneText: 'Jossué will call you on {when} (Guadalajara time) at {phone}.',
				ics: 'Add to my calendar',
				google: 'Google Calendar',
				manage: 'See or cancel',
				page: 'Open the calendar',
				leave: 'Leave a message',
				topicAudit: 'Go over my express audit of {domain} ({score}/100)',
				errors: {
					invalid_name: 'Please write your name.',
					invalid_email: 'Check your email, something seems to be missing.',
					invalid_phone: 'Check your phone: 10 digits, or with the country code if outside Mexico.',
					consent_required: 'I need your permission for Jossué to call you.',
					blocked: 'I cannot book from this chat right now. Message Jossué on WhatsApp.',
					booking_unavailable: 'I cannot book from here right now. Open the calendar or message him on WhatsApp.',
				},
			},
			audit: {
				invite: 'I can run a free express audit. In about 2 minutes I tell you 3 things on your site you can improve.',
				start: 'Run my express audit',
				intro: 'Sure. I review your site’s home page the way a customer sees it on their phone, give it a score and tell you the 3 things costing you the most sales, right here in the chat. It is free and takes a minute or two. What is your name, and at what email can Jossué reach you?',
				name: 'Your name',
				email: 'Your email',
				consent: 'I agree that Jossué may write to me about this audit. My details are only used for that; I can ask for them to be deleted at hola@jossuealcala.com.',
				next: 'Next',
				askUrl: 'Thanks, {name}. What is your site’s address?',
				url: 'yoursite.com',
				run: 'Review my site',
				steps: ['Opening your site', 'Measuring mobile speed', 'Checking what your customer sees', 'Looking for what costs you sales', 'Writing what you can improve'],
				waiting: 'Reviewing {domain}…',
				doneTitle: 'Your express audit of {domain}',
				health: 'Score',
				areas: '{n} things you can improve',
				areaOne: 'What you can improve',
				why: 'Why it matters',
				fix: 'Where I would start',
				severity: { high: 'High', medium: 'Medium', low: 'Low' },
				hello: '{name}, I reviewed {domain} the way a customer sees it on their phone.',
				verdict: { good: 'It is doing well, but some details cost you customers.', mid: 'You are losing sales here.', bad: 'Your site is costing you customers.' },
				cost: 'What it is costing you',
				teaser: 'How to fix each point, and in what order, I explain in a 10-minute call. Jossué already has your full review.',
				talk: 'Book 10 min to fix it',
				whatsapp: 'I prefer WhatsApp',
				errors: {
					invalid_name: 'Please type your name.',
					invalid_email: 'Check your email, something seems to be missing.',
					consent_required: 'I need your permission for Jossué to write to you about your review.',
					invalid_url: 'I cannot review that address. Type your public site, for example yourstore.com.',
					limit_ip: 'You already ran several audits from here today. To review another site, write to Jossué.',
					limit_domain: 'That site was already reviewed today. Book 10 minutes with Jossué and he will walk you through it.',
					blocked: 'I cannot run the audit from this chat right now.',
					unavailable: 'I cannot run the review right now. Leave Jossué your details and he will email it to you.',
				},
			},
		};
const invites = es
	? {
			audit: copy.audit.invite,
			home: '¿Algo no funciona en tu tienda o tu página? Cuéntame y te digo si Jossué te puede ayudar.',
			products: '¿No sabes qué producto necesitas? Te ayudo a elegir.',
			about: '¿Eres reclutador? Pregúntame por su experiencia.',
			work: '¿Quieres el resumen de un caso? Pregúntame.',
			madre: '¿Dudas sobre MADRE? Te explico cómo funciona.',
			default: '¿Tienes una pregunta sobre el trabajo de Jossué?',
		}
	: {
			audit: copy.audit.invite,
			home: 'Something not working on your store or website? Tell me and I will say whether Jossué can help.',
			products: 'Not sure which product fits? I can help you pick.',
			about: 'Recruiting? Ask me about his experience.',
			work: 'Want the short version of a case? Ask me.',
			madre: 'Questions about MADRE? I can explain how it works.',
			default: 'Got a question about Jossué’s work?',
		};
const config = {
	locale,
	auditEnabled: AUDIT_ENABLED,
	copy,
	links: { contact: routes[locale].contact, call: `${routes[locale].booking}?origen=chat`, whatsapp: contact.whatsapp, cv: cvHref },
	invites,
	routes: routes[locale],
};
---

<aside class="jai" data-jai>
	<p class="jai__invite" data-jai-invite hidden>
		<button class="jai__invite-text" type="button" data-jai-invite-open></button>
		<button class="jai__invite-close" type="button" data-jai-invite-close aria-label={es ? 'Cerrar invitación' : 'Dismiss invitation'}><Icon name="close" /></button>
	</p>
	<button class="jai__launcher" type="button" aria-expanded="false" aria-controls="jai-panel" data-analytics-event="assistant_open">
		<span class="jai__avatar" aria-hidden="true"><img src="/images/jossue-alcala-480.webp" alt="" width="40" height="40" loading="lazy" decoding="async" /><i></i></span>
		<span class="jai__launcher-text"><strong>Jossue AI</strong><small>{es ? 'Pregúntame' : 'Ask me'}</small></span>
	</button>
	<section class="jai__panel" id="jai-panel" hidden aria-label="Jossue AI" role="dialog">
		<header class="jai__head">
			<span class="jai__avatar jai__avatar--lg" aria-hidden="true"><img src="/images/jossue-alcala-480.webp" alt="" width="44" height="44" loading="lazy" decoding="async" /><i></i></span>
			<div class="jai__title">
				<h2>Jossue AI</h2>
				<p>{copy.role}</p>
			</div>
			<button class="jai__icon-btn" type="button" data-jai-reset aria-label={copy.reset} title={copy.reset}>
				<svg viewBox="0 0 32 32" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 16a10 10 0 1 0 3-7.1M6 5v5h5" /></g></svg>
			</button>
			<button class="jai__icon-btn" type="button" data-jai-close aria-label={es ? 'Cerrar Jossue AI' : 'Close Jossue AI'}><Icon name="close" /></button>
		</header>
		<div class="jai__log" data-jai-log aria-live="polite" aria-relevant="additions">
			<div class="jai__msg jai__msg--ai jai__greeting" data-jai-greeting><p>{copy.greeting}</p></div>
		</div>
		<div class="jai__chips" data-jai-chips>
			{starters.map((text) => <button type="button" data-jai-chip>{text}</button>)}
		</div>
		<div class="jai__next" data-jai-next>
			<button class="jai__leave jai__leave--book" type="button" data-jai-book data-analytics-event="assistant_book_open" aria-label={copy.actions.call}><Icon name="calendar" />{copy.bookShort}</button>
			<button class="jai__leave" type="button" data-jai-leave data-analytics-event="assistant_leave_message" aria-label={copy.leave}><Icon name="envelope" />{copy.leaveShort}</button>
		</div>
		<form class="jai__form" data-jai-form>
			<label class="sr-only" for="jai-input">{copy.placeholder}</label>
			<textarea id="jai-input" rows="1" maxlength="800" placeholder={copy.placeholder} data-jai-input enterkeyhint="send"></textarea>
			<button class="jai__send" type="submit" aria-label={copy.send} data-jai-send><Icon name="arrow-right" /></button>
		</form>
		<p class="jai__disclosure">{copy.disclosure} <a href={routes[locale].privacy}>{es ? 'Aviso de privacidad' : 'Privacy notice'}</a></p>
	</section>
	<script type="application/json" data-jai-config set:html={JSON.stringify(config)} />
</aside>

<script>
	import { trackLead } from '../scripts/analytics';

	type Message = { role: 'user' | 'assistant'; content: string; sig?: string; action?: string; page?: string | null };
	type AuditCopy = {
		invite: string; start: string; intro: string; name: string; email: string; consent: string; next: string; askUrl: string; url: string; run: string;
		steps: string[]; waiting: string; doneTitle: string; health: string; areas: string; areaOne: string; why: string; fix: string; severity: Record<string, string>;
		hello: string; verdict: Record<'good' | 'mid' | 'bad', string>; cost: string; teaser: string; talk: string; whatsapp: string; errors: Record<string, string>;
	};
	type BookingCopy = Record<'intro' | 'loading' | 'full' | 'left' | 'leftOne' | 'yourTime' | 'empty' | 'failed' | 'picked' | 'change' | 'later' | 'name' | 'email' | 'phone' | 'topic' | 'consent' | 'submit' | 'sending' | 'doneTitle' | 'doneText' | 'ics' | 'google' | 'manage' | 'page' | 'leave' | 'topicAudit', string> & { errors: Record<string, string> };
	type Copy = {
		greeting: string; greetings: string[]; greetingAudit: string; placeholder: string; send: string; typing: string; disclosure: string; error: string; limit: string; lead: string;
		actions: Record<string, string>; reset: string; leave: string; leaveAsk: string; role: string; audit: AuditCopy; booking: BookingCopy;
	};
	// La cita se guarda igual que en /agenda/ (jossue-booking) para poder verla o cancelarla ahí.
	type Saved = { id: string; token: string; slot: number; end: number; when: string; phone: string };
	type BookingDay = { date: string; slots: number[] };
	type BookingState = {
		step: 'slots' | 'contact' | 'done' | 'failed';
		source: 'chat' | 'auditoria';
		day?: string; slot?: number; name?: string; email?: string; phone?: string; topic?: string; consent?: boolean; error?: string; saved?: Saved;
	};
	type Finding = { title: string; severity: string; business_effect: string; recommendation: string; category?: string };
	type AuditResult = { id: string; status: string; domain: string; url: string; score: number | null; findings: Finding[]; error: string | null };
	type AuditState = { step: 'contact' | 'url' | 'running' | 'done' | 'failed'; name?: string; email?: string; consent?: boolean; error?: string; audit?: AuditResult; startedAt?: number };
	type Config = {
		locale: 'es' | 'en';
		auditEnabled: boolean;
		copy: Copy;
		links: { contact: string; call: string; whatsapp: string | null; cv: string | null };
		invites: Record<string, string>;
		routes: Record<string, string>;
	};

	const root = document.querySelector<HTMLElement>('[data-jai]');
	const configNode = root?.querySelector<HTMLScriptElement>('[data-jai-config]');
	if (root && configNode) {
		const config = JSON.parse(configNode.textContent || '{}') as Config;
		const host: HTMLElement = root;
		const $ = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
		const launcher = $<HTMLButtonElement>('.jai__launcher');
		const panel = $<HTMLElement>('.jai__panel');
		const log = $<HTMLElement>('[data-jai-log]');
		const chips = $<HTMLElement>('[data-jai-chips]');
		const form = $<HTMLFormElement>('[data-jai-form]');
		const input = $<HTMLTextAreaElement>('[data-jai-input]');
		const send = $<HTMLButtonElement>('[data-jai-send]');
		const invite = $<HTMLElement>('[data-jai-invite]');
		const inviteText = $<HTMLButtonElement>('[data-jai-invite-open]');
		const leave = $<HTMLButtonElement>('[data-jai-leave]');
		const bookButton = $<HTMLButtonElement>('[data-jai-book]');
		const next = $<HTMLElement>('[data-jai-next]');

		const store = {
			get<T>(key: string, fallback: T): T {
				try {
					const raw = sessionStorage.getItem(`jai:${key}`);
					return raw ? (JSON.parse(raw) as T) : fallback;
				} catch {
					return fallback;
				}
			},
			set(key: string, value: unknown) {
				try {
					sessionStorage.setItem(`jai:${key}`, JSON.stringify(value));
				} catch {
					/* modo privado: el chat funciona igual, solo no se recuerda */
				}
			},
		};
		const newSid = () => (crypto.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(16).slice(2)}`).replace(/[^\w-]/g, '');
		let sid = store.get('sid', '') || newSid();
		store.set('sid', sid);
		let messages = store.get<Message[]>('messages', []);
		// Saludo al azar entre los de Jossué, fijo durante la conversación; uno nuevo al reiniciarla.
		const greetingNode = root.querySelector<HTMLElement>('[data-jai-greeting] p');
		function pickGreeting() {
			const pool = [...config.copy.greetings, ...(config.auditEnabled ? [config.copy.greetingAudit] : [])];
			let index = store.get<number>('greeting', -1);
			if (index < 0 || index >= pool.length) {
				index = Math.floor(Math.random() * pool.length);
				store.set('greeting', index);
			}
			if (greetingNode) greetingNode.textContent = pool[index];
		}
		pickGreeting();
		let busy = false;

		const scrollDown = () => (log.scrollTop = log.scrollHeight);

		function actionHref(message: Message) {
			if (message.action === 'contact') return config.links.contact;
			if (message.action === 'call') return config.links.call;
			if (message.action === 'whatsapp') return config.links.whatsapp;
			if (message.action === 'cv') return config.links.cv;
			if (message.action === 'page') return message.page ?? null;
			return null;
		}

		function renderMessage(message: Message) {
			const bubble = document.createElement('div');
			bubble.className = `jai__msg jai__msg--${message.role === 'user' ? 'me' : 'ai'}`;
			const text = document.createElement('p');
			text.textContent = message.content;
			bubble.append(text);
			if (message.role === 'assistant' && message.action === 'audit' && config.auditEnabled) {
				const start = document.createElement('button');
				start.type = 'button';
				start.className = 'jai__action';
				start.textContent = config.copy.audit.start;
				start.dataset.analyticsEvent = 'assistant_audit_offer';
				start.addEventListener('click', () => startAudit());
				bubble.append(start);
			}
			// La llamada se agenda aquí mismo: el botón abre los horarios en la conversación.
			if (message.role === 'assistant' && message.action === 'call') {
				if (isBooked()) {
					log.append(bubble);
					return;
				}
				const book = document.createElement('button');
				book.type = 'button';
				book.className = 'jai__action';
				book.textContent = config.copy.actions.call;
				book.dataset.analyticsEvent = 'assistant_call';
				book.addEventListener('click', () => startBooking('chat'));
				bubble.append(book);
				log.append(bubble);
				return;
			}
			const href = message.role === 'assistant' ? actionHref(message) : null;
			if (href && message.action) {
				const link = document.createElement('a');
				link.className = 'jai__action';
				link.href = href;
				link.textContent = config.copy.actions[message.action] ?? config.copy.actions.page;
				link.dataset.analyticsEvent = `assistant_${message.action}`;
				if (message.action === 'whatsapp') link.rel = 'noreferrer';
				if (message.action === 'cv') link.setAttribute('download', '');
				bubble.append(link);
			}
			log.append(bubble);
		}

		function renderChips(all: string[]) {
			// Con la llamada ya agendada, la sugerencia de agendar sobra.
			const list = isBooked() ? all.filter((label) => label !== config.copy.actions.call) : all;
			chips.replaceChildren(
				...list.map((label) => {
					const chip = document.createElement('button');
					chip.type = 'button';
					chip.dataset.jaiChip = '';
					chip.textContent = label;
					return chip;
				}),
			);
			chips.hidden = list.length === 0;
		}

		function renderAll() {
			log.querySelectorAll('.jai__msg:not(:first-child)').forEach((node) => node.remove());
			messages.forEach(renderMessage);
			if (messages.length) renderChips(store.get<string[]>('chips', []));
			if (store.get<AuditState | null>('audit', null)) renderAudit();
			if (bookingState()) renderBooking();
			scrollDown();
		}

		function typing(on: boolean) {
			log.querySelector('.jai__typing')?.remove();
			if (!on) return;
			const dots = document.createElement('div');
			dots.className = 'jai__msg jai__msg--ai jai__typing';
			dots.setAttribute('aria-label', config.copy.typing);
			dots.innerHTML = '<span></span><span></span><span></span>';
			log.append(dots);
			scrollDown();
		}

		function note(text: string, action?: string) {
			const message: Message = { role: 'assistant', content: text, action };
			renderMessage(message);
			scrollDown();
		}

		// ---------- Auditoría express: solo se hace aquí, en el chat ----------
		const A = config.copy.audit;
		let pollTimer: number | undefined;
		let stepTimer: number | undefined;
		const fill = (template: string, values: Record<string, string>) => template.replace(/\{(\w+)\}/g, (_, key: string) => values[key] ?? '');
		const make = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
			const node = document.createElement(tag);
			if (className) node.className = className;
			if (text !== undefined) node.textContent = text;
			return node;
		};
		const auditState = () => store.get<AuditState | null>('audit', null);
		const setAudit = (state: AuditState | null) => {
			store.set('audit', state);
			renderAudit();
		};

		function field(type: string, name: string, label: string, value = '', required = true) {
			const wrap = make('label', 'jai__field');
			wrap.append(make('span', 'sr-only', label));
			const input = make('input');
			input.type = type;
			input.name = name;
			input.placeholder = label;
			input.value = value;
			input.required = required;
			input.setAttribute('autocomplete', ({ email: 'email', name: 'name', phone: 'tel', topic: 'off' } as Record<string, string>)[name] ?? 'url');
			if (name === 'url') input.inputMode = 'url';
			if (name === 'phone') input.inputMode = 'tel';
			wrap.append(input);
			return wrap;
		}

		function renderAudit() {
			window.clearInterval(stepTimer);
			log.querySelector('[data-jai-audit]')?.remove();
			const state = auditState();
			// Mientras llena el formulario o espera, las sugerencias y «Dejarle un mensaje» se esconden.
			// (Con el resultado ya visible también: ya dejó sus datos y la tarjeta necesita el espacio.)
			host.classList.toggle('is-auditing', Boolean(state));
			if (!state) return;
			const card = make('div', 'jai__msg jai__msg--ai jai__audit');
			card.dataset.jaiAudit = '';
			if (state.step === 'contact' || state.step === 'url') {
				const formNode = make('form', 'jai__audit-form');
				formNode.noValidate = true;
				if (state.step === 'contact') {
					formNode.append(make('p', '', A.intro), field('text', 'name', A.name, state.name), field('email', 'email', A.email, state.email));
					const consent = make('label', 'jai__consent');
					const box = make('input');
					box.type = 'checkbox';
					box.name = 'consent';
					box.checked = Boolean(state.consent);
					const consentText = make('span', '', `${A.consent} `);
					const privacy = make('a', '', config.locale === 'es' ? 'Aviso de privacidad' : 'Privacy notice');
					privacy.href = config.routes.privacy;
					privacy.target = '_blank';
					consentText.append(privacy);
					consent.append(box, consentText);
					formNode.append(consent);
				} else {
					formNode.append(make('p', '', fill(A.askUrl, { name: (state.name ?? '').split(' ')[0] })), field('text', 'url', A.url));
				}
				if (state.error) formNode.append(make('p', 'jai__audit-error', state.error));
				const submit = make('button', 'jai__action', state.step === 'contact' ? A.next : A.run);
				submit.type = 'submit';
				submit.dataset.analyticsEvent = state.step === 'contact' ? 'assistant_audit_contact' : 'assistant_audit_submit';
				formNode.append(submit);
				formNode.addEventListener('submit', (event) => {
					event.preventDefault();
					const data = new FormData(formNode);
					if (state.step === 'contact') {
						const name = String(data.get('name') ?? '').trim();
						const email = String(data.get('email') ?? '').trim();
						const consent = data.get('consent') === 'on';
						const error = name.length < 2 ? A.errors.invalid_name : !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email) ? A.errors.invalid_email : !consent ? A.errors.consent_required : '';
						setAudit(error ? { ...state, name, email, consent, error } : { step: 'url', name, email, consent: true });
					} else {
						submit.disabled = true;
						requestAudit(state, String(data.get('url') ?? '').trim());
					}
				});
				card.append(formNode);
				log.append(card);
				// Hasta el final del formulario, sin animación: el permiso y el botón tienen que verse.
				// El foco va sin mover el scroll; antes cortaba la bajada y dejaba la casilla tapada.
				window.requestAnimationFrame(() => {
					log.scrollTo({ top: log.scrollHeight, behavior: 'instant' });
					if (matchMedia('(pointer: fine)').matches) formNode.querySelector<HTMLInputElement>('input:not([type=checkbox])')?.focus({ preventScroll: true });
				});
				return;
			}
			const audit = state.audit;
			if (state.step === 'running' && audit) {
				card.classList.add('is-running');
				card.append(make('p', 'jai__audit-title', fill(A.waiting, { domain: audit.domain })));
				const list = make('ol', 'jai__audit-steps');
				A.steps.forEach((label) => list.append(make('li', '', label)));
				card.append(list, make('div', 'jai__audit-bar'));
				let current = Math.min(A.steps.length - 1, Math.floor((Date.now() - (state.startedAt ?? Date.now())) / 9000));
				const paint = () => [...list.children].forEach((item, index) => item.className = index < current ? 'is-done' : index === current ? 'is-now' : '');
				paint();
				stepTimer = window.setInterval(() => {
					current = Math.min(A.steps.length - 1, current + 1);
					paint();
				}, 9000);
				log.append(card);
				scrollDown();
				return;
			}
			if (state.step === 'done' && audit) {
				// Resultado en el chat, a la medida de quien lo pidió: su nombre, su sitio, su calificación y lo
				// que le está costando. Sin informe ni PDF: cómo resolverlo es la llamada de 10 minutos.
				card.classList.add('jai__audit--done');
				const score = audit.score ?? 0;
				const tone = score >= 80 ? 'good' : score >= 55 ? 'mid' : 'bad';
				const first = (state.name ?? '').trim().split(/\s+/)[0] || (config.locale === 'es' ? 'Listo' : 'Done');
				const head = make('div', `jai__audit-head jai__audit-head--${tone}`);
				const ring = make('div', 'jai__ring');
				ring.style.setProperty('--score', String(Math.max(0, Math.min(100, score))));
				ring.setAttribute('role', 'img');
				ring.setAttribute('aria-label', `${A.health}: ${audit.score ?? '—'} / 100`);
				ring.append(make('strong', '', audit.score === null ? '—' : String(audit.score)), make('small', '', '/100'));
				const words = make('div', 'jai__audit-words');
				words.append(make('p', 'jai__audit-hello', fill(A.hello, { name: first, domain: audit.domain })), make('p', 'jai__audit-verdict', A.verdict[tone]));
				head.append(ring, words);
				card.append(head, make('p', 'jai__audit-kicker', audit.findings.length === 1 ? A.areaOne : fill(A.areas, { n: String(audit.findings.length) })));
				const areas = make('ol', 'jai__pains');
				audit.findings.slice(0, 3).forEach((finding, index) => {
					const item = make('li', `jai__pain jai__pain--${finding.severity}`);
					const top = make('div', 'jai__pain-top');
					top.append(make('span', 'jai__pain-n', String(index + 1)), make('span', `jai__sev jai__sev--${finding.severity}`, A.severity[finding.severity] ?? finding.severity));
					item.append(top, make('p', 'jai__pain-title', finding.title));
					if (finding.business_effect) item.append(make('p', 'jai__pain-cost', finding.business_effect));
					areas.append(item);
				});
				card.append(areas, make('p', 'jai__audit-teaser', A.teaser));
				const actions = make('div', 'jai__audit-actions');
				const go = (href: string | null, label: string, event: string, primary: boolean) => {
					if (!href) return;
					const anchor = make('a', primary ? 'jai__action' : 'jai__action jai__action--ghost', label);
					anchor.href = href;
					if (!href.startsWith('/')) {
						anchor.target = '_blank';
						anchor.rel = 'noopener';
					}
					anchor.dataset.analyticsEvent = event;
					actions.append(anchor);
				};
				// La llamada se agenda aquí mismo, con su nombre, correo y el tema ya puestos.
				if (!isBooked()) {
					const talk = make('button', 'jai__action', A.talk);
					talk.type = 'button';
					talk.dataset.analyticsEvent = 'assistant_audit_talk';
					talk.addEventListener('click', () => startBooking('auditoria'));
					actions.append(talk);
				}
				go(config.links.whatsapp, A.whatsapp, 'assistant_audit_whatsapp', false);
				card.append(actions);
				log.append(card);
				// Que se vea desde el saludo y la calificación, no desde los botones.
				log.scrollTop = Math.max(0, card.offsetTop - log.offsetTop - 8);
				return;
			}
			card.append(make('p', '', state.error || A.errors.unavailable));
			const contactLink = make('a', 'jai__action', config.copy.actions.contact);
			contactLink.href = `${config.links.contact}?producto=consultoria`;
			card.append(contactLink);
			log.append(card);
			scrollDown();
		}

		async function requestAudit(state: AuditState, url: string) {
			try {
				const response = await fetch('/api/audit', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ sid, locale: config.locale, page: location.pathname, name: state.name, email: state.email, url, consent: true }),
				});
				const data = await response.json().catch(() => ({}));
				if (response.status === 400) {
					const backToContact = ['invalid_name', 'invalid_email', 'consent_required'].includes(data.error);
					setAudit({ ...state, step: backToContact ? 'contact' : 'url', error: A.errors[data.error] ?? A.errors.invalid_url });
					return;
				}
				if (response.status === 429) return setAudit({ ...state, step: 'url', error: A.errors[data.error] ?? A.errors.limit_ip });
				if (!response.ok || !data.ok) return setAudit({ ...state, step: 'failed', error: A.errors.unavailable });
				trackLead('audit');
				applyAudit({ ...state, startedAt: Date.now() }, data as AuditResult);
			} catch {
				setAudit({ ...state, step: 'url', error: A.errors.unavailable });
			}
		}

		function applyAudit(state: AuditState, audit: AuditResult) {
			const step = audit.status === 'done' ? 'done' : ['failed', 'rejected'].includes(audit.status) ? 'failed' : 'running';
			setAudit({ ...state, step, audit, error: audit.error ?? undefined });
			if (step === 'running') schedulePoll();
		}

		function schedulePoll() {
			window.clearTimeout(pollTimer);
			pollTimer = window.setTimeout(async () => {
				const state = auditState();
				if (!state?.audit || state.step !== 'running') return;
				if (Date.now() - (state.startedAt ?? 0) > 10 * 60_000) return setAudit({ ...state, step: 'failed', error: A.errors.unavailable });
				try {
					const response = await fetch(`/api/audit/${encodeURIComponent(state.audit.id)}?sid=${encodeURIComponent(sid)}`);
					if (response.ok) applyAudit(state, (await response.json()) as AuditResult);
					else schedulePoll();
				} catch {
					schedulePoll();
				}
			}, 4000);
		}

		function startAudit() {
			if (panel.hidden) setOpen(true, false);
			hideInvite(true);
			const state = auditState();
			if (!state) setAudit({ step: 'contact' });
			else {
				renderAudit();
				if (state.step === 'running') schedulePoll();
			}
		}

		// ---------- Llamada de 10 minutos: se agenda aquí, con la misma agenda de /agenda/ ----------
		const B = config.copy.booking;
		const SAVED_KEY = 'jossue-booking';
		const TZ = 'America/Mexico_City';
		const lang = config.locale === 'en' ? 'en-US' : 'es-MX';
		const hour12 = config.locale === 'en';
		const dayFmt = new Intl.DateTimeFormat(lang, { weekday: 'short', day: 'numeric', month: 'short', timeZone: TZ });
		const hourFmt = new Intl.DateTimeFormat(lang, { hour: '2-digit', minute: '2-digit', hour12, timeZone: TZ });
		const localHourFmt = new Intl.DateTimeFormat(lang, { hour: '2-digit', minute: '2-digit', hour12 });
		const longParts = new Intl.DateTimeFormat(lang, { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit', hour12, timeZone: TZ });
		// Igual que whenLabel del Worker: «martes 6 de octubre a las 10:15».
		const whenLabel = (ms: number) => {
			const p = Object.fromEntries(longParts.formatToParts(ms).map((part) => [part.type, part.value]));
			return config.locale === 'en' ? `${p.weekday}, ${p.month} ${p.day} at ${p.hour}:${p.minute} ${p.dayPeriod ?? ''}`.trim() : `${p.weekday} ${p.day} de ${p.month} a las ${p.hour}:${p.minute}`;
		};
		let bookingDays: BookingDay[] | null = null;
		let bookingLoad: Promise<void> | null = null;
		let bookingFailed = false;

		function bookingState() {
			return store.get<BookingState | null>('booking', null);
		}
		function readSaved(): Saved | null {
			try {
				const value = JSON.parse(localStorage.getItem(SAVED_KEY) ?? 'null');
				return value && value.slot > Date.now() ? value : null;
			} catch {
				return null;
			}
		}
		function isBooked() {
			return Boolean(readSaved()) || bookingState()?.step === 'done';
		}
		const setBooking = (state: BookingState | null) => {
			store.set('booking', state);
			renderBooking();
			syncNext();
		};
		// «Agendar llamada» y «Dejar un mensaje» se esconden cuando ya no aplican.
		function syncNext() {
			bookButton.hidden = isBooked();
			leave.hidden = store.get('leadSaved', false);
			next.hidden = bookButton.hidden && leave.hidden;
		}

		function loadDays() {
			bookingLoad ??= (async () => {
				try {
					const response = await fetch('/api/booking/slots', { headers: { Accept: 'application/json' } });
					const data = await response.json();
					if (!response.ok || !data.ok) throw new Error('slots');
					bookingDays = (data.days ?? []) as BookingDay[];
					bookingFailed = false;
				} catch {
					bookingFailed = true;
				} finally {
					bookingLoad = null;
				}
			})();
			return bookingLoad;
		}

		// El tema de la llamada sale de la plática: la auditoría o lo último que la persona contó.
		function topicFromConversation(source: BookingState['source']) {
			const audit = auditState();
			if (source === 'auditoria' && audit?.audit) return fill(B.topicAudit, { domain: audit.audit.domain, score: String(audit.audit.score ?? '—') });
			const said = messages.filter((message) => message.role === 'user' && message.content.length > 12 && message.content !== config.copy.leaveAsk).at(-1)?.content ?? '';
			return said.slice(0, 280);
		}

		function startBooking(source: BookingState['source'] = 'chat') {
			// En la página de la agenda ya está todo a la vista: se cierra el chat y se va a los horarios.
			if (location.pathname === config.routes.booking) {
				setOpen(false);
				document.querySelector('[data-booking]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
				return;
			}
			if (panel.hidden) setOpen(true, false);
			hideInvite(true);
			const saved = readSaved();
			if (saved) return setBooking({ step: 'done', source, saved, name: bookingState()?.name });
			const current = bookingState();
			if (current && current.step !== 'failed') return renderBooking();
			const audit = auditState();
			setBooking({ step: 'slots', source, name: audit?.name, email: audit?.email, topic: topicFromConversation(source) });
		}

		function bookingActions(...items: Array<[string | null, string, string, boolean] | HTMLElement>) {
			const row = make('div', 'jai__audit-actions');
			for (const item of items) {
				if (item instanceof HTMLElement) {
					row.append(item);
					continue;
				}
				const [href, label, event, primary] = item;
				if (!href) continue;
				const anchor = make('a', primary ? 'jai__action' : 'jai__action jai__action--ghost', label);
				anchor.href = href;
				if (!href.startsWith('/')) {
					anchor.target = '_blank';
					anchor.rel = 'noopener';
				}
				anchor.dataset.analyticsEvent = event;
				row.append(anchor);
			}
			return row;
		}

		function ghost(label: string, onClick: () => void) {
			const button = make('button', 'jai__action jai__action--ghost', label);
			button.type = 'button';
			button.addEventListener('click', onClick);
			return button;
		}

		function renderBooking() {
			log.querySelector('[data-jai-book-card]')?.remove();
			const state = bookingState();
			host.classList.toggle('is-booking', Boolean(state) && state?.step !== 'done');
			if (!state) return;
			const card = make('div', 'jai__msg jai__msg--ai jai__audit jai__book');
			card.dataset.jaiBookCard = '';
			const pageLink = `${config.routes.booking}?origen=${state.source}`;

			if (state.step === 'slots') {
				card.append(make('p', '', B.intro));
				if (!bookingDays && !bookingFailed) {
					card.append(make('p', 'jai__audit-note', B.loading));
					log.append(card);
					scrollDown();
					void loadDays().then(() => bookingState()?.step === 'slots' && renderBooking());
					return;
				}
				const open = (bookingDays ?? []).filter((day) => day.slots.length);
				if (bookingFailed || !open.length) {
					card.append(make('p', '', bookingFailed ? B.failed : B.empty));
					const leaveIt = ghost(B.leave, () => {
						setBooking(null);
						ask(config.copy.leaveAsk);
					});
					card.append(bookingActions([config.links.whatsapp, config.copy.actions.whatsapp, 'assistant_book_whatsapp', true], leaveIt, [pageLink, B.page, 'assistant_book_page', false]));
					log.append(card);
					scrollDown();
					return;
				}
				const active = state.day && open.some((day) => day.date === state.day) ? state.day : open[0].date;
				const days = make('div', 'jai__days');
				days.setAttribute('role', 'group');
				for (const day of (bookingDays ?? []).slice(0, 10)) {
					const button = make('button', 'jai__day');
					button.type = 'button';
					const [weekday, ...rest] = dayFmt.format(Date.parse(`${day.date}T18:00:00Z`)).replace(',', '').split(' ');
					button.append(make('span', '', weekday), make('strong', '', rest.join(' ')));
					const n = day.slots.length;
					if (!n) {
						button.disabled = true;
						button.classList.add('is-full');
						button.append(make('em', '', B.full));
					} else if (n <= 2) {
						button.append(make('em', '', n === 1 ? B.leftOne : fill(B.left, { n: String(n) })));
					}
					button.setAttribute('aria-pressed', String(day.date === active));
					button.addEventListener('click', () => setBooking({ ...state, day: day.date, error: undefined }));
					days.append(button);
				}
				const times = make('div', 'jai__times');
				for (const start of open.find((day) => day.date === active)?.slots ?? []) {
					const label = hourFmt.format(start);
					const theirs = localHourFmt.format(start);
					const button = make('button', 'jai__time', label);
					button.type = 'button';
					button.dataset.slot = String(start);
					button.dataset.analyticsEvent = 'assistant_book_time';
					if (theirs !== label) button.append(make('small', '', `${B.yourTime} ${theirs}`));
					button.addEventListener('click', () => setBooking({ ...state, step: 'contact', day: active, slot: start, error: undefined }));
					times.append(button);
				}
				card.append(days, times);
				if (state.error) card.append(make('p', 'jai__audit-error', state.error));
				card.append(bookingActions(ghost(B.later, () => setBooking(null))));
				log.append(card);
				window.requestAnimationFrame(() => log.scrollTo({ top: log.scrollHeight, behavior: 'instant' }));
				return;
			}

			if (state.step === 'contact' && state.slot) {
				const formNode = make('form', 'jai__audit-form');
				formNode.noValidate = true;
				const picked = make('p', 'jai__book-picked', fill(B.picked, { when: whenLabel(state.slot) }));
				const change = make('button', 'jai__link', B.change);
				change.type = 'button';
				change.addEventListener('click', () => setBooking({ ...state, step: 'slots', slot: undefined, error: undefined }));
				picked.append(' ', change);
				formNode.append(
					picked,
					field('text', 'name', B.name, state.name),
					field('email', 'email', B.email, state.email),
					field('tel', 'phone', B.phone, state.phone),
					field('text', 'topic', B.topic, state.topic, false),
				);
				const consent = make('label', 'jai__consent');
				const box = make('input');
				box.type = 'checkbox';
				box.name = 'consent';
				box.checked = Boolean(state.consent);
				const consentText = make('span', '', `${B.consent} `);
				const privacy = make('a', '', config.locale === 'es' ? 'Aviso de privacidad' : 'Privacy notice');
				privacy.href = config.routes.privacy;
				privacy.target = '_blank';
				consentText.append(privacy);
				consent.append(box, consentText);
				formNode.append(consent);
				if (state.error) formNode.append(make('p', 'jai__audit-error', state.error));
				const submit = make('button', 'jai__action', B.submit);
				submit.type = 'submit';
				submit.dataset.analyticsEvent = 'assistant_book_submit';
				formNode.append(submit);
				formNode.addEventListener('submit', (event) => {
					event.preventDefault();
					const data = new FormData(formNode);
					const value = (key: string) => String(data.get(key) ?? '').trim();
					const draft: BookingState = { ...state, name: value('name'), email: value('email'), phone: value('phone'), topic: value('topic').slice(0, 300), consent: data.get('consent') === 'on' };
					const error =
						draft.name!.length < 2 ? B.errors.invalid_name
						: !/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(draft.email!) ? B.errors.invalid_email
						: draft.phone!.replace(/\D/g, '').length < 10 ? B.errors.invalid_phone
						: !draft.consent ? B.errors.consent_required
						: '';
					if (error) return setBooking({ ...draft, error });
					submit.disabled = true;
					submit.textContent = B.sending;
					void requestBooking(draft);
				});
				card.append(formNode);
				log.append(card);
				window.requestAnimationFrame(() => {
					log.scrollTo({ top: log.scrollHeight, behavior: 'instant' });
					if (matchMedia('(pointer: fine)').matches) formNode.querySelector<HTMLInputElement>('input[name=name]')?.focus({ preventScroll: true });
				});
				return;
			}

			if (state.step === 'done' && state.saved) {
				const saved = state.saved;
				card.classList.add('jai__book--done');
				const first = (state.name ?? '').trim().split(/\s+/)[0];
				card.append(make('p', 'jai__audit-title', first ? fill(B.doneTitle, { name: first }) : B.doneTitle.replace(/,? \{name\}/, '')));
				card.append(make('p', '', fill(B.doneText, { when: saved.when, phone: saved.phone })));
				const stamp = (ms: number) => new Date(ms).toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
				const google = new URL('https://calendar.google.com/calendar/render');
				google.searchParams.set('action', 'TEMPLATE');
				google.searchParams.set('text', config.locale === 'en' ? 'Call with Jossué Alcalá (10 min)' : 'Llamada con Jossué Alcalá (10 min)');
				google.searchParams.set('dates', `${stamp(saved.slot)}/${stamp(saved.end)}`);
				google.searchParams.set('details', config.locale === 'en' ? 'Jossué will call you at the number you left.' : 'Jossué te llama al número que dejaste.');
				card.append(
					bookingActions(
						[`/api/booking/${encodeURIComponent(saved.id)}.ics?t=${encodeURIComponent(saved.token)}`, B.ics, 'assistant_book_ics', true],
						[google.toString(), B.google, 'assistant_book_google', false],
						[config.routes.booking, B.manage, 'assistant_book_manage', false],
					),
				);
				log.append(card);
				scrollDown();
				return;
			}

			card.append(make('p', '', state.error || B.errors.booking_unavailable));
			card.append(bookingActions([pageLink, B.page, 'assistant_book_page', true], [config.links.whatsapp, config.copy.actions.whatsapp, 'assistant_book_whatsapp', false]));
			log.append(card);
			scrollDown();
		}

		async function requestBooking(state: BookingState) {
			try {
				const response = await fetch('/api/booking', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify({ slot: state.slot, name: state.name, email: state.email, phone: state.phone, topic: state.topic, consent: true, locale: config.locale, source: state.source, page: location.pathname }),
				});
				const result = await response.json().catch(() => ({}));
				if (response.ok && result.booking) {
					const saved = result.booking as Saved;
					try {
						localStorage.setItem(SAVED_KEY, JSON.stringify(saved));
					} catch {
						/* sin almacenamiento la cita solo se ve en esta sesión */
					}
					trackLead('booking');
					setBooking({ ...state, step: 'done', saved, error: undefined });
					log.querySelectorAll('[data-analytics-event="assistant_call"], [data-analytics-event="assistant_audit_talk"]').forEach((node) => node.remove());
					renderChips(store.get<string[]>('chips', []));
					window.dispatchEvent(new CustomEvent('jai:booked'));
					return;
				}
				const message = result.message ?? B.errors[result.error] ?? B.errors.booking_unavailable;
				// Horario ganado por alguien más: de vuelta a los horarios, ya actualizados.
				if (['slot_taken', 'slot_invalid'].includes(result.error)) {
					bookingDays = null;
					return setBooking({ ...state, step: 'slots', slot: undefined, error: message });
				}
				if (['invalid_name', 'invalid_email', 'invalid_phone', 'consent_required'].includes(result.error)) return setBooking({ ...state, error: message });
				setBooking({ ...state, step: response.status === 409 || response.status === 429 ? 'contact' : 'failed', error: message });
			} catch {
				setBooking({ ...state, step: 'failed', error: B.errors.booking_unavailable });
			}
		}

		// Lo que el bot necesita saber de esta conversación para elegir el siguiente paso.
		function conversationContext() {
			const audit = auditState();
			return { audit: audit?.step === 'done' ? (audit.audit?.score ?? null) : null, booked: isBooked(), lead: store.get('leadSaved', false) };
		}
		const BOOK_INTENT = /\b(agend\w*|llamad\w*|reuni[oó]n\w*|cita|videollamada|call|book\w*|schedul\w*|meeting)\b/i;

		async function ask(question: string) {
			const content = question.trim().slice(0, 800);
			if (!content || busy) return;
			busy = true;
			send.disabled = true;
			const userMessage: Message = { role: 'user', content };
			messages.push(userMessage);
			store.set('messages', messages);
			renderMessage(userMessage);
			renderChips([]);
			input.value = '';
			autosize();
			typing(true);
			try {
				// Si el modelo tarda de más, se corta a los 30 s y se ofrece WhatsApp.
				const controller = new AbortController();
				const timer = window.setTimeout(() => controller.abort(), 30000);
				const response = await fetch('/api/ai', {
					signal: controller.signal,
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						sid,
						locale: config.locale,
						page: location.pathname,
						// Las respuestas del asistente vuelven con su firma: el servidor solo confía en las que firmó él.
						messages: messages.slice(-12).map(({ role, content, sig }) => ({ role, content, ...(sig ? { sig } : {}) })),
						// Auditoría, llamada y recado: el bot ofrece el siguiente paso que falta, no uno repetido.
						context: conversationContext(),
					}),
				});
				window.clearTimeout(timer);
				const data = await response.json().catch(() => ({}));
				typing(false);
				if (!response.ok || !data.ok) {
					note(response.status === 429 ? config.copy.limit : config.copy.error, 'whatsapp');
					return;
				}
				const reply: Message = { role: 'assistant', content: data.reply, sig: data.sig, action: data.action, page: data.page };
				messages.push(reply);
				store.set('messages', messages);
				renderMessage(reply);
				store.set('chips', data.suggestions ?? []);
				renderChips(data.suggestions ?? []);
				// Bloqueado por abuso: el chat se queda en pausa en esta sesión.
				if (data.blocked) {
					input.disabled = true;
					send.disabled = true;
					store.set('blocked', true);
				}
				if (data.leadSaved) {
					store.set('leadSaved', true);
					syncNext();
					window.dispatchEvent(new CustomEvent('jai:lead'));
				}
				// Si pidió agendar con sus palabras, la agenda se abre sola debajo de la respuesta.
				if (data.action === 'call' && BOOK_INTENT.test(content) && !isBooked()) startBooking('chat');
				scrollDown();
			} catch {
				typing(false);
				note(config.copy.error, 'whatsapp');
			} finally {
				busy = false;
				send.disabled = store.get('blocked', false);
			}
		}

		function autosize() {
			input.style.height = 'auto';
			input.style.height = `${Math.min(input.scrollHeight, 132)}px`;
		}

		// Teclado del teléfono: el panel se ajusta al alto visible, como en Daniela.
		const fitViewport = () => {
			const viewport = window.visualViewport;
			if (!viewport) return;
			host.style.setProperty('--jai-vh', `${viewport.height}px`);
			host.style.setProperty('--jai-top', `${viewport.offsetTop}px`);
		};

		function setOpen(open: boolean, focusInput = true) {
			launcher.setAttribute('aria-expanded', String(open));
			panel.hidden = !open;
			host.classList.toggle('is-open', open);
			document.documentElement.classList.toggle('jai-open', open);
			window.requestAnimationFrame(() => clearConsent());
			if (open) {
				hideInvite(true);
				fitViewport();
				renderAll();
				if (focusInput && matchMedia('(pointer: fine)').matches) input.focus();
				store.set('opened', true);
			}
		}

		function hideInvite(forever = false) {
			invite.hidden = true;
			if (forever) store.set('inviteDone', true);
		}

		launcher.addEventListener('click', () => setOpen(!host.classList.contains('is-open')));
		$<HTMLButtonElement>('[data-jai-close]').addEventListener('click', () => {
			setOpen(false);
			launcher.focus();
		});
		$<HTMLButtonElement>('[data-jai-reset]').addEventListener('click', () => {
			messages = [];
			sid = newSid();
			store.set('sid', sid);
			store.set('messages', []);
			store.set('chips', []);
			store.set('audit', null);
			store.set('booking', null);
			host.classList.remove('is-booking');
			store.set('greeting', -1);
			pickGreeting();
			window.clearTimeout(pollTimer);
			renderAll();
			renderChips(JSON.parse(chips.dataset.starters || '[]'));
			input.focus();
		});
		chips.dataset.starters = JSON.stringify([...chips.querySelectorAll('button')].map((button) => button.textContent));
		// Si el servidor bloqueó esta sesión por abuso, el chat sigue en pausa aunque se recargue la página.
		if (store.get('blocked', false)) {
			input.disabled = true;
			send.disabled = true;
		}
		chips.addEventListener('click', (event) => {
			const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-jai-chip]');
			if (!chip) return;
			// La sugerencia «Agendar llamada de 10 min» no va al bot: abre la agenda aquí mismo.
			if (chip.textContent === config.copy.actions.call) return startBooking('chat');
			ask(chip.textContent ?? '');
		});
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			ask(input.value);
		});
		input.addEventListener('keydown', (event) => {
			if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
				event.preventDefault();
				ask(input.value);
			}
		});
		input.addEventListener('input', autosize);
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !panel.hidden) {
				setOpen(false);
				launcher.focus();
			}
		});
		window.visualViewport?.addEventListener('resize', fitViewport);
		window.visualViewport?.addEventListener('scroll', fitViewport);

		// Botones del sitio con data-ai-book: abren el chat directo en la agenda de la llamada.
		document.addEventListener('click', (event) => {
			const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-ai-book]');
			if (!trigger) return;
			event.preventDefault();
			startBooking(trigger.dataset.aiBook === 'auditoria' ? 'auditoria' : 'chat');
		});

		// Botones del sitio con data-ai-audit: abren el chat directo en la auditoría express.
		document.addEventListener('click', (event) => {
			const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-ai-audit]');
			if (!trigger || !config.auditEnabled) return;
			event.preventDefault();
			startAudit();
		});

		// Cualquier botón del sitio con data-ai-open abre el chat; con data-ai-ask además pregunta.
		document.addEventListener('click', (event) => {
			const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-ai-open]');
			if (!trigger) return;
			event.preventDefault();
			setOpen(true, !trigger.dataset.aiAsk);
			if (trigger.dataset.aiAsk) ask(trigger.dataset.aiAsk);
		});

		// Invitación medida: una por página, máximo dos por sesión, nunca en contacto ni si ya abrió el chat.
		const path = location.pathname;
		const pageKey = Object.entries(config.routes).find(([key, route]) => key !== 'home' && path.startsWith(route))?.[0] ?? (path === config.routes.home ? 'home' : 'default');
		const shown = store.get('invites', 0);
		const allowed = pageKey !== 'contact' && !store.get('opened', false) && !store.get('inviteDone', false) && shown < 2;
		if (allowed) {
			window.setTimeout(() => {
				if (!panel.hidden || document.hidden) return;
				// El mensaje discreto junto al botón: la auditoría express, salvo en Sobre mí y MADRE
				// (ahí llega gente buscando otra cosa) o si ya la hizo en esta sesión.
				const offerAudit = config.auditEnabled && !['about', 'madre'].includes(pageKey) && !auditState();
				inviteText.dataset.audit = offerAudit ? '1' : '';
				inviteText.textContent = offerAudit ? config.invites.audit : config.invites[pageKey] ?? config.invites.default;
				invite.hidden = false;
				store.set('invites', shown + 1);
				window.setTimeout(() => hideInvite(), 9000);
			}, 12000);
		}
		inviteText.addEventListener('click', () => (inviteText.dataset.audit ? startAudit() : setOpen(true)));
		$<HTMLButtonElement>('[data-jai-invite-close]').addEventListener('click', () => hideInvite(true));

		// Mientras el aviso de analítica está visible, el botón sube por encima de él.
		const consentBanner = document.querySelector<HTMLElement>('[data-analytics-consent]');
		const clearConsent = () => {
			if (!consentBanner || consentBanner.hidden || host.classList.contains('is-open')) {
				host.style.bottom = '';
				return;
			}
			const rect = consentBanner.getBoundingClientRect();
			host.style.bottom = rect.height ? `${Math.max(0, window.innerHeight - rect.top) + 12}px` : '';
		};
		if (consentBanner) {
			new MutationObserver(clearConsent).observe(consentBanner, { attributes: true, attributeFilter: ['hidden'] });
			window.addEventListener('resize', clearConsent);
			window.requestAnimationFrame(clearConsent);
		}

		syncNext();
		leave.addEventListener('click', () => ask(config.copy.leaveAsk));
		bookButton.addEventListener('click', () => startBooking('chat'));

		if (messages.length || auditState()) renderAll();
		if (auditState()?.step === 'running') schedulePoll();
	}
</script>
