---
// Portada con el sistema de madre.run (MADRE UX): negro #050605, grafito en las bandas,
// superficies de radio grande sin bordes, rótulos mono. El acento del sitio es marfil;
// el verde fósforo queda solo para MADRE, el producto estrella.
import type { CollectionEntry } from 'astro:content';
import { brandForCaseSlug } from '../data/brands';
import { caseCover } from '../data/workImages';
import { casePresentation } from '../data/casePresentation';
import { routes, type Locale } from '../data/i18n';
import { commercialProducts, featuredProducts, otherProducts, productDemo, productHref } from '../data/products';
import AiDevSpotlight from './AiDevSpotlight.astro';
import AuditCta from './AuditCta.astro';
import { AUDIT_ENABLED } from '../data/features';
import { madreFacts } from '../data/madre';
import AiInvite from './AiInvite.astro';
import BrandLogos from './BrandLogos.astro';
import ConsultingSection from './ConsultingSection.astro';
import DemoVideo from './DemoVideo.astro';
import HeroLoop from './HeroLoop.astro';
import Icon, { type IconName } from './Icon.astro';

interface Props {
	locale: Locale;
	cases: CollectionEntry<'cases'>[];
}

const { locale, cases } = Astro.props;
const es = locale === 'es';
const madre = commercialProducts.find((product) => product.slug === 'madre');
if (!madre) throw new Error('MADRE product is required');
const others = otherProducts;
const alsoFeatured = featuredProducts.filter((product) => product.slug !== 'madre');
const madreDemo = productDemo(madre, locale);
const productIcons: Record<string, IconName> = { 'bloqio-builder': 'layers', daniela: 'chat', chatbots: 'chats', consultoria: 'compass', 'desarrollo-web': 'code', 'ia-aplicada': 'sparkles-ai' };
const outside: Record<string, { href: string; label: string }> = {
	'ahp-plus': { href: 'https://github.com/jossuealcacao-exe/ahp_plus', label: 'GitHub' },
	daniela: { href: 'https://wunutrition.com/', label: es ? 'Verla en wunutrition.com' : 'See it on wunutrition.com' },
	'bloqio-builder': { href: 'https://bloqio.app/', label: 'bloqio.app' },
	miawseo: { href: 'https://github.com/jossuealcacao-exe/miawseo', label: 'GitHub' },
};

const selected = ['wu-nutrition', 'come-verde', 'la-carniceria-virtual', 'bloqio-cro-apps']
	.map((slug) => cases.find((entry) => entry.data.slug === slug))
	.filter((entry): entry is CollectionEntry<'cases'> => Boolean(entry));

const MADRE_RUN = 'https://madre.run/';
const V = '/videos/madre';

const facts = es
	? [['+8 años', 'en ventas en línea, publicidad digital y desarrollo web'], ['5', 'productos míos, entre ellos MADRE y AHP+'], ['9', 'proyectos contados con detalle, incluido lo que no salió bien']]
	: [['8+ years', 'in online sales, digital ads and web development'], ['5', 'products of my own, MADRE and AHP+ among them'], ['9', 'projects told in detail, including what did not go well']];

const madrePoints: [IconName, string, string][] = es
	? [
			['chats', 'Trabajan en la misma conversación.', 'Codex, Claude Code, Gemini CLI y OpenCode leen los mismos mensajes.'],
			['layers', 'Ninguno empieza de cero.', 'Cada asistente recibe lo que se dijo antes, y MADRE guarda lo que ya se decidió.'],
			['shield', 'Nada cambia sin tu permiso.', 'Para que editen archivos tienes que escribir el nombre del proyecto. Cada cambio se puede deshacer.'],
			['bolt', 'Gastas menos en IA.', 'En una prueba ahorró 496,894 tokens (la unidad con la que cobran los servicios de IA) en siete turnos.'],
		]
	: [
			['chats', 'They work in the same conversation.', 'Codex, Claude Code, Gemini CLI and OpenCode read the same messages.'],
			['layers', 'None of them starts from scratch.', 'Each assistant gets what was said before, and MADRE keeps what was already decided.'],
			['shield', 'Nothing changes without your say.', 'Before they can edit files, you have to type the project name. Every change can be undone.'],
			['bolt', 'You spend less on AI.', 'In a test it saved 496,894 tokens (the unit AI services charge by) over seven turns.'],
		];

const showcase = es
	? [
			{ key: 'anuncio', src: `${V}/madre-anuncio.mp4`, poster: `${V}/madre-anuncio.webp`, ratio: '16:9', label: 'Anuncio · 30 s', title: 'Lo principal de MADRE en 30 segundos.' },
			{ key: 'vertical', src: `${V}/madre-vertical.mp4`, poster: `${V}/madre-vertical.webp`, ratio: '9:16', label: 'Vertical · 45 s', title: 'Cómo recuerda cada proyecto y cómo protege tus archivos.' },
			{ key: 'showcase', src: `${V}/madre-showcase.mp4`, poster: `${V}/madre-showcase.webp`, ratio: '16:9', label: 'Demo · 1 min', title: 'Cuatro asistentes hacen una app y un módulo.' },
		]
	: [
			{ key: 'anuncio', src: `${V}/madre-anuncio.mp4`, poster: `${V}/madre-anuncio.webp`, ratio: '16:9', label: 'Ad · 30 s', title: 'The main points of MADRE in 30 seconds.' },
			{ key: 'vertical', src: `${V}/madre-vertical.mp4`, poster: `${V}/madre-vertical.webp`, ratio: '9:16', label: 'Vertical · 45 s', title: 'How it remembers each project and protects your files.' },
			{ key: 'showcase', src: `${V}/madre-showcase.mp4`, poster: `${V}/madre-showcase.webp`, ratio: '16:9', label: 'Demo · 1 min', title: 'Four assistants build an app and a module.' },
		];

const method = es
	? [
			['01', 'Entender', 'Platicamos qué quieres lograr, qué tienes hoy y qué te está frenando.'],
			['02', 'Proponer', 'Te digo qué haría y cómo se va a ver antes de construir nada.'],
			['03', 'Construir', 'Hago la tienda, la página o la herramienta y la dejo funcionando.'],
			['04', 'Comprobar', 'La pruebo y te enseño cómo quedó antes de darla por terminada.'],
		]
	: [
			['01', 'Understand', 'We talk about what you want, what you have today and what is holding you back.'],
			['02', 'Propose', 'I tell you what I would do and how it will look before building anything.'],
			['03', 'Build', 'I make the store, the page or the tool and leave it working.'],
			['04', 'Check', 'I test it and show you how it turned out before calling it done.'],
		];
const madreSlide = AUDIT_ENABLED ? 2 : 1;
const campaign = `/videos/madre/madre-campaign-${locale}`;
---

<article class="jx-home" data-storefront-home>
	<div class="jx-page-hero jx-slides" data-hero="home" data-hero-slides>
		<div class="jx-slides__stage">
		<div class="jx-slides__bg is-active" data-slide-bg="0"><HeroLoop name="home" fit="aspect" /></div>
		{AUDIT_ENABLED && <div class="jx-slides__bg" data-slide-bg="1"><HeroLoop name="audit" fit="aspect" /></div>}
		<div class="jx-slides__bg" data-slide-bg={madreSlide}><HeroLoop name="madre" fit="aspect" /></div>
		<div class="jx-slides__track">
			<section class="jx-hero jx-slide is-active" data-slide="0" aria-labelledby="jx-hero-title" aria-roledescription={AUDIT_ENABLED ? (es ? 'diapositiva' : 'slide') : undefined}>
				<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>Jossue Alcalá · {es ? 'Guadalajara, México' : 'Guadalajara, Mexico'}</p>
				<h1 id="jx-hero-title" class="jx-hero__title">
					<span>{es ? 'Tiendas en línea y chatbots' : 'Online stores and chatbots'}</span>
					<span class="jx-soft">{es ? 'que venden y que tu equipo puede manejar.' : 'that sell, and that your team can run.'}</span>
				</h1>
				<p class="jx-hero__lede">
					{es
						? 'Dirijo las ventas en línea de WU Nutrition y Come Verde. Para otros negocios hago tiendas en Shopify, chatbots que contestan en tu sitio o en WhatsApp con la información real de tu negocio, y herramientas con IA. Te lo dejo listo para que tu equipo lo use sin depender de mí ni de una agencia.'
						: 'I lead online sales at WU Nutrition and Come Verde. For other businesses I build Shopify stores, chatbots that answer on your site or on WhatsApp with your real business information, and AI tools. I hand it over ready for your team to use without depending on me or an agency.'}
				</p>
				<div class="jx-actions">
					<a class="jx-btn jx-btn--primary" href={routes[locale].work}>{es ? 'Ver mis proyectos' : 'See my projects'}<Icon name="arrow-right" /></a>
					<a class="jx-btn jx-btn--ghost" href={`${routes[locale].products}chatbots/`}>{es ? 'Chatbots con IA' : 'AI chatbots'}</a>
				</div>
			</section>
			{AUDIT_ENABLED && (
				<section class="jx-hero jx-slide" data-slide="1" aria-labelledby="jx-hero-audit-title" aria-roledescription={es ? 'diapositiva' : 'slide'} aria-hidden="true" inert>
					<p class="jx-label"><span class="jx-dot jx-dot--live" aria-hidden="true"></span>{es ? 'Auditoría express · gratis' : 'Express audit · free'}</p>
					<h2 id="jx-hero-audit-title" class="jx-hero__title">
						<span>{es ? '¿Tu sitio pierde ventas?' : 'Is your site losing sales?'}</span>
						<span class="jx-soft">{es ? 'Revísalo gratis en 2 minutos.' : 'Check it for free in 2 minutes.'}</span>
					</h2>
					<p class="jx-hero__lede">
						{es
							? 'Mi asistente Jossue AI revisa la página principal de tu sitio como la ve un cliente desde su celular. Te da un puntaje de salud y las 3 cosas que más te conviene corregir, en un reporte que puedes descargar. Es gratis y se hace aquí en el chat.'
							: 'My assistant Jossue AI reviews your site’s home page the way a customer sees it on their phone. You get a health score and the 3 things most worth fixing, in a report you can download. It is free and happens right here in the chat.'}
					</p>
					<div class="jx-actions">
						<button class="jx-btn jx-btn--primary" type="button" data-ai-audit data-analytics-event="click_hero_audit">{es ? 'Revisar mi sitio gratis' : 'Check my site for free'}<Icon name="arrow-right" /></button>
						<a class="jx-btn jx-btn--ghost" href={`${routes[locale].booking}?origen=inicio`} data-analytics-event="click_hero_booking">{es ? 'Agendar una llamada de 10 min' : 'Book a 10-min call'}</a>
					</div>
				</section>
			)}
			<section class="jx-hero jx-slide jx-slide--madre" data-slide={madreSlide} aria-labelledby="jx-hero-madre-title" aria-roledescription={es ? 'diapositiva' : 'slide'} aria-hidden="true" inert>
				<p class="jx-label"><span class="jx-dot jx-dot--live" aria-hidden="true"></span>{es ? 'MADRE · gratis y de código abierto' : 'MADRE · free and open source'}</p>
				<h2 id="jx-hero-madre-title" class="jx-hero__title">
					<span>{es ? 'Programa con MADRE.' : 'Code with MADRE.'}</span>
					<span class="jx-soft">{es ? 'Tus IAs ya hablan entre sí.' : 'Your AIs finally talk to each other.'}</span>
				</h2>
				<p class="jx-hero__lede">
					{es
						? 'Codex, Claude Code, Gemini CLI y OpenCode en la misma conversación, con la memoria de tu proyecto. Ya no les pasas el contexto a mano. Corre gratis en tu computadora, en macOS y Linux, y Windows viene en camino.'
						: 'Codex, Claude Code, Gemini CLI and OpenCode in the same conversation, with your project’s memory. No more passing context around by hand. It runs free on your computer, on macOS and Linux, and Windows is on the way.'}
				</p>
				<div class="jx-actions">
					<a class="jx-btn jx-btn--primary" href={`${madreFacts.site}${es ? '' : 'en/'}#instalar`} rel="noopener" data-analytics-event="click_hero_madre_install">{es ? 'Instalar MADRE gratis' : 'Install MADRE for free'}<Icon name="arrow-up-right" /></a>
					<button class="jx-btn jx-btn--ghost" type="button" data-campaign-open data-analytics-event="click_hero_madre_video"><Icon name="play" />{es ? 'Ver el video · 40 s' : 'Watch the video · 40 s'}</button>
				</div>
			</section>
		</div>
		{(
			<div class="jx-slides__nav" role="group" aria-label={es ? 'Elegir diapositiva' : 'Choose slide'}>
				<button type="button" class="jx-slides__dot" data-slide-dot="0" aria-current="true" aria-label={es ? 'Tiendas en línea y chatbots' : 'Online stores and chatbots'}></button>
				{AUDIT_ENABLED && <button type="button" class="jx-slides__dot" data-slide-dot="1" aria-current="false" aria-label={es ? 'Auditoría express' : 'Express audit'}></button>}
				<button type="button" class="jx-slides__dot" data-slide-dot={madreSlide} aria-current="false" aria-label={es ? 'Programa con MADRE' : 'Code with MADRE'}></button>
				<button type="button" class="jx-slides__pause" data-slide-pause aria-pressed="false" aria-label={es ? 'Pausar el cambio automático' : 'Pause autoplay'} data-label-pause={es ? 'Pausar el cambio automático' : 'Pause autoplay'} data-label-play={es ? 'Reanudar el cambio automático' : 'Resume autoplay'}>
					<svg class="jx-slides__icon-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9M11 3.5v9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
					<svg class="jx-slides__icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5 12.5 8 5 12.5Z" fill="currentColor" /></svg>
				</button>
			</div>
		)}
		</div>
		<div class="jx-hero jx-hero--foot">
			<dl class="jx-facts">
				{facts.map(([value, text]) => (
					<div><dt>{value}</dt><dd>{text}</dd></div>
				))}
			</dl>
			<div class="jx-hero__brands" data-home="brands">
				<p class="jx-mono">{es ? 'Marcas con las que he trabajado' : 'Brands I have worked with'}</p>
				<BrandLogos locale={locale} variant="marquee" />
			</div>
		</div>
	</div>

	<dialog class="jx-campaign" data-campaign-dialog aria-label={es ? 'Video: Programa con MADRE' : 'Video: Code with MADRE'}>
		<button class="jx-campaign__close" type="button" data-campaign-close aria-label={es ? 'Cerrar el video' : 'Close the video'}>×</button>
		<video controls playsinline preload="none" poster={`${campaign}-poster.jpg`} data-campaign-video>
			<source src={`${campaign}-mobile.webm`} type="video/webm" media="(max-width: 40em)" />
			<source src={`${campaign}-mobile.mp4`} type="video/mp4" media="(max-width: 40em)" />
			<source src={`${campaign}.webm`} type="video/webm" />
			<source src={`${campaign}.mp4`} type="video/mp4" />
		</video>
		<p class="jx-campaign__note">{es ? 'Con música. Las pantallas son de MADRE 0.6.0 real; las escenas de vida son de Pexels.' : 'With music. The screens are from the real MADRE 0.6.0; the lifestyle shots are from Pexels.'}</p>
	</dialog>

	<AiDevSpotlight locale={locale} />

	<section id="madre" class="jx-star" data-home="madre" aria-labelledby="jx-madre-title">
		<div class="jx-wrap">
			<p class="jx-label jx-label--madre"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Mi producto principal · Gratis' : 'My main product · Free'}</p>
			<h2 class="jx-wordmark" data-home="madre-wordmark" aria-label="MADRE">
				<svg class="jx-pulse" viewBox="0 0 48 16" aria-hidden="true" focusable="false"><path d="M1 8h10l3-6 5 12 4-9 2 3h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" /><circle cx="43.5" cy="8" r="2.6" fill="currentColor" /></svg>
				<span aria-hidden="true">MADRE</span>
			</h2>
			<p id="jx-madre-title" class="jx-star__title">
				<span>{es ? 'Tus IAs ya hablan entre sí' : 'Your AIs finally talk to each other'}</span>
				<span class="jx-soft">{es ? 'y todas recuerdan tu proyecto.' : 'and all of them remember your project.'}</span>
			</p>
			<p class="jx-star__lede">{madre.summary[locale]}</p>

			{madreDemo && <DemoVideo demo={madreDemo} locale={locale} class="jx-player" />}

			<ul class="jx-points">
				{madrePoints.map(([icon, title, text]) => (
					<li><Icon name={icon} size="md" /><strong>{title}</strong><span>{text}</span></li>
				))}
			</ul>

			<div class="jx-actions jx-actions--center">
				<a class="jx-btn jx-btn--madre" href={MADRE_RUN} rel="noopener" data-analytics-event="click_madre_install">{es ? 'Instalar MADRE' : 'Install MADRE'}<Icon name="arrow-up-right" /></a>
				<a class="jx-btn jx-btn--ghost" href={productHref(madre, locale)}>{es ? 'Cómo funciona' : 'How it works'}</a>
			</div>
			<div class="jx-command">
				<code><span aria-hidden="true">$</span> npx @jossuealcala/madre start</code>
				<button type="button" class="jx-command__copy" data-copy="npx @jossuealcala/madre start" data-copied={es ? 'Copiado' : 'Copied'}>{es ? 'Copiar' : 'Copy'}</button>
			</div>
		</div>
	</section>

	<section id="destacados" class="jx-featured" data-home="featured" aria-labelledby="jx-featured-title">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Otros productos míos' : 'More of my products'}</p>
			<h2 id="jx-featured-title" class="jx-h2"><span>{es ? 'También construí' : 'I also built'}</span> <span class="jx-soft">{es ? 'AHP+, Bloqio Builder, Daniela y Miawseo.' : 'AHP+, Bloqio Builder, Daniela and Miawseo.'}</span></h2>
			<div class="jx-featured__grid">
				{alsoFeatured.map((product) => {
					const demo = productDemo(product, locale);
					const link = outside[product.slug];
					return (
						<article class="jx-feature" data-home-featured={product.slug}>
							{demo && <DemoVideo demo={demo} locale={locale} orientation="wide" />}
							<div class="jx-feature__body">
								<p class="jx-mono">{product.status?.[locale] ?? product.category[locale]}</p>
								<h3 class="jx-feature__title">{product.title[locale]}</h3>
								<p class="jx-feature__promise">{product.promise[locale]}</p>
								<div class="jx-actions">
									<a class="jx-btn jx-btn--primary" href={productHref(product, locale)}>{es ? `Conocer ${product.title[locale]}` : `Meet ${product.title[locale]}`}<Icon name="arrow-right" /></a>
									{link && <a class="jx-btn jx-btn--ghost" href={link.href} rel="noopener">{link.label}<Icon name="arrow-up-right" /></a>}
								</div>
							</div>
						</article>
					);
				})}
			</div>
		</div>
	</section>

	<section id="showcase" class="jx-showcase" data-home="showcase" aria-labelledby="jx-showcase-title">
		<div class="jx-wrap">
			<p class="jx-label jx-label--madre"><span class="jx-dot" aria-hidden="true"></span>Videos</p>
			<h2 id="jx-showcase-title" class="jx-h2"><span>{es ? 'Mira a MADRE trabajando.' : 'Watch MADRE at work.'}</span> <span class="jx-soft">{es ? 'Grabado en una computadora con MADRE instalada.' : 'Recorded on a computer with MADRE installed.'}</span></h2>
			<div class="jx-showcase__grid">
				{showcase.map((item) => (
					<article class:list={['jx-clip', `jx-clip--${item.key}`]}>
						<DemoVideo
							demo={{ wide: item.src.replace(/\.mp4$/, ''), tall: item.src.replace(/\.mp4$/, ''), label: item.label, alt: `${item.label}. ${item.title}` }}
							locale={locale}
							orientation="wide"
							class="jx-clip__video"
						/>
						<div class="jx-clip__caption">
							<p class="jx-mono">{item.label}</p>
							<h3>{item.title}</h3>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="productos" class="jx-band" aria-labelledby="jx-products-title">
		<div class="jx-wrap">
			<div class="jx-head">
				<div>
					<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Servicios y otros productos' : 'Services and other products'}</p>
					<h2 id="jx-products-title" class="jx-h2"><span>{es ? 'También hago tiendas en línea, páginas web' : 'I also make online stores, websites'}</span> <span class="jx-soft">{es ? 'y herramientas para tu negocio.' : 'and tools for your business.'}</span></h2>
				</div>
				<a class="jx-link" href={routes[locale].products}>{es ? 'Ver todos' : 'See all'}<Icon name="arrow-right" /></a>
			</div>
			<ol class="jx-rows" data-home="products">
				{others.map((product) => (
					<li>
						<a href={productHref(product, locale)}>
							<Icon name={productIcons[product.slug] ?? 'cube'} size="md" />
							<strong>{product.title[locale]}</strong>
							<span>{product.promise[locale]}</span>
							<Icon name="arrow-right" class="jx-rows__go" />
						</a>
					</li>
				))}
			</ol>
		</div>
	</section>

	<ConsultingSection locale={locale} />

	{AUDIT_ENABLED && <AuditCta locale={locale} />}

	<section id="casos" class="jx-work" aria-labelledby="jx-work-title">
		<div class="jx-wrap">
			<div class="jx-head">
				<div>
					<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Trabajo' : 'Work'}</p>
					<h2 id="jx-work-title" class="jx-h2"><span>{es ? 'Proyectos en los que' : 'Projects I have'}</span> <span class="jx-soft">{es ? 'he trabajado.' : 'worked on.'}</span></h2>
				</div>
				<a class="jx-link" href={routes[locale].work}>{es ? 'Ver los 9 proyectos' : 'See all 9 projects'}<Icon name="arrow-right" /></a>
			</div>
			<div class="jx-cases">
				{selected.map((entry, index) => {
					const p = casePresentation(entry.data.slug, locale);
					const brand = brandForCaseSlug(entry.data.slug);
					const cover = caseCover(entry.data.slug);
					return (
						<a class="jx-case" data-home-case href={`${routes[locale].work}${entry.data.slug}/`}>
							{cover && <span class="jx-case__shot"><img src={cover} alt="" width="1600" height="1000" loading="lazy" decoding="async" /></span>}
							{brand && <img class="jx-case__logo" src={brand.mono ?? brand.src} alt={brand.name[locale]} width={brand.width} height={brand.height} loading="lazy" decoding="async" style={`--logo-h:${brand.stripHeight}rem`} />}
							<span class="jx-mono">{String(index + 1).padStart(2, '0')} · {p?.category ?? entry.data.client}</span>
							<strong>{entry.data.title}</strong>
							<p>{p?.summary ?? entry.data.summary}</p>
							<span class="jx-link">{es ? 'Ver el caso' : 'Read the case'}<Icon name="arrow-right" /></span>
						</a>
					);
				})}
			</div>
		</div>
