<script>
	document.querySelectorAll<HTMLButtonElement>('.jx-command__copy').forEach((button) => {
		const label = button.textContent;
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy ?? '');
				button.textContent = button.dataset.copied ?? label;
				window.setTimeout(() => (button.textContent = label), 1800);
			} catch {
				/* sin portapapeles: el comando sigue a la vista para copiarlo a mano */
			}
		});
	});
</script>

<script>
	// Slider del héroe: dos diapositivas (ecommerce e IA, auditoría express) que se turnan solas cada
	// 9 s, en bucle. Se detiene con el botón de pausa (WCAG 2.2.2), al navegar con teclado dentro, en una
	// pestaña oculta y con «reducir movimiento». En el teléfono también se desliza con el dedo.
	const root = document.querySelector<HTMLElement>('[data-hero-slides]');
	const slides = root ? [...root.querySelectorAll<HTMLElement>('[data-slide]')] : [];
	if (root && slides.length > 1) {
		const backgrounds = [...root.querySelectorAll<HTMLElement>('[data-slide-bg]')];
		const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-slide-dot]')];
		const pause = root.querySelector<HTMLButtonElement>('[data-slide-pause]');
		const EVERY = 9000;
		let index = 0;
		let timer = 0;
		let stopped = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let hold = false;
		root.style.setProperty('--slide-ms', `${EVERY}ms`);

		const schedule = () => {
			window.clearTimeout(timer);
			const running = !stopped && !hold && !document.hidden;
			root.classList.toggle('is-paused', !running);
			// Reinicia la barra de progreso del punto activo.
			root.classList.remove('is-running');
			void root.offsetWidth;
			if (running) {
				root.classList.add('is-running');
				timer = window.setTimeout(() => show(index + 1), EVERY);
			}
		};
		const show = (next: number) => {
			index = (next + slides.length) % slides.length;
			slides.forEach((slide, i) => {
				const on = i === index;
				slide.classList.toggle('is-active', on);
				slide.toggleAttribute('inert', !on);
				slide.setAttribute('aria-hidden', String(!on));
			});
			backgrounds.forEach((bg, i) => bg.classList.toggle('is-active', i === index));
			dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
			document.dispatchEvent(new CustomEvent('jx-loops-refresh'));
			schedule();
		};

		dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
		pause?.addEventListener('click', () => {
			stopped = !stopped;
			pause.setAttribute('aria-pressed', String(stopped));
			pause.setAttribute('aria-label', (stopped ? pause.dataset.labelPlay : pause.dataset.labelPause) ?? '');
			schedule();
		});
		const track = root.querySelector<HTMLElement>('.jx-slides__track');
		// Solo el teclado detiene el cambio: el cursor casi siempre está sobre un héroe así de grande.
		root.addEventListener('focusin', (event) => {
			if (!(event.target as HTMLElement).matches(':focus-visible')) return;
			hold = true;
			schedule();
		});
		root.addEventListener('focusout', (event) => {
			if (root.contains(event.relatedTarget as Node | null) && (event.relatedTarget as HTMLElement).matches(':focus-visible')) return;
			hold = false;
			schedule();
		});
		document.addEventListener('visibilitychange', schedule);
		let startX: number | null = null;
		track?.addEventListener('pointerdown', (event) => {
			if (event.pointerType !== 'mouse') startX = event.clientX;
		});
		track?.addEventListener('pointerup', (event) => {
			if (startX === null) return;
			const dx = event.clientX - startX;
			startX = null;
			if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
		});
		schedule();
	}
</script>

<script>
	// Video de campaña de MADRE en una ventana: se descarga solo al abrirla y se pausa al cerrarla.
	const dialog = document.querySelector<HTMLDialogElement>('[data-campaign-dialog]');
	const video = dialog?.querySelector<HTMLVideoElement>('[data-campaign-video]');
	if (dialog && video) {
		document.querySelectorAll<HTMLElement>('[data-campaign-open]').forEach((button) =>
			button.addEventListener('click', () => {
				dialog.showModal();
				video.play().catch(() => {});
			}),
		);
		const shut = () => {
			video.pause();
			dialog.close();
		};
		dialog.querySelector('[data-campaign-close]')?.addEventListener('click', shut);
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) shut();
		});
		dialog.addEventListener('close', () => video.pause()); // también con Esc
	}
</script>
