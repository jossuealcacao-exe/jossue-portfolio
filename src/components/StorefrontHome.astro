---
import type { CollectionEntry } from 'astro:content';
import { routes, type Locale } from '../data/i18n';
import { commercialProducts, productHref } from '../data/products';
import { profileCopy } from '../data/profile';
import FlagshipHeroCarousel from './FlagshipHeroCarousel.astro';
import Icon from './Icon.astro';
import MediaSlot from './surface/MediaSlot.astro';
import Stage from './surface/Stage.astro';

interface Props {
	locale: Locale;
	cases: CollectionEntry<'cases'>[];
}

const { locale, cases } = Astro.props;
const es = locale === 'es';
const about = profileCopy(locale);
const madre = commercialProducts.find((product) => product.slug === 'madre');
if (!madre) throw new Error('MADRE product is required');
const secondaryProducts = commercialProducts.filter((product) => product.slug !== 'madre');

const caseSlots = [
	{ key: 'wu-nutrition', label: 'WU', ratio: '16:9' as const, kind: es ? 'Ecommerce · IA' : 'Ecommerce · AI' },
	{ key: 'come-verde', label: 'COME VERDE', ratio: '4:5' as const, kind: es ? 'Producto · Growth' : 'Product · Growth' },
	{ key: 'hp', label: 'HP', ratio: '3:2' as const, kind: es ? 'Experiencia · Ecommerce' : 'Experience · Ecommerce' },
	{ key: 'tdi', label: 'TDI', ratio: '4:5' as const, kind: es ? 'Experiencia · Digital' : 'Experience · Digital' },
].map((item) => ({ ...item, entry: cases.find((entry) => entry.data.slug === item.key) }));

const method = es
	? [
			['01', 'Entender', 'El problema, el negocio y la decisión que importa.'],
			['02', 'Diseñar', 'Una dirección clara antes de multiplicar pantallas.'],
			['03', 'Construir', 'Producto, web e IA llevados a una entrega operable.'],
			['04', 'Comprobar', 'QA, evidencia y control humano antes de darlo por hecho.'],
		]
	: [
			['01', 'Understand', 'The problem, the business, and the decision that matters.'],
			['02', 'Design', 'A clear direction before multiplying screens.'],
			['03', 'Build', 'Product, web, and AI brought into an operable delivery.'],
			['04', 'Verify', 'QA, evidence, and human control before calling it done.'],
		];
---

<article class="home-surface" data-storefront-home>
	<FlagshipHeroCarousel locale={locale} />

	<Stage id="madre" size="loose" class="madre-feature">
		<div class="madre-feature__heading">
			<div>
				<p class="stage__eyebrow">01 · {es ? 'Producto destacado' : 'Featured product'}</p>
				<h2 class="madre-feature__wordmark">MADRE</h2>
			</div>
			<div class="madre-feature__summary">
				<h3>{madre.promise[locale]}</h3>
				<p>{madre.summary[locale]}</p>
				<a class="pill" href={productHref(madre, locale)}>{es ? 'Explorar MADRE' : 'Explore MADRE'}<Icon name="arrow-right" /></a>
			</div>
		</div>
		<MediaSlot
			id="home-madre"
			ratio="21:9"
			variant="bleed"
			label={es ? 'Producto / MADRE · landing en desarrollo' : 'Product / MADRE · landing in development'}
			note={es ? 'Imagen editorial del producto. No es la identidad de la tienda.' : 'Editorial product image. It is not the store identity.'}
		/>
	</Stage>

	<Stage tone="ink" size="loose" class="product-index" id="productos">
		<div class="product-index__head">
			<p class="stage__eyebrow">02 · {es ? 'Más productos y servicios' : 'More products and services'}</p>
			<a class="pill pill--ghost" href={routes[locale].products}>{es ? 'Ver todos' : 'View all'}<Icon name="arrow-right" /></a>
		</div>
		<ol class="product-index__list" aria-label={es ? 'Malla de productos y servicios' : 'Product and service mesh'}>
			{secondaryProducts.map((product, index) => (
				<li class:list={['product-index__item', `product-index__item--${index + 1}`]}>
					<a href={productHref(product, locale)}>
						<MediaSlot
							id={`home-product-${product.slug}`}
							ratio={index === 0 ? '16:9' : index === 3 ? '21:9' : '1:1'}
							variant="soft"
							label={`${product.title[locale]} · ${es ? 'imagen pendiente' : 'image pending'}`}
						/>
						<div class="product-index__body">
							<span>{String(index + 2).padStart(2, '0')}</span>
							<strong>{product.title[locale]}</strong>
							<p>{product.promise[locale]}</p>
							<Icon name="arrow-right" />
						</div>
					</a>
				</li>
			))}
		</ol>
	</Stage>

	<Stage id="casos" size="loose" class="case-filmstrip">
		<div class="case-filmstrip__head">
			<div>
				<p class="stage__eyebrow">03 · {es ? 'Casos y experiencia' : 'Cases and experience'}</p>
				<h2 class="stage__title">{es ? 'Trabajo con contexto real.' : 'Work grounded in real context.'}</h2>
			</div>
			<a class="pill pill--ghost" href={routes[locale].work}>{es ? 'Ver casos' : 'View cases'}<Icon name="arrow-right" /></a>
		</div>
		<div class="case-filmstrip__grid">
			{caseSlots.map((item, index) => {
				const content = (
					<>
						<MediaSlot
							id={`home-case-${item.key}`}
							ratio={item.ratio}
							variant="soft"
							label={`${es ? 'Caso' : 'Case'} / ${item.label}`}
							note={es ? 'Imagen del caso pendiente de dirección de arte.' : 'Case image awaiting art direction.'}
						/>
						<span>{String(index + 1).padStart(2, '0')}</span>
						<strong>{item.label}</strong>
						<small>{item.kind}</small>
					</>
				);
				return item.entry ? (
					<a class="case-filmstrip__item" href={`${routes[locale].work}${item.entry.data.slug}/`}>{content}</a>
				) : (
					<article class="case-filmstrip__item">{content}</article>
				);
			})}
		</div>
	</Stage>

	<Stage tone="ink" size="loose" class="method-chapter" id="metodo">
		<div class="method-chapter__heading">
			<p class="stage__eyebrow">04 · {es ? 'Forma de trabajar' : 'Way of working'}</p>
			<h2 class="stage__title">{es ? 'Menos ceremonia. Más claridad.' : 'Less ceremony. More clarity.'}</h2>
		</div>
		<ol class="method-chapter__list">
			{method.map(([number, title, text]) => (
				<li><span>{number}</span><strong>{title}</strong><p>{text}</p></li>
			))}
		</ol>
	</Stage>

	<Stage size="loose" class="trajectory-chapter" id="trayectoria">
		<MediaSlot
			id="home-portrait"
			ratio="4:5"
			variant="soft"
			label={es ? 'Retrato editorial · por producir' : 'Editorial portrait · to be produced'}
			note={es ? 'Retrato sobrio y directo; sin estética corporativa genérica.' : 'Restrained, direct portrait; no generic corporate aesthetic.'}
		/>
		<div>
			<p class="stage__eyebrow">05 · {es ? 'Trayectoria verificable' : 'Verifiable track record'}</p>
			<h2 class="stage__title">{es ? 'Dirección comercial con capacidad de construir.' : 'Commercial direction with the ability to build.'}</h2>
			<p class="stage__lede">{about.summary}</p>
			<div class="stage__actions">
				<a class="pill" href={routes[locale].about}>{es ? 'Ver trayectoria' : 'View track record'}<Icon name="arrow-right" /></a>
				<a class="pill pill--ghost" href={routes[locale].contact}>{es ? 'Contacto' : 'Contact'}</a>
			</div>
		</div>
	</Stage>

	<Stage tone="ink" size="loose" class="closing-chapter">
		<p class="stage__eyebrow">{es ? 'Siguiente paso' : 'Next step'}</p>
		<h2 class="stage__title">{es ? 'Construyamos algo que merezca existir.' : 'Let’s build something worth existing.'}</h2>
		<a class="pill pill--soft" href={routes[locale].contact} data-analytics-event="click_contact">
			{es ? 'Iniciar conversación' : 'Start a conversation'}
			<Icon name="arrow-right" />
		</a>
	</Stage>
</article>
