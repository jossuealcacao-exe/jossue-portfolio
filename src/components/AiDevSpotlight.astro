---
// IA aplicada: los cuatro productos con IA que ya funcionan, agrupados por para quién trabajan
// (dos atienden clientes, dos me ayudan a programar). Se usa en el home y en la página de IA.
import { routes, type Locale } from '../data/i18n';
import Icon, { type IconName } from './Icon.astro';

interface Props {
	locale: Locale;
	showPageLink?: boolean;
}

const { locale, showPageLink = true } = Astro.props;
const es = locale === 'es';
type Item = { icon: IconName; title: string; tag: string; text: string; href: string };
const groups: Array<{ title: string; items: Item[] }> = es
	? [
			{
				title: 'Atienden a clientes',
				items: [
					{ icon: 'chat', title: 'Daniela', tag: 'En wunutrition.com', text: 'Atiende a los clientes de la tienda en línea de WU Nutrition. Recomienda productos del catálogo real, arma el carrito y revisa cómo va un pedido.', href: `${routes.es.products}daniela/` },
					{ icon: 'sparkles-ai', title: 'Jossue AI', tag: 'En este sitio', text: 'Te contesta lo que quieras saber de mi trabajo y me pasa tu mensaje. Puedes probarlo ahora.', href: '#' },
				],
			},
			{
				title: 'Me ayudan a programar',
				items: [
					{ icon: 'terminal', title: 'MADRE', tag: 'Versión 0.5.2', text: 'Una app donde cuatro asistentes de IA programan en el mismo proyecto sin estorbarse. Recuerda lo que se decidió y no cambia nada sin tu permiso.', href: routes.es.madre },
					{ icon: 'layers', title: 'AHP+', tag: 'Versión 1.4.1', text: 'Unas reglas abiertas (un protocolo) para que un asistente de IA siga el trabajo donde otro lo dejó, en cualquier computadora.', href: routes.es.ahpAtlas },
				],
			},
		]
	: [
			{
				title: 'They serve customers',
				items: [
					{ icon: 'chat', title: 'Daniela', tag: 'On wunutrition.com', text: 'Serves customers in the WU Nutrition online store. It recommends products from the real catalog, builds the cart and checks how an order is going.', href: `${routes.en.products}daniela/` },
					{ icon: 'sparkles-ai', title: 'Jossue AI', tag: 'On this site', text: 'Answers whatever you want to know about my work and passes your message on to me. You can try it now.', href: '#' },
				],
			},
			{
				title: 'They help me build',
				items: [
					{ icon: 'terminal', title: 'MADRE', tag: 'Version 0.5.2', text: 'An app where four AI assistants code on the same project without getting in each other’s way. It remembers what was decided and changes nothing without your permission.', href: routes.en.madre },
					{ icon: 'layers', title: 'AHP+', tag: 'Version 1.4.1', text: 'A set of open rules (a protocol) so one AI assistant can pick up the work where another left it, on any computer.', href: routes.en.ahpAtlas },
				],
			},
		];
const headingId = `ai-dev-${showPageLink ? 'home' : 'page'}`;
---

<section class="jx-spot" data-home="ai-dev" aria-labelledby={headingId}>
	<div class="jx-wrap jx-spot__inner">
		<div class="jx-spot__copy">
			<p class="jx-label"><span class="jx-dot jx-dot--live" aria-hidden="true"></span>{es ? 'Inteligencia artificial · ya en uso' : 'Artificial intelligence · already in use'}</p>
			<h2 id={headingId} class="jx-h2">
				<span>{es ? 'Hago herramientas con IA' : 'I build AI tools,'}</span>{' '}
				<span class="jx-soft">{es ? 'y cuatro ya están en uso.' : 'and four are already in use.'}</span>
			</h2>
			<p class="jx-spot__lede">
				{es
					? 'Además de llevar ventas en línea, programo herramientas con IA. Yo decido qué información usan, qué pueden hacer y cómo se ven, y las pruebo antes de ponerlas a trabajar. Dos atienden a clientes y dos me ayudan a programar más rápido.'
					: 'Besides running online sales, I build AI tools. I decide what information they use, what they can do and how they look, and I test them before putting them to work. Two serve customers and two help me code faster.'}
			</p>
			<div class="jx-actions">
				{showPageLink && <a class="jx-btn jx-btn--primary" href={routes[locale].ai}>{es ? 'Ver mis herramientas con IA' : 'See my AI tools'}<Icon name="arrow-right" /></a>}
				<a class:list={['jx-btn', showPageLink ? 'jx-btn--ghost' : 'jx-btn--primary']} href={`${routes[locale].products}chatbots/`}>{es ? 'Chatbots para tu negocio' : 'Chatbots for your business'}{!showPageLink && <Icon name="arrow-right" />}</a>
			</div>
		</div>
		<div class="jx-spot__groups">
			{groups.map((group) => (
				<div class="jx-spot__group">
					<p class="jx-spot__group-title jx-mono">{group.title}</p>
					<ul class="jx-spot__list">
						{group.items.map((item) => (
							<li>
								<a href={item.href} data-ai-open={item.href === '#' ? '' : undefined}>
									<Icon name={item.icon} size="md" />
									<span>
										<strong>{item.title}<small>{item.tag}</small></strong>
										<span>{item.text}</span>
									</span>
									<Icon name="arrow-right" class="jx-spot__go" />
								</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</div>
</section>
