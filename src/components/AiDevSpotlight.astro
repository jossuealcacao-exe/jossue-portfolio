---
// IA aplicada: los cuatro productos con IA que ya funcionan, agrupados por para quién trabajan
// (dos atienden clientes, dos me ayudan a programar). Se usa en el home y en la página de IA.
import { routes, type Locale } from '../data/i18n';
import Icon, { type IconName } from './Icon.astro';

interface Props {
	locale: Locale;
	showPageLink?: boolean;
}

const { locale, showPageLink = true } = Astro.props;
const es = locale === 'es';
type Item = { icon: IconName; title: string; tag: string; text: string; href: string };
const groups: Array<{ title: string; items: Item[] }> = es
	? [
			{
				title: 'Atienden clientes',
				items: [
					{ icon: 'chat', title: 'Daniela', tag: 'En wunutrition.com', text: 'Atiende a los clientes de la tienda con el catálogo real: recomienda, arma el carrito y consulta pedidos.', href: `${routes.es.products}daniela/` },
					{ icon: 'sparkles-ai', title: 'Jossue AI', tag: 'En este sitio', text: 'Contesta por mí lo que quieras saber de mi trabajo y me deja tu mensaje. Pruébalo.', href: '#' },
				],
			},
			{
				title: 'Me ayudan a programar',
				items: [
					{ icon: 'terminal', title: 'MADRE', tag: 'Versión 0.5.2', text: 'Una app donde cuatro asistentes de código trabajan en el mismo proyecto sin pisarse, con permisos y memoria compartida.', href: routes.es.madre },
					{ icon: 'layers', title: 'AHP+', tag: 'Versión 1.4.1', text: 'Un protocolo abierto para que un asistente retome el trabajo donde otro lo dejó, en cualquier computadora.', href: routes.es.ahpAtlas },
				],
			},
		]
	: [
			{
				title: 'They serve customers',
				items: [
					{ icon: 'chat', title: 'Daniela', tag: 'On wunutrition.com', text: 'Serves the store’s customers with the real catalog: recommends, builds the cart and checks orders.', href: `${routes.en.products}daniela/` },
					{ icon: 'sparkles-ai', title: 'Jossue AI', tag: 'On this site', text: 'Answers for me whatever you want to know about my work and passes your message on. Try it.', href: '#' },
				],
			},
			{
				title: 'They help me build',
				items: [
					{ icon: 'terminal', title: 'MADRE', tag: 'Version 0.5.2', text: 'An app where four coding assistants work on the same project without stepping on each other, with permissions and shared memory.', href: routes.en.madre },
					{ icon: 'layers', title: 'AHP+', tag: 'Version 1.4.1', text: 'An open protocol so one assistant picks up the work where another left it, on any computer.', href: routes.en.ahpAtlas },
				],
			},
		];
const headingId = `ai-dev-${showPageLink ? 'home' : 'page'}`;
---

<section class="jx-spot" data-home="ai-dev" aria-labelledby={headingId}>
	<div class="jx-wrap jx-spot__inner">
		<div class="jx-spot__copy">
			<p class="jx-label"><span class="jx-dot jx-dot--live" aria-hidden="true"></span>{es ? 'IA aplicada · en uso hoy' : 'Applied AI · live today'}</p>
			<h2 id={headingId} class="jx-h2">
				<span>{es ? 'Construyo productos con IA,' : 'I build AI products,'}</span>{' '}
				<span class="jx-soft">{es ? 'y cuatro ya están funcionando.' : 'and four are already running.'}</span>
			</h2>
			<p class="jx-spot__lede">
				{es
					? 'Además de dirigir ecommerce, diseño y programo IA de principio a fin: qué sabe, qué puede hacer, cómo se ve y cómo se prueba. Dos atienden clientes; dos me ayudan a programar más rápido y con orden.'
					: 'Besides leading ecommerce, I design and build AI end to end: what it knows, what it can do, how it looks and how it is tested. Two serve customers; two help me build faster and with order.'}
			</p>
			<div class="jx-actions">
				{showPageLink && <a class="jx-btn jx-btn--primary" href={routes[locale].ai}>{es ? 'Ver IA aplicada' : 'See applied AI'}<Icon name="arrow-right" /></a>}
				<a class:list={['jx-btn', showPageLink ? 'jx-btn--ghost' : 'jx-btn--primary']} href={`${routes[locale].products}chatbots/`}>{es ? 'Chatbots para tu negocio' : 'Chatbots for your business'}{!showPageLink && <Icon name="arrow-right" />}</a>
			</div>
		</div>
		<div class="jx-spot__groups">
			{groups.map((group) => (
				<div class="jx-spot__group">
					<p class="jx-spot__group-title jx-mono">{group.title}</p>
					<ul class="jx-spot__list">
						{group.items.map((item) => (
							<li>
								<a href={item.href} data-ai-open={item.href === '#' ? '' : undefined}>
									<Icon name={item.icon} size="md" />
									<span>
										<strong>{item.title}<small>{item.tag}</small></strong>
										<span>{item.text}</span>
									</span>
									<Icon name="arrow-right" class="jx-spot__go" />
								</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</div>
</section>
