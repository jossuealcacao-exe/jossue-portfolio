---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import profilePhoto from '../assets/profile.jpeg';
import { brandStrip } from '../data/brands';
import { contact, contactEndpoint } from '../data/contact';
import { routes, type Locale, type PageKey } from '../data/i18n';
import { homeOutcomes } from '../data/outcomes';
import { profile, profileCopy } from '../data/profile';
import BrandMark from './BrandMark.astro';
import CaseCard from './CaseCard.astro';
import ContactForm from './ContactForm.astro';
import HeroCarousel from './HeroCarousel.astro';
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import StackCarousel from './StackCarousel.astro';

interface Props {
	locale: Locale;
	pageKey: PageKey;
	cases: CollectionEntry<'cases'>[];
}

const { locale, pageKey, cases } = Astro.props;
const es = locale === 'es';
const about = profileCopy(locale);
const outcomes = homeOutcomes(locale);
const brands = brandStrip();
const cvHref = contact.cvEs;
const ownedSlugs = new Set(['bloqio-builder', 'bloqio-cro-apps']);
const groupFor = (entry: CollectionEntry<'cases'>) =>
	entry.data.positioning ?? (ownedSlugs.has(entry.data.slug) ? 'owned-product' : 'client-work');
const sortFeatured = (entries: CollectionEntry<'cases'>[]) =>
	[...entries].sort(
		(a, b) =>
			Number(b.data.publication.featured) - Number(a.data.publication.featured) ||
			a.data.title.localeCompare(b.data.title),
	);
const clientWork = sortFeatured(cases.filter((entry) => groupFor(entry) === 'client-work'));
const ownedProducts = sortFeatured(cases.filter((entry) => groupFor(entry) === 'owned-product'));
const concepts = sortFeatured(cases.filter((entry) => groupFor(entry) === 'concept'));
const selectedSlugs = ['ahp-plus', 'bloqio-builder', 'wu-nutrition', 'miawseo', 'vineria'];
const selectedCases = selectedSlugs.flatMap((slug) => {
	const entry = cases.find((item) => item.data.slug === slug);
	return entry ? [entry] : [];
});

const capabilities: Array<{ title: string; text: string; icon: IconName }> = es
	? [
			{ title: 'Shopify y producto', text: 'Storefronts, themes, apps y sistemas de contenido diseñados para que el equipo pueda operar y crecer.', icon: 'basket' },
			{ title: 'UX/CRO y growth', text: 'Experiencias de compra, priorización y adquisición conectadas con objetivos comerciales concretos.', icon: 'trend-up' },
			{ title: 'IA aplicada', text: 'Productos y automatizaciones que integran datos, interfaces y control humano dentro del flujo real.', icon: 'sparkles-ai' },
		]
	: [
			{ title: 'Shopify and product', text: 'Storefronts, themes, apps, and content systems designed for teams to operate and grow.', icon: 'basket' },
			{ title: 'UX/CRO and growth', text: 'Shopping experiences, prioritization, and acquisition connected to specific commercial goals.', icon: 'trend-up' },
			{ title: 'Applied AI', text: 'Products and automations integrating data, interfaces, and human control into real workflows.', icon: 'sparkles-ai' },
		];

const services = es
	? [
			['Shopify y desarrollo web', 'Themes, secciones, storefronts y componentes comerciales construidos alrededor del negocio.'],
			['Estrategia UX/CRO', 'Priorización de oportunidades en navegación, producto, confianza, carrito y compra móvil.'],
			['Optimización ecommerce', 'Mejoras de experiencia, performance y operación que el equipo puede implementar y mantener.'],
			['Analítica y growth', 'Medición, paid media y CRM conectados con la experiencia que recibe el usuario.'],
			['IA aplicada y automatización', 'Copilotos, agentes y flujos con datos, permisos y decisiones humanas.'],
			['Apps y sistemas Shopify', 'Productos propios cuando una necesidad comercial requiere más que una app genérica.'],
		]
	: [
			['Shopify and web development', 'Themes, sections, storefronts, and commercial components built around the business.'],
			['UX/CRO strategy', 'Opportunity prioritization across navigation, product, trust, cart, and mobile purchase.'],
			['Ecommerce optimization', 'Experience, performance, and operational improvements teams can implement and maintain.'],
			['Analytics and growth', 'Measurement, paid media, and CRM connected to the experience users actually receive.'],
			['Applied AI and automation', 'Copilots, agents, and workflows with data, permissions, and human decisions.'],
			['Shopify apps and systems', 'Owned products when a commercial need requires more than a generic app.'],
		];

const aiSystems = es
	? [
			['IA en producto', 'Asistentes que entienden contexto, proponen acciones y mantienen visible el control del usuario.'],
			['Desarrollo asistido', 'Agentes integrados en un proceso de alcance, implementación, revisión y documentación.'],
			['Sistemas de operación', 'Copilotos sobre Shopify, Odoo, CRM, analítica y medios para apoyar decisiones recurrentes.'],
			['Inteligencia de growth', 'Scorecards, síntesis y automatizaciones para convertir datos dispersos en prioridades.'],
		]
	: [
			['AI in products', 'Assistants that understand context, propose actions, and keep user control visible.'],
			['Assisted development', 'Agents integrated into a process for scoping, implementation, review, and documentation.'],
			['Operating systems', 'Copilots over Shopify, Odoo, CRM, analytics, and media supporting recurring decisions.'],
			['Growth intelligence', 'Scorecards, synthesis, and automation turning fragmented data into priorities.'],
	];

const opportunitySignals: Array<{ label: string; detail: string; value: number; icon: IconName; metric: string }> = es
	? [
			{ label: 'Storefront lento', detail: 'Riesgo: sesiones pagadas llegan a una experiencia que no sostiene intención móvil.', value: 86, icon: 'exclamation', metric: 'CR en riesgo' },
			{ label: 'Cart drawer incompleto', detail: 'Riesgo: valor, envío, cantidad o confianza no están visibles cuando el usuario decide.', value: 78, icon: 'basket', metric: 'Ticket sin capturar' },
			{ label: 'UX sin evidencia', detail: 'Riesgo: rediseñar sin separar fricción real, percepción interna y prioridad comercial.', value: 72, icon: 'filter', metric: 'Prioridad borrosa' },
			{ label: 'IA sin operación', detail: 'Riesgo: automatizar tareas sin datos, permisos, revisión humana ni medición útil.', value: 68, icon: 'sparkles-ai', metric: 'Horas no recuperadas' },
		]
	: [
			{ label: 'Slow storefront', detail: 'Risk: paid sessions land on an experience that does not sustain mobile intent.', value: 86, icon: 'exclamation', metric: 'CR at risk' },
			{ label: 'Incomplete cart drawer', detail: 'Risk: value, shipping, quantity, or trust are missing when the user decides.', value: 78, icon: 'basket', metric: 'Uncaptured AOV' },
			{ label: 'UX without evidence', detail: 'Risk: redesigning without separating real friction, internal opinion, and commercial priority.', value: 72, icon: 'filter', metric: 'Blurred priority' },
			{ label: 'AI without operations', detail: 'Risk: automating tasks without data, permissions, human review, or useful measurement.', value: 68, icon: 'sparkles-ai', metric: 'Hours not recovered' },
		];

const decisionPath = es
	? ['Detectar fuga', 'Priorizar impacto', 'Prototipo medible', 'Implementar', 'QA y aprendizaje']
	: ['Detect leakage', 'Prioritize impact', 'Measurable prototype', 'Implement', 'QA and learning'];
---

{
	pageKey === 'home' && (
		<>
			<section class="hero home-hero">
				<HeroCarousel locale={locale} />
			</section>

			<section class="section shell selected-work" aria-labelledby="selected-work-title">
				<div class="section-heading">
					<p class="index">01 / {es ? 'Trabajo seleccionado' : 'Selected work'}</p>
					<div class="flow">
						<h2 id="selected-work-title">{es ? 'Productos y experiencias construidos para avanzar el negocio.' : 'Products and experiences built to move the business forward.'}</h2>
						<p>{es ? 'Estrategia, diseño y ejecución reunidos en una misma historia.' : 'Strategy, design, and execution brought together in one story.'}</p>
					</div>
				</div>
				<div class="project-grid">
					{selectedCases.map((entry, index) => <CaseCard entry={entry} index={index} locale={locale} />)}
				</div>
				<a class="link-with-icon section-link" href={routes[locale].work}>
					{es ? 'Ver todos los proyectos' : 'View all projects'}
					<Icon name="arrow-right" />
				</a>
			</section>

			<section class="section section-band section-band--soft">
				<div class="shell impact-layout">
					<div class="section-heading">
						<p class="index">02 / {es ? 'Impacto profesional' : 'Professional impact'}</p>
						<div class="flow">
							<h2>{es ? 'Experiencia comercial con profundidad técnica.' : 'Commercial experience with technical depth.'}</h2>
							<p>{es ? 'Más de ocho años trabajando entre growth, ecommerce, producto y ejecución digital.' : 'More than eight years working across growth, ecommerce, product, and digital delivery.'}</p>
						</div>
					</div>
					<ul class="outcomes-grid">
						{outcomes.map((outcome) => (
							<li>
								<p class="outcomes-grid__value">{outcome.value}</p>
								<p class="outcomes-grid__label">{outcome.label}</p>
								<p class="outcomes-grid__detail">{outcome.detail}</p>
							</li>
						))}
					</ul>
					<ul class="brand-strip" aria-label={es ? 'Marcas con las que he trabajado' : 'Brands I have worked with'}>
						{brands.map((brand) => <li><BrandMark brand={brand} locale={locale} size="md" decorative={false} /></li>)}
					</ul>
				</div>
			</section>

			<section class="section shell capabilities-section">
				<div class="section-heading">
					<p class="index">03 / {es ? 'Capacidades' : 'Capabilities'}</p>
					<div class="flow">
						<h2>{es ? 'Una visión completa, de la oportunidad a la operación.' : 'A complete view, from opportunity to operation.'}</h2>
						<p>{es ? 'El stack cambia. El criterio para elegir, priorizar y entregar permanece.' : 'The stack changes. The judgment to choose, prioritize, and deliver remains.'}</p>
					</div>
				</div>
				<div class="capability-grid">
					{capabilities.map((capability, index) => <article><span>0{index + 1}</span><Icon name={capability.icon} size="md" /><h3>{capability.title}</h3><p>{capability.text}</p></article>)}
				</div>
				<StackCarousel locale={locale} />
			</section>

			<section class="section shell opportunity-section" aria-labelledby="opportunity-title">
				<div class="section-heading">
					<p class="index">04 / {es ? 'Diagnóstico para decidir' : 'Diagnostic for decision'}</p>
					<div class="flow">
						<h2 id="opportunity-title">{es ? 'Si la tienda pierde intención, primero ubicamos dónde se fuga.' : 'If the store is losing intent, first we locate the leakage.'}</h2>
						<p>{es ? 'Detecto dónde se está perdiendo conversión, priorizo la mejora con mayor impacto y convierto el diagnóstico en acciones que tu equipo puede lanzar.' : 'I detect where conversion is leaking, prioritize the highest-impact improvement, and turn diagnosis into actions your team can launch.'}</p>
					</div>
				</div>
				<div class="opportunity-grid">
					<article class="signal-panel">
						<p class="eyebrow">{es ? 'Pain points frecuentes' : 'Common pain points'}</p>
						<ul class="signal-bars">
							{opportunitySignals.map((signal) => (
								<li style={`--signal:${signal.value}%`}>
									<Icon name={signal.icon} size="md" />
									<div>
										<strong>{signal.label}</strong>
										<span>{signal.detail}</span>
									</div>
									<i aria-hidden="true"><span /></i>
									<em>{signal.metric}</em>
								</li>
							))}
						</ul>
					</article>
					<article class="path-panel">
						<p class="eyebrow">{es ? 'Cuándo contactarme' : 'When to contact me'}</p>
						<ol class="decision-path">
							{decisionPath.map((label, index) => (
								<li>
									<span>{String(index + 1).padStart(2, '0')}</span>
									<strong>{label}</strong>
								</li>
							))}
						</ol>
						<a class="button" href={routes[locale].contact} data-analytics-event="click_contact">
							{es ? 'Auditar mi experiencia ecommerce' : 'Audit my ecommerce experience'}
						</a>
					</article>
				</div>
			</section>

			<section class="section shell profile-section">
				<div class="profile-intro">
					<figure class="profile-intro__photo">
						<Image src={profilePhoto} alt={es ? 'Retrato de Jossue Alcalá' : 'Portrait of Jossue Alcalá'} width={640} height={800} loading="lazy" decoding="async" />
					</figure>
					<div class="flow">
						<p class="index">05 / {es ? 'Perfil' : 'Profile'}</p>
						<h2>{es ? 'Estrategia de negocio con capacidad de construir.' : 'Business strategy with the ability to build.'}</h2>
						<p class="profile-headline">{about.headline}</p>
						<p>{es ? 'Trabajo entre dirección y ejecución para que las ideas no terminen en una presentación: se conviertan en una experiencia que el equipo pueda lanzar, medir y mejorar.' : 'I work between direction and delivery so ideas do not stop at a presentation: they become experiences teams can launch, measure, and improve.'}</p>
						<div class="hero__actions">
							<a class="button" href={routes[locale].about}>{es ? 'Conocer mi experiencia' : 'Explore my experience'}</a>
							<a class="button button--ghost" href={routes[locale].contact}>{es ? 'Iniciar conversación' : 'Start a conversation'}</a>
						</div>
					</div>
				</div>
			</section>
		</>
	)
}

{
	pageKey === 'work' && (
		<div class="page shell">
			<section class="hero work-hero">
				<div class="flow">
					<p class="eyebrow">{es ? 'Proyectos seleccionados' : 'Selected projects'}</p>
					<h1>{es ? 'Trabajo que une estrategia, producto y ejecución.' : 'Work that brings strategy, product, and execution together.'}</h1>
					<p class="hero__lede">{es ? 'Experiencias ecommerce, productos propios y conceptos diseñados para resolver necesidades reales con claridad.' : 'Ecommerce experiences, independent products, and concepts designed to solve real needs with clarity.'}</p>
				</div>
				<dl class="work-folio">
					<div><dt>{String(clientWork.length).padStart(2, '0')}</dt><dd>{es ? 'Marcas' : 'Brands'}</dd></div>
					<div><dt>{String(ownedProducts.length).padStart(2, '0')}</dt><dd>{es ? 'Productos' : 'Products'}</dd></div>
					<div><dt>{String(concepts.length).padStart(2, '0')}</dt><dd>{es ? 'Conceptos' : 'Concepts'}</dd></div>
				</dl>
			</section>
			{clientWork.length > 0 && (
				<section class="section work-group" aria-labelledby="client-work-title">
					<div class="section-heading"><p class="index">01 / {es ? 'Trabajo para marcas' : 'Work for brands'}</p><h2 id="client-work-title">{es ? 'Ecommerce y growth llevados a la operación.' : 'Ecommerce and growth brought into operation.'}</h2></div>
					<div class="project-grid">{clientWork.map((entry, index) => <CaseCard entry={entry} index={index} locale={locale} />)}</div>
				</section>
			)}
			{ownedProducts.length > 0 && (
				<section class="section work-group" aria-labelledby="owned-products-title">
					<div class="section-heading"><p class="index">02 / {es ? 'Productos independientes' : 'Independent products'}</p><h2 id="owned-products-title">{es ? 'Ideas convertidas en productos utilizables.' : 'Ideas turned into usable products.'}</h2></div>
					<div class="project-grid">{ownedProducts.map((entry, index) => <CaseCard entry={entry} index={index} locale={locale} />)}</div>
				</section>
			)}
			{concepts.length > 0 && (
				<section class="section work-group" aria-labelledby="concepts-title">
					<div class="section-heading"><p class="index">03 / {es ? 'Conceptos de producto' : 'Product concepts'}</p><h2 id="concepts-title">{es ? 'Exploraciones técnicas con intención comercial.' : 'Technical explorations with commercial intent.'}</h2></div>
					<div class="project-grid">{concepts.map((entry, index) => <CaseCard entry={entry} index={index} locale={locale} />)}</div>
				</section>
			)}
		</div>
	)
}

{
	pageKey === 'services' && (
		<div class="page shell">
			<section class="hero compact-hero">
				<p class="eyebrow">{es ? 'Servicios' : 'Services'}</p>
				<h1>{es ? 'De la oportunidad comercial a una solución que tu equipo puede operar.' : 'From commercial opportunity to a solution your team can operate.'}</h1>
				<p class="hero__lede">{es ? 'Defino prioridades, diseño la experiencia y participo en la implementación para conectar estrategia, tecnología y resultados.' : 'I define priorities, design the experience, and work through implementation to connect strategy, technology, and outcomes.'}</p>
				<a class="button" href={routes[locale].contact}>{es ? 'Contarme tu reto' : 'Tell me about your challenge'}</a>
			</section>
			<section class="section service-grid">
				{services.map(([title, text], index) => <article class="service-card"><span>{String(index + 1).padStart(2, '0')}</span><h2>{title}</h2><p>{text}</p>{index === 4 && <a class="link-with-icon" href={routes[locale].ai}>{es ? 'Ver IA aplicada' : 'Explore applied AI'}<Icon name="arrow-right" /></a>}</article>)}
			</section>
			<section class="section process-section">
				<div class="section-heading"><p class="index">{es ? 'Cómo trabajo' : 'How I work'}</p><h2>{es ? 'Un proceso simple para decisiones complejas.' : 'A simple process for complex decisions.'}</h2></div>
				<ol class="process-list">
					{(es ? ['Objetivo', 'Prioridad', 'Diseño', 'Implementación', 'Medición'] : ['Goal', 'Priority', 'Design', 'Implementation', 'Measurement']).map((item, index) => <li><span>0{index + 1}</span><strong>{item}</strong></li>)}
				</ol>
				<a class="button" href={routes[locale].contact}>{es ? 'Definir el siguiente paso' : 'Define the next step'}</a>
			</section>
		</div>
	)
}

{
	pageKey === 'ai' && (
		<div class="page shell">
			<section class="hero compact-hero">
				<p class="eyebrow">{es ? 'IA aplicada' : 'Applied AI'}</p>
				<h1>{es ? 'IA integrada a productos y operaciones ecommerce.' : 'AI integrated into ecommerce products and operations.'}</h1>
				<p class="hero__lede">{es ? 'Diseño asistentes, automatizaciones y sistemas que trabajan con contexto real, acciones claras y decisiones humanas.' : 'I design assistants, automations, and systems that work with real context, clear actions, and human decisions.'}</p>
			</section>
			<section class="section ai-grid">
				{aiSystems.map(([title, text], index) => <article><span>0{index + 1}</span><h2>{title}</h2><p>{text}</p></article>)}
			</section>
			<section class="section ai-principles">
				<div class="section-heading"><p class="index">{es ? 'Diseñada para operar' : 'Designed to operate'}</p><h2>{es ? 'La mejor IA no se siente como una capa añadida.' : 'The best AI does not feel like an added layer.'}</h2></div>
				<ul>
					<li>{es ? 'Parte de una necesidad concreta del usuario o del equipo.' : 'It starts from a specific user or team need.'}</li>
					<li>{es ? 'Convierte contexto en acciones comprensibles y reversibles.' : 'It turns context into understandable, reversible actions.'}</li>
					<li>{es ? 'Se integra con permisos, datos y decisiones del negocio.' : 'It integrates with business permissions, data, and decisions.'}</li>
				</ul>
				<a class="button" href={routes[locale].contact}>{es ? 'Explorar una oportunidad con IA' : 'Explore an AI opportunity'}</a>
			</section>
		</div>
	)
}

{
	pageKey === 'about' && (
		<div class="page shell">
			<section class="hero about-hero">
				<div class="flow">
					<p class="eyebrow">{es ? 'Perfil profesional' : 'Professional profile'}</p>
					<h1>{profile.name}</h1>
					<p class="profile-headline">{about.headline}</p>
					<p class="hero__lede">{es ? 'Más de ocho años conectando estrategia comercial, ecommerce, paid media, producto digital y ejecución técnica.' : 'More than eight years connecting commercial strategy, ecommerce, paid media, digital product, and technical delivery.'}</p>
					<div class="hero__actions">
						{cvHref && <a class="button link-with-icon" href={cvHref} download data-analytics-event="download_cv"><Icon name="download" />{es ? 'Descargar CV' : 'Download CV'}</a>}
						<a class="button button--ghost" href={routes[locale].contact}>{es ? 'Contacto' : 'Contact'}</a>
					</div>
				</div>
				<figure class="about-hero__portrait"><Image src={profilePhoto} alt={es ? 'Retrato de Jossue Alcalá' : 'Portrait of Jossue Alcalá'} width={640} height={800} loading="eager" decoding="async" /></figure>
			</section>
			<section class="section"><div class="section-heading"><p class="index">01 / {es ? 'Marcas' : 'Brands'}</p><h2>{es ? 'Experiencia en tecnología, retail, salud y consumo.' : 'Experience across technology, retail, health, and consumer brands.'}</h2></div><ul class="brand-strip">{brands.map((brand) => <li><BrandMark brand={brand} locale={locale} size="md" decorative={false} /></li>)}</ul></section>
			<section class="section"><div class="section-heading"><p class="index">02 / {es ? 'Impacto profesional' : 'Professional impact'}</p><h2>{es ? 'Resultados dentro de contextos comerciales reales.' : 'Outcomes inside real commercial contexts.'}</h2></div><ul class="kpi-grid">{about.kpis.map((kpi) => <li><p class="kpi-grid__value">{kpi.value}</p><p class="kpi-grid__label">{kpi.label}</p><p class="kpi-grid__detail">{kpi.detail}</p></li>)}</ul></section>
			<section class="section"><div class="section-heading"><p class="index">03 / {es ? 'Experiencia' : 'Experience'}</p><h2>{es ? 'Una trayectoria entre negocio, growth y producto.' : 'A career across business, growth, and product.'}</h2></div><ol class="profile-timeline">{about.experience.map((item) => <li><p class="profile-timeline__meta"><span>{item.period}</span><span>{item.org}</span></p><h2>{item.role}</h2><ul class="list">{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul></li>)}</ol></section>
			<section class="section about-capabilities"><div class="section-heading"><p class="index">04 / {es ? 'Capacidades' : 'Capabilities'}</p><h2>{es ? 'Dirección estratégica con capacidad técnica.' : 'Strategic direction with technical capability.'}</h2></div><div class="capability-grid">{capabilities.map((capability, index) => <article><span>0{index + 1}</span><Icon name={capability.icon} size="md" /><h3>{capability.title}</h3><p>{capability.text}</p></article>)}</div><StackCarousel locale={locale} /></section>
			<section class="section about-details"><div><p class="index">05 / {es ? 'Formación' : 'Education'}</p><ul class="list">{about.education.map((item) => <li>{item}</li>)}</ul></div><div><p class="index">06 / {es ? 'Idiomas y enlaces' : 'Languages and links'}</p><ul class="list">{about.languages.map((item) => <li>{item}</li>)}{about.links.map((link) => <li><a class="link-with-icon" href={link.href} rel="noreferrer" data-analytics-event={link.event}>{link.label}<Icon name="arrow-up-right" /></a></li>)}</ul></div></section>
		</div>
	)
}

{
	pageKey === 'contact' && (
		<div class="page shell contact-page">
			<section class="hero compact-hero contact-hero">
				<p class="eyebrow">{es ? 'Contacto' : 'Contact'}</p>
				<h1>{es ? 'Hablemos de lo que quieres construir, mejorar o lanzar.' : 'Let’s discuss what you want to build, improve, or launch.'}</h1>
				<p class="hero__lede">{es ? 'Comparte el contexto, la oportunidad y lo que necesitas mover. Te responderé con preguntas claras y un siguiente paso concreto.' : 'Share the context, the opportunity, and what needs to move. I will respond with clear questions and a concrete next step.'}</p>
			</section>
			<section class="section contact-layout">
				<div class="flow"><p class="index">{es ? 'Canales directos' : 'Direct channels'}</p><h2>{es ? 'Elige el canal que te resulte más cómodo.' : 'Choose the channel that works best for you.'}</h2></div>
				<ul class="contact-channels">
					{contact.email && <li><a href={`mailto:${contact.email}`} data-analytics-event="click_email"><Icon name="envelope" /><span><small>Email</small>{contact.email}</span><Icon name="arrow-up-right" /></a></li>}
					{contact.whatsapp && contact.phone && <li><a href={contact.whatsapp} rel="noreferrer" data-analytics-event="click_whatsapp"><Icon name="chat" /><span><small>WhatsApp</small>{contact.phone}</span><Icon name="arrow-up-right" /></a></li>}
					{contact.linkedin && <li><a href={contact.linkedin} rel="noreferrer" data-analytics-event="click_linkedin"><span><small>LinkedIn</small>Jossue Alcalá</span><Icon name="arrow-up-right" /></a></li>}
				</ul>
			</section>
			{contactEndpoint && <section class="section"><div class="section-heading"><p class="index">{es ? 'Cuéntame sobre el proyecto' : 'Tell me about the project'}</p><h2>{es ? 'Un poco de contexto es suficiente para empezar.' : 'A little context is enough to get started.'}</h2></div><ContactForm locale={locale} /></section>}
		</div>
	)
}
