---
import type { CollectionEntry } from 'astro:content';
import { brandStrip } from '../data/brands';
import { contact } from '../data/contact';
import { routes, type Locale, type PageKey } from '../data/i18n';
import { homeOutcomes } from '../data/outcomes';
import { profileCopy } from '../data/profile';
import CaseCard from './CaseCard.astro';
import ContactForm from './ContactForm.astro';
import HeroCarousel from './HeroCarousel.astro';
import AboutPage from './AboutPage.astro';
import { workImage } from '../data/workImages';
import AiPage from './AiPage.astro';
import ConsultingSection from './ConsultingSection.astro';
import AiInvite from './AiInvite.astro';
import PageHero from './PageHero.astro';
import Icon from './Icon.astro';
import MediaSlot from './surface/MediaSlot.astro';
import type { IconName } from './Icon.astro';
import StackCarousel from './StackCarousel.astro';

interface Props {
	locale: Locale;
	pageKey: PageKey;
	cases: CollectionEntry<'cases'>[];
}

const { locale, pageKey, cases } = Astro.props;
const es = locale === 'es';
const about = profileCopy(locale);
const outcomes = homeOutcomes(locale);
const brands = brandStrip();
const ownedSlugs = new Set(['bloqio-builder', 'bloqio-cro-apps']);
const groupFor = (entry: CollectionEntry<'cases'>) =>
	entry.data.positioning ?? (ownedSlugs.has(entry.data.slug) ? 'owned-product' : 'client-work');
const sortFeatured = (entries: CollectionEntry<'cases'>[]) =>
	[...entries].sort(
		(a, b) =>
			Number(b.data.publication.featured) - Number(a.data.publication.featured) ||
			a.data.title.localeCompare(b.data.title),
	);
const clientWork = sortFeatured(cases.filter((entry) => groupFor(entry) === 'client-work'));
const ownedProducts = sortFeatured(cases.filter((entry) => groupFor(entry) === 'owned-product'));
const concepts = sortFeatured(cases.filter((entry) => groupFor(entry) === 'concept'));
const selectedSlugs = ['ahp-plus', 'bloqio-builder', 'wu-nutrition', 'miawseo', 'vineria'];
const selectedCases = selectedSlugs.flatMap((slug) => {
	const entry = cases.find((item) => item.data.slug === slug);
	return entry ? [entry] : [];
});

const capabilities: Array<{ title: string; text: string; icon: IconName }> = es
	? [
			{ title: 'Shopify y ecommerce', text: 'Levanto tiendas Shopify que venden y que tu equipo puede mover sin depender de nadie: storefront, temas y apps a la medida del negocio.', icon: 'basket' },
			{ title: 'UX/CX y CRO', text: 'Encuentro dónde se te escapa la venta y rediseño la experiencia para que más visitas terminen en compra. Mido antes y después.', icon: 'trend-up' },
			{ title: 'Sistemas operativos con IA', text: 'Pongo la IA a trabajar en tu operación diaria: asistentes y agentes con tus datos, tus permisos y una persona que revisa.', icon: 'sparkles-ai' },
			{ title: 'Desarrollo web', text: 'Construyo el producto completo, de la idea al deploy: front, back, integraciones y APIs que aguantan el negocio real.', icon: 'code' },
		]
	: [
			{ title: 'Shopify and ecommerce', text: 'I build Shopify stores that sell and that your team can run on its own: storefront, themes, and apps shaped around the business.', icon: 'basket' },
			{ title: 'UX/CX and CRO', text: 'I find where sales leak and redesign the experience so more visits become purchases. Driven by evidence, not opinions.', icon: 'trend-up' },
			{ title: 'AI operating systems', text: 'I put AI to real work: copilots and agents with your data, your permissions, and human control, wired into daily operations.', icon: 'sparkles-ai' },
			{ title: 'Web development', text: 'I build the whole product, from idea to deploy: front, back, integrations, and APIs that hold up in the real business.', icon: 'code' },
		];

// Cada servicio con la captura del proyecto donde lo hice.
const serviceShots = [
	{ image: 'cover-wu-nutrition', slug: 'wu-nutrition', name: 'WU Nutrition' },
	{ image: 'cover-la-carniceria-virtual', slug: 'la-carniceria-virtual', name: 'La Carnicería Virtual' },
	{ image: 'cover-tiendaonline', slug: 'tiendaonline', name: 'Casa Tecalli' },
	{ image: 'cover-come-verde', slug: 'come-verde', name: 'Come Verde' },
	{ image: 'wu-daniela-combo', slug: 'wu-nutrition', name: 'Daniela · WU Nutrition' },
	{ image: 'prometeo-public-desktop', slug: 'bloqio-cro-apps', name: 'Prometeo y Hermes' },
];
const services: Array<{ title: string; text: string; icon: IconName }> = es
	? [
			{ title: 'Armar tu tienda en línea', text: 'Armo tu tienda en Shopify desde cero o termino la parte que te falta. La acomodo a lo que vendes y a cómo lo entregas.', icon: 'code' },
			{ title: 'Encontrar dónde pierdes ventas', text: 'Recorro tu sitio como lo haría un cliente y te digo en qué paso se va sin comprar. Te entrego los arreglos en orden, empezando por el que más ventas te cuesta.', icon: 'filter' },
			{ title: 'Que cargue rápido y la puedas mover tú', text: 'Muchos de tus clientes entran desde el celular. Hago que la página abra rápido ahí y que tu equipo pueda cambiar precios, fotos y promociones sin pedirle ayuda a nadie.', icon: 'trend-up' },
			{ title: 'Saber de dónde llegan tus ventas', text: 'Dejo bien configurado Google Analytics junto con tus anuncios y tus correos. Así sabes de dónde llegó cada venta y en qué anuncio vale la pena seguir invirtiendo.', icon: 'badge-percent' },
			{ title: 'Un asistente que conteste por ti', text: 'Un asistente con IA que responde a tus clientes en tu sitio o en WhatsApp con tus precios y tu catálogo reales, también fuera de horario. Lo que no sabe te lo pasa a ti.', icon: 'sparkles-ai' },
			{ title: 'Programar lo que ninguna app hace', text: 'Si ninguna app de Shopify hace lo que necesitas, la programo yo. Así nacieron Prometeo y Hermes, mi barra de avisos y mi botón de compra fijo.', icon: 'basket' },
		]
	: [
			{ title: 'Build your online store', text: 'I build your Shopify store from scratch or finish the part you are missing. I set it up around what you sell and how you deliver it.', icon: 'code' },
			{ title: 'Find where you lose sales', text: 'I go through your site the way a customer would and tell you at which step people leave without buying. You get the fixes in order, starting with the one that costs you the most sales.', icon: 'filter' },
			{ title: 'Fast to load, easy for you to run', text: 'Many of your customers come in from their phone. I make the page open quickly there and set it up so your team can change prices, photos and promotions without asking anyone for help.', icon: 'trend-up' },
			{ title: 'Know where your sales come from', text: 'I set up Google Analytics properly together with your ads and your emails. That way you know where each sale came from and which ad is worth more of your money.', icon: 'badge-percent' },
			{ title: 'An assistant that answers for you', text: 'An AI assistant that answers your customers on your site or on WhatsApp with your real prices and catalog, also after hours. Whatever it does not know, it passes to you.', icon: 'sparkles-ai' },
			{ title: 'Code what no app does', text: 'If no Shopify app does what you need, I code it myself. That is how Prometeo and Hermes started, my announcement bar and my sticky buy button.', icon: 'basket' },
		];

const painPoints: Array<{ title: string; text: string; icon: IconName }> = es
	? [
			{ icon: 'exclamation', title: 'Llega tráfico pero no convierte', text: 'Las sesiones pagadas caen en una experiencia que no sostiene la intención de compra, sobre todo en móvil.' },
			{ icon: 'basket', title: 'El carrito pierde la venta al final', text: 'Valor, envío, cantidad y confianza no quedan claros justo cuando la persona decide.' },
			{ icon: 'filter', title: 'Se rediseña sin saber dónde está la fuga', text: 'Se cambia por opinión y no por evidencia: se mueve todo y no mejora lo que de verdad importa.' },
			{ icon: 'sparkles-ai', title: 'La IA suena bien pero no opera', text: 'Automatizaciones sin datos, permisos ni revisión humana que al final nadie usa.' },
		]
	: [
			{ icon: 'exclamation', title: 'Traffic arrives but doesn’t convert', text: 'Paid sessions land on an experience that doesn’t sustain purchase intent, especially on mobile.' },
			{ icon: 'basket', title: 'The cart loses the sale at the end', text: 'Value, shipping, quantity, and trust aren’t clear right when the person decides.' },
			{ icon: 'filter', title: 'Redesigns happen without finding the leak', text: 'Driven by opinion, not evidence: everything moves and what matters doesn’t improve.' },
			{ icon: 'sparkles-ai', title: 'AI sounds good but doesn’t operate', text: 'Automations with no data, permissions, or human review that nobody ends up using.' },
		];

const pillars: Array<{ title: string; text: string; icon: IconName }> = es
	? [
			{ icon: 'trend-up', title: 'Que la gente compre', text: 'Diseño pensando en la persona que está del otro lado, y trabajo justo en los momentos donde decide o se va.' },
			{ icon: 'sparkles-ai', title: 'Que la IA sirva de algo', text: 'Asistentes con tus datos y tus permisos, metidos en el trabajo diario. Si nadie los usa a la semana, no sirvieron.' },
			{ icon: 'code', title: 'Que lo puedas mantener', text: 'Construyo la tienda para que tu equipo la mueva solo. No para que dependas de mí.' },
		]
	: [
			{ icon: 'trend-up', title: 'Getting people to buy', text: 'I design for the person on the other side, and work exactly where they decide or walk away.' },
			{ icon: 'sparkles-ai', title: 'Making AI actually useful', text: 'Assistants with your data and your permissions, built into daily work. If nobody uses them a week later, they were pointless.' },
			{ icon: 'code', title: 'Leaving it maintainable', text: 'I build the store so your team can run it alone. Not so you depend on me.' },
		];
---

{
	pageKey === 'home' && (
		<>
			<section class="hero home-hero">
				<HeroCarousel locale={locale} />
			</section>

			<section class="section shell selected-work" aria-labelledby="selected-work-title">
				<div class="section-heading">
					<p class="index">01 / {es ? 'Trabajo seleccionado' : 'Selected work'}</p>
					<div class="flow">
						<h2 id="selected-work-title">{es ? 'Cosas que construí y siguen funcionando.' : 'Things I built that are still running.'}</h2>
						<p>{es ? 'Cada proyecto lo pensé, lo diseñé y lo programé. Puedes abrir casi todos y verlos en vivo.' : 'I planned, designed, and coded each one. You can open almost all of them and see them live.'}</p>
					</div>
				</div>
				<div class="project-grid">
					{selectedCases.map((entry, index) => <CaseCard entry={entry} index={index} locale={locale} />)}
				</div>
				<a class="link-with-icon section-link" href={routes[locale].work}>
					{es ? 'Ver todos los proyectos' : 'View all projects'}
					<Icon name="arrow-right" />
				</a>
			</section>

			<section class="section section-band section-band--soft">
				<div class="shell impact-layout">
					<div class="section-heading">
						<p class="index">02 / {es ? 'Lo que ha pasado' : 'What has happened'}</p>
						<div class="flow">
							<h2>{es ? 'Ocho años vendiendo en internet y programando lo que hace falta.' : 'Eight years selling online and coding whatever it takes.'}</h2>
							<p>{es ? 'Entiendo el negocio porque lo he operado, y puedo construirlo porque lo he programado. Normalmente esas dos cosas viven en personas distintas.' : 'I understand the business because I have run it, and I can build it because I have coded it. Usually those two things live in different people.'}</p>
						</div>
					</div>
					<ul class="outcomes-grid">
						{outcomes.map((outcome) => (
							<li data-kpi-item>
								<p class="outcomes-grid__value">{outcome.value}{outcome.suffix && <small>{outcome.suffix}</small>}</p>
								<p class="outcomes-grid__label">{outcome.label}</p>
								<p class="outcomes-grid__detail">{outcome.detail}</p>
							</li>
						))}
					</ul>
					<ul class="brand-strip" aria-label={es ? 'Marcas con las que he trabajado' : 'Brands I have worked with'}>
						{brands.map((brand) => <li class="brand-label">{brand.name[locale]}</li>)}
					</ul>
				</div>
			</section>

			<section class="section shell capabilities-section">
				<div class="section-heading">
					<p class="index">03 / {es ? 'En qué te puedo ayudar' : 'How I can help'}</p>
					<div class="flow">
						<h2>{es ? 'Cuatro cosas que hago bien.' : 'Four things I do well.'}</h2>
						<p>{es ? 'Normalmente llegan por una y terminamos trabajando en varias, porque casi siempre están conectadas.' : 'People usually come for one and we end up working on several, because they are almost always connected.'}</p>
					</div>
				</div>
				<div class="capability-grid">
					{capabilities.map((capability, index) => <article><span>0{index + 1}</span><Icon name={capability.icon} size="md" /><h3>{capability.title}</h3><p>{capability.text}</p></article>)}
				</div>
				<StackCarousel locale={locale} />
			</section>

			<section class="section shell opportunity-section" aria-labelledby="opportunity-title">
				<div class="section-heading">
					<p class="index">04 / {es ? 'Antes de tocar nada' : 'Before touching anything'}</p>
					<div class="flow">
						<h2 id="opportunity-title">{es ? 'Si la tienda no vende, primero hay que saber por qué.' : 'If the store is not selling, first we need to know why.'}</h2>
						<p>{es ? 'Busco en qué punto se cae la venta, te digo qué arreglar primero y lo dejo escrito como tareas concretas que tu equipo puede ejecutar sin mí.' : 'I look for the point where the sale drops, tell you what to fix first, and leave it written as concrete tasks your team can run without me.'}</p>
					</div>
				</div>
				<div class="opportunity-grid">
					<article class="signal-panel">
						<p class="eyebrow">{es ? 'Lo que veo casi siempre' : 'What I see almost every time'}</p>
						<ul class="pain-list">
							{painPoints.map((pain, index) => (
								<li data-reveal-item style={`--reveal-i:${index}`}>
									<span class="opp-motif" aria-hidden="true">
										<Icon name={pain.icon} size="md" />
									</span>
									<strong>{pain.title}</strong>
									<span>{pain.text}</span>
								</li>
							))}
						</ul>
					</article>
					<article class="path-panel">
						<p class="eyebrow">{es ? 'Cómo lo resuelvo' : 'How I solve it'}</p>
						<ul class="solve-list">
							{pillars.map((pillar, index) => (
								<li data-reveal-item style={`--reveal-i:${index}`}>
									<span class="opp-motif" aria-hidden="true">
										<Icon name={pillar.icon} size="md" />
									</span>
									<strong>{pillar.title}</strong>
									<span>{pillar.text}</span>
								</li>
							))}
						</ul>
						<a class="button" href={routes[locale].contact} data-analytics-event="click_contact">
							{es ? 'Auditar mi tienda online' : 'Audit my online store'}
						</a>
					</article>
				</div>
			</section>

			<section class="section shell profile-section">
				<p class="index">05 / {es ? 'Perfil' : 'Profile'}</p>
				<div class="profile-intro">
					<MediaSlot id="profile-home" ratio="4:5" variant="soft" label={es ? 'Retrato editorial · por producir' : 'Editorial portrait · to be produced'} />
					<div class="flow">
						<h2>{es ? 'Estrategia de negocio con capacidad de construir.' : 'Business strategy with the ability to build.'}</h2>
						<p class="profile-headline">{about.headline}</p>
						<p>{es ? 'Trabajo con dirección y ejecución para que las ideas no terminen en una presentación y se conviertan en una experiencia que el equipo pueda usar, medir y mejorar.' : 'I work with direction and delivery so ideas do not stop at a presentation and become an experience the team can use, measure, and improve.'}</p>
						<div class="hero__actions">
							<a class="button" href={routes[locale].about}>{es ? 'Conocer mi experiencia' : 'Explore my experience'}</a>
							<a class="button button--ghost" href={routes[locale].contact}>{es ? 'Iniciar conversación' : 'Start a conversation'}</a>
						</div>
					</div>
				</div>
			</section>
		</>
	)
}

{
	pageKey === 'work' && (
		<div class="work-index">
			<PageHero
				loop="work"
				id="work-hero-title"
				label={es ? 'Proyectos seleccionados' : 'Selected projects'}
				title={es ? ['Proyectos en los que', 'he trabajado.'] : ['Projects I have', 'worked on.']}
				lede={es ? 'Aquí están las tiendas que dirijo, los productos que programé por mi cuenta y algunos proyectos de muestra. En cada uno te cuento cuál era el problema y qué hice para resolverlo.' : 'Here are the stores I run, the products I built on my own and a few sample projects. Each one tells you what the problem was and what I did to solve it.'}
			>
				<dl class="jx-facts">
					<div><dt>{String(clientWork.length).padStart(2, '0')}</dt><dd>{es ? 'marcas y tiendas' : 'brands and stores'}</dd></div>
					<div><dt>{String(ownedProducts.length).padStart(2, '0')}</dt><dd>{es ? 'productos propios' : 'own products'}</dd></div>
					<div><dt>{String(concepts.length).padStart(2, '0')}</dt><dd>{es ? 'proyectos de muestra' : 'sample projects'}</dd></div>
				</dl>
			</PageHero>
			{clientWork.length > 0 && (
				<section class="work-chapter" aria-labelledby="client-work-title" data-reveal>
					<div class="work-chapter__head"><p>01 / {es ? 'Trabajo para marcas' : 'Work for brands'}</p><h2 id="client-work-title">{es ? 'Tiendas y marcas que dirijo o dirigí.' : 'Stores and brands I lead or have led.'}</h2></div>
					<div class="work-gallery">{clientWork.map((entry, index) => <CaseCard entry={entry} index={index} locale={locale} />)}</div>
				</section>
			)}
			{ownedProducts.length > 0 && (
				<section class="work-chapter" aria-labelledby="owned-products-title" data-reveal>
					<div class="work-chapter__head"><p>02 / {es ? 'Productos propios' : 'My own products'}</p><h2 id="owned-products-title">{es ? 'Productos que programé por mi cuenta.' : 'Products I built on my own.'}</h2></div>
					<div class="work-gallery">{ownedProducts.map((entry, index) => <CaseCard entry={entry} index={index} locale={locale} />)}</div>
				</section>
			)}
			{concepts.length > 0 && (
				<section class="work-chapter" aria-labelledby="concepts-title" data-reveal>
					<div class="work-chapter__head"><p>03 / {es ? 'Proyectos de muestra' : 'Sample projects'}</p><h2 id="concepts-title">{es ? 'Ejemplos que armé para probar una idea.' : 'Examples I built to test an idea.'}</h2></div>
					<div class="work-gallery">{concepts.map((entry, index) => <CaseCard entry={entry} index={index} locale={locale} />)}</div>
				</section>
			)}
		</div>
	)
}

{
	pageKey === 'services' && (
		<div class="editorial-page editorial-page--services">
			<PageHero
				loop="services"
				id="services-hero-title"
				label={es ? 'Servicios' : 'Services'}
				title={es ? ['Te ayudo a vender', 'más por internet.'] : ['I help you sell', 'more online.']}
				lede={es ? 'Primero busco qué te está costando más ventas. Después lo diseño y lo programo yo mismo, así que no te quedas con un documento de recomendaciones que nadie ejecuta.' : 'First I find what is costing you the most sales. Then I design the fix and code it myself, so you are not left with a document of recommendations nobody carries out.'}
			>
				<div class="jx-actions jx-actions--center">
					<a class="jx-btn jx-btn--primary" href={routes[locale].contact}>{es ? 'Cuéntame tu caso' : 'Tell me your case'}<Icon name="arrow-right" /></a>
					<button class="jx-btn jx-btn--ghost" type="button" data-ai-open>{es ? 'Pregúntale a Jossue AI' : 'Ask Jossue AI'}</button>
				</div>
			</PageHero>
			<section class="section service-grid editorial-page__content">
				{services.map((service, index) => { const shot = serviceShots[index]; const src = shot && workImage(shot.image); return <article class="service-card">{src && <a class="service-card__shot" href={`${routes[locale].work}${shot.slug}/`} aria-label={es ? `Ver el caso ${shot.name}` : `See the ${shot.name} case`}><img src={src} alt="" loading="lazy" decoding="async" /><span>{shot.name}</span></a>}<span>{String(index + 1).padStart(2, '0')}</span><Icon name={service.icon} size="md" /><h2>{service.title}</h2><p>{service.text}</p>{index === 4 && <a class="link-with-icon" href={`${routes[locale].products}chatbots/`}>{es ? 'Ver chatbots con IA' : 'See AI chatbots'}<Icon name="arrow-right" /></a>}</article>; })}
			</section>
			<ConsultingSection locale={locale} id="consultoria-servicios" />
			<section class="section process-section editorial-page__content">
				<div class="section-heading"><p class="index">{es ? 'Cómo trabajo' : 'How I work'}</p><h2>{es ? 'Los pasos para trabajar conmigo.' : 'The steps of working with me.'}</h2></div>
				<ol class="process-list">
					{(es ? ['Qué quieres lograr', 'Qué va primero', 'Cómo se va a ver', 'Lo programo', 'Reviso si funcionó'] : ['What you want to achieve', 'What goes first', 'How it will look', 'I build it', 'I check whether it worked']).map((item, index) => <li><span>0{index + 1}</span><strong>{item}</strong></li>)}
				</ol>
				<a class="button" href={routes[locale].contact}>{es ? 'Platícame tu caso' : 'Tell me about your business'}</a>
			</section>
		</div>
	)
}

{pageKey === 'ai' && <AiPage locale={locale} />}

{pageKey === 'about' && <AboutPage locale={locale} />}

{
	pageKey === 'contact' && (
		<div class="editorial-page contact-page">
			<PageHero
				loop="contact"
				loopFit="aspect"
				id="contact-hero-title"
				label={es ? 'Contacto' : 'Contact'}
				title={es ? ['Cuéntame qué', 'necesita tu negocio.'] : ['Tell me what your', 'business needs.']}
				lede={es ? 'No necesitas tenerlo todo claro. Escríbeme qué está pasando en tu negocio y te respondo con lo que yo haría primero.' : 'You do not need to have it all figured out. Tell me what is going on in your business and I will reply with what I would do first.'}
			/>
			<section class="section contact-layout editorial-page__content">
				<div class="flow"><p class="index">{es ? 'Cómo contactarme' : 'How to reach me'}</p><h2>{es ? 'Escríbeme por donde te quede más cómodo. Todos los mensajes los contesto yo.' : 'Write wherever is easiest for you. I answer every message myself.'}</h2></div>
				<ul class="contact-channels">
					<li><a href={`${routes[locale].booking}?origen=contacto`} data-analytics-event="click_booking"><Icon name="calendar" /><span><small>{es ? 'Llamada de 10 min' : '10-min call'}</small>{es ? 'Elige una hora y te llamo' : 'Pick a time and I call you'}</span><Icon name="arrow-right" /></a></li>
					{contact.email && <li><a href={`mailto:${contact.email}`} data-analytics-event="click_email"><Icon name="envelope" /><span><small>Email</small>{contact.email}</span><Icon name="arrow-up-right" /></a></li>}
					{contact.whatsapp && contact.phone && <li><a href={contact.whatsapp} rel="noreferrer" data-analytics-event="click_whatsapp"><Icon name="chat" /><span><small>WhatsApp</small>{contact.phone}</span><Icon name="arrow-up-right" /></a></li>}
					{contact.linkedin && <li><a href={contact.linkedin} rel="noreferrer" data-analytics-event="click_linkedin"><Icon name="linkedin" size="md" /><span><small>LinkedIn</small>Jossue Alcalá</span><Icon name="arrow-up-right" /></a></li>}
				</ul>
			</section>
			<AiInvite locale={locale} context="contact" />
			<section class="section contact-form-section editorial-page__content"><div class="section-heading"><p class="index">{es ? 'O déjame un mensaje' : 'Or leave me a message'}</p><h2>{es ? 'Con dos o tres líneas tengo para empezar.' : 'Two or three lines are enough for me to start.'}</h2></div><ContactForm locale={locale} /></section>
		</div>
	)
}
