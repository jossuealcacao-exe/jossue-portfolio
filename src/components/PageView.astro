---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import profilePhoto from '../assets/profile.jpeg';
import { brandStrip } from '../data/brands';
import { contact } from '../data/contact';
import { routes, type Locale, type PageKey } from '../data/i18n';
import { homeOutcomes } from '../data/outcomes';
import { profile, profileCopy } from '../data/profile';
import BrandMark from './BrandMark.astro';
import CaseCard from './CaseCard.astro';
import ContactForm from './ContactForm.astro';
import HeroCarousel from './HeroCarousel.astro';
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import StackCarousel from './StackCarousel.astro';

interface Props {
	locale: Locale;
	pageKey: PageKey;
	cases: CollectionEntry<'cases'>[];
}

const { locale, pageKey, cases } = Astro.props;
const es = locale === 'es';
const about = profileCopy(locale);
const outcomes = homeOutcomes(locale);
const brands = brandStrip();
const cvHref = contact.cvEs;
const ownedSlugs = new Set(['bloqio-builder', 'bloqio-cro-apps']);
const groupFor = (entry: CollectionEntry<'cases'>) =>
	entry.data.positioning ?? (ownedSlugs.has(entry.data.slug) ? 'owned-product' : 'client-work');
const sortFeatured = (entries: CollectionEntry<'cases'>[]) =>
	[...entries].sort(
		(a, b) =>
			Number(b.data.publication.featured) - Number(a.data.publication.featured) ||
			a.data.title.localeCompare(b.data.title),
	);
const clientWork = sortFeatured(cases.filter((entry) => groupFor(entry) === 'client-work'));
const ownedProducts = sortFeatured(cases.filter((entry) => groupFor(entry) === 'owned-product'));
const concepts = sortFeatured(cases.filter((entry) => groupFor(entry) === 'concept'));
const selectedSlugs = ['ahp-plus', 'bloqio-builder', 'wu-nutrition', 'miawseo', 'vineria'];
const selectedCases = selectedSlugs.flatMap((slug) => {
	const entry = cases.find((item) => item.data.slug === slug);
	return entry ? [entry] : [];
});

const capabilities: Array<{ title: string; text: string; icon: IconName }> = es
	? [
			{ title: 'Shopify y ecommerce', text: 'Levanto tiendas Shopify que venden y que tu equipo puede mover sin depender de nadie: storefront, temas y apps a la medida del negocio.', icon: 'basket' },
			{ title: 'UX/CX y CRO', text: 'Encuentro dónde se te escapa la venta y rediseño la experiencia para que más visitas terminen en compra. Con evidencia, no con opiniones.', icon: 'trend-up' },
			{ title: 'Sistemas operativos con IA', text: 'Pongo la IA a trabajar de verdad: copilotos y agentes con tus datos, tus permisos y control humano, integrados a tu operación diaria.', icon: 'sparkles-ai' },
			{ title: 'Desarrollo web', text: 'Construyo el producto completo, de la idea al deploy: front, back, integraciones y APIs que aguantan el negocio real.', icon: 'code' },
		]
	: [
			{ title: 'Shopify and ecommerce', text: 'I build Shopify stores that sell and that your team can run on its own: storefront, themes, and apps shaped around the business.', icon: 'basket' },
			{ title: 'UX/CX and CRO', text: 'I find where sales leak and redesign the experience so more visits become purchases. Driven by evidence, not opinions.', icon: 'trend-up' },
			{ title: 'AI operating systems', text: 'I put AI to real work: copilots and agents with your data, your permissions, and human control, wired into daily operations.', icon: 'sparkles-ai' },
			{ title: 'Web development', text: 'I build the whole product, from idea to deploy: front, back, integrations, and APIs that hold up in the real business.', icon: 'code' },
		];

const services: Array<{ title: string; text: string; icon: IconName }> = es
	? [
			{ title: 'Shopify y desarrollo web', text: 'Themes, secciones, storefronts y componentes comerciales construidos alrededor del negocio.', icon: 'code' },
			{ title: 'Estrategia UX/CRO', text: 'Priorización de oportunidades en navegación, producto, confianza, carrito y compra móvil.', icon: 'filter' },
			{ title: 'Optimización ecommerce', text: 'Mejoras de experiencia, performance y operación que el equipo puede implementar y usar.', icon: 'trend-up' },
			{ title: 'Analítica y growth', text: 'Medición, paid media y CRM conectados con la experiencia que recibe el usuario.', icon: 'badge-percent' },
			{ title: 'IA aplicada y automatización', text: 'Copilotos, agentes y flujos con datos, permisos y decisiones que se integran con tus necesidades.', icon: 'sparkles-ai' },
			{ title: 'Apps y sistemas Shopify', text: 'Desarrollo de productos personalizados cuando una necesidad comercial requiere más que una app genérica.', icon: 'basket' },
		]
	: [
			{ title: 'Shopify and web development', text: 'Themes, sections, storefronts, and commercial components built around the business.', icon: 'code' },
			{ title: 'UX/CRO strategy', text: 'Opportunity prioritization across navigation, product, trust, cart, and mobile purchase.', icon: 'filter' },
			{ title: 'Ecommerce optimization', text: 'Experience, performance, and operational improvements teams can implement and use.', icon: 'trend-up' },
			{ title: 'Analytics and growth', text: 'Measurement, paid media, and CRM connected to the experience users actually receive.', icon: 'badge-percent' },
			{ title: 'Applied AI and automation', text: 'Copilots, agents, and workflows with data, permissions, and decisions that fit your needs.', icon: 'sparkles-ai' },
			{ title: 'Shopify apps and systems', text: 'Custom product development when a commercial need requires more than a generic app.', icon: 'basket' },
		];

const aiSystems = es
	? [
			['IA en producto', 'Asistentes que entienden contexto, proponen acciones y mantienen visible el control del usuario.'],
			['Desarrollo y programación', 'Agentes de desarrollo integrados en un proceso de alcance, implementación, revisión y documentación para ejecución de tareas operativas.'],
			['Sistemas de operación', 'Copilotos sobre Shopify, Odoo, CRM, analítica y paid media para complementar decisiones estratégicas.'],
			['Inteligencia de growth', 'Scorecards, síntesis y automatizaciones para convertir datos dispersos en prioridades.'],
		]
	: [
			['AI in products', 'Assistants that understand context, propose actions, and keep user control visible.'],
			['Development and programming', 'Development agents integrated into a scoping, implementation, review, and documentation process to execute operational tasks.'],
			['Operating systems', 'Copilots over Shopify, Odoo, CRM, analytics, and paid media to support strategic decisions.'],
			['Growth intelligence', 'Scorecards, synthesis, and automation turning fragmented data into priorities.'],
	];

const painPoints: Array<{ title: string; text: string; icon: IconName }> = es
	? [
			{ icon: 'exclamation', title: 'Llega tráfico pero no convierte', text: 'Las sesiones pagadas caen en una experiencia que no sostiene la intención de compra, sobre todo en móvil.' },
			{ icon: 'basket', title: 'El carrito pierde la venta al final', text: 'Valor, envío, cantidad y confianza no quedan claros justo cuando la persona decide.' },
			{ icon: 'filter', title: 'Se rediseña sin saber dónde está la fuga', text: 'Se cambia por opinión y no por evidencia: se mueve todo y no mejora lo que de verdad importa.' },
			{ icon: 'sparkles-ai', title: 'La IA suena bien pero no opera', text: 'Automatizaciones sin datos, permisos ni revisión humana que al final nadie usa.' },
		]
	: [
			{ icon: 'exclamation', title: 'Traffic arrives but doesn’t convert', text: 'Paid sessions land on an experience that doesn’t sustain purchase intent, especially on mobile.' },
			{ icon: 'basket', title: 'The cart loses the sale at the end', text: 'Value, shipping, quantity, and trust aren’t clear right when the person decides.' },
			{ icon: 'filter', title: 'Redesigns happen without finding the leak', text: 'Driven by opinion, not evidence: everything moves and what matters doesn’t improve.' },
			{ icon: 'sparkles-ai', title: 'AI sounds good but doesn’t operate', text: 'Automations with no data, permissions, or human review that nobody ends up using.' },
		];

const pillars: Array<{ title: string; text: string; icon: IconName }> = es
	? [
			{ icon: 'trend-up', title: 'UX y CX para CRO', text: 'Diseño la experiencia alrededor del cliente. Optimizo dónde se decide y dónde se fuga el usuario.' },
			{ icon: 'sparkles-ai', title: 'Sistemas operativos con IA', text: 'Copilotos y agentes con datos, permisos y control humano que sí se integran a tu negocio.' },
			{ icon: 'code', title: 'Desarrollo web', text: 'Storefronts, temas y componentes Shopify hechos para que el equipo opere y crezca.' },
		]
	: [
			{ icon: 'trend-up', title: 'UX and CX for CRO', text: 'I design the experience around the customer. I optimize where decisions happen and where users drop off.' },
			{ icon: 'sparkles-ai', title: 'AI operating systems', text: 'Copilots and agents with data, permissions, and human control that truly integrate into your business.' },
			{ icon: 'code', title: 'Web development', text: 'Shopify storefronts, themes, and components built for teams to operate and grow.' },
		];
---

{
	pageKey === 'home' && (
		<>
			<section class="hero home-hero">
				<HeroCarousel locale={locale} />
			</section>

			<section class="section shell selected-work" aria-labelledby="selected-work-title">
				<div class="section-heading">
					<p class="index">01 / {es ? 'Trabajo seleccionado' : 'Selected work'}</p>
					<div class="flow">
						<h2 id="selected-work-title">{es ? 'Productos y experiencias construidos profesionalmente.' : 'Products and experiences built professionally.'}</h2>
						<p>{es ? 'Estrategia, diseño y ejecución reunidos en un mismo portafolio.' : 'Strategy, design, and execution brought together in one portfolio.'}</p>
					</div>
				</div>
				<div class="project-grid">
					{selectedCases.map((entry, index) => <CaseCard entry={entry} index={index} locale={locale} />)}
				</div>
				<a class="link-with-icon section-link" href={routes[locale].work}>
					{es ? 'Ver todos los proyectos' : 'View all projects'}
					<Icon name="arrow-right" />
				</a>
			</section>

			<section class="section section-band section-band--soft">
				<div class="shell impact-layout">
					<div class="section-heading">
						<p class="index">02 / {es ? 'Impacto profesional' : 'Professional impact'}</p>
						<div class="flow">
							<h2>{es ? 'Experiencia comercial con profundidad técnica.' : 'Commercial experience with technical depth.'}</h2>
							<p>{es ? 'Más de 8 años trabajando en desarrollo web, desarrollo IA, ecommerce, producto y ejecución digital.' : 'More than 8 years across web development, AI development, ecommerce, product, and digital delivery.'}</p>
						</div>
					</div>
					<ul class="outcomes-grid">
						{outcomes.map((outcome) => (
							<li data-kpi-item>
								<p class="outcomes-grid__value">{outcome.value}{outcome.suffix && <small>{outcome.suffix}</small>}</p>
								<p class="outcomes-grid__label">{outcome.label}</p>
								<p class="outcomes-grid__detail">{outcome.detail}</p>
							</li>
						))}
					</ul>
					<ul class="brand-strip" aria-label={es ? 'Marcas con las que he trabajado' : 'Brands I have worked with'}>
						{brands.map((brand) => <li><BrandMark brand={brand} locale={locale} size="md" decorative={false} /></li>)}
					</ul>
				</div>
			</section>

			<section class="section shell capabilities-section">
				<div class="section-heading">
					<p class="index">03 / {es ? 'Capacidades' : 'Capabilities'}</p>
					<div class="flow">
						<h2>{es ? 'Una visión completa, de la oportunidad a la operación.' : 'A complete view, from opportunity to operation.'}</h2>
						<p>{es ? 'Un stack sólido para cada necesidad digital de tu negocio.' : 'A solid stack for every digital need of your business.'}</p>
					</div>
				</div>
				<div class="capability-grid">
					{capabilities.map((capability, index) => <article><span>0{index + 1}</span><Icon name={capability.icon} size="md" /><h3>{capability.title}</h3><p>{capability.text}</p></article>)}
				</div>
				<StackCarousel locale={locale} />
			</section>

			<section class="section shell opportunity-section" aria-labelledby="opportunity-title">
				<div class="section-heading">
					<p class="index">04 / {es ? 'Diagnóstico para decidir' : 'Diagnostic for decision'}</p>
					<div class="flow">
						<h2 id="opportunity-title">{es ? 'Si la tienda pierde intención, primero ubicamos dónde se fuga.' : 'If the store is losing intent, first we locate the leakage.'}</h2>
						<p>{es ? 'Detecto dónde se está perdiendo conversión, priorizo la mejora con mayor impacto y convierto el diagnóstico en acciones que tu equipo puede operar.' : 'I detect where conversion is leaking, prioritize the highest-impact improvement, and turn diagnosis into actions your team can operate.'}</p>
					</div>
				</div>
				<div class="opportunity-grid">
					<article class="signal-panel">
						<p class="eyebrow">{es ? 'Síntomas que veo seguido' : 'Symptoms I see often'}</p>
						<ul class="pain-list">
							{painPoints.map((pain, index) => (
								<li data-reveal-item style={`--reveal-i:${index}`}>
									<span class="opp-motif" aria-hidden="true">
										<Icon name={pain.icon} size="md" />
									</span>
									<strong>{pain.title}</strong>
									<span>{pain.text}</span>
								</li>
							))}
						</ul>
					</article>
					<article class="path-panel">
						<p class="eyebrow">{es ? 'Cómo lo resuelvo' : 'How I solve it'}</p>
						<ul class="solve-list">
							{pillars.map((pillar, index) => (
								<li data-reveal-item style={`--reveal-i:${index}`}>
									<span class="opp-motif" aria-hidden="true">
										<Icon name={pillar.icon} size="md" />
									</span>
									<strong>{pillar.title}</strong>
									<span>{pillar.text}</span>
								</li>
							))}
						</ul>
						<a class="button" href={routes[locale].contact} data-analytics-event="click_contact">
							{es ? 'Auditar mi tienda online' : 'Audit my online store'}
						</a>
					</article>
				</div>
			</section>

			<section class="section shell profile-section">
				<p class="index">05 / {es ? 'Perfil' : 'Profile'}</p>
				<div class="profile-intro">
					<figure class="profile-intro__photo">
						<Image src={profilePhoto} alt={es ? 'Retrato de Jossue Alcalá' : 'Portrait of Jossue Alcalá'} width={640} height={800} loading="lazy" decoding="async" />
					</figure>
					<div class="flow">
						<h2>{es ? 'Estrategia de negocio con capacidad de construir.' : 'Business strategy with the ability to build.'}</h2>
						<p class="profile-headline">{about.headline}</p>
						<p>{es ? 'Trabajo con dirección y ejecución para que las ideas no terminen en una presentación y se conviertan en una experiencia que el equipo pueda usar, medir y mejorar.' : 'I work with direction and delivery so ideas do not stop at a presentation and become an experience the team can use, measure, and improve.'}</p>
						<div class="hero__actions">
							<a class="button" href={routes[locale].about}>{es ? 'Conocer mi experiencia' : 'Explore my experience'}</a>
							<a class="button button--ghost" href={routes[locale].contact}>{es ? 'Iniciar conversación' : 'Start a conversation'}</a>
						</div>
					</div>
				</div>
			</section>
		</>
	)
}

{
	pageKey === 'work' && (
		<div class="page shell">
			<section class="hero work-hero">
				<div class="flow">
					<p class="eyebrow">{es ? 'Proyectos seleccionados' : 'Selected projects'}</p>
					<h1>{es ? 'Trabajo que une estrategia, producto y ejecución.' : 'Work that brings strategy, product, and execution together.'}</h1>
					<p class="hero__lede">{es ? 'Experiencias ecommerce, productos propios y conceptos diseñados para resolver necesidades reales del negocio.' : 'Ecommerce experiences, independent products, and concepts designed to solve real business needs.'}</p>
				</div>
				<dl class="work-folio">
					<div><dt>{String(clientWork.length).padStart(2, '0')}</dt><dd>{es ? 'Marcas' : 'Brands'}</dd></div>
					<div><dt>{String(ownedProducts.length).padStart(2, '0')}</dt><dd>{es ? 'Productos' : 'Products'}</dd></div>
					<div><dt>{String(concepts.length).padStart(2, '0')}</dt><dd>{es ? 'Conceptos' : 'Concepts'}</dd></div>
				</dl>
			</section>
			{clientWork.length > 0 && (
				<section class="section work-group" aria-labelledby="client-work-title">
					<div class="section-heading"><p class="index">01 / {es ? 'Trabajo para marcas' : 'Work for brands'}</p><h2 id="client-work-title">{es ? 'Ecommerce y growth llevados a la operación.' : 'Ecommerce and growth brought into operation.'}</h2></div>
					<div class="project-grid">{clientWork.map((entry, index) => <CaseCard entry={entry} index={index} locale={locale} />)}</div>
				</section>
			)}
			{ownedProducts.length > 0 && (
				<section class="section work-group" aria-labelledby="owned-products-title">
					<div class="section-heading"><p class="index">02 / {es ? 'Productos independientes' : 'Independent products'}</p><h2 id="owned-products-title">{es ? 'Ideas convertidas en productos utilizables.' : 'Ideas turned into usable products.'}</h2></div>
					<div class="project-grid">{ownedProducts.map((entry, index) => <CaseCard entry={entry} index={index} locale={locale} />)}</div>
				</section>
			)}
			{concepts.length > 0 && (
				<section class="section work-group" aria-labelledby="concepts-title">
					<div class="section-heading"><p class="index">03 / {es ? 'Conceptos de producto' : 'Product concepts'}</p><h2 id="concepts-title">{es ? 'Exploraciones técnicas con intención comercial.' : 'Technical explorations with commercial intent.'}</h2></div>
					<div class="project-grid">{concepts.map((entry, index) => <CaseCard entry={entry} index={index} locale={locale} />)}</div>
				</section>
			)}
		</div>
	)
}

{
	pageKey === 'services' && (
		<div class="page shell">
			<section class="hero compact-hero">
				<p class="eyebrow">{es ? 'Servicios' : 'Services'}</p>
				<h1>{es ? 'De la oportunidad comercial a una solución que tu equipo puede operar.' : 'From commercial opportunity to a solution your team can operate.'}</h1>
				<p class="hero__lede">{es ? 'Defino prioridades, diseño la experiencia y participo en la implementación para conectar estrategia, tecnología y resultados.' : 'I define priorities, design the experience, and work through implementation to connect strategy, technology, and outcomes.'}</p>
				<a class="button" href={routes[locale].contact}>{es ? 'Contáctame' : 'Contact me'}</a>
			</section>
			<section class="section service-grid">
				{services.map((service, index) => <article class="service-card"><span>{String(index + 1).padStart(2, '0')}</span><Icon name={service.icon} size="md" /><h2>{service.title}</h2><p>{service.text}</p>{index === 4 && <a class="link-with-icon" href={routes[locale].ai}>{es ? 'Ver IA aplicada' : 'Explore applied AI'}<Icon name="arrow-right" /></a>}</article>)}
			</section>
			<section class="section process-section">
				<div class="section-heading"><p class="index">{es ? 'Cómo trabajo' : 'How I work'}</p><h2>{es ? 'Un proceso simple para decisiones complejas.' : 'A simple process for complex decisions.'}</h2></div>
				<ol class="process-list">
					{(es ? ['Objetivo', 'Prioridad', 'Diseño', 'Implementación', 'Medición'] : ['Goal', 'Priority', 'Design', 'Implementation', 'Measurement']).map((item, index) => <li><span>0{index + 1}</span><strong>{item}</strong></li>)}
				</ol>
				<a class="button" href={routes[locale].contact}>{es ? 'Definir el siguiente paso' : 'Define the next step'}</a>
			</section>
		</div>
	)
}

{
	pageKey === 'ai' && (
		<div class="page shell">
			<section class="hero compact-hero">
				<p class="eyebrow">{es ? 'IA aplicada' : 'Applied AI'}</p>
				<h1>{es ? 'IA integrada a productos y operaciones ecommerce.' : 'AI integrated into ecommerce products and operations.'}</h1>
				<p class="hero__lede">{es ? 'Diseño asistentes, automatizaciones y sistemas que trabajan con contexto en tiempo real, interconectados, con acciones claras y decisiones humanas.' : 'I design assistants, automations, and systems that work with real-time, connected context, clear actions, and human decisions.'}</p>
			</section>
			<section class="section ai-grid">
				{aiSystems.map(([title, text], index) => <article><span>0{index + 1}</span><h2>{title}</h2><p>{text}</p></article>)}
			</section>
			<section class="section ai-principles">
				<div class="section-heading"><p class="index">{es ? 'Diseñada para operar' : 'Designed to operate'}</p><h2>{es ? 'La mejor IA no se siente como una capa añadida.' : 'The best AI does not feel like an added layer.'}</h2></div>
				<ul>
					<li>{es ? 'Parte de una necesidad concreta del usuario o del equipo.' : 'It starts from a specific user or team need.'}</li>
					<li>{es ? 'Convierte contexto en acciones comprensibles y reversibles.' : 'It turns context into understandable, reversible actions.'}</li>
					<li>{es ? 'Se integra con permisos, datos y decisiones del negocio.' : 'It integrates with business permissions, data, and decisions.'}</li>
				</ul>
				<a class="button" href={routes[locale].contact}>{es ? 'Quiero mi negocio con IA' : 'I want my business running on AI'}</a>
			</section>
		</div>
	)
}

{
	pageKey === 'about' && (
		<div class="page shell">
			<section class="hero about-hero">
				<div class="flow">
					<p class="eyebrow">{es ? 'Perfil profesional' : 'Professional profile'}</p>
					<h1>{profile.name}</h1>
					<p class="profile-headline">{about.headline}</p>
					<p class="hero__lede">{about.summary}</p>
					<div class="hero__actions">
						{cvHref && <a class="button link-with-icon" href={cvHref} download data-analytics-event="download_cv"><Icon name="download" />{es ? 'Descargar CV' : 'Download CV'}</a>}
						<a class="button button--ghost" href={routes[locale].contact}>{es ? 'Contacto' : 'Contact'}</a>
					</div>
				</div>
				<figure class="about-hero__portrait"><Image src={profilePhoto} alt={es ? 'Retrato de Jossue Alcalá' : 'Portrait of Jossue Alcalá'} width={640} height={800} loading="eager" decoding="async" /></figure>
			</section>
			<section class="section"><div class="section-heading"><p class="index">01 / {es ? 'Marcas' : 'Brands'}</p><h2>{es ? 'Experiencia en tecnología, retail, salud y consumo.' : 'Experience across technology, retail, health, and consumer brands.'}</h2></div><ul class="brand-strip">{brands.map((brand) => <li><BrandMark brand={brand} locale={locale} size="md" decorative={false} /></li>)}</ul></section>
			<section class="section"><div class="section-heading"><p class="index">02 / {es ? 'Impacto profesional' : 'Professional impact'}</p><h2>{es ? 'Resultados en contextos comerciales reales.' : 'Results in real commercial contexts.'}</h2></div><ul class="kpi-grid">{about.kpis.map((kpi) => <li data-kpi-item><p class="kpi-grid__value">{kpi.value}</p><p class="kpi-grid__label">{kpi.label}</p><p class="kpi-grid__detail">{kpi.detail}</p></li>)}</ul></section>
			<section class="section"><div class="section-heading"><p class="index">03 / {es ? 'Experiencia' : 'Experience'}</p><h2>{es ? 'Una trayectoria entre negocio, growth y producto.' : 'A career across business, growth, and product.'}</h2></div><ol class="profile-timeline">{about.experience.map((item) => <li><p class="profile-timeline__meta"><span>{item.period}</span><span>{item.org}</span></p><h2>{item.role}</h2><ul class="list">{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul></li>)}</ol></section>
			<section class="section about-capabilities"><div class="section-heading"><p class="index">04 / {es ? 'Capacidades' : 'Capabilities'}</p><h2>{es ? 'Dirección estratégica con capacidad técnica.' : 'Strategic direction with technical capability.'}</h2></div><div class="capability-grid">{capabilities.map((capability, index) => <article><span>0{index + 1}</span><Icon name={capability.icon} size="md" /><h3>{capability.title}</h3><p>{capability.text}</p></article>)}</div><StackCarousel locale={locale} /></section>
			<section class="section about-skills"><div class="section-heading"><p class="index">05 / {es ? 'Habilidades' : 'Skills'}</p><h2>{es ? 'Stack y habilidades aplicadas al negocio.' : 'Stack and skills applied to the business.'}</h2></div><div class="about-skills__grid"><div class="flow"><p class="eyebrow">{es ? 'Plataformas y técnica' : 'Platforms and technical'}</p><ul class="list">{about.skills.map((item) => <li>{item}</li>)}</ul></div><div class="flow"><p class="eyebrow">{es ? 'IA aplicada' : 'Applied AI'}</p><ul class="list">{about.aiCapabilities.map((item) => <li>{item}</li>)}</ul></div></div></section>
			<section class="section about-details"><div><p class="index">06 / {es ? 'Formación' : 'Education'}</p><ul class="list">{about.education.map((item) => <li>{item}</li>)}</ul></div><div><p class="index">07 / {es ? 'Idiomas y enlaces' : 'Languages and links'}</p><ul class="list">{about.languages.map((item) => <li>{item}</li>)}{about.links.map((link) => <li><a class="link-with-icon" href={link.href} rel="noreferrer" data-analytics-event={link.event}>{link.label}<Icon name="arrow-up-right" /></a></li>)}</ul></div></section>
		</div>
	)
}

{
	pageKey === 'contact' && (
		<div class="page shell contact-page">
			<section class="hero compact-hero contact-hero">
				<p class="eyebrow">{es ? 'Contacto' : 'Contact'}</p>
				<h1>{es ? 'Hablemos de lo que quieres construir, mejorar o crear.' : 'Let’s discuss what you want to build, improve, or create.'}</h1>
				<p class="hero__lede">{es ? 'Compárteme tus dudas y te responderé con soluciones claras y un siguiente paso concreto.' : 'Share your questions and I will reply with clear solutions and a concrete next step.'}</p>
			</section>
			<section class="section contact-layout">
				<div class="flow"><p class="index">{es ? 'Canales directos' : 'Direct channels'}</p><h2>{es ? 'Elige el canal que te resulte más cómodo.' : 'Choose the channel that works best for you.'}</h2></div>
				<ul class="contact-channels">
					{contact.email && <li><a href={`mailto:${contact.email}`} data-analytics-event="click_email"><Icon name="envelope" /><span><small>Email</small>{contact.email}</span><Icon name="arrow-up-right" /></a></li>}
					{contact.whatsapp && contact.phone && <li><a href={contact.whatsapp} rel="noreferrer" data-analytics-event="click_whatsapp"><Icon name="chat" /><span><small>WhatsApp</small>{contact.phone}</span><Icon name="arrow-up-right" /></a></li>}
					{contact.linkedin && <li><a href={contact.linkedin} rel="noreferrer" data-analytics-event="click_linkedin"><Icon name="linkedin" size="md" /><span><small>LinkedIn</small>Jossue Alcalá</span><Icon name="arrow-up-right" /></a></li>}
				</ul>
			</section>
			<section class="section contact-form-section"><div class="section-heading"><p class="index">{es ? 'Cuéntame sobre el proyecto' : 'Tell me about the project'}</p><h2>{es ? 'Un poco de contexto es suficiente para empezar.' : 'A little context is enough to get started.'}</h2></div><ContactForm locale={locale} /></section>
		</div>
	)
}
