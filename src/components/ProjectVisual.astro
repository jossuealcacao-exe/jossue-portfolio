---
import type { Locale } from '../data/i18n';

interface Props {
	slug: string;
	title: string;
	stack: string[];
	locale: Locale;
	priority?: boolean;
}

const { slug, title, locale } = Astro.props;
const es = locale === 'es';
---

<div class="portfolio-visual" data-image-slot={`case-${slug}-cover`} role="img" aria-label={`${es ? 'Espacio reservado para la portada del caso' : 'Reserved space for the case cover'} ${title}`}>
	<div class="portfolio-visual__label">
		<span>{es ? 'Imagen del caso' : 'Case image'}</span>
		<strong>{title}</strong>
	</div>
	<span class="portfolio-visual__ratio" aria-hidden="true">16:9</span>
</div>
