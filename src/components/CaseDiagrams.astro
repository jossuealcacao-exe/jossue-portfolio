---
// Gráficos de apoyo de un caso (barras, capas, comparaciones y flujos) en el sistema jx.
// Los números cuentan hacia su valor y las barras se llenan al llegar a ellos.
import Icon from './Icon.astro';

interface DiagramItem {
	label: string;
	value: number;
	unit?: string;
	detail?: string;
}

interface Diagram {
	id: string;
	title: string;
	caption: string;
	kind: 'bars' | 'layers' | 'compare' | 'flow';
	items: DiagramItem[];
	note?: string;
}

interface Props {
	diagrams: Diagram[];
	locale: 'es' | 'en';
}

const { diagrams, locale } = Astro.props;
const peakOf = (items: DiagramItem[]) => Math.max(...items.map((item) => item.value), 1);
---

<div class="cdg" role="group" aria-label={locale === 'es' ? 'Gráficos de apoyo' : 'Supporting charts'}>
	{
		diagrams.map((diagram) => {
			const peak = peakOf(diagram.items);
			return (
				<figure class={`cdg__card cdg__card--${diagram.kind}`}>
					<header class="cdg__head">
						<p class="jx-mono">{diagram.id}</p>
						<h3>{diagram.title}</h3>
						<p>{diagram.caption}</p>
					</header>
					{diagram.kind === 'flow' ? (
						<ol class="cdg-flow">
							{diagram.items.map((item, index) => (
								<li>
									<span class="cdg-flow__n">{String(index + 1).padStart(2, '0')}</span>
									<div>
										<strong>{item.label}</strong>
										{item.detail && <p>{item.detail}</p>}
									</div>
								</li>
							))}
						</ol>
					) : diagram.kind === 'compare' ? (
						<ul class="cdg-compare">
							{diagram.items.map((item) => (
								<li>
									<span class="cdg-compare__value">
										<b data-count>{item.value}</b>
										{item.unit && <small>{item.unit}</small>}
									</span>
									<span class="cdg-compare__label">{item.label}</span>
									{item.detail && <span class="cdg-compare__detail">{item.detail}</span>}
								</li>
							))}
						</ul>
					) : (
						<ul class="cdg-bars">
							{diagram.items.map((item) => (
								<li>
									<div class="cdg-bars__meta">
										<span>{item.label}</span>
										<strong data-count>
											{item.value}
											{item.unit ?? '%'}
										</strong>
									</div>
									<div class="cdg-bars__track" aria-hidden="true" style={`--bar: ${diagram.kind === 'layers' ? item.value : Math.round((item.value / peak) * 100)}%`}>
										<span />
									</div>
									{item.detail && <p class="cdg-bars__detail">{item.detail}</p>}
								</li>
							))}
						</ul>
					)}
					{diagram.note && (
						<figcaption>
							<Icon name="exclamation" />
							{diagram.note}
						</figcaption>
					)}
				</figure>
			);
		})
	}
</div>
