---
import { routes, type Locale } from '../data/i18n';

interface Item {
	label: string;
	href?: string;
}

interface Props {
	locale: Locale;
	items: Item[];
}

const { locale, items } = Astro.props;
const site = Astro.site ?? new URL('https://portfolio.invalid');
const breadcrumbItems = [
	{ label: locale === 'es' ? 'Inicio' : 'Home', href: routes[locale].home },
	...items,
];
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: breadcrumbItems.map((item, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: item.label,
		item: new URL(item.href ?? Astro.url.pathname, site).href,
	})),
};
---

<nav class="breadcrumbs shell" aria-label={locale === 'es' ? 'Migas de pan' : 'Breadcrumbs'}>
	<ol>
		<li><a href={routes[locale].home}>{locale === 'es' ? 'Inicio' : 'Home'}</a></li>
		{
			items.map((item) => (
				<li>
					{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
				</li>
			))
		}
	</ol>
</nav>
<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
