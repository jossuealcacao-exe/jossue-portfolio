---
// Catálogo con el sistema de madre.run. MADRE va primero y con su verde; el resto, con el
// acento marfil del sitio y un ícono en vez de una imagen pendiente.
import type { Locale } from '../data/i18n';
import { routes } from '../data/i18n';
import { commercialProducts, featuredProducts, otherProducts, productDemo, productHref } from '../data/products';
import DemoVideo from './DemoVideo.astro';
import HeroLoop from './HeroLoop.astro';
import Icon, { type IconName } from './Icon.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';
const madre = commercialProducts.find((product) => product.slug === 'madre');
if (!madre) throw new Error('MADRE product is required');
const alsoFeatured = featuredProducts.filter((product) => product.slug !== 'madre');
const others = otherProducts;
const madreDemo = productDemo(madre, locale);
const icons: Record<string, IconName> = { 'bloqio-builder': 'layers', daniela: 'chat', chatbots: 'chats', consultoria: 'compass', 'desarrollo-web': 'code', 'ia-aplicada': 'sparkles-ai' };

const method = es
	? [['01', 'Escucho', 'Me cuentas qué quieres lograr y con qué cuentas hoy.'], ['02', 'Priorizo', 'Empiezo por lo que más te está costando ahora.'], ['03', 'Construyo', 'Lo hago por partes y tú revisas cada una antes de que siga.'], ['04', 'Pruebo', 'Te enseño que funciona antes de darlo por terminado.']]
	: [['01', 'Listen', 'You tell me what you want to achieve and what you have today.'], ['02', 'Prioritize', 'I start with what is costing you the most right now.'], ['03', 'Build', 'I do it in parts and you review each one before I go on.'], ['04', 'Test', 'I show you it works before calling it done.']];
---

<article class="jx-home jx-catalog" data-product-catalog>
	<div class="jx-page-hero" data-hero="products">
		<HeroLoop name="products" />
		<section class="jx-hero" aria-labelledby="catalog-title">
		<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Productos y servicios' : 'Products and services'}</p>
		<h1 id="catalog-title" class="jx-hero__title">
			<span>{es ? 'Mis productos y lo que' : 'My products and what'}</span>
			<span class="jx-soft">{es ? 'puedo construir para tu negocio' : 'I can build for your business'}</span>
		</h1>
		<p class="jx-hero__lede">
			{es
				? 'Primero están las herramientas que hice yo, cada una con su demo. Después viene lo que puedo hacer para tu negocio, como chatbots con IA, tiendas en línea, tareas automatizadas y consultoría. No publico precios porque cada proyecto es distinto. Te doy uno después de una llamada corta.'
				: 'First come the tools I made myself, each with its demo. After that is what I can do for your business, like AI chatbots, online stores, automated tasks and consulting. I do not publish prices because every project is different. I give you one after a short call.'}
		</p>
	</section>
	</div>

	<section id="catalogo" class="jx-wrap jx-catalog__list" aria-label={es ? 'Catálogo' : 'Catalog'}>
		<article class="catalog__item jx-catalog__star">
			{madreDemo && <DemoVideo demo={madreDemo} locale={locale} class="jx-catalog__media" />}
			<div class="jx-catalog__body">
				<p class="jx-label jx-label--madre"><span class="jx-dot" aria-hidden="true"></span>{madre.category[locale]}{madre.status && ` · ${madre.status[locale]}`}</p>
				<h2 class="jx-catalog__title"><a href={productHref(madre, locale)}>{madre.title[locale]}</a></h2>
				<p class="jx-catalog__promise">{madre.promise[locale]}</p>
				<p class="jm-muted">{madre.summary[locale]}</p>
				<div class="jx-actions">
					<a class="jx-btn jx-btn--madre" href={productHref(madre, locale)}>{es ? 'Conocer MADRE' : 'Meet MADRE'}<Icon name="arrow-right" /></a>
					<a class="jx-btn jx-btn--ghost" href="https://madre.run/" rel="noopener">madre.run<Icon name="arrow-up-right" /></a>
				</div>
			</div>
		</article>

		<div class="jx-catalog__grid">
			{alsoFeatured.map((product) => {
				const demo = productDemo(product, locale);
				return (
					<article class="catalog__item jx-catalog__card jx-catalog__card--demo">
						{demo && <DemoVideo demo={demo} locale={locale} />}
						<p class="jx-mono">{product.category[locale]}{product.status && ` · ${product.status[locale]}`}</p>
						<h2 class="jx-catalog__title jx-catalog__title--sm"><a href={productHref(product, locale)}>{product.title[locale]}</a></h2>
						<p class="jx-catalog__promise">{product.promise[locale]}</p>
						<p class="jm-muted">{product.summary[locale]}</p>
						<div class="jx-actions">
							<a class="jx-btn jx-btn--primary" href={productHref(product, locale)}>{es ? 'Ver detalle' : 'View detail'}<Icon name="arrow-right" /></a>
							<a class="jx-btn jx-btn--ghost" href={`${routes[locale].contact}?producto=${product.slug}`}>{es ? 'Preguntarme por esto' : 'Ask me about this'}</a>
						</div>
					</article>
				);
			})}
			{others.map((product) => (
				<article class:list={['catalog__item', 'jx-catalog__card', productDemo(product, locale) && 'jx-catalog__card--demo']}>
					{productDemo(product, locale) ? <DemoVideo demo={productDemo(product, locale)!} locale={locale} orientation="wide" /> : <Icon name={icons[product.slug] ?? 'cube'} size="md" />}
					<p class="jx-mono">{product.category[locale]}</p>
					<h2 class="jx-catalog__title jx-catalog__title--sm"><a href={productHref(product, locale)}>{product.title[locale]}</a></h2>
					<p class="jx-catalog__promise">{product.promise[locale]}</p>
					<p class="jm-muted">{product.summary[locale]}</p>
					{product.status && <p class="jx-mono jx-catalog__status">{product.status[locale]}</p>}
					<div class="jx-actions">
						<a class="jx-btn jx-btn--primary" href={productHref(product, locale)}>{es ? 'Ver detalle' : 'View detail'}<Icon name="arrow-right" /></a>
						<a class="jx-btn jx-btn--ghost" href={`${routes[locale].contact}?producto=${product.slug}`}>{es ? 'Preguntarme por esto' : 'Ask me about this'}</a>
					</div>
				</article>
			))}
		</div>
	</section>

	<section id="metodo" class="jx-band" aria-labelledby="catalog-method-title">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Método' : 'Method'}</p>
			<h2 id="catalog-method-title" class="jx-h2"><span>{es ? 'Cómo llevo' : 'How I run'}</span> <span class="jx-soft">{es ? 'cada proyecto.' : 'every project.'}</span></h2>
			<ol class="jx-steps">
				{method.map(([number, title, text]) => (
					<li><span class="jx-mono">{number}</span><strong>{title}</strong><p>{text}</p></li>
				))}
			</ol>
		</div>
	</section>

	<section class="jx-close" aria-labelledby="catalog-close-title">
		<div class="jx-close__card">
			<h2 id="catalog-close-title" class="jx-close__title"><span>{es ? '¿No sabes con cuál empezar?' : 'Not sure where to start?'}</span></h2>
			<p>{es ? 'Cuéntame qué problema tienes en tu negocio y te digo por dónde empezaría yo, aunque no sea con nada de esta lista.' : 'Tell me what problem your business has and I will tell you where I would start, even if it is nothing on this list.'}</p>
			<div class="jx-actions jx-actions--center">
				<a class="jx-btn jx-btn--primary" href={routes[locale].contact}>{es ? 'Escríbeme' : 'Write to me'}<Icon name="arrow-right" /></a>
			</div>
		</div>
	</section>
</article>
