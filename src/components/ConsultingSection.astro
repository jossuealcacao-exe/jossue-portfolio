---
// Consultoría: tres formas de trabajar juntos antes (o en vez) de construir, los temas que
// cubre y un caso real de diagnóstico. Sin precios: se definen después de una llamada corta.
import { routes, type Locale } from '../data/i18n';
import Icon, { type IconName } from './Icon.astro';

interface Props {
	locale: Locale;
	id?: string;
}

const { locale, id = 'consultoria' } = Astro.props;
const es = locale === 'es';
const productUrl = `${routes[locale].products}consultoria/`;
const contactUrl = `${routes[locale].contact}?producto=consultoria`;
const formats: Array<{ icon: IconName; title: string; text: string; tag: string }> = es
	? [
			{ icon: 'chats', tag: '01 · Una llamada', title: 'Diagnóstico', text: 'Revisamos tu negocio en una llamada, con tus números a la mano. Al colgar sabes qué te conviene cambiar primero y qué puede esperar.' },
			{ icon: 'check-list', tag: '02 · Por escrito', title: 'Revisión con plan', text: 'Reviso tu tienda, tus anuncios, lo que estás midiendo y qué tan rápido carga tu sitio. Te entrego por escrito qué hacer primero, qué después y qué no hace falta hacer.' },
			{ icon: 'compass', tag: '03 · Seguimiento', title: 'Acompañamiento', text: 'Me reúno con tu equipo cada cierto tiempo para revisar resultados, tomar decisiones y resolver lo que esté atorado. Así no tienes que contratar a alguien de planta.' },
		]
	: [
			{ icon: 'chats', tag: '01 · One call', title: 'Diagnosis', text: 'We go over your business on a call, with your numbers at hand. When we hang up you know what to change first and what can wait.' },
			{ icon: 'check-list', tag: '02 · In writing', title: 'Review with a plan', text: 'I review your store, your ads, what you are measuring and how fast your site loads. You get in writing what to do first, what later and what you do not need to do.' },
			{ icon: 'compass', tag: '03 · Follow-up', title: 'Ongoing support', text: 'I meet with your team every so often to review results, make decisions and sort out whatever is stuck. That way you do not need to hire someone full time.' },
		];
const topics = es
	? ['Shopify y tu tienda en línea', 'Que más visitas terminen en compra (conversión)', 'Anuncios y cuáles sí te traen ventas', 'Que te encuentren en Google (SEO)', 'Vender en Amazon y Mercado Libre', 'Usar IA en tu equipo']
	: ['Shopify and your online store', 'Turning more visits into sales (conversion)', 'Ads, and which ones actually bring sales', 'Getting found on Google (SEO)', 'Selling on Amazon and Mercado Libre', 'Using AI in your team'];
---

<section id={id} class="jx-consult" data-home="consulting" aria-labelledby={`${id}-title`}>
	<div class="jx-wrap">
		<div class="jx-consult__head">
			<div>
				<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Consultoría' : 'Consulting'}</p>
				<h2 id={`${id}-title`} class="jx-h2">
					<span>{es ? 'Te ayudo a decidir' : 'I help you decide'}</span>{' '}
					<span class="jx-soft">{es ? 'antes de gastar en algo nuevo.' : 'before you spend on something new.'}</span>
				</h2>
			</div>
			<p class="jx-consult__lede">
				{es
					? 'Antes de pagar una tienda nueva o más anuncios, conviene saber qué está fallando. Reviso tus ventas en línea como dueño de negocio, como mercadólogo y como programador, y te digo por dónde empezaría.'
					: 'Before paying for a new store or more ads, it helps to know what is failing. I look at your online sales as a business owner, a marketer and a developer, and tell you where I would start.'}
			</p>
		</div>

		<ul class="jx-consult__formats">
			{formats.map((format) => (
				<li>
					<Icon name={format.icon} size="md" />
					<p class="jx-mono">{format.tag}</p>
					<h3>{format.title}</h3>
					<p>{format.text}</p>
				</li>
			))}
		</ul>

		<div class="jx-consult__foot">
			<ul class="jx-consult__topics" aria-label={es ? 'Temas de consultoría' : 'Consulting topics'}>
				{topics.map((topic) => <li>{topic}</li>)}
			</ul>
			<div class="jx-actions">
				<a class="jx-btn jx-btn--primary" href={contactUrl} data-analytics-event="click_consulting">{es ? 'Agendar un diagnóstico' : 'Book a diagnosis'}<Icon name="arrow-right" /></a>
				<a class="jx-btn jx-btn--ghost" href={productUrl}>{es ? 'Cómo funciona' : 'How it works'}</a>
			</div>
			<p class="jx-consult__proof">
				{es ? 'Un ejemplo: ' : 'An example: '}
				<a class="jx-link" href={`${routes[locale].work}la-carniceria-virtual/`}>{es ? 'el diagnóstico de La Carnicería Virtual' : 'the La Carnicería Virtual diagnosis'}<Icon name="arrow-right" /></a>
			</p>
		</div>
	</div>
</section>
