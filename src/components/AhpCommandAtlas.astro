---
import { ahpAtlasCategories, ahpAtlasCommands, ahpAtlasPlatforms } from '../data/ahpAtlas';
import { routes, type Locale } from '../data/i18n';
import '../styles/ahp-atlas.css';
import CodeBlock from './AhpCodeBlock.astro';
import CopyGlyph from './CopyGlyph.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';
const installSequence = `node --version
npm install --save-dev @jossuealcala/ahp-plus@latest
npx ahp init . --owner "${es ? 'Tu nombre' : 'Your name'}" --project ${es ? 'mi-proyecto' : 'my-project'}
npx ahp doctor .
npx ahp verify . --strict`;
const heartbeat = `npx ahp root .
npx ahp doctor .
npx ahp verify . --strict
npx ahp status .
npx ahp context . --format markdown --budget 8000`;
const handoffReceive = `npx ahp verify . --strict
npx ahp handoff inspect HOF-... .
npx ahp handoff receive HOF-... .
npx ahp sync check . --require-remote`;
const osOptions = [
	{ id: 'macos', label: 'macOS', icon: '/tools/apple.svg', shell: 'zsh', note: es ? 'Ejecuta cada operación desde Terminal en la raíz del repositorio.' : 'Run each operation from Terminal at the repository root.' },
	{ id: 'linux', label: 'Linux', icon: '/tools/linux.svg', shell: 'bash', note: es ? 'Los comandos son iguales en Bash y deben ejecutarse desde la raíz Git.' : 'Commands are identical in Bash and must run from the Git root.' },
	{ id: 'powershell', label: 'Windows PowerShell', icon: '/tools/powershell.svg', shell: 'powershell', note: es ? 'Usa una línea por comando. PowerShell usa el acento grave para continuar líneas, no la barra invertida de Bash.' : 'Use one line per command. PowerShell uses the backtick for continuation, not Bash’s backslash.' },
	{ id: 'cmd', label: 'Windows CMD', icon: '/tools/windows-terminal.svg', shell: 'cmd', note: es ? 'Mantén cada operación en una sola línea. Cambia el shell, no el protocolo.' : 'Keep each operation on one line. The shell changes; the protocol does not.' },
];
const categoryLabel = (id: string) => ahpAtlasCategories.find((category) => category.id === id)?.label[locale] ?? id;
---

<article class="ahp-atlas" data-ahp-atlas data-locale={locale}>
	<header class="ahp-atlas__hero shell">
		<p class="eyebrow">{es ? 'Referencia oficial · AHP+ 1.1.0' : 'Official reference · AHP+ 1.1.0'}</p>
		<h1>AHP+ <span>Command Atlas</span></h1>
		<p class="hero__lede">
			{es
				? 'Instala, verifica, gestiona y transfiere el contexto de un proyecto entre terminales, IDEs y agentes sin confundir una petición en chat con evidencia de ejecución.'
				: 'Install, verify, manage, and transfer project context across terminals, IDEs, and agents without confusing a chat request with execution evidence.'}
		</p>
		<div class="ahp-atlas__stats" aria-label={es ? 'Resumen de la referencia' : 'Reference summary'}>
			<p><strong>{ahpAtlasCommands.length}</strong><span>{es ? 'comandos y patrones CLI' : 'CLI commands and patterns'}</span></p>
			<p><strong>{ahpAtlasPlatforms.length}</strong><span>{es ? 'adaptadores de plataforma' : 'platform adapters'}</span></p>
			<p><strong>Git</strong><span>{es ? 'contrato canónico portable' : 'portable canonical contract'}</span></p>
		</div>
		<nav class="ahp-atlas__index" aria-label={es ? 'Contenido de la guía' : 'Guide contents'}>
			<a href="#instalacion">01 · {es ? 'Instalación' : 'Installation'}</a>
			<a href="#pulso">02 · {es ? 'Pulso' : 'Heartbeat'}</a>
			<a href="#terminal">03 · Terminal</a>
			<a href="#plataformas">04 · {es ? 'Plataformas' : 'Platforms'}</a>
			<a href="#handoff">05 · Handoff</a>
			<a href="#autoridad">06 · {es ? 'Autoridad' : 'Authority'}</a>
		</nav>
	</header>

	<section class="ahp-atlas__section shell" aria-labelledby="surfaces-title">
		<div class="ahp-atlas__section-heading">
			<p class="index">00 / {es ? 'Orientación' : 'Orientation'}</p>
			<div><h2 id="surfaces-title">{es ? 'Terminal y chat no son lo mismo.' : 'Terminal and chat are not the same.'}</h2><p>{es ? 'El protocolo es uno. La superficie determina cómo solicitas la operación y qué puede probarse.' : 'There is one protocol. The surface determines how you request an operation and what can be proven.'}</p></div>
		</div>
		<div class="ahp-atlas__two-col">
			<article class="ahp-atlas__panel">
				<p class="ahp-atlas__label">TERMINAL</p>
				<h3>{es ? 'Ejecución verificable' : 'Verifiable execution'}</h3>
				<p>{es ? 'Escribe comandos exactos con npx ahp. La salida del proceso puede convertirse en evidencia reproducible.' : 'Enter exact commands with npx ahp. Process output can become reproducible evidence.'}</p>
				<CodeBlock command="npx ahp verify . --strict" label="shell" locale={locale} />
			</article>
			<article class="ahp-atlas__panel">
				<p class="ahp-atlas__label">IDE / CHAT</p>
				<h3>{es ? 'Intención semántica' : 'Semantic intent'}</h3>
				<p>{es ? 'Pide la operación mediante el adaptador. El agente debe ejecutar la CLI y mostrar el resultado; su texto por sí solo no es evidencia.' : 'Request the operation through the adapter. The agent must run the CLI and show the result; model text alone is not evidence.'}</p>
				<CodeBlock command="/ahp verify strict" label="chat" locale={locale} />
			</article>
		</div>
		<aside class="ahp-atlas__notice">
			<strong>{es ? 'Regla de oro' : 'Golden rule'}</strong>
			<p>{es ? 'Si la plataforma no tiene repositorio y terminal, solo puede consumir una cápsula confirmada. Debe declarar que no ejecutó verificaciones, tests, commits ni pushes.' : 'If a platform has no repository and shell, it can only consume a committed capsule. It must disclose that it did not run verification, tests, commits, or pushes.'}</p>
		</aside>
	</section>

	<section id="instalacion" class="ahp-atlas__section shell" aria-labelledby="install-title">
		<div class="ahp-atlas__section-heading">
			<p class="index">01 / INSTALL</p>
			<div><h2 id="install-title">{es ? 'Instalación por sistema operativo.' : 'Installation by operating system.'}</h2><p>{es ? 'Ejecuta desde la raíz de un repositorio Git existente, con al menos un commit y Node.js 20 o superior.' : 'Run from the root of an existing Git repository with at least one commit and Node.js 20 or newer.'}</p></div>
		</div>
		<div class="ahp-atlas__tabs" role="tablist" aria-label={es ? 'Sistema operativo' : 'Operating system'}>
			{osOptions.map((os, index) => <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`os-${os.id}`} id={`tab-${os.id}`} data-os-tab={os.id}><img src={os.icon} alt="" width="20" height="20" aria-hidden="true" />{os.label}</button>)}
		</div>
		{osOptions.map((os, index) => (
			<div class="ahp-atlas__os-panel" id={`os-${os.id}`} role="tabpanel" aria-labelledby={`tab-${os.id}`} hidden={index !== 0} data-os-panel={os.id}>
				<p>{os.note}</p>
				<CodeBlock command={installSequence} label={os.shell} locale={locale} />
			</div>
		))}
		<div class="ahp-atlas__channel-grid">
			<article><p class="ahp-atlas__label">STABLE</p><h3><code>@latest</code></h3><p>{es ? 'Canal recomendado para uso normal.' : 'Recommended channel for normal use.'}</p><CodeBlock command="npm install --save-dev @jossuealcala/ahp-plus@latest" label="terminal" locale={locale} /></article>
			<article><p class="ahp-atlas__label">PINNED</p><h3><code>@1.1.0</code></h3><p>{es ? 'Reproducción exacta de esta referencia.' : 'Exact reproduction of this reference.'}</p><CodeBlock command="npm install --save-dev @jossuealcala/ahp-plus@1.1.0" label="terminal" locale={locale} /></article>
			<article><p class="ahp-atlas__label">DEVELOPMENT</p><h3><code>@next</code></h3><p>{es ? 'Solo para probar candidatos y reportar mejoras.' : 'Only for testing candidates and reporting improvements.'}</p><CodeBlock command="npm install --save-dev @jossuealcala/ahp-plus@next" label="terminal" locale={locale} /></article>
		</div>
	</section>

	<section id="pulso" class="ahp-atlas__section shell" aria-labelledby="heartbeat-title">
		<div class="ahp-atlas__section-heading">
			<p class="index">02 / START</p>
			<div><h2 id="heartbeat-title">{es ? 'Pulso de inicio.' : 'Start heartbeat.'}</h2><p>{es ? 'Ejecuta esta secuencia al abrir el proyecto, cambiar de agente o recibir un handoff.' : 'Run this sequence when opening a project, changing agents, or receiving a handoff.'}</p></div>
		</div>
		<CodeBlock command={heartbeat} label="terminal · all OS" locale={locale} />
		<p class="ahp-atlas__after-code">{es ? 'Después lee .ahp/manifest.json, .ahp/state/project.json y .ahp/INDEX.md. El contexto generado en vivo prevalece sobre un brief persistido antiguo.' : 'Then read .ahp/manifest.json, .ahp/state/project.json, and .ahp/INDEX.md. Live-generated context overrides a stale persisted brief.'}</p>
	</section>

	<section id="terminal" class="ahp-atlas__section shell" aria-labelledby="terminal-title">
		<div class="ahp-atlas__section-heading">
			<p class="index">03 / CLI</p>
			<div><h2 id="terminal-title">{es ? 'Catálogo completo de terminal.' : 'Complete terminal catalog.'}</h2><p>{es ? 'Busca por intención, comando o categoría. Todos los ejemplos usan la instalación local mediante npx ahp.' : 'Search by intent, command, or category. Every example uses the local installation through npx ahp.'}</p></div>
		</div>
		<label class="ahp-atlas__search"><span>{es ? 'Buscar' : 'Search'}</span><input type="search" data-ahp-search placeholder={es ? 'doctor, evidencia, handoff…' : 'doctor, evidence, handoff…'} autocomplete="off" /></label>
		<div class="ahp-atlas__filters" aria-label={es ? 'Filtrar comandos' : 'Filter commands'}>
			{ahpAtlasCategories.map((category, index) => <button type="button" data-ahp-filter={category.id} aria-pressed={index === 0 ? 'true' : 'false'}>{category.label[locale]}</button>)}
		</div>
		<p class="ahp-atlas__count" aria-live="polite" data-ahp-count>{ahpAtlasCommands.length} {es ? 'comandos visibles' : 'commands visible'}</p>
		<div class="ahp-atlas__command-grid">
			{ahpAtlasCommands.map((item) => (
				<article class="ahp-atlas__command" data-ahp-command data-category={item.category} data-search={`${item.title.es} ${item.title.en} ${item.description.es} ${item.description.en} ${item.command}`.toLowerCase()}>
					<div><p class="ahp-atlas__label">{categoryLabel(item.category)}</p><h3>{item.title[locale]}</h3><p>{item.description[locale]}</p></div>
					<CodeBlock command={item.command} label="terminal" locale={locale} compact />
				</article>
			))}
		</div>
		<p class="ahp-atlas__empty" data-ahp-empty hidden>{es ? 'No hay comandos que coincidan con la búsqueda.' : 'No commands match this search.'}</p>
	</section>

	<section id="plataformas" class="ahp-atlas__section shell" aria-labelledby="platforms-title">
		<div class="ahp-atlas__section-heading">
			<p class="index">04 / CHAT</p>
			<div><h2 id="platforms-title">{es ? 'Comandos por plataforma.' : 'Commands by platform.'}</h2><p>{es ? 'Primero instala el adaptador desde terminal. Después usa el vocabulario semántico directamente en el chat.' : 'Install the adapter from a terminal first. Then use the semantic vocabulary directly in chat.'}</p></div>
		</div>
		<div class="ahp-atlas__platform-grid">
			{ahpAtlasPlatforms.map((platform) => (
				<article class="ahp-atlas__platform">
					<div class="ahp-atlas__platform-head"><span class:list={['ahp-atlas__platform-mark', { 'ahp-atlas__platform-mark--wide': platform.adapter === 'opencode' }]} aria-hidden="true"><img src={platform.logo} alt="" width="96" height="36" loading="lazy" /></span><div><p class="ahp-atlas__label">IDE / APP</p><h3>{platform.name}</h3></div></div>
					<p>{platform.description[locale]}</p>
					<p class="ahp-atlas__surface">{es ? 'En terminal' : 'In terminal'}</p>
					<CodeBlock command={`npx ahp adapter install ${platform.adapter} . --apply`} label="terminal" locale={locale} compact />
					<p class="ahp-atlas__surface">{es ? 'Directamente en el chat' : 'Directly in chat'}</p>
					<ul>{platform.prompts.map((prompt) => <li><div class="ahp-atlas__prompt-head"><span>CHAT</span><button type="button" data-copy-value={prompt[locale]} title={es ? 'Copiar prompt' : 'Copy prompt'}><CopyGlyph /><span class="sr-only" data-copy-feedback>{es ? 'Copiar prompt' : 'Copy prompt'}</span></button></div><code>{prompt[locale]}</code></li>)}</ul>
				</article>
			))}
		</div>
	</section>

	<section id="handoff" class="ahp-atlas__section shell" aria-labelledby="handoff-title">
		<div class="ahp-atlas__section-heading">
			<p class="index">05 / HANDOFF</p>
			<div><h2 id="handoff-title">{es ? 'Continuidad entre plataformas.' : 'Cross-platform continuity.'}</h2><p>{es ? 'Un handoff sella contexto e identidad. Git lo transporta; la persona autoriza el commit y el push por separado.' : 'A handoff seals context and identity. Git transports it; a person authorizes commit and push separately.'}</p></div>
		</div>
		<ol class="ahp-atlas__steps">
			<li><div class="ahp-atlas__step-copy"><span>01</span><div><h3>{es ? 'Checkpoint en el emisor' : 'Checkpoint on the sender'}</h3><p>{es ? 'Conserva un límite recuperable antes de cambiar de host.' : 'Preserve a recoverable boundary before changing hosts.'}</p></div></div><div class="ahp-atlas__step-command"><CodeBlock command={'npx ahp checkpoint . --session feature-x --platform codex --actor "Codex" --summary "Límite validado" --next-action "Recibir y continuar"'} label="terminal" locale={locale} /></div></li>
			<li><div class="ahp-atlas__step-copy"><span>02</span><div><h3>{es ? 'Crear el handoff' : 'Create the handoff'}</h3><p>{es ? 'Declara plataforma de origen, destino y resumen.' : 'Declare the source platform, destination, and summary.'}</p></div></div><div class="ahp-atlas__step-command"><CodeBlock command={'npx ahp handoff create . --from codex --to cursor --session feature-x --summary "Continuar desde el límite validado"'} label="terminal" locale={locale} /></div></li>
			<li><div class="ahp-atlas__step-copy"><span>03</span><div><h3>{es ? 'Transportar con autoridad' : 'Transport with authority'}</h3><p>{es ? 'El handoff debe quedar confirmado y disponible en el remoto. AHP+ no ejecuta Git ni concede permiso para publicarlo.' : 'The handoff must be committed and remotely available. AHP+ neither runs Git nor grants permission to publish it.'}</p></div></div></li>
			<li><div class="ahp-atlas__step-copy"><span>04</span><div><h3>{es ? 'Verificar y recibir' : 'Verify and receive'}</h3><p>{es ? 'El receptor valida integridad, identidad y relación Git antes de editar.' : 'The receiver validates integrity, identity, and Git relationship before editing.'}</p></div></div><div class="ahp-atlas__step-command"><CodeBlock command={handoffReceive} label="terminal" locale={locale} /></div></li>
		</ol>
	</section>

	<section class="ahp-atlas__section shell" aria-labelledby="migration-title">
		<div class="ahp-atlas__section-heading">
			<p class="index">06 / MIGRATE</p>
			<div><h2 id="migration-title">{es ? 'Migración desde /agent.' : 'Migration from /agent.'}</h2><p>{es ? 'Si AHP+ detecta estado 1.0 heredado, no vuelvas a inicializar el repositorio.' : 'If AHP+ detects legacy 1.0 state, do not initialize the repository again.'}</p></div>
		</div>
		<div class="ahp-atlas__two-col">
			<article class="ahp-atlas__panel"><p class="ahp-atlas__label">READ ONLY</p><h3>{es ? '1. Revisar el plan' : '1. Review the plan'}</h3><CodeBlock command="npx ahp migrate . --plan" label="terminal" locale={locale} /><p>{es ? 'Informa conteos, destino y colisiones sin modificar archivos.' : 'Reports counts, destination, and collisions without changing files.'}</p></article>
			<article class="ahp-atlas__panel"><p class="ahp-atlas__label">WRITE</p><h3>{es ? '2. Aplicar después de revisar' : '2. Apply after review'}</h3><CodeBlock command={'npx ahp migrate . --apply\nnpx ahp verify . --strict'} label="terminal" locale={locale} /><p>{es ? 'Preserva agent/. Si .ahp/ ya existe, AHP+ se detiene antes de mezclar estados.' : 'Preserves agent/. If .ahp/ already exists, AHP+ stops before merging state.'}</p></article>
		</div>
		<aside class="ahp-atlas__notice ahp-atlas__notice--warning"><strong>{es ? 'No ejecutes init sobre estado heredado' : 'Do not run init over legacy state'}</strong><p>{es ? 'Usa primero migrate --plan. No borres ni muevas colisiones sin revisar y conservar un rollback.' : 'Run migrate --plan first. Do not delete or move collisions without review and a retained rollback.'}</p></aside>
	</section>

	<section id="autoridad" class="ahp-atlas__section shell" aria-labelledby="authority-title">
		<div class="ahp-atlas__section-heading">
			<p class="index">07 / AUTHORITY</p>
			<div><h2 id="authority-title">{es ? 'AHP+ registra; no autoriza.' : 'AHP+ records; it does not authorize.'}</h2><p>{es ? 'READY o REMOTE_READY prueba compatibilidad o transporte, no permiso humano.' : 'READY or REMOTE_READY proves compatibility or transport, not human permission.'}</p></div>
		</div>
		<ul class="ahp-atlas__authority">
			{['commit', 'push', 'pull', 'merge', 'publish', 'deploy', es ? 'acciones destructivas' : 'destructive actions'].map((action) => <li><code>{action}</code></li>)}
		</ul>
		<div class="ahp-atlas__links">
			<a class="button" href="https://github.com/jossuealcacao-exe/ahp_plus" rel="noreferrer" data-analytics-event="click_ahp_github">GitHub</a>
			<a class="button button--secondary" href="https://www.npmjs.com/package/@jossuealcala/ahp-plus" rel="noreferrer" data-analytics-event="click_ahp_npm">npm</a>
			<a class="text-link" href={`${routes[locale].work}ahp-plus/`}>{es ? 'Ver caso de producto' : 'View product case'}</a>
		</div>
		<p class="ahp-atlas__fineprint">{es ? 'Referencia portable preparada desde la documentación y CLI canónicas de AHP+ 1.1.0. Antes de reutilizar comandos de instalación, confirma la versión publicada y revisa el changelog oficial.' : 'Portable reference prepared from the canonical AHP+ 1.1.0 documentation and CLI. Before reusing installation commands, confirm the published version and review the official changelog.'}</p>
	</section>
</article>

<script>
	const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

	for (const atlas of document.querySelectorAll<HTMLElement>('[data-ahp-atlas]')) {
		let activeCategory = 'all';
		const locale = atlas.dataset.locale === 'en' ? 'en' : 'es';
		const search = atlas.querySelector<HTMLInputElement>('[data-ahp-search]');
		const cards = [...atlas.querySelectorAll<HTMLElement>('[data-ahp-command]')];
		const count = atlas.querySelector<HTMLElement>('[data-ahp-count]');
		const empty = atlas.querySelector<HTMLElement>('[data-ahp-empty]');

		const filter = () => {
			const query = normalize(search?.value ?? '');
			let visible = 0;
			for (const card of cards) {
				const matchesCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
				const matchesSearch = !query || normalize(card.dataset.search ?? '').includes(query);
				card.hidden = !(matchesCategory && matchesSearch);
				if (!card.hidden) visible += 1;
			}
			if (count) count.textContent = `${visible} ${locale === 'es' ? 'comandos visibles' : 'commands visible'}`;
			if (empty) empty.hidden = visible !== 0;
		};

		search?.addEventListener('input', filter);
		for (const button of atlas.querySelectorAll<HTMLButtonElement>('[data-ahp-filter]')) {
			button.addEventListener('click', () => {
				activeCategory = button.dataset.ahpFilter ?? 'all';
				for (const sibling of atlas.querySelectorAll<HTMLButtonElement>('[data-ahp-filter]')) sibling.setAttribute('aria-pressed', String(sibling === button));
				filter();
			});
		}

		for (const tab of atlas.querySelectorAll<HTMLButtonElement>('[data-os-tab]')) {
			tab.addEventListener('click', () => {
				const target = tab.dataset.osTab;
				for (const sibling of atlas.querySelectorAll<HTMLButtonElement>('[data-os-tab]')) sibling.setAttribute('aria-selected', String(sibling === tab));
				for (const panel of atlas.querySelectorAll<HTMLElement>('[data-os-panel]')) panel.hidden = panel.dataset.osPanel !== target;
			});
		}

		for (const button of atlas.querySelectorAll<HTMLButtonElement>('[data-copy-value]')) {
			button.addEventListener('click', async () => {
				const value = button.dataset.copyValue ?? '';
				const feedback = button.querySelector<HTMLElement>('[data-copy-feedback]');
				const originalFeedback = feedback?.textContent ?? '';
				const originalTitle = button.title;
				const setCopyState = (message: string, state: 'success' | 'error') => {
					if (feedback) feedback.textContent = message;
					button.title = message;
					button.dataset.copyState = state;
				};
				try {
					await navigator.clipboard.writeText(value);
					setCopyState(locale === 'es' ? 'Copiado' : 'Copied', 'success');
				} catch {
					setCopyState(locale === 'es' ? 'No se pudo copiar' : 'Could not copy', 'error');
				}
				window.setTimeout(() => {
					if (feedback) feedback.textContent = originalFeedback;
					button.title = originalTitle;
					delete button.dataset.copyState;
				}, 1600);
			});
		}
	}
</script>
