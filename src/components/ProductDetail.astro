---
// Ficha de producto común (Daniela, AHP+, Bloqio Builder y Miawseo) en el sistema jx, el mismo
// de Chatbots, IA aplicada, Consultoría y Desarrollo web: héroe centrado con un bucle abstracto
// detrás y la demo real debajo, qué hace, cómo funciona (escena animada con pasos), qué incluye,
// control y límites, para quién es, proyectos relacionados, preguntas frecuentes y ficha.
// Todo el texto sale de data/productDetails.ts.
import type { CollectionEntry } from 'astro:content';
import type { CommercialProduct } from '../data/products';
import { commercialProducts, productDemo, productHref } from '../data/products';
import { productDetails } from '../data/productDetails';
import { routes, type Locale } from '../data/i18n';
import Breadcrumbs from './Breadcrumbs.astro';
import DemoVideo from './DemoVideo.astro';
import Icon from './Icon.astro';
import JxProofCards from './JxProofCards.astro';
import PageHero from './PageHero.astro';
import AhpScene from './pdp/AhpScene.astro';
import BloqioScene from './pdp/BloqioScene.astro';
import DanielaScene from './pdp/DanielaScene.astro';
import HowStage from './pdp/HowStage.astro';
import MiawseoScene from './pdp/MiawseoScene.astro';

interface Props {
	locale: Locale;
	product: CommercialProduct;
	cases: CollectionEntry<'cases'>[];
}

const { locale, product, cases } = Astro.props;
const es = locale === 'es';
const detail = productDetails[product.slug];
if (!detail) throw new Error(`Falta el contenido de la ficha de ${product.slug} en data/productDetails.ts`);

const title = product.title[locale];
const demo = productDemo(product, locale);
const contactHref = `${routes[locale].contact}?producto=${product.slug}`;
const secondaryHref = typeof detail.secondary.href === 'string' ? detail.secondary.href : detail.secondary.href[locale];
const hasProofs = product.proofSlugs.some((slug) => cases.some((entry) => entry.data.slug === slug));
const siblings = commercialProducts.filter((item) => item.slug !== product.slug).slice(0, 4);
const faq = detail.faq[locale];
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })),
};
const heading = (pair: [string, string]) => pair;
// Las secciones alternan fondo (negro y grafito) en el orden en que aparecen.
let tone = 0;
const next = () => (tone++ % 2 === 0 ? 'jx-bots__section' : 'jx-band');
const rows = detail.overview.rows;
const cols = rows.length % 3 === 0 ? 3 : 2;
---

<Breadcrumbs
	locale={locale}
	items={[
		{ label: es ? 'Productos' : 'Products', href: routes[locale].products },
		{ label: title },
	]}
/>
<article class="jx-home jx-pdp" data-product-detail={product.slug}>
	<PageHero
		loop={detail.loop}
		id="pdp-title"
		label={product.category[locale]}
		title={heading(detail.title[locale])}
		lede={detail.lede[locale]}
	>
		<div class="jx-actions jx-actions--center">
			<a class="jx-btn jx-btn--primary" href={contactHref} data-analytics-event="contact_product">{detail.cta[locale]}<Icon name="arrow-right" /></a>
			<a class="jx-btn jx-btn--ghost" href={secondaryHref} {...(detail.secondary.external ? { target: '_blank', rel: 'noopener' } : {})}>{detail.secondary.label[locale]}{detail.secondary.external && <Icon name="arrow-up-right" />}</a>
		</div>
		{
			detail.command && (
				<div class="jx-command">
					<code><span aria-hidden="true">$</span> {detail.command}</code>
					<button type="button" class="jx-command__copy" data-copy={detail.command} data-copied={es ? 'Copiado' : 'Copied'}>{es ? 'Copiar' : 'Copy'}</button>
				</div>
			)
		}
		{demo && <DemoVideo demo={demo} locale={locale} class="jx-bots__stage" />}
		<dl class="jx-facts">
			{detail.facts.map((fact) => <div><dt data-nocount={/\d+\.\d+/.test(fact.value[locale]) ? '' : undefined}>{fact.value[locale]}</dt><dd>{fact.label[locale]}</dd></div>)}
		</dl>
		{product.status && <p class="pdp-status"><span class="jx-dot jx-dot--live" aria-hidden="true"></span>{product.status[locale]}</p>}
	</PageHero>

	<section class={next()} aria-labelledby="pdp-overview">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{detail.overview.label[locale]}</p>
			<h2 id="pdp-overview" class="jx-h2"><span>{detail.overview.title[locale][0]}</span>{' '}<span class="jx-soft">{detail.overview.title[locale][1]}</span></h2>
			<p class="jx-bots__lede">{detail.overview.lede[locale]}</p>
			<ul class="jx-iap__tasks pdp-tasks" style={`--cols: ${cols}`}>
				{
					rows.map((row) => (
						<li>
							<Icon name={row.icon} size="md" />
							<strong>{row.title[locale]}</strong>
							<dl>
								<div><dt>{detail.overview.beforeLabel[locale]}</dt><dd>{row.before[locale]}</dd></div>
								<div><dt>{detail.overview.afterLabel[locale]}</dt><dd>{row.after[locale]}</dd></div>
							</dl>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class={next()} id="como-funciona" aria-labelledby="pdp-how">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{detail.how.label[locale]}</p>
			<h2 id="pdp-how" class="jx-h2"><span>{detail.how.title[locale][0]}</span>{' '}<span class="jx-soft">{detail.how.title[locale][1]}</span></h2>
			<p class="jx-bots__lede">{detail.how.lede[locale]}</p>
			<HowStage
				locale={locale}
				scene={detail.scene}
				caption={detail.how.caption[locale]}
				steps={detail.how.steps.map((step) => ({ title: step.title[locale], text: step.text[locale] }))}
			>
				{detail.scene === 'daniela' && <DanielaScene locale={locale} />}
				{detail.scene === 'ahp' && <AhpScene locale={locale} />}
				{detail.scene === 'bloqio' && <BloqioScene locale={locale} />}
				{detail.scene === 'miawseo' && <MiawseoScene locale={locale} />}
			</HowStage>
		</div>
	</section>

	<section class={next()} aria-labelledby="pdp-included">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{detail.included.label[locale]}</p>
			<h2 id="pdp-included" class="jx-h2"><span>{detail.included.title[locale][0]}</span>{' '}<span class="jx-soft">{detail.included.title[locale][1]}</span></h2>
			<ul class="jx-points pdp-points">
				{detail.included.items.map((item) => <li><Icon name={item.icon} size="md" /><strong>{item.title[locale]}</strong><span>{item.text[locale]}</span></li>)}
			</ul>
		</div>
	</section>

	<section class={next()} aria-labelledby="pdp-limits">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{detail.limits.label[locale]}</p>
			<h2 id="pdp-limits" class="jx-h2"><span>{detail.limits.title[locale][0]}</span>{' '}<span class="jx-soft">{detail.limits.title[locale][1]}</span></h2>
			<div class="jx-iap__fit pdp-limits">
				<div class="is-yes">
					<p class="jx-mono">{detail.limits.doesLabel[locale]}</p>
					<ul>{detail.limits.does[locale].map((line) => <li><span class="jx-iap__mark" aria-hidden="true">✓</span>{line}</li>)}</ul>
				</div>
				<div class="is-no">
					<p class="jx-mono">{detail.limits.doesNotLabel[locale]}</p>
					<ul>{detail.limits.doesNot[locale].map((line) => <li><span class="jx-iap__mark" aria-hidden="true">–</span>{line}</li>)}</ul>
				</div>
			</div>
		</div>
	</section>

	<section class={next()} aria-labelledby="pdp-fit">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Para quién es' : 'Who it is for'}</p>
			<h2 id="pdp-fit" class="jx-h2"><span>{es ? 'Cuándo conviene' : 'When it makes sense'}</span>{' '}<span class="jx-soft">{es ? 'y cuándo todavía no' : 'and when it does not yet'}</span></h2>
			<div class="jx-iap__fit">
				<div class="is-yes">
					<p class="jx-mono">{es ? 'Conviene si' : 'It makes sense if'}</p>
					<ul>{detail.fit.yes[locale].map((line) => <li><span class="jx-iap__mark" aria-hidden="true">✓</span>{line}</li>)}</ul>
				</div>
				<div class="is-no">
					<p class="jx-mono">{es ? 'Todavía no, si' : 'Not yet, if'}</p>
					<ul>{detail.fit.no[locale].map((line) => <li><span class="jx-iap__mark" aria-hidden="true">–</span>{line}</li>)}</ul>
				</div>
			</div>
		</div>
	</section>

	{
		hasProofs && (
			<section class={next()} aria-labelledby="pdp-proofs">
				<div class="jx-wrap">
					<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Caso relacionado' : 'Related case'}</p>
					<h2 id="pdp-proofs" class="jx-h2"><span>{es ? 'El caso completo' : 'The full case'}</span>{' '}<span class="jx-soft">{es ? 'del proyecto' : 'for the project'}</span></h2>
					<JxProofCards locale={locale} slugs={product.proofSlugs} cases={cases} />
				</div>
			</section>
		)
	}

	<section class={next()} aria-labelledby="pdp-faq">
		<div class="jx-wrap jx-bots__faq">
			<div>
				<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Preguntas frecuentes' : 'FAQ'}</p>
				<h2 id="pdp-faq" class="jx-h2"><span>{es ? 'Lo que más me preguntan' : 'What people ask me most'}</span>{' '}<span class="jx-soft">{es ? `sobre ${title}` : `about ${title}`}</span></h2>
			</div>
			<div class="jx-bots__faq-list">
				{
					faq.map(([question, answer]) => (
						<details>
							<summary>{question}<Icon name="arrow-right" /></summary>
							<p>{answer}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<section class={next()} aria-labelledby="pdp-spec">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Ficha técnica' : 'Spec sheet'}</p>
			<h2 id="pdp-spec" class="jx-h2"><span>{es ? 'Datos clave' : 'Key facts'}</span>{' '}<span class="jx-soft">{es ? `de ${title}` : `about ${title}`}</span></h2>
			<dl class="pdp-spec">
				{detail.spec.map((row) => <div><dt>{row.term[locale]}</dt><dd>{row.detail[locale]}</dd></div>)}
			</dl>
		</div>
	</section>

	<section class="jx-close" aria-labelledby="pdp-close">
		<div class="jx-close__card">
			<h2 id="pdp-close" class="jx-close__title"><span>{detail.close.title[locale][0]}</span>{' '}<span class="jx-soft">{detail.close.title[locale][1]}</span></h2>
			<p>{detail.close.text[locale]}</p>
			<div class="jx-actions jx-actions--center">
				<a class="jx-btn jx-btn--primary" href={contactHref} data-analytics-event="contact_product_bottom">{detail.close.cta[locale]}<Icon name="arrow-right" /></a>
				<button class="jx-btn jx-btn--ghost" type="button" data-ai-open data-ai-ask={es ? `¿Cómo funciona ${title} y qué necesito para empezar?` : `How does ${title} work and what do I need to get started?`}>{es ? 'Pregúntale a Jossue AI' : 'Ask Jossue AI'}</button>
			</div>
		</div>
	</section>

	<nav class="pdp-more jx-wrap" aria-label={es ? 'Otros productos' : 'Other products'}>
		<p class="jx-mono">{es ? 'Otros productos' : 'Other products'}</p>
		<ul>
			{siblings.map((item) => <li><a href={productHref(item, locale)}>{item.title[locale]}<Icon name="arrow-right" /></a></li>)}
		</ul>
	</nav>
</article>
<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

<script>
	document.querySelectorAll<HTMLButtonElement>('.jx-pdp .jx-command__copy').forEach((button) => {
		const label = button.textContent;
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy ?? '');
				button.textContent = button.dataset.copied ?? label;
				window.setTimeout(() => (button.textContent = label), 1800);
			} catch {
				/* sin portapapeles: el comando sigue a la vista para copiarlo a mano */
			}
		});
	});
</script>
