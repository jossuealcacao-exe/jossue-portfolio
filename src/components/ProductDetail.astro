---
import type { CollectionEntry } from 'astro:content';
import type { CommercialProduct } from '../data/products';
import { commercialProducts, productDemo, productHref } from '../data/products';
import DemoVideo from './DemoVideo.astro';
import { casePresentation } from '../data/casePresentation';
import { routes, type Locale } from '../data/i18n';
import Icon from './Icon.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ChapterNav from './surface/ChapterNav.astro';
import Gallery from './surface/Gallery.astro';
import Panel from './surface/Panel.astro';
import { caseCover, workImage } from '../data/workImages';
import MediaSlot from './surface/MediaSlot.astro';
import Showcase from './surface/Showcase.astro';
import Specs from './surface/Specs.astro';
import Stage from './surface/Stage.astro';

interface Props {
	locale: Locale;
	product: CommercialProduct;
	cases: CollectionEntry<'cases'>[];
}

const { locale, product, cases } = Astro.props;
const es = locale === 'es';
const proofCases = product.proofSlugs.flatMap((slug) => {
	const entry = cases.find((item) => item.data.slug === slug);
	return entry ? [entry] : [];
});
// «Cómo avanzamos» muestra una pantalla de trabajo del proyecto, distinta de la portada.
const scopeKeys = proofCases.flatMap((entry) => (entry.data.media ?? []).map((item) => item.key)).filter((key) => workImage(key));
const scopeKey = scopeKeys[1] ?? scopeKeys[0];
const scopeImage = (scopeKey && workImage(scopeKey)) ?? caseCover(product.proofSlugs[0] ?? product.visualSlug);
const siblingProducts = commercialProducts.filter((item) => item.slug !== product.slug).slice(0, 3);
const contactHref = `${routes[locale].contact}?producto=${product.slug}`;
const demo = productDemo(product, locale);

const chapters = [
	{ href: '#alcance', label: es ? 'Qué incluye' : 'What is included' },
	{ href: '#encaje', label: es ? 'Para quién' : 'Who it is for' },
	{ href: '#recorrido', label: es ? 'Cómo avanzamos' : 'Process' },
	...(proofCases.length ? [{ href: '#pruebas', label: es ? 'Proyectos' : 'Projects' }] : []),
	{ href: '#detalle', label: es ? 'Ficha' : 'Specs' },
];

// La tabla de detalle recoge lo que la pagina ya dijo, para que el dato
// completo exista sin cobrarlo por adelantado en la lectura.
const specGroups = [
	{
		title: es ? 'Qué incluye' : 'What is included',
		rows: product.included[locale].map((item, index) => ({
			term: `${String(index + 1).padStart(2, '0')}`,
			detail: item,
		})),
	},
	{
		title: es ? 'Recorrido' : 'Process',
		rows: product.process[locale].map((step, index) => ({
			term: es ? `Paso ${index + 1}` : `Step ${index + 1}`,
			detail: step,
		})),
	},
	{
		title: es ? 'Encaje y condiciones' : 'Fit and conditions',
		rows: [
			{ term: es ? 'Ideal para' : 'Ideal for', detail: product.idealFor[locale] },
			{
				term: es ? 'Tipo' : 'Type',
				detail:
					product.kind === 'owned-product'
						? es ? 'Producto propio' : 'Owned product'
						: es ? 'Servicio entregado como producto' : 'Service delivered as a product',
			},
			...(product.status ? [{ term: es ? 'Estado' : 'Status', detail: product.status[locale] }] : []),
			{
				term: es ? 'Precio' : 'Price',
				detail: es
					? 'Te lo doy después de una llamada corta, cuando sepa qué necesitas.'
					: 'I share it after a short call, once I know what you need.',
			},
		],
	},
];
---

<article class="pdp" data-product-detail={product.slug}>
	<Breadcrumbs
		locale={locale}
		items={[
			{ label: es ? 'Productos' : 'Products', href: routes[locale].products },
			{ label: product.title[locale] },
		]}
	/>
	<ChapterNav
		title={product.title[locale]}
		links={chapters}
		cta={{ href: contactHref, label: es ? 'Hablar' : 'Talk' }}
	/>

	<Stage tone="ink" hero tall size="loose" class="pdp-hero">
		<p class="stage__eyebrow">{product.category[locale]}</p>
		<h1 class="stage__title">{product.title[locale]}</h1>
		<p class="stage__lede">{product.promise[locale]}</p>
		<div class="stage__actions">
			<a class="pill" href={contactHref} data-analytics-event="contact_product">
				{es ? 'Quiero esto para mi negocio' : 'I want this for my business'}
				<Icon name="arrow-right" />
			</a>
			<a class="pill pill--ghost" href={routes[locale].products}>{es ? 'Volver al catálogo' : 'Back to catalog'}</a>
		</div>
		{product.status && <p class="pdp__status">{product.status[locale]}</p>}
	</Stage>

	{demo ? (
		<div class="jx-wrap pdp__demo"><DemoVideo demo={demo} locale={locale} /></div>
	) : null}
	{product.slug === 'daniela' && (
		<aside class="pdp__bots" aria-label={es ? 'Chatbots para tu negocio' : 'Chatbots for your business'}>
			<div>
				<p class="jx-mono">{es ? 'Para tu negocio' : 'For your business'}</p>
				<h2>{es ? '¿Quieres una Daniela para tu tienda?' : 'Want a Daniela for your store?'}</h2>
				<p>{es ? 'Construyo chatbots como ella para otras marcas: con tu catálogo, tus pedidos y tu CRM, y con la misma seguridad del lado del servidor.' : 'I build chatbots like her for other brands: with your catalog, orders and CRM, and the same server-side security.'}</p>
			</div>
			<div class="jx-actions">
				<a class="jx-btn jx-btn--primary" href={`${routes[locale].products}chatbots/`}>{es ? 'Ver chatbots con IA' : 'See AI chatbots'}<Icon name="arrow-right" /></a>
				<a class="jx-btn jx-btn--ghost" href="https://wunutrition.com/" target="_blank" rel="noopener">{es ? 'Platica con Daniela' : 'Talk to Daniela'}<Icon name="arrow-up-right" /></a>
			</div>
		</aside>
	)}
	{!demo && <Panel
		src={caseCover(product.visualSlug)}
		alt={es ? `Proyecto relacionado con ${product.title[locale]}` : `Project related to ${product.title[locale]}`}
		slotId={`product-${product.slug}-hero`}
		ratio="21:9"
		label={es ? `Apertura de ${product.title[locale]}` : `${product.title[locale]} opening`}
		note={es
			? 'A sangre, de borde a borde. La imagen que sostiene la promesa: el entregable real, la pantalla de trabajo o la escena donde este producto ocurre.'
			: 'Full bleed, edge to edge. The image that carries the promise: the real deliverable, the working screen, or the scene where this product happens.'}
	/>}

	<Stage id="alcance" size="loose">
		<p class="stage__eyebrow">01 · {product.title[locale]}</p>
		<h2 class="stage__title">{es ? 'Qué incluye.' : 'What is included.'}</h2>
		<Gallery label={es ? 'Lo que incluye este producto' : 'What this product includes'} class="pdp__gallery">
			{product.included[locale].map((item, index) => (
				<article class="gallery-card">
					<p class="gallery-card__kicker">{String(index + 1).padStart(2, '0')}</p>
					<h3>{item}</h3>
				</article>
			))}
		</Gallery>
	</Stage>

	<Stage id="encaje" tone="ink" size="loose">
		<p class="stage__eyebrow">02 · {product.title[locale]}</p>
		<h2 class="stage__title">{es ? 'Para quién es.' : 'Who it is for.'}</h2>
		<p class="stage__lede">{product.idealFor[locale]}</p>
	</Stage>

	<Stage id="recorrido" size="loose">
		<p class="stage__eyebrow">03 · {product.title[locale]}</p>
		<h2 class="stage__title">{es ? 'Cómo avanzamos.' : 'How we move forward.'}</h2>
		<Showcase class="pdp__showcase showcase--compact">
			<MediaSlot
				slot="media"
				id={`product-${product.slug}-scope`}
				ratio="4:3"
				src={scopeImage}
				focus="50% 0%"
				alt={es ? `Entregable de ${product.title[locale]}` : `${product.title[locale]} deliverable`}
				label={es ? 'El entregable' : 'The deliverable'}
				note={es
					? 'Queda fija mientras se lee el recorrido. Una sola pieza: el documento, el tablero o la interfaz que se entrega.'
					: 'Stays pinned while the process is read. A single piece: the document, the board, or the interface delivered.'}
			/>
			{product.process[locale].map((step, index) => (
				<div class="showcase__beat" data-rise>
					<span class="showcase__index">{es ? `Paso ${index + 1}` : `Step ${index + 1}`}</span>
					<h3>{step}</h3>
				</div>
			))}
		</Showcase>
	</Stage>


	{proofCases.length > 0 && (
		<Stage id="pruebas" size="loose">
			<p class="stage__eyebrow">04 · {product.title[locale]}</p>
			<h2 class="stage__title">{es ? 'Proyectos relacionados.' : 'Related projects.'}</h2>
			<div class="pdp__proof">
				{proofCases.map((entry) => {
					const presented = casePresentation(entry.data.slug, locale);
					return (
					<a class="tile" href={`${routes[locale].work}${entry.data.slug}/`} data-rise>
						<MediaSlot
							id={`product-${product.slug}-proof-${entry.data.slug}`}
							ratio="4:3"
							src={caseCover(entry.data.slug)}
							alt={es ? `Portada de ${entry.data.title}` : `${entry.data.title} cover`}
							variant="soft"
							label={es ? `Portada de ${entry.data.title}` : `${entry.data.title} cover`}
							note={es ? 'Captura real del proyecto.' : 'Real capture of the project.'}
						/>
						<div class="tile__body">
							<h3>{entry.data.title}</h3>
							<p>{presented?.summary ?? ''}</p>
							<span class="tile__cue">{es ? 'Abrir caso' : 'Open case'}<Icon name="arrow-right" /></span>
						</div>
					</a>
					);
				})}
			</div>
		</Stage>
	)}

	<Stage id="detalle" size="loose">
		<p class="stage__eyebrow">05 · {product.title[locale]}</p>
		<h2 class="stage__title">{es ? 'La ficha completa.' : 'The full spec sheet.'}</h2>
		<div class="pdp__specs"><Specs groups={specGroups} /></div>
	</Stage>

	<Stage tone="ink" size="loose" class="pdp__close conversion-chapter">
		<p class="stage__eyebrow">{es ? 'Siguiente paso' : 'Next step'}</p>
		<h2 class="stage__title">{es ? 'Cuéntame qué estás intentando resolver.' : 'Tell me what you are trying to solve.'}</h2>
		<p class="stage__lede">
			{es
				? 'Cuéntame tu caso y te digo si esto te sirve, qué falta definir o si conviene empezar por otro lado.'
				: 'Tell me about your case and I will tell you whether this fits, what still needs defining, or whether to start somewhere else.'}
		</p>
		<div class="stage__actions">
			<a class="pill pill--soft" href={contactHref} data-analytics-event="contact_product_bottom">
				{es ? 'Iniciar conversación' : 'Start a conversation'}
				<Icon name="arrow-right" />
			</a>
		</div>
	</Stage>

	<Stage size="tight" class="pdp__related">
		<p class="stage__eyebrow">{es ? 'Otras rutas' : 'Other routes'}</p>
		<ul class="pdp__related-list">
			{siblingProducts.map((item) => (
				<li>
					<a class="pill pill--soft" href={productHref(item, locale)}>
						{item.title[locale]}
						<Icon name="arrow-right" />
					</a>
				</li>
			))}
		</ul>
	</Stage>
</article>
