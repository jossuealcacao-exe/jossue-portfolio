---
import { madreCopy, madreFacts } from '../data/madre';
import { routes, type Locale } from '../data/i18n';
import '../styles/madre.css';
import Icon from './Icon.astro';
import MediaSlot from './surface/MediaSlot.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';
const m = madreCopy(locale);
const ids = {
	install: es ? 'instalar' : 'install',
	flow: es ? 'como-funciona' : 'how-it-works',
	permissions: es ? 'permisos' : 'permissions',
	evidence: es ? 'evidencia' : 'evidence',
	resources: es ? 'recursos' : 'resources',
};
const site = Astro.site ?? new URL('https://portfolio.invalid');
const pageUrl = new URL(routes[locale].madre, site);
const softwareJson = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	'@id': `${pageUrl.href}#software`,
	name: 'MADRE',
	description: m.lede,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'macOS, Linux',
	softwareVersion: madreFacts.version,
	isAccessibleForFree: true,
	license: madreFacts.license,
	codeRepository: madreFacts.github,
	downloadUrl: madreFacts.npm,
	softwareRequirements: 'Node.js 22.5 or newer; at least one supported agent CLI',
	inLanguage: ['es', 'en'],
	url: pageUrl.href,
};
---

<article
	class="madre-product"
	data-madre-page
	data-copy-label={m.install.copy}
	data-copied-label={m.install.copied}
	data-copy-failed-label={m.install.failed}
>
	<nav class="madre-product__index" aria-label={es ? 'Contenido de MADRE' : 'MADRE contents'}>
		<div class="madre-product__index-inner">
			<a class="madre-product__wordmark" href={`#${ids.install}`}>MADRE</a>
			<ul>
				{m.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
			</ul>
			<a class="madre-product__github" href={madreFacts.github} target="_blank" rel="noreferrer">
				{es ? 'Ver en GitHub' : 'View on GitHub'} <Icon name="arrow-up-right" />
			</a>
		</div>
	</nav>

	<section class="madre-product__hero" aria-labelledby="madre-title">
		<div class="madre-product__frame">
			<div class="madre-product__hero-grid">
				<header class="madre-product__hero-copy">
					<p class="madre-product__eyebrow">{m.eyebrow}</p>
					<h1 id="madre-title">{m.title}</h1>
					<p class="madre-product__lede">{m.lede}</p>
				</header>
				<aside class="madre-product__aside" aria-label={es ? 'En una frase' : 'In one sentence'}>
					<p>{m.aside}</p>
					<span>{es ? 'Local por diseño' : 'Local by design'}</span>
				</aside>
			</div>

			<section class="madre-install" id={ids.install} aria-labelledby="madre-install-title">
				<div class="madre-install__head">
					<div>
						<p class="madre-product__eyebrow">{es ? 'INSTALACIÓN' : 'INSTALLATION'}</p>
						<h2 id="madre-install-title">{m.install.title}</h2>
					</div>
					<p>{m.install.intro}</p>
				</div>

				<div class="madre-install__console">
					<div class="madre-install__tabs" role="tablist" aria-label={es ? 'Sistema operativo' : 'Operating system'}>
						{m.install.platforms.map((platform, index) => (
							<button
								id={`madre-tab-${platform.id}-${locale}`}
								type="button"
								role="tab"
								aria-selected={index === 0 ? 'true' : 'false'}
								aria-controls={`madre-panel-${platform.id}-${locale}`}
								tabindex={index === 0 ? 0 : -1}
								data-madre-os-tab={platform.id}
							>
								<img src={platform.id === 'macos' ? '/tools/apple.svg' : '/tools/linux.svg'} alt="" width="22" height="22" />
								<span>{platform.label}</span>
							</button>
						))}
					</div>
					<div class="madre-install__command">
						<span aria-hidden="true">$</span>
						<code>{madreFacts.startCommand}</code>
						<button type="button" data-copy-value={madreFacts.startCommand}>{m.install.copy}</button>
					</div>
				</div>

				<div class="madre-install__support">
					<div>
						{m.install.platforms.map((platform, index) => (
							<p
								id={`madre-panel-${platform.id}-${locale}`}
								role="tabpanel"
								aria-labelledby={`madre-tab-${platform.id}-${locale}`}
								hidden={index !== 0}
								data-madre-os-panel={platform.id}
							>
								{platform.note}
							</p>
						))}
					</div>
					<ul>
						{m.install.requirements.map((item) => <li>{item}</li>)}
					</ul>
					<p class="madre-install__status" role="status" aria-live="polite" data-copy-status></p>
				</div>
			</section>

			<section class="madre-quickstart" aria-labelledby="madre-quickstart-title">
				<header>
					<p class="madre-product__eyebrow">{m.quickstart.eyebrow}</p>
					<h2 id="madre-quickstart-title">{m.quickstart.title}</h2>
				</header>
				<ol>
					{m.quickstart.steps.map((step, index) => (
						<li>
							<div class="madre-quickstart__step">
								<span>{step.number}</span>
								<h3>{step.title}</h3>
								<p>{step.text}</p>
								{step.command && (
									<div class="madre-quickstart__code">
										<code>{step.command}</code>
										<button type="button" data-copy-value={step.command}>{m.install.copy}</button>
									</div>
								)}
							</div>
							{index < m.quickstart.steps.length - 1 && <Icon name="arrow-right" class="madre-quickstart__arrow" />}
						</li>
					))}
				</ol>
			</section>
		</div>
	</section>

	<section class="madre-evidence" id={ids.evidence} aria-labelledby="madre-evidence-title">
		<div class="madre-product__frame">
			<header class="madre-section-head">
				<p class="madre-product__eyebrow">{m.evidence.eyebrow}</p>
				<div>
					<h2 id="madre-evidence-title">{m.evidence.title}</h2>
					<p>{m.evidence.text}</p>
				</div>
			</header>
			<div class="madre-gallery__controls">
				<button type="button" data-gallery-delta="-1"><Icon name="arrow-left" /> {m.gallery.previous}</button>
				<button type="button" data-gallery-delta="1">{m.gallery.next} <Icon name="arrow-right" /></button>
			</div>
			<div class="madre-gallery" data-madre-gallery tabindex="0" aria-label={m.gallery.title}>
				<figure class="madre-evidence__figure">
					<img
						src="/images/madre/room-0.4.0.webp"
						width="3200"
						height="2110"
						alt={m.evidence.alt}
						loading="eager"
						decoding="async"
						fetchpriority="high"
					/>
					<figcaption>{m.evidence.caption}</figcaption>
					<p data-madre-explanatory>{es ? 'ALCANCE DE LA EVIDENCIA' : 'EVIDENCE BOUNDARY'} · {m.evidence.disclosure}</p>
				</figure>
				{m.gallery.slots.map((slot) => (
					<MediaSlot id={slot.id} label={slot.title} note={slot.note} ratio={slot.ratio} variant="bleed" class="madre-gallery__slot" />
				))}
			</div>
		</div>
	</section>

	<section class="madre-flow" id={ids.flow} aria-labelledby="madre-flow-title">
		<div class="madre-product__frame">
			<header class="madre-section-head">
				<p class="madre-product__eyebrow">{m.flow.eyebrow}</p>
				<div>
					<h2 id="madre-flow-title">{m.flow.title}</h2>
					<p>{m.flow.text}</p>
				</div>
			</header>
			<ol class="madre-flow__steps">
				{m.flow.steps.map((step) => (
					<li>
						<span>{step.number}</span>
						<h3>{step.title}</h3>
						<p>{step.text}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="madre-permissions" id={ids.permissions} aria-labelledby="madre-permissions-title">
		<div class="madre-product__frame">
			<header class="madre-section-head madre-section-head--dark">
				<p class="madre-product__eyebrow">{m.permissions.eyebrow}</p>
				<div>
					<h2 id="madre-permissions-title">{m.permissions.title}</h2>
					<p>{m.permissions.text}</p>
				</div>
			</header>
			<ol class="madre-permissions__rail">
				{m.permissions.modes.map((mode) => (
					<li>
						<span>{mode.code}</span>
						<strong>{mode.name}</strong>
						<p>{mode.text}</p>
					</li>
				))}
			</ol>
			<p class="madre-permissions__warning">{m.permissions.warning}</p>
		</div>
	</section>

	<section class="madre-capabilities" aria-labelledby="madre-capabilities-title">
		<div class="madre-product__frame">
			<header class="madre-section-head">
				<p class="madre-product__eyebrow">{m.capabilities.eyebrow}</p>
				<h2 id="madre-capabilities-title">{m.capabilities.title}</h2>
			</header>
			<div class="madre-capabilities__list">
				{m.capabilities.items.map((item, index) => (
					<article>
						<span>{String(index + 1).padStart(2, '0')} · {item.label}</span>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="madre-details">
		<div class="madre-product__frame madre-details__grid">
			<section aria-labelledby="madre-compatibility-title">
				<p class="madre-product__eyebrow">{m.compatibility.eyebrow}</p>
				<h2 id="madre-compatibility-title">{m.compatibility.title}</h2>
				<p class="madre-details__intro">{m.compatibility.text}</p>
				<dl>
					{m.compatibility.items.map((item) => (
						<div><dt>{item.term}</dt><dd>{item.detail}</dd></div>
					))}
				</dl>
			</section>
			<section id={ids.resources} aria-labelledby="madre-resources-title">
				<p class="madre-product__eyebrow">{m.resources.eyebrow}</p>
				<h2 id="madre-resources-title">{m.resources.title}</h2>
				<ul>
					{m.resources.items.map((item) => (
						<li>
							<a href={item.href} target="_blank" rel="noreferrer">
								<span><strong>{item.label}</strong><small>{item.text}</small></span>
								<Icon name="arrow-up-right" />
							</a>
						</li>
					))}
				</ul>
			</section>
		</div>
	</section>

	<section class="madre-closing" aria-labelledby="madre-closing-title">
		<div class="madre-product__frame madre-closing__grid">
			<header>
				<p class="madre-product__eyebrow">{m.closing.eyebrow}</p>
				<h2 id="madre-closing-title">{m.closing.title}</h2>
				<p>{m.closing.text}</p>
			</header>
			<div class="madre-closing__actions">
				<button type="button" class="madre-closing__primary" data-copy-value={madreFacts.startCommand}>{m.closing.primary}</button>
				<a href={madreFacts.github} target="_blank" rel="noreferrer">{m.closing.secondary}<Icon name="arrow-up-right" /></a>
				<a href={routes[locale].contact} data-analytics-event="click_madre_contact">{m.closing.contact}<Icon name="arrow-right" /></a>
				<a href={routes[locale].ahpAtlas} data-analytics-event="click_madre_ahp">{m.closing.ahp}<Icon name="arrow-right" /></a>
			</div>
		</div>
	</section>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(softwareJson)} />
</article>

<script>
	const activateMadre = () => {
		document.querySelectorAll<HTMLElement>('[data-madre-page]').forEach((root) => {
			const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-madre-os-tab]')];
			const panels = [...root.querySelectorAll<HTMLElement>('[data-madre-os-panel]')];
			const setTab = (tab: HTMLButtonElement) => {
				const target = tab.dataset.madreOsTab;
				tabs.forEach((item) => {
					const active = item === tab;
					item.setAttribute('aria-selected', String(active));
					item.tabIndex = active ? 0 : -1;
				});
				panels.forEach((panel) => {
					panel.hidden = panel.dataset.madreOsPanel !== target;
				});
			};

			tabs.forEach((tab, index) => {
				tab.addEventListener('click', () => setTab(tab));
				tab.addEventListener('keydown', (event) => {
					if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
					event.preventDefault();
					const nextIndex = event.key === 'Home'
						? 0
						: event.key === 'End'
							? tabs.length - 1
							: (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
					setTab(tabs[nextIndex]);
					tabs[nextIndex].focus();
				});
			});

			const copyLabel = root.dataset.copyLabel ?? 'Copy';
			const copiedLabel = root.dataset.copiedLabel ?? 'Copied';
			const failedLabel = root.dataset.copyFailedLabel ?? 'Copy the command';
			const status = root.querySelector<HTMLElement>('[data-copy-status]');
			root.querySelectorAll<HTMLButtonElement>('[data-copy-value]').forEach((button) => {
				button.addEventListener('click', async () => {
					const value = button.dataset.copyValue ?? '';
					const copied = await navigator.clipboard.writeText(value).then(() => true).catch(() => false);
					button.textContent = copied ? copiedLabel : failedLabel;
					if (status) status.textContent = copied ? `${copiedLabel}: ${value}` : failedLabel;
					window.setTimeout(() => { button.textContent = copyLabel; }, 1800);
				});
			});

			const gallery = root.querySelector<HTMLElement>('[data-madre-gallery]');
			root.querySelectorAll<HTMLButtonElement>('[data-gallery-delta]').forEach((button) => {
				button.addEventListener('click', () => {
					if (!gallery) return;
					gallery.scrollBy({ left: gallery.clientWidth * Number(button.dataset.galleryDelta ?? 1), behavior: 'smooth' });
				});
			});
		});
	};

	activateMadre();
</script>
