---
// Página de MADRE con el sistema de madre.run (MADRE UX): negro, grafito, superficies sin bordes,
// rótulos mono y el verde fósforo como acento. Los colores de los modos solo viven en «Permisos».
import { madreCopy, madreFacts } from '../data/madre';
import { routes, type Locale } from '../data/i18n';
import DemoVideo from './DemoVideo.astro';
import Icon from './Icon.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';
const m = madreCopy(locale);
const ids = {
	install: es ? 'instalar' : 'install',
	flow: es ? 'como-funciona' : 'how-it-works',
	permissions: es ? 'permisos' : 'permissions',
	evidence: es ? 'evidencia' : 'evidence',
	resources: es ? 'recursos' : 'resources',
};
const V = '/videos/madre';
const clips = es
	? [
			{ key: 'anuncio', label: 'Anuncio · 30 s', title: 'Lo más destacado, en medio minuto.' },
			{ key: 'vertical', label: 'Vertical · 45 s', title: 'Contexto propio, seguridad y memoria.' },
			{ key: 'showcase', label: 'Demo · 1 min', title: 'Cuatro agentes construyen una app y un módulo.' },
		]
	: [
			{ key: 'anuncio', label: 'Ad · 30 s', title: 'The highlights, in half a minute.' },
			{ key: 'vertical', label: 'Vertical · 45 s', title: 'Own context, security and memory.' },
			{ key: 'showcase', label: 'Demo · 1 min', title: 'Four agents build an app and a module.' },
		];
const site = Astro.site ?? new URL('https://portfolio.invalid');
const pageUrl = new URL(routes[locale].madre, site);
const softwareJson = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	'@id': `${pageUrl.href}#software`,
	name: 'MADRE',
	description: m.lede,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'macOS, Linux',
	softwareVersion: madreFacts.version,
	isAccessibleForFree: true,
	license: madreFacts.license,
	codeRepository: madreFacts.github,
	downloadUrl: madreFacts.npm,
	url: madreFacts.site,
	softwareRequirements: 'Node.js 22.5 or newer; at least one supported agent CLI',
	inLanguage: ['es', 'en'],
	sameAs: [madreFacts.site, madreFacts.github, madreFacts.npm],
};
const [titleA, titleB] = m.title.includes(',') ? [m.title.slice(0, m.title.indexOf(',') + 1), m.title.slice(m.title.indexOf(',') + 1).trim()] : [m.title, ''];
---

<article
	class="jm"
	data-madre-page
	data-copy-label={m.install.copy}
	data-copied-label={m.install.copied}
	data-copy-failed-label={m.install.failed}
>
	<section class="jm-hero" aria-labelledby="madre-title">
		<p class="jx-label jx-label--madre"><span class="jx-dot" aria-hidden="true"></span>{m.eyebrow}</p>
		<p class="jx-wordmark jm-hero__mark" aria-hidden="true">
			<svg class="jx-pulse" viewBox="0 0 48 16" focusable="false"><path d="M1 8h10l3-6 5 12 4-9 2 3h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" /><circle cx="43.5" cy="8" r="2.6" fill="currentColor" /></svg>
			<span>MADRE</span>
		</p>
		<h1 id="madre-title" class="jm-hero__title"><span>{titleA}</span>{titleB && <span class="jx-soft">{titleB}</span>}</h1>
		<p class="jm-hero__lede">{m.lede}</p>
		<div class="jx-actions jx-actions--center">
			<a class="jx-btn jx-btn--madre" href={madreFacts.site} rel="noopener" data-analytics-event="click_madre_site">{es ? 'Ir a madre.run' : 'Go to madre.run'}<Icon name="arrow-up-right" /></a>
			<a class="jx-btn jx-btn--ghost" href={`#${ids.evidence}`}>{es ? 'Ver el showcase' : 'Watch the showcase'}</a>
		</div>
		<p class="jm-hero__aside">{m.aside}</p>
	</section>

	<section class="jm-install" id={ids.install} aria-labelledby="madre-install-title">
		<div class="jx-wrap jm-install__card">
			<div>
				<p class="jx-label jx-label--madre"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Instalar' : 'Install'}</p>
				<h2 id="madre-install-title" class="jx-h2">{m.install.title}</h2>
				<p class="jm-muted">{m.install.intro}</p>
			</div>
			<div>
				<div class="jm-tabs" role="tablist" aria-label={es ? 'Sistema operativo' : 'Operating system'}>
					{m.install.platforms.map((platform, index) => (
						<button
							id={`madre-tab-${platform.id}-${locale}`}
							type="button"
							role="tab"
							aria-selected={index === 0 ? 'true' : 'false'}
							aria-controls={`madre-panel-${platform.id}-${locale}`}
							tabindex={index === 0 ? 0 : -1}
							data-madre-os-tab={platform.id}
						>
							<img src={platform.id === 'macos' ? '/tools/apple.svg' : '/tools/linux.svg'} alt="" width="18" height="18" />
							<span>{platform.label}</span>
						</button>
					))}
				</div>
				<div class="madre-install__command jm-command">
					<span aria-hidden="true">$</span>
					<code>{madreFacts.startCommand}</code>
					<button type="button" data-copy-value={madreFacts.startCommand}>{m.install.copy}</button>
				</div>
				{m.install.platforms.map((platform, index) => (
					<p id={`madre-panel-${platform.id}-${locale}`} class="jm-muted jm-note" role="tabpanel" aria-labelledby={`madre-tab-${platform.id}-${locale}`} hidden={index !== 0} data-madre-os-panel={platform.id}>
						{platform.note}
					</p>
				))}
				<ul class="jm-reqs">
					{m.install.requirements.map((item) => <li>{item}</li>)}
				</ul>
				<p class="jm-status" role="status" aria-live="polite" data-copy-status></p>
			</div>
		</div>
		<div class="jx-wrap">
			<p class="jx-label jm-sub"><span class="jx-dot" aria-hidden="true"></span>{m.quickstart.eyebrow}</p>
			<h3 id="madre-quickstart-title" class="jm-h3">{m.quickstart.title}</h3>
			<ol class="jm-quick" aria-labelledby="madre-quickstart-title">
				{m.quickstart.steps.map((step) => (
					<li>
						<span class="jx-mono">{step.number}</span>
						<strong>{step.title}</strong>
						<p>{step.text}</p>
						{step.command && (
							<div class="jm-code"><code>{step.command}</code><button type="button" data-copy-value={step.command}>{m.install.copy}</button></div>
						)}
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="jm-showcase" id={ids.evidence} aria-labelledby="madre-evidence-title">
		<div class="jx-wrap">
			<p class="jx-label jx-label--madre"><span class="jx-dot" aria-hidden="true"></span>{m.evidence.eyebrow}</p>
			<h2 id="madre-evidence-title" class="jx-h2">{m.evidence.title}</h2>
			<p class="jm-muted jm-lede">{m.evidence.text}</p>
			<figure class="madre-evidence__figure jm-figure">
				<img src="/images/madre/room-0.5.2.webp" width="1920" height="1080" loading="lazy" decoding="async" alt={m.evidence.alt} />
				<figcaption><span class="jx-mono">{m.evidence.caption}</span></figcaption>
			</figure>
			<div class="jx-showcase__grid">
				{clips.map((clip) => (
					<article class:list={['jx-clip', `jx-clip--${clip.key}`]}>
						<DemoVideo
							demo={{ wide: `${V}/madre-${clip.key}`, tall: `${V}/madre-${clip.key}`, label: clip.label, alt: `${clip.label}. ${clip.title}` }}
							locale={locale}
							orientation="wide"
							class="jx-clip__video"
						/>
						<div class="jx-clip__caption">
							<p class="jx-mono">{clip.label}</p>
							<h3>{clip.title}</h3>
						</div>
					</article>
				))}
			</div>
			<figure class="jm-bento">
				<img src={`${V}/madre-bento.webp`} width="1080" height="1920" loading="lazy" decoding="async" alt={es ? 'Resumen de MADRE en formato vertical: una sala para cuatro agentes, 496,894 tokens ahorrados en esta sala, cada agente sabe lo que dijo el anterior, nada cambia sin tu permiso y tu memoria se queda en tu computadora.' : 'MADRE summary in vertical format: one room for four agents, 496,894 tokens saved in this room, each agent knows what the previous one said, nothing changes without your say, and your memory stays on your machine.'} />
				<figcaption>
					<span class="jx-mono">{es ? 'Para redes · 9:16' : 'For social · 9:16'}</span>
					<strong>{es ? 'Lo más destacado, en una imagen.' : 'The highlights, in one image.'}</strong>
					<p class="jm-muted" data-madre-explanatory>{m.evidence.disclosure}</p>
				</figcaption>
			</figure>
		</div>
	</section>

	<section class="jx-band" id={ids.flow} aria-labelledby="madre-flow-title">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{m.flow.eyebrow}</p>
			<h2 id="madre-flow-title" class="jx-h2">{m.flow.title}</h2>
			<p class="jm-muted jm-lede">{m.flow.text}</p>
			<ol class="jx-steps">
				{m.flow.steps.map((step) => (
					<li><span class="jx-mono">{step.number}</span><strong>{step.title}</strong><p>{step.text}</p></li>
				))}
			</ol>
		</div>
	</section>

	<section class="jm-perms" id={ids.permissions} aria-labelledby="madre-permissions-title">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{m.permissions.eyebrow}</p>
			<h2 id="madre-permissions-title" class="jx-h2">{m.permissions.title}</h2>
			<p class="jm-muted jm-lede">{m.permissions.text}</p>
			<ol class="jm-modes">
				{m.permissions.modes.map((mode, index) => (
					<li class={`jm-mode jm-mode--${index}`}>
						<span class="jm-mode__code">{mode.code}</span>
						<strong>{mode.name}</strong>
						<p>{mode.text}</p>
					</li>
				))}
			</ol>
			<p class="jm-warning">{m.permissions.warning}</p>
		</div>
	</section>

	<section class="jx-band" aria-labelledby="madre-capabilities-title">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{m.capabilities.eyebrow}</p>
			<h2 id="madre-capabilities-title" class="jx-h2">{m.capabilities.title}</h2>
			<ul class="jx-points jm-caps">
				{m.capabilities.items.map((item, index) => (
					<li>
						<Icon name={(['chats', 'layers', 'bolt', 'shield'] as const)[index] ?? 'cube'} size="md" />
						<strong>{item.title}</strong>
						<span>{item.text}</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="jm-details">
		<div class="jx-wrap jm-details__grid">
			<section aria-labelledby="madre-compatibility-title">
				<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{m.compatibility.eyebrow}</p>
				<h2 id="madre-compatibility-title" class="jm-h3">{m.compatibility.title}</h2>
				<p class="jm-muted">{m.compatibility.text}</p>
				<dl class="jm-dl">
					{m.compatibility.items.map((item) => (
						<div><dt>{item.term}</dt><dd>{item.detail}</dd></div>
					))}
				</dl>
			</section>
			<section id={ids.resources} aria-labelledby="madre-resources-title">
				<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{m.resources.eyebrow}</p>
				<h2 id="madre-resources-title" class="jm-h3">{m.resources.title}</h2>
				<ul class="jm-links">
					{m.resources.items.map((item) => (
						<li>
							<a href={item.href} target="_blank" rel="noreferrer">
								<span><strong>{item.label}</strong><small>{item.text}</small></span>
								<Icon name="arrow-up-right" />
							</a>
						</li>
					))}
				</ul>
			</section>
		</div>
	</section>

	<section class="jx-close" aria-labelledby="madre-closing-title">
		<div class="jx-close__card">
			<p class="jx-label jx-label--madre"><span class="jx-dot" aria-hidden="true"></span>{m.closing.eyebrow}</p>
			<h2 id="madre-closing-title" class="jx-close__title jm-close__title">{m.closing.title}</h2>
			<p>{m.closing.text}</p>
			<p class="jx-command"><code><span>$</span> {madreFacts.startCommand}</code></p>
			<div class="jx-actions jx-actions--center">
				<button type="button" class="jx-btn jx-btn--madre" data-copy-value={madreFacts.startCommand}>{m.closing.primary}</button>
				<a class="jx-btn jx-btn--ghost" href={madreFacts.github} target="_blank" rel="noreferrer">{m.closing.secondary}<Icon name="arrow-up-right" /></a>
			</div>
			<p class="jm-close__more">
				<a class="jx-link" href={routes[locale].contact} data-analytics-event="click_madre_contact">{m.closing.contact}<Icon name="arrow-right" /></a>
				<a class="jx-link" href={routes[locale].ahpAtlas} data-analytics-event="click_madre_ahp">{m.closing.ahp}<Icon name="arrow-right" /></a>
			</p>
		</div>
	</section>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(softwareJson)} />
</article>

<script>
	const activateMadre = () => {
		document.querySelectorAll<HTMLElement>('[data-madre-page]').forEach((root) => {
			const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-madre-os-tab]')];
			const panels = [...root.querySelectorAll<HTMLElement>('[data-madre-os-panel]')];
			const setTab = (tab: HTMLButtonElement) => {
				const target = tab.dataset.madreOsTab;
				tabs.forEach((item) => {
					const active = item === tab;
					item.setAttribute('aria-selected', String(active));
					item.tabIndex = active ? 0 : -1;
				});
				panels.forEach((panel) => {
					panel.hidden = panel.dataset.madreOsPanel !== target;
				});
			};

			tabs.forEach((tab, index) => {
				tab.addEventListener('click', () => setTab(tab));
				tab.addEventListener('keydown', (event) => {
					if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
					event.preventDefault();
					const nextIndex = event.key === 'Home'
						? 0
						: event.key === 'End'
							? tabs.length - 1
							: (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
					setTab(tabs[nextIndex]);
					tabs[nextIndex].focus();
				});
			});

			const copyLabel = root.dataset.copyLabel ?? 'Copy';
			const copiedLabel = root.dataset.copiedLabel ?? 'Copied';
			const failedLabel = root.dataset.copyFailedLabel ?? 'Copy the command';
			const status = root.querySelector<HTMLElement>('[data-copy-status]');
			root.querySelectorAll<HTMLButtonElement>('[data-copy-value]').forEach((button) => {
				button.addEventListener('click', async () => {
					const value = button.dataset.copyValue ?? '';
					const copied = await navigator.clipboard.writeText(value).then(() => true).catch(() => false);
					button.textContent = copied ? copiedLabel : failedLabel;
					if (status) status.textContent = copied ? `${copiedLabel}: ${value}` : failedLabel;
					window.setTimeout(() => { button.textContent = copyLabel; }, 1800);
				});
			});

			const gallery = root.querySelector<HTMLElement>('[data-madre-gallery]');
			root.querySelectorAll<HTMLButtonElement>('[data-gallery-delta]').forEach((button) => {
				button.addEventListener('click', () => {
					if (!gallery) return;
					gallery.scrollBy({ left: gallery.clientWidth * Number(button.dataset.galleryDelta ?? 1), behavior: 'smooth' });
				});
			});
		});
	};

	activateMadre();
</script>
