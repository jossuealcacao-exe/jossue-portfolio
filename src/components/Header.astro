---
import { equivalentPath, navigation, routes, type Locale } from '../data/i18n';

interface Props {
	locale: Locale;
	pathname: string;
	counterpartSlug?: string;
}

const { locale, pathname, counterpartSlug } = Astro.props;
const otherLocale: Locale = locale === 'es' ? 'en' : 'es';
const languagePath = equivalentPath(pathname, locale, otherLocale, counterpartSlug);
const menuLabel = locale === 'es' ? 'Menú' : 'Menu';
const isCurrent = (key: keyof typeof routes[typeof locale]) => {
	const href = routes[locale][key];
	return pathname === href || (key === 'work' && pathname.startsWith(href));
};
---

<header class="site-header">
	<div class="site-header__inner shell">
		<a class="brand" href={routes[locale].home} aria-label={`Jossue Alcalá — ${locale === 'es' ? 'inicio' : 'home'}`}>
			<span>Jossue Alcalá</span>
			<small>{locale === 'es' ? 'Crear y Construir' : 'Create and Build'}</small>
		</a>
		<nav class="nav" aria-label={locale === 'es' ? 'Navegación principal' : 'Primary navigation'}>
			<ul class="nav__links">
				{
					navigation[locale].map((item) => (
						<li>
							<a class:list={{ 'nav__cta': item.key === 'contact' }} href={routes[locale][item.key]} aria-current={isCurrent(item.key) ? 'page' : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
			<a class="language" href={languagePath} hreflang={otherLocale} lang={otherLocale} data-analytics-event="select_language">
				{otherLocale}
			</a>
			<details class="menu">
				<summary class="menu__toggle" aria-label={menuLabel}>
					<span class="menu__glyph" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="sr-only">{menuLabel}</span>
				</summary>
				<ul class="menu__panel">
					<li class="menu__masthead">
						<a class="menu__brand" href={routes[locale].home}>Jossue Alcalá</a>
						<a class="menu__lang" href={languagePath} hreflang={otherLocale} lang={otherLocale} data-analytics-event="select_language">
							{otherLocale}
						</a>
					</li>
					{
						navigation[locale].map((item) => (
							<li>
								<a class:list={{ 'menu__cta': item.key === 'contact' }} href={routes[locale][item.key]} aria-current={isCurrent(item.key) ? 'page' : undefined}>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</details>
		</nav>
	</div>
</header>
