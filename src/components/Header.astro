---
import { equivalentPath, navigation, routes, type Locale } from '../data/i18n';
import Icon from './Icon.astro';

interface Props {
	locale: Locale;
	pathname: string;
	counterpartSlug?: string;
}

const { locale, pathname, counterpartSlug } = Astro.props;
const otherLocale: Locale = locale === 'es' ? 'en' : 'es';
const languagePath = equivalentPath(pathname, locale, otherLocale, counterpartSlug);
const menuLabel = locale === 'es' ? 'Menú' : 'Menu';
const menuLead = locale === 'es' ? 'Producto, trabajo y trayectoria' : 'Product, work, and track record';
const isCurrent = (key: keyof typeof routes[typeof locale]) => {
	const href = routes[locale][key];
	return pathname === href || (key === 'work' && pathname.startsWith(href)) || (key === 'products' && (pathname.startsWith(href) || pathname === routes[locale].madre));
};
---

<header class="global-nav" data-global-nav>
	<div class="global-nav__bar">
		<a class="global-nav__brand" href={routes[locale].home} aria-label={`Jossue Alcalá — ${locale === 'es' ? 'inicio' : 'home'}`}>
			<img class="global-nav__mark" src="/images/brand/jossue-mark.svg" alt="" width="36" height="36" aria-hidden="true" />
			<span class="global-nav__brand-text">
				<span class="global-nav__brand-name">Jossue Alcalá</span>
				<small>{locale === 'es' ? 'Crear · Construir' : 'Create · Build'}</small>
			</span>
		</a>
		<nav class="global-nav__primary" aria-label={locale === 'es' ? 'Navegación principal' : 'Primary navigation'}>
			<ul class="global-nav__links">
				{
					navigation[locale].map((item, index) => (
						<li>
							<a href={routes[locale][item.key]} aria-current={isCurrent(item.key) ? 'page' : undefined}>
								<span class="global-nav__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
								<span>{item.label}</span>
							</a>
						</li>
					))
				}
			</ul>
			<a class="global-nav__language" href={languagePath} hreflang={otherLocale} lang={otherLocale} data-analytics-event="select_language">
				{otherLocale}
			</a>
			<details class="global-nav__drawer">
				<summary class="global-nav__trigger" aria-label={menuLabel}>
					<span aria-hidden="true">{menuLabel}</span>
					<span class="global-nav__menu-icon global-nav__menu-icon--open" aria-hidden="true"><Icon name="menu" /></span>
					<span class="global-nav__menu-icon global-nav__menu-icon--close" aria-hidden="true"><Icon name="close" /></span>
				</summary>
				<div class="global-nav__sheet">
					<div class="global-nav__sheet-inner">
						<div class="global-nav__sheet-head">
							<p>{menuLead}</p>
							<span aria-hidden="true">{locale === 'es' ? 'Índice' : 'Index'}</span>
						</div>
						<ol class="global-nav__index">
							{
								navigation[locale].map((item, index) => (
									<li>
										<a href={routes[locale][item.key]} aria-current={isCurrent(item.key) ? 'page' : undefined}>
											<span class="global-nav__index-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
											<span>{item.label}</span>
											<Icon name="arrow-up-right" />
										</a>
									</li>
								))
							}
						</ol>
						<div class="global-nav__sheet-actions">
							<a class="jx-btn jx-btn--primary" href={routes[locale].contact} data-analytics-event="menu_contact">{locale === 'es' ? 'Escríbeme' : 'Write to me'}<Icon name="arrow-right" /></a>
						</div>
						<div class="global-nav__sheet-foot">
							<a href={routes[locale].home}>{locale === 'es' ? 'Volver al inicio' : 'Back home'}</a>
							<a href={languagePath} hreflang={otherLocale} lang={otherLocale} data-analytics-event="select_language">
								{locale === 'es' ? 'View in English' : 'Ver en español'}
							</a>
						</div>
					</div>
				</div>
			</details>
		</nav>
	</div>
</header>

<!--
	Burbuja de navegación, con la regla de apple.com: el menú de arriba se va con el scroll y,
	al pasar el hero, baja esta barra flotante (redondeada, de cristal, a 10 px del borde).
	Se queda visible también al subir y se esconde al volver arriba. En las fichas de producto
	la burbuja es el propio submenú de la ficha, así que esta no aparece.
-->
<div class="site-bubble" data-site-bubble aria-hidden="true" inert>
	<nav class="site-bubble__wrap" aria-label={locale === 'es' ? 'Navegación rápida' : 'Quick navigation'}>
		<a class="site-bubble__brand" href={routes[locale].home}><img src="/images/brand/jossue-mark.svg" alt="" width="26" height="26" aria-hidden="true" />Jossue Alcalá</a>
		<ul class="site-bubble__links">
			{navigation[locale].map((item) => (
				<li><a href={routes[locale][item.key]} aria-current={isCurrent(item.key) ? 'page' : undefined}>{item.label}</a></li>
			))}
		</ul>
		<div class="site-bubble__actions">
			<button class="site-bubble__cta site-bubble__cta--ghost" type="button" data-ai-open>Jossue AI</button>
			<a class="site-bubble__cta" href={routes[locale].contact} data-analytics-event="bubble_contact">{locale === 'es' ? 'Escríbeme' : 'Write to me'}</a>
			<button class="site-bubble__menu" type="button" data-bubble-menu aria-label={menuLabel}><Icon name="menu" /></button>
		</div>
	</nav>
</div>
