---
// Aviso de cookies. Nada de medición ni publicidad se carga sin permiso: Google entra con el modo de
// consentimiento v2 (todo «denied» por defecto) y el pixel de Meta ni siquiera se descarga hasta que
// la persona acepta la publicidad. La opción de publicidad solo aparece si hay pixel o Google Ads.
// Lo que dice este aviso tiene que coincidir con el apartado 6 de PrivacyPage.astro.
import { analyticsConfig } from '../data/analytics';
import { routes, type Locale } from '../data/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { ga4Id, metaPixelId, googleAdsId, googleAdsLeadLabel } = analyticsConfig;
const ads = Boolean(metaPixelId || googleAdsId);
const es = locale === 'es';
const copy = es
	? {
		label: 'Preferencias de cookies',
		text: ads
			? 'Uso Google Analytics para saber qué contenido sirve y, si lo aceptas, cookies de publicidad de Meta y Google para medir mis anuncios y mostrártelos.'
			: 'Uso Google Analytics para entender qué contenido resulta útil y mejorar el sitio.',
		all: ads ? 'Aceptar todo' : 'Aceptar analítica',
		analytics: 'Solo analítica',
		reject: ads ? 'Rechazar todo' : 'Continuar sin analítica',
		more: 'Aviso de privacidad',
	}
	: {
		label: 'Cookie preferences',
		text: ads
			? 'I use Google Analytics to learn which content is useful and, if you accept, Meta and Google advertising cookies to measure my ads and show them to you.'
			: 'I use Google Analytics to understand which content is useful and improve the site.',
		all: ads ? 'Accept all' : 'Accept analytics',
		analytics: 'Analytics only',
		reject: ads ? 'Reject all' : 'Continue without analytics',
		more: 'Privacy notice',
	};
---

{
	(ga4Id || ads) && (
		<aside
			class="analytics-consent"
			data-analytics-consent
			data-measurement-id={ga4Id ?? ''}
			data-ads-id={googleAdsId ?? ''}
			data-ads-lead={googleAdsId && googleAdsLeadLabel ? `${googleAdsId}/${googleAdsLeadLabel}` : ''}
			data-pixel-id={metaPixelId ?? ''}
			aria-label={copy.label}
			hidden
		>
			<p>{copy.text} <a href={routes[locale].privacy}>{copy.more}</a></p>
			<div class="analytics-consent__actions">
				<button type="button" class="button" data-analytics-accept>{copy.all}</button>
				{ads && ga4Id && <button type="button" class="analytics-consent__secondary" data-analytics-only>{copy.analytics}</button>}
				<button type="button" class="analytics-consent__reject" data-analytics-reject>{copy.reject}</button>
			</div>
		</aside>
	)
}

<script>
	type Choice = { analytics: boolean; ads: boolean };
	const STORAGE_KEY = 'jossue-consent';
	const OLD_KEY = 'jossue-analytics-consent';
	const consent = document.querySelector<HTMLElement>('[data-analytics-consent]');

	const read = (key: string) => {
		try {
			return localStorage.getItem(key);
		} catch {
			return null;
		}
	};
	const write = (choice: Choice) => {
		try {
			localStorage.setItem(STORAGE_KEY, JSON.stringify(choice));
		} catch {
			// Sin almacenamiento la elección dura lo que dura la página; se vuelve a preguntar después.
		}
	};

	function saved(adsOffered: boolean): Choice | null {
		try {
			const choice = JSON.parse(read(STORAGE_KEY) ?? 'null');
			if (choice && typeof choice.analytics === 'boolean' && typeof choice.ads === 'boolean') return choice;
		} catch {
			// Un valor dañado cuenta como «sin elegir».
		}
		// Quien eligió antes de que existiera la publicidad: un «no» se respeta para todo; un «sí» a la
		// analítica no es un «sí» a la publicidad, así que solo se vuelve a preguntar si hay publicidad.
		const old = read(OLD_KEY);
		if (old === 'denied') return { analytics: false, ads: false };
		if (old === 'granted' && !adsOffered) return { analytics: true, ads: false };
		return null;
	}

	function google(choice: Choice, ga4: string, adsId: string) {
		const wanted = (choice.analytics && ga4) || (choice.ads && adsId);
		if (!window.gtag) {
			if (!wanted) return;
			window.dataLayer ??= [];
			window.gtag = function gtag() {
				// eslint-disable-next-line prefer-rest-params -- gtag.js consumes the Arguments object.
				window.dataLayer?.push(arguments);
			};
			window.gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
			window.gtag('js', new Date());
			const script = document.createElement('script');
			script.async = true;
			script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(ga4 || adsId)}`;
			script.dataset.ga4 = ga4 || adsId;
			document.head.append(script);
		}
		const ads = choice.ads ? 'granted' : 'denied';
		window.gtag('consent', 'update', { analytics_storage: choice.analytics ? 'granted' : 'denied', ad_storage: ads, ad_user_data: ads, ad_personalization: ads });
		const configured = (window.__jxGoogle ??= new Set<string>());
		if (choice.analytics && ga4 && !configured.has(ga4)) {
			configured.add(ga4);
			window.gtag('config', ga4, { anonymize_ip: true });
		}
		if (choice.ads && adsId && !configured.has(adsId)) {
			configured.add(adsId);
			// Sin conversiones mejoradas: a Google no se le manda ni nombre ni correo.
			window.gtag('config', adsId, { allow_enhanced_conversions: false });
		}
	}

	function meta(choice: Choice, pixelId: string) {
		if (!pixelId) return;
		if (!choice.ads) {
			window.fbq?.('consent', 'revoke');
			return;
		}
		if (!window.fbq) {
			const fbq = function (...args: unknown[]) {
				if (fbq.callMethod) fbq.callMethod(...args);
				else fbq.queue.push(args);
			} as FbqStub;
			fbq.push = fbq;
			fbq.loaded = true;
			fbq.version = '2.0';
			fbq.queue = [];
			window.fbq = fbq;
			window._fbq = fbq;
			const script = document.createElement('script');
			script.async = true;
			script.src = 'https://connect.facebook.net/en_US/fbevents.js';
			document.head.append(script);
			fbq('consent', 'grant');
			// Sin coincidencia avanzada: a Meta no se le manda ni nombre ni correo.
			fbq('init', pixelId);
			fbq('track', 'PageView');
			return;
		}
		window.fbq('consent', 'grant');
	}

	if (consent) {
		const ga4 = consent.dataset.measurementId ?? '';
		const adsId = consent.dataset.adsId ?? '';
		const pixelId = consent.dataset.pixelId ?? '';
		const adsOffered = Boolean(adsId || pixelId);
		const apply = (choice: Choice) => {
			google(choice, ga4, adsId);
			meta(choice, pixelId);
		};
		const choose = (choice: Choice) => {
			write(choice);
			consent.hidden = true;
			apply(choice);
		};

		const current = saved(adsOffered);
		if (current) apply(current);
		else consent.hidden = false;

		consent.querySelector('[data-analytics-accept]')?.addEventListener('click', () => choose({ analytics: Boolean(ga4), ads: adsOffered }));
		consent.querySelector('[data-analytics-only]')?.addEventListener('click', () => choose({ analytics: true, ads: false }));
		consent.querySelector('[data-analytics-reject]')?.addEventListener('click', () => choose({ analytics: false, ads: false }));
		// «Preferencias de cookies» en el pie: vuelve a mostrar el aviso para cambiar la elección.
		document.addEventListener('click', (event) => {
			const trigger = (event.target as HTMLElement | null)?.closest('[data-consent-open]');
			if (!trigger) return;
			event.preventDefault();
			consent.hidden = false;
			consent.querySelector<HTMLButtonElement>('button')?.focus();
		});
	}
</script>

<style>
	.analytics-consent {
		position: fixed;
		right: clamp(1rem, 3vw, 2rem);
		bottom: clamp(1rem, 3vw, 2rem);
		z-index: 80;
		display: grid;
		gap: 1rem;
		width: min(28rem, calc(100vw - 2rem));
		padding: 1.25rem;
		border: 1px solid var(--line);
		background: color-mix(in srgb, var(--paper) 94%, transparent);
		box-shadow: 0 1rem 3rem rgb(0 0 0 / 12%);
		backdrop-filter: blur(18px) saturate(130%);
	}

	.analytics-consent[hidden] {
		display: none;
	}

	.analytics-consent p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.analytics-consent p a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.analytics-consent__actions {
		display: flex;
		align-items: center;
		gap: 0.75rem 1rem;
		flex-wrap: wrap;
	}

	.analytics-consent .button {
		min-height: 2.75rem;
		padding: 0.75rem 1rem;
	}

	.analytics-consent__secondary,
	.analytics-consent__reject {
		min-height: 2.75rem;
		padding: 0.5rem 0;
		border: 0;
		background: transparent;
		color: var(--ink-muted);
		font: inherit;
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 0.2em;
		cursor: pointer;
	}

	.analytics-consent__secondary {
		color: inherit;
	}

	@media (max-width: 40rem) {
		.analytics-consent {
			left: 1rem;
			right: 1rem;
			bottom: 1rem;
			width: auto;
		}
	}
</style>
