---
import type { Locale } from '../data/i18n';
import CopyGlyph from './CopyGlyph.astro';

interface Props {
	command: string;
	label: string;
	locale: Locale;
	compact?: boolean;
}

const { command, label, locale, compact = false } = Astro.props;
---

<div class:list={['ahp-atlas__code', { 'ahp-atlas__code--compact': compact }]}>
	<div>
		<span>{label}</span>
		<button type="button" data-copy-value={command} title={locale === 'es' ? 'Copiar comando' : 'Copy command'}>
			<CopyGlyph />
			<span class="sr-only" data-copy-feedback>{locale === 'es' ? 'Copiar comando' : 'Copy command'}</span>
		</button>
	</div>
	<pre><code>{command}</code></pre>
</div>
