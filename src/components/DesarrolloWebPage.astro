---
// Desarrollo web (servicio): qué construyo, qué cambia cuando está bien hecho, proyectos reales,
// cómo avanzamos, con qué trabajo y cierre. Mismo sistema visual que chatbots e IA aplicada.
import type { CollectionEntry } from 'astro:content';
import { routes, type Locale } from '../data/i18n';
import { workImage } from '../data/workImages';
import Breadcrumbs from './Breadcrumbs.astro';
import AuditCta from './AuditCta.astro';
import { AUDIT_ENABLED } from '../data/features';
import Icon, { type IconName } from './Icon.astro';
import JxProofCards from './JxProofCards.astro';
import PageHero from './PageHero.astro';

interface Props {
	locale: Locale;
	cases: CollectionEntry<'cases'>[];
}

const { locale, cases } = Astro.props;
const es = locale === 'es';
const contactUrl = `${routes[locale].contact}?producto=desarrollo-web`;
const desk = workImage('cv-home-desktop');
const phone = workImage('wu-home-campaign');

type Card = { icon: IconName; title: string; text: string };
const builds: Card[] = es
	? [
			{ icon: 'basket', title: 'Tiendas en Shopify', text: 'Armo la plantilla completa de tu tienda con el sistema de bloques de Shopify (Online Store 2.0). Tú o tu equipo arman páginas nuevas sin tocar código.' },
			{ icon: 'display', title: 'Rediseños', text: 'Cambio lo que está frenando tus ventas y cuido lo que ya funciona, como tu lugar en Google, tus mediciones y tus textos.' },
			{ icon: 'layers', title: 'Partes nuevas para tu tienda', text: 'Carruseles, comparadores, paquetes de productos o reseñas. Lo que tu plantilla no trae, hecho para que lo vuelvas a usar en otras páginas.' },
			{ icon: 'cube', title: 'Apps y funciones', text: 'Cuando ninguna app hace lo que necesitas, la programo. Así nacieron Prometeo y Hermes.' },
			{ icon: 'nodes', title: 'Conexión con tus sistemas', text: 'Conecto tu tienda con tu sistema administrativo (ERP), tu lista de clientes (CRM), tu correo y los marketplaces donde vendes, para que nadie copie datos a mano.' },
			{ icon: 'code', title: 'Páginas y herramientas fuera de Shopify', text: 'Páginas que abren rápido y herramientas hechas para un negocio en particular, como este sitio o MADRE.' },
		]
	: [
			{ icon: 'basket', title: 'Shopify stores', text: 'I build your store’s full template with Shopify’s block system (Online Store 2.0). You or your team put together new pages without touching code.' },
			{ icon: 'display', title: 'Redesigns', text: 'I change what is holding back your sales and protect what already works, like your place on Google, your tracking and your text.' },
			{ icon: 'layers', title: 'New parts for your store', text: 'Carousels, comparisons, product bundles or reviews. What your template does not include, built so you can reuse it on other pages.' },
			{ icon: 'cube', title: 'Apps and features', text: 'When no app does what you need, I build it. That is how Prometeo and Hermes happened.' },
			{ icon: 'nodes', title: 'Connections to your systems', text: 'I connect your store to your back-office system (ERP), your customer list (CRM), your email and the marketplaces where you sell, so nobody copies data by hand.' },
			{ icon: 'code', title: 'Websites and tools outside Shopify', text: 'Websites that open fast and tools built for one specific business, like this site or MADRE.' },
		];

const qualities: Card[] = es
	? [
			{ icon: 'mobile', title: 'Rápida en celular', text: 'Mido cuánto tarda en abrir antes de empezar y después de entregar, con datos de visitantes reales.' },
			{ icon: 'pen', title: 'La puedes cambiar tú', text: 'Para cambiar un banner o una categoría de productos no tienes que llamar a un programador.' },
			{ icon: 'pulse', title: 'Mide tus ventas desde el primer día', text: 'Dejo Google Analytics y los píxeles de tus anuncios registrando cada compra, y lo reviso antes de lanzar.' },
			{ icon: 'check-list', title: 'Con manual y notas', text: 'Te entrego las pruebas que hice, por qué decidí cada cosa y un manual corto para quien la trabaje después.' },
		]
	: [
			{ icon: 'mobile', title: 'Fast on mobile', text: 'I measure how long it takes to open before I start and after I deliver, with data from real visitors.' },
			{ icon: 'pen', title: 'You can change it yourself', text: 'Changing a banner or a product category does not mean calling a developer.' },
			{ icon: 'pulse', title: 'Tracks your sales from day one', text: 'I set up Google Analytics and your ad pixels to record every purchase, and I check it before launch.' },
			{ icon: 'check-list', title: 'With a manual and notes', text: 'I hand you the tests I ran, why I decided each thing and a short manual for whoever works on it next.' },
		];

const steps = es
	? [
			['01', 'Alcance', 'Me cuentas qué problema quieres resolver y acordamos qué incluye el proyecto y qué no.'],
			['02', 'Diseño', 'Antes de programar, diseño las pantallas principales en celular y en computadora para que las revises.'],
			['03', 'Construcción', 'Programo por partes y te las voy enseñando funcionando. No tienes que esperar al final para ver algo.'],
			['04', 'Entrega', 'Pruebo todo, reviso que las mediciones funcionen, te dejo el manual y te acompaño en el lanzamiento.'],
		]
	: [
			['01', 'Scope', 'You tell me which problem you want to solve and we agree on what the project includes and what it does not.'],
			['02', 'Design', 'Before coding, I design the main screens on mobile and desktop for you to review.'],
			['03', 'Build', 'I build in parts and show them to you working. You do not have to wait until the end to see something.'],
			['04', 'Delivery', 'I test everything, check that tracking works, leave you the manual and stay with you through launch.'],
		];

const stack = ['Shopify', 'Liquid', 'JavaScript', 'Astro', 'Cloudflare', 'GA4 · GTM', 'Klaviyo', 'Odoo'];
---

<Breadcrumbs
	locale={locale}
	items={[
		{ label: es ? 'Productos' : 'Products', href: routes[locale].products },
		{ label: es ? 'Desarrollo web' : 'Web development' },
	]}
/>
<article class="jx-home jx-bots jx-svc" data-product-detail="desarrollo-web">
	<PageHero
		loop="web"
		id="dev-title"
		label={es ? 'Servicio · Desarrollo web' : 'Service · Web development'}
		title={es ? ['Hago tiendas en Shopify y páginas web', 'que abren rápido y que tú puedes actualizar.'] : ['I build Shopify stores and websites', 'that open fast and that you can update.']}
		lede={es
			? 'Diseño y programo tu tienda o tu página, le agrego lo que tu plantilla no trae y la conecto con los sistemas que ya usas. Antes de diseñar veo qué te está haciendo perder ventas, y al final te entrego todo probado y con un manual.'
			: 'I design and build your store or your website, add what your template does not include and connect it to the systems you already use. Before designing I look at what is making you lose sales, and at the end I hand everything over tested and with a manual.'}
	>
		<div class="jx-actions jx-actions--center">
			<a class="jx-btn jx-btn--primary" href={contactUrl} data-analytics-event="click_dev_contact">{es ? 'Quiero mi tienda' : 'I want my store'}<Icon name="arrow-right" /></a>
			<a class="jx-btn jx-btn--ghost" href={routes[locale].work}>{es ? 'Ver proyectos reales' : 'See real projects'}</a>
		</div>
		{desk && (
			<figure class="jx-svc__stage">
				<img class="jx-svc__desk" src={desk} alt={es ? 'La tienda de Come Verde en escritorio' : 'The Come Verde store on desktop'} width="1600" height="1000" decoding="async" fetchpriority="high" />
				{phone && <img class="jx-svc__phone" src={phone} alt={es ? 'La tienda de WU Nutrition en celular' : 'The WU Nutrition store on mobile'} width="780" height="1688" loading="lazy" decoding="async" />}
				<figcaption class="jx-mono">{es ? 'Proyectos reales · Come Verde y WU Nutrition' : 'Real projects · Come Verde and WU Nutrition'}</figcaption>
			</figure>
		)}
	</PageHero>

	<section class="jx-bots__section" aria-labelledby="dev-builds">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Qué construyo' : 'What I build'}</p>
			<h2 id="dev-builds" class="jx-h2"><span>{es ? 'De una sección nueva' : 'From one new section'}</span>{' '}<span class="jx-soft">{es ? 'a la tienda completa.' : 'to the whole store.'}</span></h2>
			<ul class="jx-points jx-svc__grid3">
				{builds.map((item) => <li><Icon name={item.icon} size="md" /><strong>{item.title}</strong><span>{item.text}</span></li>)}
			</ul>
		</div>
	</section>

	<section class="jx-bots__section" aria-labelledby="dev-quality">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Cómo la entrego' : 'How I deliver it'}</p>
			<h2 id="dev-quality" class="jx-h2"><span>{es ? 'Lo que incluye' : 'What every delivery'}</span>{' '}<span class="jx-soft">{es ? 'cada entrega' : 'includes'}</span></h2>
			<ul class="jx-points jx-svc__grid4">
				{qualities.map((item) => <li><Icon name={item.icon} size="md" /><strong>{item.title}</strong><span>{item.text}</span></li>)}
			</ul>
		</div>
	</section>

	<section class="jx-bots__section" aria-labelledby="dev-proof">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot jx-dot--live" aria-hidden="true"></span>{es ? 'Proyectos reales' : 'Real projects'}</p>
			<h2 id="dev-proof" class="jx-h2"><span>{es ? 'Lo que ya construí,' : 'What I have built,'}</span>{' '}<span class="jx-soft">{es ? 'con capturas reales.' : 'with real captures.'}</span></h2>
			<JxProofCards locale={locale} slugs={['wu-nutrition', 'come-verde', 'bloqio-cro-apps', 'tiendaonline']} cases={cases} />
		</div>
	</section>

	<section class="jx-bots__section" aria-labelledby="dev-steps">
		<div class="jx-wrap">
			<p class="jx-label"><span class="jx-dot" aria-hidden="true"></span>{es ? 'Los pasos' : 'The steps'}</p>
			<h2 id="dev-steps" class="jx-h2"><span>{es ? 'Revisas avances' : 'You review progress'}</span>{' '}<span class="jx-soft">{es ? 'en cada etapa' : 'at every stage'}</span></h2>
			<ol class="jx-steps">{steps.map(([number, title, text]) => <li><span class="jx-mono">{number}</span><strong>{title}</strong><p>{text}</p></li>)}</ol>
			<ul class="jx-svc__stack" aria-label={es ? 'Con qué trabajo' : 'What I work with'}>
				{stack.map((item) => <li>{item}</li>)}
			</ul>
		</div>
	</section>

	{AUDIT_ENABLED && <AuditCta locale={locale} id="auditoria-express" />}

	<section class="jx-close" aria-labelledby="dev-close">
		<div class="jx-close__card">
			<h2 id="dev-close" class="jx-close__title"><span>{es ? '¿Vas a abrir tu tienda en línea' : 'Opening your online store'}</span>{' '}<span class="jx-soft">{es ? 'o a rehacer la que tienes?' : 'or rebuilding the one you have?'}</span></h2>
			<p>{es ? 'Cuéntame qué vendes, en qué plataforma estás y qué te gustaría cambiar. En menos de un día hábil te respondo con cómo lo haría.' : 'Tell me what you sell, which platform you are on and what you would like to change. Within one business day I reply with how I would do it.'}</p>
			<div class="jx-actions jx-actions--center">
				<a class="jx-btn jx-btn--primary" href={contactUrl} data-analytics-event="click_dev_contact_bottom">{es ? 'Cuéntame tu proyecto' : 'Tell me about your project'}<Icon name="arrow-right" /></a>
				<a class="jx-btn jx-btn--ghost" href={`${routes[locale].products}consultoria/`}>{es ? 'Si todavía no sabes qué necesitas' : 'If you are not sure yet what you need'}</a>
			</div>
		</div>
	</section>
</article>
