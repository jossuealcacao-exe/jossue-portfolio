---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JossueAssistant from '../components/JossueAssistant.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import { analyticsConfig } from '../data/analytics';
import { contact } from '../data/contact';
import { equivalentPath, routes, type Locale } from '../data/i18n';
import { monetizationConfig } from '../data/monetization';
import { profile } from '../data/profile';
import '../styles/global.css';
import '../styles/redesign.css';
import '../styles/surface.css';
import '../styles/storefront.css';
import '../styles/flagship.css';
import '../styles/editorial.css';
import '../styles/jossue-system.css';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	pathname: string;
	counterpartSlug?: string;
	caseStudy?: {
		title: string;
		client: string;
		role: string;
		stack: string[];
	};
	socialImage?: {
		src: string;
		alt: string;
		width: number;
		height: number;
	};
	theme?: 'default' | 'storefront';
}

const { locale, title, description: fullDescription, pathname, counterpartSlug, caseStudy, socialImage: pageImage, theme = 'default' } = Astro.props;
// Descripción de hasta 158 caracteres, cortada en palabra completa: lo que muestran Google y las IA.
const clampText = (text: string, max = 158) => {
	const clean = text.replace(/\s+/g, ' ').trim();
	if (clean.length <= max) return clean;
	const cut = clean.slice(0, max - 1);
	return `${cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:·—-]+$/, '')}…`;
};
const description = clampText(fullDescription);
// Todas las páginas llevan imagen para redes; si la página no trae la suya, va la tarjeta de marca.
const socialImage = pageImage ?? {
	src: `/images/og/jossue-alcala-${locale}.jpg`,
	alt: locale === 'es' ? 'Jossue Alcalá, Head of E-commerce & Digital Growth. Ecommerce, Shopify, CRO, IA aplicada y AI Dev.' : 'Jossue Alcalá, Head of E-commerce & Digital Growth. Ecommerce, Shopify, CRO, applied AI and AI Dev.',
	width: 1200,
	height: 630,
};
const alternateLocale: Locale = locale === 'es' ? 'en' : 'es';
const alternatePath = equivalentPath(pathname, locale, alternateLocale, counterpartSlug);
const site = Astro.site ?? new URL('https://portfolio.invalid');
const canonical = new URL(pathname, site);
const alternate = new URL(alternatePath, site);
const defaultUrl = new URL(equivalentPath(pathname, locale, 'es', counterpartSlug), site);
const socialImageUrl = socialImage ? new URL(socialImage.src, site) : undefined;
const isProfilePage = pathname === routes[locale].home || pathname === routes[locale].about;
const pageNode = {
	'@type': isProfilePage ? 'ProfilePage' : 'WebPage',
	'@id': `${canonical.href}#page`,
	url: canonical.href,
	name: title,
	description,
	inLanguage: locale,
	isPartOf: { '@id': `${site.href}#website` },
	...(isProfilePage ? { mainEntity: { '@id': `${site.href}#person` } } : { about: { '@id': `${site.href}#person` } }),
};
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': `${site.href}#person`,
			name: profile.name,
			jobTitle: 'Head of E-commerce & Digital Growth',
			description: profile.summary[locale],
			image: new URL('/images/jossue-alcala.webp', site).href,
			url: new URL(routes[locale].about, site).href,
			worksFor: [
				{ '@type': 'Organization', name: 'WU Nutrition', url: 'https://wunutrition.com/' },
				{ '@type': 'Organization', name: 'Come Verde', url: 'https://comeverde.mx/' },
			],
			alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad de Guadalajara' },
			address: { '@type': 'PostalAddress', addressLocality: 'Guadalajara', addressRegion: 'Jalisco', addressCountry: 'MX' },
			knowsLanguage: ['es', 'en'],
			knowsAbout: [
				'Shopify',
				'Liquid',
				'E-commerce leadership and digital growth',
				'Conversion rate optimization (CRO)',
				'UX',
				'Paid media (Meta Ads, Google Ads, Amazon Ads)',
				'SEO',
				'GA4 and analytics',
				'Klaviyo',
				'Applied AI',
				'AI agents and multi-agent systems',
				'LLM applications',
				'AI-assisted software development',
				'Business automation',
				'Web development',
			],
			hasOccupation: {
				'@type': 'Occupation',
				name: 'Head of E-commerce & Digital Growth',
				skills: 'Shopify, Liquid, CRO, UX, SEO, paid media, GA4, applied AI, AI agents, web development',
			},
			...(contact.email ? { email: contact.email } : {}),
			...(contact.phone ? { telephone: contact.phone } : {}),
			sameAs: [
				...(contact.linkedin ? [contact.linkedin] : []),
				...(contact.github ? [contact.github] : []),
				'https://bloqio.app/jossuealcala/',
				'https://skillshop.credential.net/profile/jossuealcala9406/wallet',
			],
		},
		{
			'@type': 'WebSite',
			'@id': `${site.href}#website`,
			url: site.href,
			name: 'Jossue Alcalá',
			inLanguage: ['es', 'en'],
			creator: { '@id': `${site.href}#person` },
		},
		pageNode,
		...(caseStudy
			? [
					{
						'@type': 'CreativeWork',
						'@id': `${canonical.href}#project`,
						url: canonical.href,
						name: caseStudy.title,
						description,
						inLanguage: locale,
						creator: { '@id': `${site.href}#person` },
						author: { '@id': `${site.href}#person` },
						about: caseStudy.client,
						keywords: caseStudy.stack.join(', '),
						abstract: caseStudy.role,
					},
				]
			: []),
	],
};
---

<!doctype html>
<html lang={locale} data-gtm-configured={Boolean(analyticsConfig.gtmId)} data-ga4-configured={Boolean(analyticsConfig.ga4Id)}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content={profile.name} />
		<meta name="google-adsense-account" content={monetizationConfig.adsenseAccount} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="theme-color" content="#050605" />
		<title>{title}</title>
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang={locale} href={canonical} />
		<link rel="alternate" hreflang={alternateLocale} href={alternate} />
		<link rel="alternate" hreflang="x-default" href={defaultUrl} />
		<link rel="alternate" type="application/rss+xml" title={locale === 'es' ? 'Blog de Jossue Alcalá' : "Jossue Alcalá's blog"} href={`https://blog.jossuealcala.com/${locale}/rss.xml`} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Jossue Alcalá" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={locale === 'es' ? 'es_MX' : 'en_US'} />
		<meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_MX'} />
		{socialImage && socialImageUrl && (
			<>
				<meta property="og:image" content={socialImageUrl} />
				<meta property="og:image:alt" content={socialImage.alt} />
				<meta property="og:image:width" content={String(socialImage.width)} />
				<meta property="og:image:height" content={String(socialImage.height)} />
			</>
		)}
		<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{socialImage && socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
		{socialImage && <meta name="twitter:image:alt" content={socialImage.alt} />}
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
	</head>
	<body data-site-theme={theme}>
		<a class="skip-link" href="#main">{locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
		<Header locale={locale} pathname={pathname} counterpartSlug={counterpartSlug} />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<div class="section-spy" data-section-spy aria-hidden="true">
			<span class="section-spy__dot"></span>
			<span class="section-spy__label" data-section-spy-label>
				<span data-section-spy-num></span><span class="section-spy__rest" data-section-spy-rest></span>
			</span>
		</div>
		<JossueAssistant locale={locale} />
		<Footer locale={locale} />
		<script is:inline define:vars={{ locale }}>
			document.documentElement.dataset.locale = locale;
		</script>
		<AnalyticsConsent locale={locale} />
		<script>
			import { bindAnalyticsEvents } from '../scripts/analytics';
			import { initEvidenceGalleries } from '../scripts/evidence-gallery';
			import { initKpiMotion } from '../scripts/kpi-motion';
			import { initJxMotion } from '../scripts/jx-motion';
			import { initSiteBubble } from '../scripts/site-bubble';
			import { initMotion } from '../scripts/motion';
			import { initProjectSlides } from '../scripts/slides';

			import { initStackCarousels } from '../scripts/stack-carousel';

			bindAnalyticsEvents();
			initMotion();
			initJxMotion();
			initSiteBubble();
			initKpiMotion();
			initProjectSlides();
			initEvidenceGalleries();
			initStackCarousels();
		</script>
	</body>
</html>
