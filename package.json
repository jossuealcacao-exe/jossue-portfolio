{
  "name": "jossue-portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
		"dev": "astro dev",
		"api": "node --env-file=.env.api api/server.mjs",
		"test:api": "node --test api/server.test.mjs",
		"test:worker": "node --test worker/index.test.mjs",
		"build": "astro build",
		"build:production": "PUBLIC_SITE_URL=https://jossuealcala.com PUBLIC_CONTACT_ENDPOINT=/api/contact PUBLIC_GA4_ID=G-LVEXEJH1YJ astro build",
		"deploy": "npm run build:production && npx --yes wrangler@4.119.0 deploy",
		"submissions": "node --env-file=.env.api scripts/list-submissions.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "test:links": "node scripts/test-links.mjs",
    "test:routes": "node scripts/test-routes.mjs",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
		"validate": "npm run check && npm run lint && npm run build && npm run test:api && npm run test:worker && npm run test:routes && npm run test:links && npm run test:e2e",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "astro": "7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^1.7.0",
    "typescript-eslint": "^8.64.0"
  }
}
